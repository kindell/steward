#!/bin/bash
# probes/chromium-rig — is this session's browser rig answering, and how?
#
# WHY THE PRODUCT OWNS THIS ONE. A rig measurement reads ports and firewall
# rules. It knows no accounts, no tokens and no customers, so it can be
# domain-agnostic — which is exactly the line that decides what lives here and
# what lives in an estate's own probes directory.
#
# THE MEASUREMENT IS INJECTABLE, and that is not a testing convenience: a prober
# that can only be run against a live machine is a prober that is run once by
# hand and then rots. STEWARD_RIG_MEASURE_CMD takes a host and prints three key
# lines; the default below asks over ssh.
#
# FIVE RIG OUTCOMES, FOUR STATUS WORDS. The asset vocabulary is closed on
# purpose — every consumer would otherwise have to learn each new word — so two
# of the outcomes are `up` with a warning carried in the detail field:
#
#   cdp-open-to-all-local-users  CDP is full remote control of the browser with
#                                NO authentication: every tab, every cookie,
#                                every logged-in session, and the ability to act
#                                as the user. The port binds loopback, which
#                                sounds safe and is not — loopback has no user
#                                boundary, so every account on the machine
#                                reaches it. The real boundary is a firewall
#                                rule matching on UID. Without it, any other
#                                account on that machine can drive this browser.
#
#   cdp-on-port-N-not-D          The profile runs on a port the registry does
#                                not declare. The rig works; declared and
#                                measured truth have come apart. The fix is to
#                                sync the registry, not to touch the rig.
#
# Both are `up` because the status word answers "can the session use this
# asset", and in both cases it can. They are a security problem and a
# bookkeeping problem respectively — real, but not that question.
#
# READS ONLY.
set -uo pipefail

# ── the session, which does not travel in the arguments ────────────────────
#
# asset_probe hands a prober <type> <arg>, and `chromium-rig` carries no arg —
# there is nothing in the signature that says WHOSE rig to measure. The session
# name rides in the environment instead. Declaring `chromium-rig:<session>` in
# the registry would have worked too, and was rejected: it repeats the session
# name in every conf and turns a derivation (a rig implies a rig asset) into a
# transcription that can drift.
answer() { printf '%s %s\n' "$1" "$2"; exit 0; }

# THE ARGUMENT IS NOT SILENTLY IGNORED. Nothing stops a conf from declaring
# `chromium-rig:some-other-session`; the dispatcher forwards the arg faithfully
# and this prober has no use for it, so it would measure whatever
# STEWARD_PROBE_SESSION says and answer `up` about a session the reader never
# asked about — the arg's whole content lost without a word. Saying so is the
# only way the rejected syntax stays rejected instead of becoming a quiet
# half-feature.
[ -z "${2:-}" ] || answer unknown unexpected-arg

session="${STEWARD_PROBE_SESSION:-}"
[ -n "$session" ] || answer unknown no-session-context

HERE="$(CDPATH= cd -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/registry.sh
. "$HERE/lib/registry.sh" 2>/dev/null || answer unknown no-registry
registry_load "$session" >/dev/null 2>&1 || answer unknown unloadable-session

[ "${BROWSER_RIG:-}" = "yes" ] || answer unknown no-rig-declared
# THESE FIVE FIELDS ARE registry_load's GUARANTEE, NOT THIS FILE'S. It resets
# every one of them before sourcing the conf, defaults HOST to the hub and
# BROWSER_PROFILE to the session name, and REFUSES a BROWSER_RIG="yes" conf whose
# display, CDP and VNC are not numeric. Fallbacks here would only look like a
# defence: they would be dead on every path that gets this far, and they would
# imply this prober survives a malformed conf when in fact registry_load has
# already failed the load and sent us to `unloadable-session` above.
host="$HOST"
cdp="$BROWSER_CDP"
vnc="$BROWSER_VNC"
profile="$BROWSER_PROFILE"

# ── the measurement ────────────────────────────────────────────────────────
#
# ONE ROUND TRIP, not three. The host is asked once for everything: what is
# listening, which CDP ports carry a gate rule, and which profile each listener
# belongs to. Splitting it would make two answers that can disagree about the
# same instant.
#
# sudo -n for iptables and ss -p: a listener's process is only visible to the
# account that owns it, and whoever measures rarely owns the rig. Without it
# every profile reads empty and every drift is invisible, which looks exactly
# like a dead rig.
#
# THE CONNECT DEADLINE MUST FIT INSIDE asset_probe's. These two numbers are not
# independent and must never be tuned as if they were:
#
#   ConnectTimeout below            this prober's own bound on the connect phase
#   STEWARD_ASSET_PROBE_TIMEOUT     asset_probe's bound on this whole process
#                                   (lib/assets.sh, default 5s)
#
# Whichever fires first decides what the reader is told. When the prober's bound
# is the LARGER one the prober never gets to answer at all: against a blackholed
# host asset_probe kills it and reports `unknown probe-timeout`, and the
# host-unreachable branch below — which exists precisely to say WHICH machine
# stopped answering — becomes reachable only for failures fast enough to beat the
# outer clock, i.e. connection refused and DNS. It shipped that way (8s against
# 5s) and the branch was dead for every case it was written for.
#
# 3s is therefore deliberate and has to stay under the outer default. The chain
# suite asserts the ordering rather than trusting this comment.
default_measure() {
  ssh -o BatchMode=yes -o ConnectTimeout=3 "$1" '
    printf "BIND %s\n" "$(ss -ltn 2>/dev/null | tr -s " " | cut -d" " -f4 | grep -E ":(59[0-9][0-9]|9[0-9]{3})$" | sort -u | tr "\n" " ")"
    printf "GATED %s\n" "$(sudo -n iptables -L OUTPUT -n 2>/dev/null | grep -oE "dpt:9[0-9]{3}" | cut -d: -f2 | sort -u | tr "\n" " ")"
    printf "PROFILE "
    for _p in $(ss -ltn 2>/dev/null | grep -oE "127\.0\.0\.1:9[0-9]{3}" | cut -d: -f2 | sort -u); do
      _pid="$(sudo -n ss -ltnp 2>/dev/null | grep "127.0.0.1:$_p " | grep -oE "pid=[0-9]+" | cut -d= -f2 | head -1)"
      [ -n "$_pid" ] || continue
      _pr="$(sudo -n ps -o args= -p "$_pid" 2>/dev/null | grep -oE "user-data-dir=[^ ]+" | head -1 | sed "s|.*/||" | tr -d "\x27\"")"
      [ -n "$_pr" ] && printf "%s=%s " "$_p" "$_pr"
    done
    printf "\n"' 2>/dev/null
}

measure_cmd="${STEWARD_RIG_MEASURE_CMD:-}"
if [ -n "$measure_cmd" ]; then
  raw="$("$measure_cmd" "$host" 2>/dev/null)" || raw=""
else
  raw="$(default_measure "$host")" || raw=""
fi

# A HOST THAT DID NOT ANSWER IS UNKNOWN, NOT DOWN. Not knowing whether a rig
# lives is not the same as knowing it is dead — and the second sends whoever
# reads it off to restart a machine that was fine.
[ -n "$raw" ] || answer unknown host-unreachable

binds="$(printf '%s' "$raw" | sed -n 's/^BIND //p')"
gates="$(printf '%s' "$raw" | sed -n 's/^GATED //p')"
profiles="$(printf '%s' "$raw" | sed -n 's/^PROFILE //p')"

# A HOST THAT CONNECTED IS NOT A HOST THAT WAS MEASURED. The check above only
# proves `raw` is non-empty, and `raw` is non-empty as soon as ssh gets a shell:
# default_measure prints `BIND %s` whether or not the subshell inside it produced
# anything, so a host with no `ss` on its PATH answers the bare label `BIND `.
#
# AN EMPTY BIND LIST IS THEREFORE A MEASUREMENT THAT DID NOT HAPPEN, not a host
# with nothing listening. Read as the second, it makes every rig on that host
# `down not-listening` — which tells the reader to go restart machines that were
# never asked. A host really has to have SOMETHING in the 59xx/9xxx range for
# this prober to have anything to say about it; nothing at all means the question
# went unanswered.
[ -n "$binds" ] || answer unknown no-listeners-measured

# GLOBBING OFF FROM HERE DOWN. Every loop below word-splits a string that came
# off ANOTHER MACHINE — `for b in $2`, `for kv in $profiles` — and the splitting
# is what those loops are for. The expansion that rides along with it is not: a
# remote value carrying `*` or `?` would be expanded against THIS machine's
# working directory, so a bind list or a profile name could silently become a
# list of local filenames and the mapping would read a fiction. lib/assets.sh
# carries the same guard for the same hazard.
#
# NO RESTORE, AND THAT IS CHECKED RATHER THAN ASSUMED: a prober is always its own
# process — probe-dispatch `exec`s it, asset_probe runs it as a command — so this
# flag dies with `answer`'s exit and can reach no caller. session_assets has to
# restore because it deliberately runs IN the caller's shell.
#
# SET HERE, NOT AT THE TOP, so registry.sh is sourced and registry_load runs with
# the shell options they were written under.
set -f

# ── reading the bind list ──────────────────────────────────────────────────
#
# THE BIND LIST CARRIES THE ADDRESS, and the two ports ask OPPOSITE questions of
# it. CDP should be loopback-bound (it is gated per owner); VNC should be
# reachable over the tailnet, or "connect here" is a lie. A measurement that
# throws the address away and keeps the port answers neither: it once reported
# two rigs of seven as up at an address nobody could reach.
port_listening() { local p="$1" b; [ -n "$p" ] || return 1
  for b in $2; do case "$b" in *":$p") return 0 ;; esac; done; return 1; }
port_outward() { local p="$1" b a; [ -n "$p" ] || return 1
  for b in $2; do case "$b" in *":$p")
    a="${b%:*}"
    case "$a" in 127.0.0.1|"[::1]"|::1|localhost) ;; *) return 0 ;; esac ;;
  esac; done; return 1; }
in_list() { case " $2 " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# ── the mapping, in precedence order ───────────────────────────────────────
#
# VNC FIRST, because it answers whether the rig can be reached at all. A rig
# nobody can connect to is not made usable by a well-gated CDP port.
if ! port_listening "$vnc" "$binds"; then
  answer down not-listening
fi
if ! port_outward "$vnc" "$binds"; then
  # LISTENING BUT NOT OUTWARD is neither up nor down. The port is alive, so
  # restarting the rig fixes nothing — it must be rebound. Two faults with two
  # different actions must not share one word.
  answer local-only vnc-loopback-only
fi

if ! port_listening "$cdp" "$binds"; then
  # DRIFT IS NOT DOWN. Before calling a rig dead, look for the profile running
  # somewhere else: declared and measured truth coming apart is a different
  # problem with a different fix, and "down" sends the reader hunting a corpse
  # that is walking around on another port.
  other=""
  for kv in $profiles; do
    case "$kv" in *"=$profile") other="${kv%%=*}"; break ;; esac
  done
  [ -n "$other" ] && answer up "cdp-on-port-${other}-not-${cdp}"
  # NO CDP AT ALL, though VNC is reachable: you can watch the rig but not drive
  # it, and an agent cannot use a rig it cannot drive. A separate detail from
  # the VNC row so the reader knows which port is missing.
  #
  # AN EMPTY PROFILE LIST IS DELIBERATELY *NOT* TREATED THE WAY AN EMPTY BIND OR
  # GATE LIST IS, and the asymmetry is a decision, not an oversight. PROFILE
  # comes off `sudo -n`, so a denied sudo empties it the same silent way — but
  # unlike the other two, an empty PROFILE is ALSO what a host with no other
  # browser honestly reports, and that host is exactly this branch's `down`.
  # Separating the two would mean knowing that PROFILE covers the loopback CDP
  # port space, i.e. teaching this prober a port-range policy that belongs to an
  # estate, not to the product; every looser test also matches another session's
  # loopback VNC on a shared host. Inferring "sudo worked" from a non-empty gate
  # list would be inference, not measurement.
  #
  # What that leaves: the DANGEROUS half of a denied sudo — the false ungated-CDP
  # alarm — is caught below. The residual is a `down` here for a rig that may be
  # alive on a drifted port. Whoever narrows this must bring a measurement that
  # separates "sudo was refused" from "there is nothing else running".
  answer down cdp-not-listening
fi

if ! in_list "$cdp" "$gates"; then
  # THE ALARM IS DERIVED FROM AN ABSENCE, so the list it is absent from has to
  # have been read. `sudo -n iptables` is denied whenever the probing account is
  # not the one carrying the NOPASSWD rule, and it fails the same silent way the
  # bind list does: the label prints, the list behind it is empty. An empty gate
  # list would then raise the table's most serious row for every rig on the host
  # — a false alarm that costs the alarm its credibility the first time someone
  # checks and finds the rule in place.
  #
  # The gate question is only ASKED here, on the branch where CDP is listening,
  # so this is the only place an empty list can be mistaken for a "no".
  [ -n "$gates" ] || answer unknown gates-not-measured
  answer up cdp-open-to-all-local-users
fi

answer up "vnc:${vnc} cdp:${cdp}"
