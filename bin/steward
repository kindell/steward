#!/bin/bash
# bin/steward — the operator's laptop client (a personal estate list and four
# verbs over plain ssh) PLUS a thin dispatcher onto the local bash engine for
# commands that build an estate rather than reach one. Runs on macOS bash 3.2
# as well as Linux — no arrays of the modern kind, no mapfile. A bare
# invocation (no subcommand) starts the interactive cockpit (a Rust TUI under
# cockpit/), building it with cargo first if this checkout has never built it.
#
# THE LIST IS PERSONAL, AND THAT IS THE DESIGN. Estates do not know about each
# other; only the operator's own machine holds the list, and two operators of
# the same estate each hold their own file under their own word for it. The
# client never becomes a channel between estates — it fans out, one ssh at a
# time, and failures are reported per estate rather than aborting the sweep.
#
#   steward add <estate> <ssh-target> [estate-root] [product-dir]
#   steward ls [<estate>]
#   steward <estate> attach <session>
#   steward <estate> peek <session>
#   steward init <estate> <ssh-target>
#   steward scaffold <dir> org=<> team=<> owner=<> session=<> [assets=<>] [--json]
#   steward assets <session> [--json]
#   steward sessions [--json]
#   steward doctor
#   steward config init --estate-root /abs [--tmux-socket /abs] [--liveness-cmd /abs]
#   steward config set KEY /abs/value
#   steward login [session]
#   steward registry team add <slug> --name "Display Name" [--member p]... [--json]
#   steward registry client add <slug> --managed-by <team-slug> --name "Display Name" [--json]
#   steward registry account add <slug> --principal <p> --host <h> [--username <u>] [--json]
#   steward registry project add <slug> --parent <entity-slug> --name "Display Name" [--json]
#   steward registry session add --account <slug> ( --project <slug> | --entity <slug> ) --slug <slug> --repo /abs/path [--host <host>] [--json]
set -uo pipefail

# THE ROOT IS WHERE THE FILE LIVES, NOT WHERE IT WAS CALLED FROM. Operators
# put a symlink to this script on PATH (~/.local/bin/steward -> the
# checkout), and BASH_SOURCE[0] carries the CALLING path, symlink and all.
# Rooting on that made every "$HERE/lib/..." source and the cockpit crate
# resolve under the symlink's home, where none of it exists — measured on the
# real hub the first day a bare `steward` ran from PATH. Resolve the symlink
# chain first (plain readlink in a loop: bash 3.2 has no readlink -f, and a
# link target may itself be relative to the link's own directory).
_selfpath="${BASH_SOURCE[0]}"
while [ -L "$_selfpath" ]; do
  _selfdir="$(CDPATH= cd -- "$(dirname "$_selfpath")" && pwd)"
  _selfpath="$(readlink "$_selfpath")"
  case "$_selfpath" in /*) ;; *) _selfpath="$_selfdir/$_selfpath" ;; esac
done
HERE="$(CDPATH= cd -- "$(dirname "$_selfpath")/.." && pwd)"
ESTATES_D="${STEWARD_ESTATES_D:-$HOME/.config/steward/estates.d}"
SSH_BIN="${STEWARD_SSH:-ssh}"
REPO_URL="${STEWARD_REPO_URL:-https://github.com/kindell/steward}"

fel() { echo "steward: $1" >&2; exit "${2:-65}"; }

usage() {
  sed -n 's/^#   //p' "${BASH_SOURCE[0]}"
  exit "${1:-64}"
}

# ---------------------------------------------------------------------------
# The operator config — ~/.config/steward/config (or $STEWARD_CONFIG_FILE).
#
# THE FILE IS NEVER SOURCED. A shell `source` on a file an operator can edit
# is an invitation to run whatever gets written there; this reader instead
# does the minimum a config file needs — read a line, split on the first
# `=`, check it against an allowlist, assign by hand through an explicit
# `case`. No `eval`, no `source`, no expansion of a value once read. A key
# outside the allowlist (COCKPIT_ENGINE_CMD, STEWARD_SSH, any other
# STEWARD_*) is refused outright — those are a different authority class,
# run via `bash -c`/argv elsewhere, and the file must never become a way to
# steer them.
#
# PRECEDENCE: the process environment always wins; the file only fills in
# what is unset. Every one of the three allowlisted variables gets a
# _CFG_SOURCE_<KEY> of process-environment | config-file | unset, set
# unconditionally so a caller never has to ask "did this even run."
#
# A BROKEN FILE IS A REFUSAL FOR THE WHOLE INVOCATION, never "skip the
# line" — the caller (the dispatcher, just below) exits before any
# subcommand runs. rc 0 covers both "no file" (the normal, unconfigured
# state) and "valid file"; rc 78 is a broken file, with a reason left in
# $_CFG_ERROR naming the file and line.

# THE ALLOWLIST IS ONE LIST, NOT TWO. `_operator_config_load` below and
# `steward config init`/`set` (further down) both decide "is this key
# writable" through this one predicate and this one piece of text — never
# two independently maintained copies that could quietly drift apart.
_CFG_ALLOWED_KEYS_TEXT="STEWARD_ESTATE_ROOT, STEWARD_TMUX_SOCKET, STEWARD_LIVENESS_CMD"
_CFG_ALLOWED_KEY() { # <key> — true iff key is one of the three writable operator-config keys.
  case "$1" in
    STEWARD_ESTATE_ROOT|STEWARD_TMUX_SOCKET|STEWARD_LIVENESS_CMD) return 0 ;;
    *) return 1 ;;
  esac
}

# _CFG_VALUE_OK <key> <value> — the value-shape contract shared by the
# parser and the writer: no quotes/escapes, no command or variable
# substitution, no CR, no leading/trailing whitespace, absolute path only.
# On failure this sets $_CFG_VALUE_REASON (no file:line prefix — the parser
# and the writer each build their own message around it) and returns 1.
# THE ROUND-TRIP CONTRACT LIVES HERE: anything `config` writes must be
# something this function accepts, and anything it refuses at parse time it
# refuses at write time too — one judgment, not two.
_CFG_VALUE_OK() {
  local key="$1" value="$2"
  case "$value" in
    *\"*|*\'*)
      _CFG_VALUE_REASON="$key: value must not be quoted"; return 1 ;;
  esac
  # BACKTICKS AND ${ ARE THE SAME SHAPE CLASS AS $(. Refusing only one
  # spelling of substitution leaves the invariant depending on every future
  # consumer staying argv-only; all three are refused at the door instead.
  case "$value" in
    *'$('*|*\`*|*'${'*)
      _CFG_VALUE_REASON="$key: value must not contain command or variable substitution"; return 1 ;;
  esac
  # CONTROL BYTES ARE INVISIBLE VALUE BYTES -- not just the CR a
  # Windows-saved file leaves behind, but an embedded NEWLINE (which turns
  # one config-file value into a second, operator-never-named line the
  # parser reads back as its own key -- the STEWARD_TMUX_SOCKET/
  # STEWARD_LIVENESS_CMD smuggle a review found against `config init`/`set`,
  # both of which take this value straight from argv) and a TAB (the
  # --json field separator downstream in doctor). Refusing the whole
  # 0x00-0x1F control range in one glob character class, rather than CR
  # alone, closes all of these at the one value-shape gate the parser and
  # the writer both call -- never two independently maintained checks that
  # could drift.
  case "$value" in
    *[[:cntrl:]]*)
      _CFG_VALUE_REASON="$key: value contains a newline or other control character (was the file saved with Windows line endings, or does the value smuggle a second line?)"; return 1 ;;
  esac
  local _tab; _tab="$(printf '\t')"
  case "$value" in
    " "*|*" "|"$_tab"*|*"$_tab")
      _CFG_VALUE_REASON="$key: value has leading or trailing whitespace"; return 1 ;;
  esac
  case "$value" in
    /*) ;;
    *)
      _CFG_VALUE_REASON="$key must be an absolute path (leading '/'): '$value'"; return 1 ;;
  esac
  return 0
}

_CFG_MODE_OF() { # <path> — best-effort octal mode, BSD or GNU stat.
  # ONLY AN OCTAL ANSWER COUNTS. On GNU/Linux, `stat -f` means FILESYSTEM
  # status — the BSD-first probe "succeeds" (rc 0) with a multi-line
  # filesystem report instead of a mode, so a non-empty check alone lets
  # garbage through and the GNU fallback is never reached. Measured
  # 2026-08-30 on a fresh Ubuntu host: the first `config init` a new
  # operator ran refused a normal 0755 directory with the ext4 report
  # pasted into the refusal. Each answer is accepted only if it looks
  # like a mode; anything else falls through to the next form.
  local p="$1" m
  for m in "$(stat -f '%Lp' "$p" 2>/dev/null)" "$(stat -c '%a' "$p" 2>/dev/null)"; do
    case "$m" in
      [0-7]|[0-7][0-7]|[0-7][0-7][0-7]|[0-7][0-7][0-7][0-7]) printf '%s' "$m"; return 0 ;;
    esac
  done
  return 1
}

_CFG_GROUP_OR_OTHER_WRITABLE() { # <octal mode> — true if group or other carries the write bit.
  local m="$1" len grp oth
  len=${#m}
  [ "$len" -ge 2 ] || return 1
  grp="${m:$((len-2)):1}"
  oth="${m:$((len-1)):1}"
  [ $(( 8#$grp & 2 )) -ne 0 ] && return 0
  [ $(( 8#$oth & 2 )) -ne 0 ] && return 0
  return 1
}

_operator_config_load() {
  _CFG_ERROR=""
  local f="${STEWARD_CONFIG_FILE:-$HOME/.config/steward/config}"

  _CFG_SOURCE_STEWARD_ESTATE_ROOT="unset"
  _CFG_SOURCE_STEWARD_TMUX_SOCKET="unset"
  _CFG_SOURCE_STEWARD_LIVENESS_CMD="unset"
  [ -n "${STEWARD_ESTATE_ROOT:-}" ]  && _CFG_SOURCE_STEWARD_ESTATE_ROOT="process-environment"
  [ -n "${STEWARD_TMUX_SOCKET:-}" ]  && _CFG_SOURCE_STEWARD_TMUX_SOCKET="process-environment"
  [ -n "${STEWARD_LIVENESS_CMD:-}" ] && _CFG_SOURCE_STEWARD_LIVENESS_CMD="process-environment"

  # A SYMLINK IS REFUSED OUTRIGHT, before anything else is asked of it —
  # including the "no file at all" check just below. `-L` does NOT follow
  # the link (unlike `-e`), so this also catches a DANGLING symlink (target
  # does not exist): checked here, ahead of `-e`, a dangling link is the
  # same refusal a live one is, rather than reading as "no file yet" and
  # being certified WARN(ambient-only) with no mention of the symlink at
  # all — the target could otherwise be swapped out from under an
  # owner/mode check that ran a moment earlier, too.
  if [ -L "$f" ]; then
    _CFG_ERROR="steward: operator config is a symlink, refusing: $f"
    return 78
  fi

  # NO FILE AT ALL IS THE NORMAL STATE. Most operators never write one — the
  # environment (a session conf, a supervisor) supplies everything. rc 0.
  [ -e "$f" ] || return 0

  if [ ! -f "$f" ]; then
    _CFG_ERROR="steward: operator config is not a regular file: $f"
    return 78
  fi
  # OWNED BY THE EFFECTIVE USER. Cannot be fixtured without root, so this
  # branch has no dedicated test — but a file another account can write is
  # exactly the injection this whole reader exists to close off.
  if [ ! -O "$f" ]; then
    _CFG_ERROR="steward: operator config is not owned by the current user, refusing: $f"
    return 78
  fi

  local mode
  mode="$(_CFG_MODE_OF "$f")" || { _CFG_ERROR="steward: cannot read the mode of operator config: $f"; return 78; }
  if _CFG_GROUP_OR_OTHER_WRITABLE "$mode"; then
    _CFG_ERROR="steward: operator config is group- or other-writable (mode $mode), refusing: $f"
    return 78
  fi

  local dir dirmode
  dir="$(dirname "$f")"
  dirmode="$(_CFG_MODE_OF "$dir")" || { _CFG_ERROR="steward: cannot read the mode of $dir"; return 78; }
  if _CFG_GROUP_OR_OTHER_WRITABLE "$dirmode"; then
    _CFG_ERROR="steward: the directory holding the operator config is group- or other-writable (mode $dirmode), refusing: $dir"
    return 78
  fi

  local lineno=0 saw_format="" line key value
  local have_root="" have_socket="" have_liveness=""
  while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno+1))

    case "$line" in
      ''|'#'*) continue ;;
    esac

    key=""; value=""
    IFS='=' read -r key value <<EOF
$line
EOF

    if [ -z "$saw_format" ]; then
      if [ "$line" != "FORMAT=1" ]; then
        if [ "$key" = "FORMAT" ]; then
          _CFG_ERROR="steward: $f:$lineno: unknown FORMAT value '$value' (only FORMAT=1 is supported)"
        else
          _CFG_ERROR="steward: $f:$lineno: the file must start with FORMAT=1"
        fi
        return 78
      fi
      saw_format=1
      continue
    fi

    if [ "$key" = "FORMAT" ]; then
      _CFG_ERROR="steward: $f:$lineno: FORMAT may only appear once, as the first line"
      return 78
    fi
    if ! _CFG_ALLOWED_KEY "$key"; then
      _CFG_ERROR="steward: $f:$lineno: unknown key '$key' (allowed: $_CFG_ALLOWED_KEYS_TEXT)"
      return 78
    fi

    if ! _CFG_VALUE_OK "$key" "$value"; then
      _CFG_ERROR="steward: $f:$lineno: $_CFG_VALUE_REASON"
      return 78
    fi

    case "$key" in
      STEWARD_ESTATE_ROOT)
        if [ -n "$have_root" ]; then
          _CFG_ERROR="steward: $f:$lineno: duplicate key 'STEWARD_ESTATE_ROOT'"
          return 78
        fi
        have_root=1
        if [ -z "${STEWARD_ESTATE_ROOT:-}" ]; then
          STEWARD_ESTATE_ROOT="$value"; export STEWARD_ESTATE_ROOT
          _CFG_SOURCE_STEWARD_ESTATE_ROOT="config-file"
        fi
        ;;
      STEWARD_TMUX_SOCKET)
        if [ -n "$have_socket" ]; then
          _CFG_ERROR="steward: $f:$lineno: duplicate key 'STEWARD_TMUX_SOCKET'"
          return 78
        fi
        have_socket=1
        if [ -z "${STEWARD_TMUX_SOCKET:-}" ]; then
          STEWARD_TMUX_SOCKET="$value"; export STEWARD_TMUX_SOCKET
          _CFG_SOURCE_STEWARD_TMUX_SOCKET="config-file"
        fi
        ;;
      STEWARD_LIVENESS_CMD)
        if [ -n "$have_liveness" ]; then
          _CFG_ERROR="steward: $f:$lineno: duplicate key 'STEWARD_LIVENESS_CMD'"
          return 78
        fi
        have_liveness=1
        if [ -z "${STEWARD_LIVENESS_CMD:-}" ]; then
          STEWARD_LIVENESS_CMD="$value"; export STEWARD_LIVENESS_CMD
          _CFG_SOURCE_STEWARD_LIVENESS_CMD="config-file"
        fi
        ;;
    esac
  done < "$f"

  if [ -z "$saw_format" ]; then
    _CFG_ERROR="steward: $f: the file must start with FORMAT=1 (file is empty or only comments)"
    return 78
  fi

  return 0
}

# estate_las <name> — source the estate file into SSH/ESTATE_ROOT/PRODUCT_DIR,
# refusing (not guessing) when a field is missing. A list entry that cannot be
# read must not look like a reachable estate.
estate_las() {
  local f="$ESTATES_D/$1.conf"
  [ -f "$f" ] || fel "unknown estate '$1' — nothing at $f (see: steward ls)"
  SSH=""; ESTATE_ROOT=""; PRODUCT_DIR=""
  # shellcheck source=/dev/null
  . "$f" || fel "the estate file could not be read: $f" 78
  [ -n "$SSH" ]         || fel "SSH missing in $f" 78
  [ -n "$ESTATE_ROOT" ] || fel "ESTATE_ROOT missing in $f" 78
  [ -n "$PRODUCT_DIR" ] || fel "PRODUCT_DIR missing in $f" 78
}

# ---------------------------------------------------------------------------
# `steward config init`/`set` — the ONE writing verb over the operator
# config (~/.config/steward/config, see the reader above). Everything else
# in this file only ever reads that file; these two subcommands are the
# whole surface that ever puts bytes into it.
#
# VALUES COME FROM ARGV ONLY. Neither verb ever picks between candidates —
# no fallback, no environment scan, no guessing between two paths that both
# look plausible. An operator names the value; this only ever writes what
# it was told.
#
# ATOMIC BY CONSTRUCTION: every write goes through _cfg_atomic_write, a temp
# file created in the SAME directory as the real one (so the final rename is
# same-filesystem and therefore atomic) and moved into place with `mv`. A
# reader can only ever see the old file or the new one, never a partial
# write, and no temp file survives a failed attempt.

# _cfg_atomic_write <path> <content> — writes content to path atomically.
# Sets $_CFG_WRITE_ERROR and returns non-zero on any failure; the caller
# turns that into a `fel` refusal in the requested exit-code class.
_cfg_atomic_write() {
  local path="$1" content="$2" dir tmp
  dir="$(dirname "$path")"
  if [ -L "$dir" ]; then
    _CFG_WRITE_ERROR="the directory holding the operator config is a symlink, refusing: $dir"
    return 78
  fi
  tmp="$( (umask 077; mktemp "$dir/.config.tmp.XXXXXX" 2>/dev/null) )"
  if [ -z "$tmp" ]; then
    _CFG_WRITE_ERROR="could not create a temporary file in $dir"
    return 70
  fi
  if ! printf '%s' "$content" > "$tmp"; then
    rm -f "$tmp"
    _CFG_WRITE_ERROR="could not write $tmp"
    return 70
  fi
  if ! chmod 0600 "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    _CFG_WRITE_ERROR="could not set mode 0600 on $tmp"
    return 70
  fi
  # RECHECKED RIGHT BEFORE THE RENAME — the window between the caller's own
  # create-only/symlink check and here is exactly where a concurrent
  # writer could have swapped the target for a symlink. `mv` onto a symlink
  # replaces the link itself rather than following it, so this is
  # belt-and-braces rather than load-bearing, but it keeps the invariant
  # honest under a hostile concurrent writer too.
  if [ -L "$path" ]; then
    rm -f "$tmp"
    _CFG_WRITE_ERROR="operator config path is a symlink, refusing: $path"
    return 78
  fi
  if ! mv -f "$tmp" "$path"; then
    rm -f "$tmp"
    _CFG_WRITE_ERROR="could not rename the temp file into place: $path"
    return 70
  fi
  return 0
}

# _cfg_file — the same seam $STEWARD_CONFIG_FILE/$HOME/.config/steward/config
# _operator_config_load reads, named once so init/set can never drift from it.
_cfg_file() { printf '%s\n' "${STEWARD_CONFIG_FILE:-$HOME/.config/steward/config}"; }

# _cfg_lock_acquire <dir> — an mkdir-based lock around the operator config's
# read-modify-write. mkdir is atomic on every filesystem this runs on and
# needs no helper binary; flock is not portable to macOS. A held lock is
# never stolen: a few short retries, then a refusal that names the lock
# path so an operator can tell a genuinely stuck lock from a slow one. On
# success sets $_CFG_LOCK_DIR (what the caller's trap releases); on failure
# sets $_CFG_LOCK_ERROR.
_cfg_lock_acquire() {
  local dir="$1" lock="$dir/.steward-config.lock" tries=0
  while ! mkdir "$lock" 2>/dev/null; do
    tries=$((tries+1))
    if [ "$tries" -ge 10 ]; then
      _CFG_LOCK_ERROR="another 'steward config' command holds the lock, refusing: $lock"
      return 1
    fi
    sleep 0.1
  done
  _CFG_LOCK_DIR="$lock"
  return 0
}

# _cfg_lock_release <lock-dir> — rmdir on a path that was never created (the
# empty-string case, when acquire itself failed) is a silent no-op, so a
# single `trap _cfg_lock_release ... EXIT` covers every return and every
# `fel` exit in the caller without a matching if/else at each one.
_cfg_lock_release() {
  [ -n "${1:-}" ] && rmdir "$1" 2>/dev/null
  return 0
}

# _cfg_refuse_writable_dir <dir> — the SAME parent-dir group/other-writable
# predicate _operator_config_load's reader enforces (_CFG_GROUP_OR_OTHER_
# WRITABLE), run by the writer too, before it creates the lock or touches
# the file. Without this the reader FAILs on a 0775 config directory
# forever, while `config set`'s own remedy text ("run: steward config set
# ...") reports success and never converges — the writer never checked the
# one thing that was actually broken. `fel`s directly (rc 78), naming the
# directory, so callers just call this ahead of the lock.
_cfg_refuse_writable_dir() {
  local dir="$1" dirmode
  dirmode="$(_CFG_MODE_OF "$dir")" || fel "could not read the mode of $dir" 70
  if _CFG_GROUP_OR_OTHER_WRITABLE "$dirmode"; then
    fel "the directory holding the operator config is group- or other-writable (mode $dirmode), refusing: $dir" 78
  fi
}

cmd_config_init() {
  local estate_root="" tmux_socket="" liveness_cmd=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --estate-root)
        [ $# -ge 2 ] || fel "config init: --estate-root needs a value" 64
        estate_root="$2"; shift 2 ;;
      --tmux-socket)
        [ $# -ge 2 ] || fel "config init: --tmux-socket needs a value" 64
        tmux_socket="$2"; shift 2 ;;
      --liveness-cmd)
        [ $# -ge 2 ] || fel "config init: --liveness-cmd needs a value" 64
        liveness_cmd="$2"; shift 2 ;;
      *) fel "config init: unknown flag '$1' (allowed: --estate-root, --tmux-socket, --liveness-cmd)" 64 ;;
    esac
  done
  [ -n "$estate_root" ] || fel "config init: --estate-root is required" 64

  # VALUE SHAPE IS CHECKED BEFORE ANYTHING TOUCHES THE FILESYSTEM. The lock
  # below needs the config directory to exist, so a bad --estate-root must
  # be caught first — otherwise a doomed `init` would still create an empty
  # directory on its way to refusing.
  _CFG_VALUE_OK STEWARD_ESTATE_ROOT "$estate_root" || fel "config init: $_CFG_VALUE_REASON" 64
  [ -z "$tmux_socket" ]  || { _CFG_VALUE_OK STEWARD_TMUX_SOCKET "$tmux_socket"   || fel "config init: $_CFG_VALUE_REASON" 64; }
  [ -z "$liveness_cmd" ] || { _CFG_VALUE_OK STEWARD_LIVENESS_CMD "$liveness_cmd" || fel "config init: $_CFG_VALUE_REASON" 64; }

  local f; f="$(_cfg_file)"
  local dir; dir="$(dirname "$f")"

  # A SYMLINK IS REFUSED BEFORE THE PLAIN -e CHECK — the same ordering the
  # reader uses, so a swapped-in symlink can never look like "no file yet"
  # for a moment longer than it has to.
  if [ -L "$f" ]; then
    fel "operator config path is a symlink, refusing: $f" 78
  fi
  if [ -L "$dir" ]; then
    fel "operator config directory is a symlink, refusing: $dir" 78
  fi
  # 0700, ONLY WHEN THIS CALL IS THE ONE CREATING IT. An already-present
  # directory (estates.d lives here too) is left exactly as it is —
  # `mkdir -p` never touches a directory that already exists. The
  # directory must exist before the lock can live in it, so this runs
  # ahead of the lock rather than inside it.
  ( umask 077; mkdir -p "$dir" ) || fel "could not create $dir" 70

  # SAME PREDICATE THE READER ENFORCES, CHECKED BEFORE THE LOCK. A
  # pre-existing 0775 directory (this call's own `mkdir -p` is a no-op on
  # it) must not be allowed to accept a lock or a write it can never pass
  # back through the reader.
  _cfg_refuse_writable_dir "$dir"

  # THE LOCK COVERS THE EXISTS-CHECK AND THE CREATE TOGETHER — a concurrent
  # `init`/`set` racing on the same file is refused, never raced.
  _cfg_lock_acquire "$dir" || fel "config init: $_CFG_LOCK_ERROR" 75
  trap '_cfg_lock_release "$_CFG_LOCK_DIR"' EXIT

  # CREATE-ONLY. Checked here, inside the lock, so a concurrent `init`
  # cannot both see "no file yet" and both write.
  if [ -e "$f" ]; then
    fel "operator config already exists: $f — use 'steward config set KEY VALUE' to change it (config init only ever creates a new file)" 65
  fi

  local content="FORMAT=1
STEWARD_ESTATE_ROOT=$estate_root
"
  [ -z "$tmux_socket" ]  || content="${content}STEWARD_TMUX_SOCKET=$tmux_socket
"
  [ -z "$liveness_cmd" ] || content="${content}STEWARD_LIVENESS_CMD=$liveness_cmd
"

  _cfg_atomic_write "$f" "$content" || fel "$_CFG_WRITE_ERROR" 70
  echo "steward: wrote $f"
}

cmd_config_set() {
  local key="${1:-}" value="${2:-}"
  [ -n "$key" ] && [ -n "$value" ] || fel "usage: steward config set KEY /abs/value" 64
  if ! _CFG_ALLOWED_KEY "$key"; then
    fel "config set: unknown key '$key' (allowed: $_CFG_ALLOWED_KEYS_TEXT)" 64
  fi
  _CFG_VALUE_OK "$key" "$value" || fel "config set: $_CFG_VALUE_REASON" 64

  local f; f="$(_cfg_file)"
  if [ -L "$f" ]; then
    fel "operator config path is a symlink, refusing: $f" 78
  fi
  if [ ! -e "$f" ]; then
    fel "operator config does not exist: $f — run 'steward config init --estate-root /abs/estate-root' first" 65
  fi
  if [ ! -f "$f" ]; then
    fel "operator config is not a regular file: $f" 78
  fi

  local dir; dir="$(dirname "$f")"
  # SAME PREDICATE THE READER ENFORCES, CHECKED BEFORE THE LOCK — see
  # _cfg_refuse_writable_dir.
  _cfg_refuse_writable_dir "$dir"
  _cfg_lock_acquire "$dir" || fel "config set: $_CFG_LOCK_ERROR" 75
  trap '_cfg_lock_release "$_CFG_LOCK_DIR"' EXIT

  # REPAIR FOR REAL, NOT JUST THE TOUCHED KEY. The old behavior only ever
  # rewrote the target key's own line(s) and carried every other line
  # through unchanged — including a line the parser would refuse, so a
  # file broken by something `set` never touched stayed broken after `set`
  # claimed success. The contract now: KEEP FORMAT=1 first (always
  # synthesized fresh — a corrupt or missing first line is silently
  # replaced, since it is not a value line and there is nothing meaningful
  # to quote), every comment and blank line, and the first occurrence of
  # every line that passes the SAME predicates the parser itself enforces
  # (_CFG_ALLOWED_KEY + _CFG_VALUE_OK). DROP everything else — an unknown
  # key, a bad value shape, or a later duplicate of an already-kept key —
  # LOUDLY: each dropped line is echoed to stderr, quoted, with its line
  # number, as it is dropped. Nothing is dropped silently. This is what
  # makes doctor's own remedy text ("config set rewrites the file cleanly")
  # true: the file _operator_config_load refused before this call is one
  # this call's own output is guaranteed to pass.
  local body="" line lineno=0 is_first=1 lkey lvalue
  local saw_STEWARD_ESTATE_ROOT="" saw_STEWARD_TMUX_SOCKET="" saw_STEWARD_LIVENESS_CMD=""
  while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno+1))
    # COMMENTS/BLANKS ARE CHECKED BEFORE "is_first", MATCHING THE PARSER
    # EXACTLY (_operator_config_load's own `case "$line" in ''|'#'*)
    # continue ;; esac` runs before its saw_format check too). Without
    # this ordering, "is_first" was keyed to the physical first line —
    # so a valid file whose first line is a comment had that comment
    # treated as "not FORMAT=1" and dropped, is_first then flipped false,
    # and the REAL FORMAT=1 line on line 2 fell through to the key=value
    # branch below, where FORMAT is not an allowed key — dropping FORMAT=1
    # itself as "unreadable" too. A leading comment/blank is preserved
    # verbatim and never counts as "the first line" for the FORMAT check.
    case "$line" in
      ''|'#'*) body="$body$line
"; continue ;;
    esac
    if [ -n "$is_first" ]; then
      is_first=""
      # The old first (non-comment/blank) line is never carried through
      # as-is — FORMAT=1 is always synthesized below — but a first line
      # that was NOT already exactly "FORMAT=1" is genuinely being
      # dropped, so that gets the same loud treatment as any other
      # refused line.
      [ "$line" = "FORMAT=1" ] || echo "steward: config set: dropping unreadable line $lineno: '$line'" >&2
      continue
    fi
    lkey="${line%%=*}"
    lvalue="${line#*=}"
    if ! _CFG_ALLOWED_KEY "$lkey" || ! _CFG_VALUE_OK "$lkey" "$lvalue"; then
      echo "steward: config set: dropping unreadable line $lineno: '$line'" >&2
      continue
    fi
    case "$lkey" in
      STEWARD_ESTATE_ROOT)
        if [ -n "$saw_STEWARD_ESTATE_ROOT" ]; then
          echo "steward: config set: dropping unreadable line $lineno: '$line'" >&2
          continue
        fi
        saw_STEWARD_ESTATE_ROOT=1 ;;
      STEWARD_TMUX_SOCKET)
        if [ -n "$saw_STEWARD_TMUX_SOCKET" ]; then
          echo "steward: config set: dropping unreadable line $lineno: '$line'" >&2
          continue
        fi
        saw_STEWARD_TMUX_SOCKET=1 ;;
      STEWARD_LIVENESS_CMD)
        if [ -n "$saw_STEWARD_LIVENESS_CMD" ]; then
          echo "steward: config set: dropping unreadable line $lineno: '$line'" >&2
          continue
        fi
        saw_STEWARD_LIVENESS_CMD=1 ;;
    esac
    if [ "$lkey" = "$key" ]; then
      body="$body$key=$value
"
    else
      body="$body$line
"
    fi
  done < "$f"
  case "$key" in
    STEWARD_ESTATE_ROOT)  [ -n "$saw_STEWARD_ESTATE_ROOT" ]  || body="$body$key=$value
" ;;
    STEWARD_TMUX_SOCKET)  [ -n "$saw_STEWARD_TMUX_SOCKET" ]  || body="$body$key=$value
" ;;
    STEWARD_LIVENESS_CMD) [ -n "$saw_STEWARD_LIVENESS_CMD" ] || body="$body$key=$value
" ;;
  esac

  _cfg_atomic_write "$f" "FORMAT=1
$body" || fel "$_CFG_WRITE_ERROR" 70
  echo "steward: updated $key in $f"
}

cmd_config() {
  case "${1:-}" in
    init) shift; cmd_config_init "$@" ;;
    set)  shift; cmd_config_set "$@" ;;
    *) fel "usage: steward config init --estate-root /abs [--tmux-socket /abs] [--liveness-cmd /abs] | steward config set KEY /abs/value" 64 ;;
  esac
}

cmd_add() {
  local name="${1:-}" target="${2:-}"
  local root="${3:-\$HOME/estate}" prod="${4:-\$HOME/Projects/steward}"
  [ -n "$name" ] && [ -n "$target" ] || usage
  case "$name" in
    *[!abcdefghijklmnopqrstuvwxyz0123456789-]*|"") fel "estate name: [a-z0-9-] only" 64 ;;
  esac
  [ ! -f "$ESTATES_D/$name.conf" ] || fel "'$name' is already in the list — remove $ESTATES_D/$name.conf deliberately first"
  # ADOPTION READS BEFORE IT WRITES. The remote estate file is the proof that
  # an estate actually lives there; a list entry written on faith would make
  # every later 'ls' failure look like a network problem.
  local remote_root remote_prod
  remote_root="$("$SSH_BIN" "$target" "eval echo $root" 2>/dev/null)" \
    || fel "could not reach $target over ssh" 70
  "$SSH_BIN" "$target" "[ -f \"$remote_root/estate/steward.conf\" ]" 2>/dev/null \
    || fel "no estate at $remote_root on $target (estate/steward.conf missing) — is the root right?"
  remote_prod="$("$SSH_BIN" "$target" "eval echo $prod" 2>/dev/null)" || remote_prod="$prod"
  mkdir -p "$ESTATES_D"
  cat > "$ESTATES_D/$name.conf" <<EOF
# $name — added by steward add $(date -u +%Y-%m-%dT%H:%M:%SZ), after reading the estate back.
SSH="$target"
ESTATE_ROOT="$remote_root"
PRODUCT_DIR="$remote_prod"
EOF
  echo "steward: '$name' added ($target, estate at $remote_root)"
}

# The remote status command, both layouts: a checkout carries linux/, a
# deployed image is flat under the estate root. Found in neither is a refusal
# with the paths named — not a guess, and not a silent empty table.
_status_cmd() { # <extra estate-status args...>
  printf 'for c in "%s/linux/estate-status.sh" "%s/estate-status.sh"; do [ -f "$c" ] && exec env STEWARD_ESTATE_ROOT="%s" bash "$c" %s; done; echo "estate-status.sh found in neither layout (%s/linux/, %s/)" >&2; exit 78' \
    "$PRODUCT_DIR" "$ESTATE_ROOT" "$ESTATE_ROOT" "$*" "$PRODUCT_DIR" "$ESTATE_ROOT"
}

# One estate's block for ls. Never lets a failure escape the block — the sweep
# must survive an unreachable machine and SAY so, per estate.
# THE ESTATE IS A COLUMN, NOT ONLY A HEADING.
#
# Measured 2026-08-24: reading a row in `steward ls` does not tell you what to
# type as ARGUMENT ONE to reach that session. The estate stands in the section
# heading, and the SAME session can appear under two estates — a session on a
# Linux host shows up under the hub's estate and under the host's. The heading
# answers the question only until you have scrolled past it.
#
# THE PREFIX IS FIXED-WIDTH AND GOES ON EVERY ROW. The far side sends a
# `column -t`-aligned table; prefixing rows unevenly would break the alignment
# and make the table harder to read than it was without the column.
#
# ONLY THE TABLE IS PREFIXED. estate-status ends with a blank line and a note
# ("* = yours ..."); prefixing prose with an estate name would read as a row.
# The first blank line is the boundary, which is the format's own structure
# rather than a guess about the text.
_prefix_estate() { # <estate-name>
  awk -v e="$1" '
    BEGIN { intable = 1 }
    /^[[:space:]]*$/ { intable = 0; print; next }
    { if (intable) printf "%-10s %s\n", (NR == 1 ? "ESTATE" : e), $0; else print }
  '
}

_ls_en() {
  local name="$1"
  estate_las "$name"
  echo "== $name ($SSH) =="
  # THE STATUS IS CAPTURED, THEN PREFIXED — not piped.
  #
  # `if ! ssh ... | _prefix_estate` tests the PIPELINE's status, which is awk's.
  # It happens to work because this file sets `pipefail`, and that is exactly the
  # kind of dependency that dies silently: remove the option for any other reason
  # and an unreachable estate renders as a section with no rows and no warning —
  # a dead machine that reads as an empty one. Capturing makes the status the
  # one thing it is about.
  #
  # AND THE TWO STREAMS ARE KEPT APART. `2>&1` here is not the inert kind: the
  # producing process is ssh, which writes to stderr on SUCCESS routinely —
  # "Warning: Permanently added ... to the list of known hosts", banners,
  # "Pseudo-terminal will not be allocated", locale warnings. Merged, every one
  # of those went through the prefixer and rendered as a table row, and a line
  # that arrived first could take the header slot. The comment below reasons
  # carefully about the rc != 0 case and never considered rc == 0 with stderr,
  # which is the same hazard through the same line.
  local _out _err _rc _errf
  _errf="$(mktemp)" || { echo "  could not create a temporary file — skipping $name" >&2; return 1; }
  _out="$("$SSH_BIN" "$SSH" "$(_status_cmd)" 2>"$_errf")"; _rc=$?
  _err="$(cat "$_errf")"; rm -f "$_errf"
  # ONLY A SUCCESSFUL ANSWER IS A TABLE. A failed call returns ssh's error
  # lines, and prefixing those makes an error look like data: the first line
  # gets the ESTATE heading and the rest line up as rows. Measured 2026-08-24
  # against an estate whose key could not be used — "ESTATE  Permission denied,
  # please try again." A reader skims that as a session list.
  if [ "$_rc" -eq 0 ]; then
    # ON SUCCESS, ssh's STDERR IS DIAGNOSIS, NOT DATA. It is forwarded rather
    # than dropped — a host key that was just added is worth seeing — but it
    # goes to this command's own stderr, where it cannot become a row.
    [ -z "$_err" ] || printf '%s\n' "$_err" >&2
    printf '%s\n' "$_out" | _prefix_estate "$name"
  else
    [ -z "$_out" ] || printf '%s\n' "$_out"
    [ -z "$_err" ] || printf '%s\n' "$_err"
    echo "  UNREACHABLE or refused — the rows above (if any) are partial."
  fi
}

cmd_peek() {
  local name="$1" sess="${2:-}"
  [ -n "$sess" ] || usage
  case "$sess" in
    *[!abcdefghijklmnopqrstuvwxyz0123456789-]*) fel "session name: [a-z0-9-] only" 64 ;;
  esac
  estate_las "$name"
  "$SSH_BIN" "$SSH" "$(_status_cmd peek "$sess")"
}

cmd_ls() {
  local one="${1:-}"
  if [ -n "$one" ]; then _ls_en "$one"; return; fi
  [ -d "$ESTATES_D" ] || fel "no estate list yet at $ESTATES_D — start with: steward add <estate> <ssh-target>"
  local any="" f
  for f in "$ESTATES_D"/*.conf; do
    [ -f "$f" ] || continue
    any=1
    ( _ls_en "$(basename "$f" .conf)" )   # subshell: one estate's refusal must not kill the sweep
  done
  [ -n "$any" ] || fel "the estate list at $ESTATES_D is empty — start with: steward add <estate> <ssh-target>"
}

# The remote attach command. TMUX IS RESOLVED, NOT ASSUMED — the same lesson
# estate-status.sh carries, and attach was written without it. Over ssh the PATH
# is bare (a package-manager prefix is a login-shell luxury) and the estate may
# run its server on a NAMED socket under ~/.tmux. Measured 2026-08-21 against a
# hub: plain `tmux attach` found neither the binary (zsh: command not found:
# tmux) nor, once given the binary, the server (the default socket path was
# missing) although the session was up on the estate's named socket the whole
# time.
#
# TMUX_SOCKET is READ, not sourced: the estate file is configuration, and a
# client that executes a remote conf to learn a filename has made every estate
# in the personal list a way to run code here. The named socket is used only
# when it EXISTS — an estate may name a socket its machinery never created, and
# attaching to a nonexistent server hides a live session behind a connect error.
_attach_cmd() { # <session> [verb]
  # The sed script travels as a %s ARGUMENT, never inside the format: printf
  # reads \1 in a format as an octal escape and the capture group vanishes,
  # which strips the socket to empty and sends attach to the default server —
  # measured here before this reached an ssh line.
  local _sed='s/^TMUX_SOCKET="\{0,1\}\([^"]*\)"\{0,1\}.*/\1/p'
  printf 'T=tmux; command -v tmux >/dev/null 2>&1 || { for c in /opt/homebrew/bin/tmux /usr/local/bin/tmux /usr/bin/tmux; do [ -x "$c" ] && { T="$c"; break; }; done; }; S=$(sed -n '"'"'%s'"'"' "%s/estate/steward.conf" 2>/dev/null | tail -1); if [ -n "$S" ] && [ -S "$HOME/.tmux/$S" ]; then exec "$T" -S "$HOME/.tmux/$S" %s -t "=%s"; else exec "$T" %s -t "=%s"; fi' \
    "$_sed" "$ESTATE_ROOT" "${2:-attach}" "$1" "${2:-attach}" "$1"
}

cmd_attach() {
  local name="$1" sess="${2:-}"
  [ -n "$sess" ] || usage
  # The same guard peek carries: a session name is the client's own input into a
  # remote shell line, and only [a-z0-9-] may cross that boundary.
  case "$sess" in
    *[!abcdefghijklmnopqrstuvwxyz0123456789-]*) fel "session name: [a-z0-9-] only" 64 ;;
  esac
  estate_las "$name"
  # =name: tmux -t prefix-matches, and attaching to the wrong session because
  # its name extends yours is exactly the trap measured 2026-08-21.
  exec "$SSH_BIN" -t "$SSH" "$(_attach_cmd "$sess")"
}

cmd_init() {
  local name="${1:-}" target="${2:-}"
  [ -n "$name" ] && [ -n "$target" ] || usage
  [ ! -f "$ESTATES_D/$name.conf" ] || fel "'$name' is already in the list — init creates, add adopts"
  echo "steward: bootstrapping on $target — the run stops at the agent login, which is yours."
  "$SSH_BIN" -t "$target" "/bin/bash -c \"\$(curl -fsSL $REPO_URL/raw/main/install.sh)\"" \
    || fel "the bootstrap did not finish on $target — nothing added locally" 70
  cmd_add "$name" "$target"
}

# emit a one-line JSON object from key=value pairs; values are strings, bools
# are the literals true/false. Uses jq so quoting is correct for any value
# (spaces, embedded quotes — a refusal reason is free text).
_json() { # <k> <v> [<k> <v> ...]  — bools are the literals true/false
  local args=() k v
  while [ "$#" -ge 2 ]; do
    k="$1"; v="$2"; shift 2
    case "$v" in true|false) args+=(--argjson "$k" "$v") ;; *) args+=(--arg "$k" "$v") ;; esac
  done
  jq -cn "${args[@]}" '$ARGS.named'
}

# `steward scaffold <dir> org=... team=... owner=... session=... [assets=...] [--json]`
# runs the local scaffold engine (lib/scaffold.sh) — no ssh, no remote estate;
# this is the command that BUILDS an estate, as opposed to the verbs above
# that operate on one already reachable over ssh. --json makes the report
# structured (estate, team, session, assets, loadable) so a future front end
# can consume it instead of scraping stderr prose. A refusal is JSON too, with
# ok=false and a reason — never a bare non-zero the caller has to interpret.
cmd_scaffold() {
  local want_json="" eng_args=() a
  for a in "$@"; do
    case "$a" in --json) want_json=1 ;; *) eng_args+=("$a") ;; esac
  done
  # shellcheck source=lib/scaffold.sh
  . "$HERE/lib/scaffold.sh"
  local err rc
  err="$(estate_scaffold "${eng_args[@]}" 2>&1 >/dev/null)"; rc=$?
  # recover the parsed values for the report by re-reading the same args —
  # the engine does not hand them back, and re-parsing is cheaper than
  # threading a second return channel through it.
  local dir="" org="" team="" owner="" session="" assets=""
  dir="${eng_args[0]:-}"
  for a in "${eng_args[@]:1}"; do case "$a" in
    org=*) org="${a#org=}";; team=*) team="${a#team=}";; owner=*) owner="${a#owner=}";;
    session=*) session="${a#session=}";; assets=*) assets="${a#assets=}";; esac
  done
  if [ -n "$want_json" ]; then
    if [ "$rc" -eq 0 ]; then
      local loadable=false
      ( export STEWARD_ESTATE_ROOT="$dir"; . "$HERE/lib/registry.sh"; registry_estate_name >/dev/null 2>&1 ) \
        && loadable=true
      _json ok true estate "$org" team "$team" owner "$owner" session "$session" \
            assets "$assets" loadable "$loadable"
    else
      _json ok false reason "$err"
    fi
  else
    [ "$rc" -ne 0 ] && printf '%s\n' "$err" >&2
  fi
  return "$rc"
}

# ── `steward registry team|client add` — THE TWO ORG VERBS ────────────────
#
# CREATE-ONLY, DELIBERATELY. Changing a team's membership or a client's
# manager is a different verb (`member add/remove`, a later scope) with a
# different safety story (an existing row, not a fresh one) — folding that
# into `add` would make one verb answer two questions.
#
# Both write entities.d/<slug>.conf through the ONE shared serializer and the
# ONE shared writer transaction in lib/registry.sh (_registry_emit_kv,
# registry_entity_write) — see that file for the injection story and the
# writer's eight-step sequence. Nothing here builds a KV line, a lock, or a
# staged file by hand.

# _reg_fail <want_json> <message> — prints the refusal in the requested
# shape (json {ok:false,reason:...} or a plain stderr line), the same
# json-or-stderr shape cmd_assets already repeats inline at each of its own
# refusals, pulled out once here so the two org verbs share it instead of
# copying it a second time. Does NOT return an exit code — every call site
# still does its own `return N` right after, so the rc lives at the call
# site next to the condition that produced it, not buried in this helper.
_reg_fail() {
  local wj="$1" msg="$2"
  if [ -n "$wj" ]; then jq -cn --arg r "$msg" '{ok:false,reason:$r}'
  else printf '%s\n' "$msg" >&2; fi
}

# _registry_validate_team_stage <staged-file> — the validate_fn
# registry_entity_write calls before publishing a team row. Re-reads the
# STAGED file (not the eventual final name) and confirms NAME and MEMBERS
# equal what cmd_registry_team_add meant to write, byte for byte — a defence
# against a bug in the serializer or the writer producing a row that quotes
# or truncates something differently than intended, never a defence against
# injection (the serializer already closed that before this file was ever
# written to disk). Reads its expectation from _REGW_EXPECT_NAME/_MEMBERS,
# set by the caller immediately before it calls registry_entity_write —
# bash has no closures, so a plain global is how this function learns what
# "correct" means for THIS call.
_registry_validate_team_stage() {
  local file="$1" NAME="" MEMBERS=""
  # shellcheck source=/dev/null
  source "$file" || { echo "registry: staged team file did not source: $file" >&2; return 70; }
  if [ "$NAME" != "$_REGW_EXPECT_NAME" ]; then
    echo "registry: staged team file's NAME does not match what was written: $file" >&2
    return 70
  fi
  if [ "$MEMBERS" != "$_REGW_EXPECT_MEMBERS" ]; then
    echo "registry: staged team file's MEMBERS does not match what was written: $file" >&2
    return 70
  fi
  return 0
}

# _registry_validate_client_stage <staged-file> — same shape as the team
# validator above, for the client row's NAME and MANAGED_BY.
_registry_validate_client_stage() {
  local file="$1" NAME="" MANAGED_BY=""
  # shellcheck source=/dev/null
  source "$file" || { echo "registry: staged client file did not source: $file" >&2; return 70; }
  if [ "$NAME" != "$_REGW_EXPECT_NAME" ]; then
    echo "registry: staged client file's NAME does not match what was written: $file" >&2
    return 70
  fi
  if [ "$MANAGED_BY" != "$_REGW_EXPECT_MANAGED_BY" ]; then
    echo "registry: staged client file's MANAGED_BY does not match what was written: $file" >&2
    return 70
  fi
  return 0
}

# _registry_validate_account_stage <staged-file> — same shape as the team
# and client validators above, for the account row's PRINCIPAL, HOST and
# USERNAME.
_registry_validate_account_stage() {
  local file="$1" PRINCIPAL="" HOST="" USERNAME=""
  # shellcheck source=/dev/null
  source "$file" || { echo "registry: staged account file did not source: $file" >&2; return 70; }
  if [ "$PRINCIPAL" != "$_REGW_EXPECT_PRINCIPAL" ]; then
    echo "registry: staged account file's PRINCIPAL does not match what was written: $file" >&2
    return 70
  fi
  if [ "$HOST" != "$_REGW_EXPECT_HOST" ]; then
    echo "registry: staged account file's HOST does not match what was written: $file" >&2
    return 70
  fi
  if [ "$USERNAME" != "$_REGW_EXPECT_USERNAME" ]; then
    echo "registry: staged account file's USERNAME does not match what was written: $file" >&2
    return 70
  fi
  return 0
}

# _registry_validate_session_stage <staged-file> — same shape as the team,
# client, account and project validators around it, for the session row's
# full field set: the minted ID, the identity pair (ACCOUNT, SLUG), the
# typed-union target, HOST, REPO_PATH, the OWNER bridge and the permission
# mode. Every field is compared — a row where any of them drifted from what
# the verb meant to write must never publish.
_registry_validate_session_stage() {
  local file="$1" ID="" ACCOUNT="" SLUG="" TARGET_ENTITY="" TARGET_PROJECT="" \
        HOST="" REPO_PATH="" OWNER="" PERMISSION_MODE=""
  # shellcheck source=/dev/null
  source "$file" || { echo "registry: staged session file did not source: $file" >&2; return 70; }
  local k v
  for k in ID ACCOUNT SLUG TARGET_ENTITY TARGET_PROJECT HOST REPO_PATH OWNER PERMISSION_MODE; do
    eval "v=\"\$_REGW_EXPECT_$k\""
    if [ "${!k}" != "$v" ]; then
      echo "registry: staged session file's $k does not match what was written: $file" >&2
      return 70
    fi
  done
  # THE (ACCOUNT, SLUG) GATE MUST BE ATOMIC, AND THIS IS WHERE. cmd's pre-check
  # is only advisory: it scans sessions.d BEFORE any lock, so two concurrent
  # adds of the same pair both pass it and both write (each under a DIFFERENT
  # opaque-id filename, so the writer's no-clobber never fires) — the
  # uniqueness the model swears is broken. This validate_fn runs INSIDE
  # registry_row_write's sessions.d lock, before publish, so re-checking here
  # makes scan+write one critical section: a concurrent winner has already
  # published its row by the time the loser reaches this line, and the scan
  # sees it. Exactly one wins; the loser refuses. (The staged file is a
  # .stage.* name, so the *.conf scan never matches the row being written.)
  if ! registry_account_slug_available "$ACCOUNT" "$SLUG"; then
    echo "registry: slug '$SLUG' was taken in account '$ACCOUNT' by a concurrent write — refusing" >&2
    return 70
  fi
  return 0
}

# _registry_validate_project_stage <staged-file> — same shape as the team,
# client and account validators above, for the project row's NAME and
# PARENT.
_registry_validate_project_stage() {
  local file="$1" NAME="" PARENT=""
  # shellcheck source=/dev/null
  source "$file" || { echo "registry: staged project file did not source: $file" >&2; return 70; }
  if [ "$NAME" != "$_REGW_EXPECT_NAME" ]; then
    echo "registry: staged project file's NAME does not match what was written: $file" >&2
    return 70
  fi
  if [ "$PARENT" != "$_REGW_EXPECT_PARENT" ]; then
    echo "registry: staged project file's PARENT does not match what was written: $file" >&2
    return 70
  fi
  return 0
}

# cmd_registry — the `registry` noun's own tiny dispatcher: team|client,
# account, project, session — add. A later scope adds non-`add` verbs;
# this refuses anything else by name rather than falling through to
# the estate-client fallback the top-level dispatcher owns.
cmd_registry() {
  case "${1:-}" in
    team)
      shift
      case "${1:-}" in
        add) shift; cmd_registry_team_add "$@" ;;
        *) fel "steward registry team: unknown verb '${1:-}' (allowed: add)" 64 ;;
      esac ;;
    client)
      shift
      case "${1:-}" in
        add) shift; cmd_registry_client_add "$@" ;;
        *) fel "steward registry client: unknown verb '${1:-}' (allowed: add)" 64 ;;
      esac ;;
    account)
      shift
      case "${1:-}" in
        add) shift; cmd_registry_account_add "$@" ;;
        *) fel "steward registry account: unknown verb '${1:-}' (allowed: add)" 64 ;;
      esac ;;
    project)
      shift
      case "${1:-}" in
        add) shift; cmd_registry_project_add "$@" ;;
        *) fel "steward registry project: unknown verb '${1:-}' (allowed: add)" 64 ;;
      esac ;;
    session)
      shift
      case "${1:-}" in
        add) shift; cmd_registry_session_add "$@" ;;
        *) fel "steward registry session: unknown verb '${1:-}' (allowed: add)" 64 ;;
      esac ;;
    migrate-session) shift; cmd_registry_migrate_session "$@" ;;
    *) fel "steward registry: unknown noun '${1:-}' (allowed: team, client, account, project, session, migrate-session)" 64 ;;
  esac
}

# cmd_registry_team_add <slug> --name "Display Name" [--member p]... [--json]
#
# MEMBERS DEFAULTS TO THE VIEWER, NEVER TO EMPTY. An entity with nobody in it
# is not a team (registry_entity_load's own MANAGED_BY check treats "no
# members" as "not a team" for exactly this reason) — so a team add with no
# --member at all still has to produce a team, and the only name it can use
# without asking is whoever is running the command. --json reports which
# happened (membersSource: default|flags) so a caller never has to guess.
cmd_registry_team_add() {
  local want_json="" slug="" name="" saw_member="" a
  local members=()
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) shift ;;
      --name)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry team add: --name needs a value" 64; return 64; }
        name="$2"; shift 2 ;;
      --member)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry team add: --member needs a value" 64; return 64; }
        members+=("$2"); saw_member=1; shift 2 ;;
      -*)
        _reg_fail "$want_json" "steward registry team add: unknown flag '$1'" 64; return 64 ;;
      *)
        if [ -n "$slug" ]; then
          _reg_fail "$want_json" "steward registry team add: one slug at a time" 64; return 64
        fi
        slug="$1"; shift ;;
    esac
  done

  [ -n "$slug" ] || { _reg_fail "$want_json" "steward registry team add: a slug is required" 64; return 64; }
  if ! [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry team add: invalid slug '$slug' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  [ -n "$name" ] || { _reg_fail "$want_json" "steward registry team add: --name is required" 64; return 64; }

  local members_source="default"
  if [ -z "$saw_member" ]; then
    local viewer="${STEWARD_VIEWER:-}"
    [ -n "$viewer" ] || viewer="$(id -un 2>/dev/null)"
    if [ -z "$viewer" ]; then
      _reg_fail "$want_json" "steward registry team add: no --member given and no viewer could be determined (set STEWARD_VIEWER)" 64
      return 64
    fi
    members=("$viewer")
  else
    members_source="flags"
  fi
  local m
  for m in "${members[@]}"; do
    if ! [[ "$m" =~ ^[a-z][a-z0-9-]*$ ]]; then
      _reg_fail "$want_json" "steward registry team add: invalid member '$m' (allowed: a-z, then a-z0-9-)" 64
      return 64
    fi
  done
  local members_joined=""
  for m in "${members[@]}"; do
    members_joined="${members_joined:+$members_joined }$m"
  done

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  # _registry_emit_kv's own refusal goes to stderr. CAPTURED here (the same
  # way rw_err captures registry_entity_write's below), never left to leak
  # onto whatever real stderr this process has — a --json caller combining
  # stdout+stderr must see exactly one JSON value, never a bare prose line
  # ahead of it.
  local kv_name kv_members rc kv_err
  kv_err="$(mktemp)" || { _reg_fail "$want_json" "steward registry team add: cannot create a temporary file" 70; return 70; }
  kv_name="$(_registry_emit_kv NAME "$name" 2>"$kv_err")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$kv_err"
    _reg_fail "$want_json" "steward registry team add: --name contains a control character or newline" 64
    return 64
  fi
  kv_members="$(_registry_emit_kv MEMBERS "$members_joined" 2>"$kv_err")"; rc=$?
  rm -f "$kv_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry team add: an invalid member slipped past validation" 64
    return 64
  fi

  _REGW_EXPECT_NAME="$name"
  _REGW_EXPECT_MEMBERS="$members_joined"
  local rw_err; rw_err="$(mktemp)" || {
    _reg_fail "$want_json" "steward registry team add: cannot create a temporary file" 70
    return 70
  }
  # HEADER + TRAILING NEWLINE, matching lib/scaffold.sh's shape — the
  # register has one row form, not one shape for scaffold-written rows and
  # another for these. $slug is already validated against the entity-id
  # form above, so interpolating it into a comment carries nothing unsafe.
  local content
  content="$(printf '# %s — team, written by steward registry team add.\n%s\n%s' \
    "$slug" "$kv_name" "$kv_members")"$'\n'
  registry_entity_write "$slug" "$content" _registry_validate_team_stage 2>"$rw_err"
  rc=$?
  local rw_msg; rw_msg="$(cat "$rw_err")"; rm -f "$rw_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry team add: $rw_msg" "$rc"
    return "$rc"
  fi

  local file; file="$(registry_entity_dir)/$slug.conf"
  if [ -n "$want_json" ]; then
    _json ok true kind team slug "$slug" name "$name" file "$file" membersSource "$members_source"
  else
    printf 'steward: wrote entities.d/%s.conf (team '\''%s'\'', members: %s)\n' "$slug" "$name" "$members_joined"
  fi
  return 0
}

# cmd_registry_client_add <slug> --managed-by <team-slug> --name "Display Name" [--json]
#
# THE MANAGER MUST ALREADY RESOLVE AS A TEAM. Not "a file with that name
# exists" — registry_entity_load must succeed AND report at least one
# member. An entity with no members is not a team, and a MANAGED_BY pointing
# at one would read as structure while carrying none — the same distinction
# registry_entity_load itself already draws for MANAGED_BY resolution.
cmd_registry_client_add() {
  local want_json="" slug="" name="" managed_by="" a
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) shift ;;
      --name)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry client add: --name needs a value" 64; return 64; }
        name="$2"; shift 2 ;;
      --managed-by)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry client add: --managed-by needs a value" 64; return 64; }
        managed_by="$2"; shift 2 ;;
      -*)
        _reg_fail "$want_json" "steward registry client add: unknown flag '$1'" 64; return 64 ;;
      *)
        if [ -n "$slug" ]; then
          _reg_fail "$want_json" "steward registry client add: one slug at a time" 64; return 64
        fi
        slug="$1"; shift ;;
    esac
  done

  [ -n "$slug" ] || { _reg_fail "$want_json" "steward registry client add: a slug is required" 64; return 64; }
  if ! [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry client add: invalid slug '$slug' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  [ -n "$name" ] || { _reg_fail "$want_json" "steward registry client add: --name is required" 64; return 64; }
  [ -n "$managed_by" ] || { _reg_fail "$want_json" "steward registry client add: --managed-by is required" 64; return 64; }
  if ! [[ "$managed_by" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry client add: invalid --managed-by slug '$managed_by'" 64
    return 64
  fi

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  # SUBSHELLED, NEVER DIRECT. registry_entity_load SOURCES the manager's
  # conf. Called un-subshelled in this shell, a manager conf that happens to
  # assign a variable sharing a name with one of THIS function's own locals
  # (slug, name — lowercase; not the uppercase ENTITY_* names
  # registry_entity_load itself declares local) would overwrite that local
  # via bash's dynamic scoping — the same never-source-unsubshelled class of
  # danger as the WRITE side below, but arriving through the READ. The
  # command-substitution subshell confines any such clobbering to a process
  # that exits before this function sees another line of its own — the same
  # pattern lib/visibility.sh:108 already uses for exactly this reason.
  local mgr_members load_rc
  mgr_members="$( registry_entity_load "$managed_by" >/dev/null 2>&1 && printf '%s' "$ENTITY_MEMBERS" )"
  load_rc=$?
  if [ "$load_rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry client add: --managed-by '$managed_by' does not resolve to a valid entity" 78
    return 78
  fi
  if [ -z "$mgr_members" ]; then
    _reg_fail "$want_json" "steward registry client add: --managed-by '$managed_by' has no members — it is not a team" 78
    return 78
  fi

  # See the matching comment in cmd_registry_team_add: _registry_emit_kv's
  # own refusal is CAPTURED, never left to leak onto whatever real stderr
  # this process has.
  local kv_name kv_managed rc kv_err
  kv_err="$(mktemp)" || { _reg_fail "$want_json" "steward registry client add: cannot create a temporary file" 70; return 70; }
  kv_name="$(_registry_emit_kv NAME "$name" 2>"$kv_err")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$kv_err"
    _reg_fail "$want_json" "steward registry client add: --name contains a control character or newline" 64
    return 64
  fi
  kv_managed="$(_registry_emit_kv MANAGED_BY "$managed_by" 2>"$kv_err")"; rc=$?
  rm -f "$kv_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry client add: --managed-by contains a control character or newline" 64
    return 64
  fi

  _REGW_EXPECT_NAME="$name"
  _REGW_EXPECT_MANAGED_BY="$managed_by"
  local rw_err; rw_err="$(mktemp)" || {
    _reg_fail "$want_json" "steward registry client add: cannot create a temporary file" 70
    return 70
  }
  # HEADER + TRAILING NEWLINE — see the matching comment in
  # cmd_registry_team_add.
  local content
  content="$(printf '# %s — client, written by steward registry client add.\n%s\n%s' \
    "$slug" "$kv_name" "$kv_managed")"$'\n'
  registry_entity_write "$slug" "$content" _registry_validate_client_stage 2>"$rw_err"
  rc=$?
  local rw_msg; rw_msg="$(cat "$rw_err")"; rm -f "$rw_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry client add: $rw_msg" "$rc"
    return "$rc"
  fi

  local file; file="$(registry_entity_dir)/$slug.conf"
  if [ -n "$want_json" ]; then
    _json ok true kind client slug "$slug" name "$name" file "$file" managedBy "$managed_by"
  else
    printf 'steward: wrote entities.d/%s.conf (client '\''%s'\'', managed by %s)\n' "$slug" "$name" "$managed_by"
  fi
  return 0
}

# cmd_registry_account_add <slug> --principal <p> --host <h> [--username <u>] [--json]
#
# Writes accounts.d/<slug>.conf through the same shared serializer and
# writer transaction as team/client add — registry_account_write is a thin
# wrapper over the ONE writer core (registry_row_write, lib/registry.sh),
# not a second implementation.
#
# THE HOST MUST ALREADY RESOLVE. Not "a file with that name exists" any
# more than client add's --managed-by is — a relation aiming at a host that
# does not resolve reads as structure while carrying none. registry_host_load
# reports that by itself (it fails on a missing/unreadable conf).
cmd_registry_account_add() {
  local want_json="" slug="" principal="" host="" username="" a
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) shift ;;
      --principal)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry account add: --principal needs a value" 64; return 64; }
        principal="$2"; shift 2 ;;
      --host)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry account add: --host needs a value" 64; return 64; }
        host="$2"; shift 2 ;;
      --username)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry account add: --username needs a value" 64; return 64; }
        username="$2"; shift 2 ;;
      -*)
        _reg_fail "$want_json" "steward registry account add: unknown flag '$1'" 64; return 64 ;;
      *)
        if [ -n "$slug" ]; then
          _reg_fail "$want_json" "steward registry account add: one slug at a time" 64; return 64
        fi
        slug="$1"; shift ;;
    esac
  done

  [ -n "$slug" ] || { _reg_fail "$want_json" "steward registry account add: a slug is required" 64; return 64; }
  if ! [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry account add: invalid slug '$slug' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  [ -n "$principal" ] || { _reg_fail "$want_json" "steward registry account add: --principal is required" 64; return 64; }
  if ! [[ "$principal" =~ ^[a-z][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry account add: invalid --principal '$principal' (allowed: a-z, then a-z0-9-)" 64
    return 64
  fi
  [ -n "$host" ] || { _reg_fail "$want_json" "steward registry account add: --host is required" 64; return 64; }
  if ! [[ "$host" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry account add: invalid --host '$host' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  if [ -z "$username" ]; then
    username="$principal"
  elif ! [[ "$username" =~ ^[a-z][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry account add: invalid --username '$username' (allowed: a-z, then a-z0-9-)" 64
    return 64
  fi

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  # SUBSHELLED, NEVER DIRECT — same reasoning as client add's --managed-by
  # lookup above. registry_host_load SOURCES the host's own conf and does
  # NOT declare its own fields `local` (OWNER, LEGAL_OWNER, …); called
  # un-subshelled, a hosts.d row carrying `slug=`/`principal=` (lowercase,
  # matching this function's own locals) would clobber them via bash's
  # dynamic scoping the moment this line ran — the exact class of bug the
  # entity writer's C1 case closed on the write side, arriving here through
  # the READ.
  local hostdir hostconf load_rc
  hostdir="$(registry_host_dir)"
  hostconf="$hostdir/$host.conf"
  ( registry_host_load "$hostconf" >/dev/null 2>&1 )
  load_rc=$?
  if [ "$load_rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry account add: --host '$host' does not resolve to a known host" 78
    return 78
  fi

  # See the matching comment in cmd_registry_team_add: _registry_emit_kv's
  # own refusal is CAPTURED, never left to leak onto whatever real stderr
  # this process has.
  local kv_principal kv_host kv_username rc kv_err
  kv_err="$(mktemp)" || { _reg_fail "$want_json" "steward registry account add: cannot create a temporary file" 70; return 70; }
  kv_principal="$(_registry_emit_kv PRINCIPAL "$principal" 2>"$kv_err")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$kv_err"
    _reg_fail "$want_json" "steward registry account add: --principal contains a control character or newline" 64
    return 64
  fi
  kv_host="$(_registry_emit_kv HOST "$host" 2>"$kv_err")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$kv_err"
    _reg_fail "$want_json" "steward registry account add: --host contains a control character or newline" 64
    return 64
  fi
  kv_username="$(_registry_emit_kv USERNAME "$username" 2>"$kv_err")"; rc=$?
  rm -f "$kv_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry account add: --username contains a control character or newline" 64
    return 64
  fi

  _REGW_EXPECT_PRINCIPAL="$principal"
  _REGW_EXPECT_HOST="$host"
  _REGW_EXPECT_USERNAME="$username"
  local rw_err; rw_err="$(mktemp)" || {
    _reg_fail "$want_json" "steward registry account add: cannot create a temporary file" 70
    return 70
  }
  # HEADER + TRAILING NEWLINE — see the matching comment in
  # cmd_registry_team_add.
  local content
  content="$(printf '# %s — account, written by steward registry account add.\n%s\n%s\n%s' \
    "$slug" "$kv_principal" "$kv_host" "$kv_username")"$'\n'
  registry_account_write "$slug" "$content" _registry_validate_account_stage 2>"$rw_err"
  rc=$?
  local rw_msg; rw_msg="$(cat "$rw_err")"; rm -f "$rw_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry account add: $rw_msg" "$rc"
    return "$rc"
  fi

  local file; file="$(registry_account_dir)/$slug.conf"
  if [ -n "$want_json" ]; then
    _json ok true kind account slug "$slug" principal "$principal" host "$host" username "$username" file "$file"
  else
    printf 'steward: wrote accounts.d/%s.conf (account for %s@%s, username %s)\n' "$slug" "$principal" "$host" "$username"
  fi
  return 0
}

# cmd_registry_project_add <slug> --parent <entity-slug> --name "Display Name" [--json]
#
# Writes projects.d/<slug>.conf through the same shared serializer and
# writer transaction as the other three registry verbs above —
# registry_project_write is a thin wrapper over the ONE writer core
# (registry_row_write, lib/registry.sh), not a second implementation.
#
# THE PARENT MUST ALREADY RESOLVE AS AN ENTITY. Not "a file with that name
# exists" — registry_entity_load must succeed. UNLIKE client add's
# --managed-by, a project's PARENT does NOT have to be a team with
# members: a project can hang directly under a client just as well as
# under a team (registry_project_load itself makes only that one check,
# and this verb makes no stronger one than its own loader will enforce on
# every future read).
#
# THE SLUG IS GLOBALLY UNIQUE IN projects.d TODAY, not parent-scoped. The
# model this register is heading toward (2026-08-30 design spec, the
# section on what it deliberately leaves open) is a slug unique only
# WITHIN its parent — two clients may each want a project called
# "website" — but projects.d today is a
# flat directory keyed on slug alone, the same create-only writer every
# other register here uses. That is a stricter constraint than the model
# calls for, not a looser one, and it relaxes only once a storage layout
# is chosen for the register as a whole (a later, separate step) — it is
# forward-compatible, never a correctness gap in the meantime.
cmd_registry_project_add() {
  local want_json="" slug="" name="" parent="" a
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) shift ;;
      --name)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry project add: --name needs a value" 64; return 64; }
        name="$2"; shift 2 ;;
      --parent)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry project add: --parent needs a value" 64; return 64; }
        parent="$2"; shift 2 ;;
      -*)
        _reg_fail "$want_json" "steward registry project add: unknown flag '$1'" 64; return 64 ;;
      *)
        if [ -n "$slug" ]; then
          _reg_fail "$want_json" "steward registry project add: one slug at a time" 64; return 64
        fi
        slug="$1"; shift ;;
    esac
  done

  [ -n "$slug" ] || { _reg_fail "$want_json" "steward registry project add: a slug is required" 64; return 64; }
  if ! [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry project add: invalid slug '$slug' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  [ -n "$name" ] || { _reg_fail "$want_json" "steward registry project add: --name is required" 64; return 64; }
  [ -n "$parent" ] || { _reg_fail "$want_json" "steward registry project add: --parent is required" 64; return 64; }
  if ! [[ "$parent" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry project add: invalid --parent slug '$parent'" 64
    return 64
  fi

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  # SUBSHELLED, NEVER DIRECT — same reasoning as client add's --managed-by
  # lookup and account add's --host lookup above: registry_entity_load
  # SOURCES the parent's conf, and a parent conf that happens to assign a
  # variable sharing a name with one of THIS function's own locals (slug,
  # name, parent — lowercase; not the uppercase ENTITY_* names
  # registry_entity_load itself declares local) would overwrite that local
  # via bash's dynamic scoping if the load ran un-subshelled. The
  # command-substitution subshell confines any such clobbering to a
  # process that exits before this function sees another line of its own.
  local load_rc
  ( registry_entity_load "$parent" >/dev/null 2>&1 )
  load_rc=$?
  if [ "$load_rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry project add: --parent '$parent' does not resolve to a valid entity" 78
    return 78
  fi

  # See the matching comment in cmd_registry_team_add: _registry_emit_kv's
  # own refusal is CAPTURED, never left to leak onto whatever real stderr
  # this process has.
  local kv_name kv_parent rc kv_err
  kv_err="$(mktemp)" || { _reg_fail "$want_json" "steward registry project add: cannot create a temporary file" 70; return 70; }
  kv_name="$(_registry_emit_kv NAME "$name" 2>"$kv_err")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$kv_err"
    _reg_fail "$want_json" "steward registry project add: --name contains a control character or newline" 64
    return 64
  fi
  kv_parent="$(_registry_emit_kv PARENT "$parent" 2>"$kv_err")"; rc=$?
  rm -f "$kv_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry project add: --parent contains a control character or newline" 64
    return 64
  fi

  _REGW_EXPECT_NAME="$name"
  _REGW_EXPECT_PARENT="$parent"
  local rw_err; rw_err="$(mktemp)" || {
    _reg_fail "$want_json" "steward registry project add: cannot create a temporary file" 70
    return 70
  }
  # HEADER + TRAILING NEWLINE — see the matching comment in
  # cmd_registry_team_add.
  local content
  content="$(printf '# %s — project, written by steward registry project add.\n%s\n%s' \
    "$slug" "$kv_name" "$kv_parent")"$'\n'
  registry_project_write "$slug" "$content" _registry_validate_project_stage 2>"$rw_err"
  rc=$?
  local rw_msg; rw_msg="$(cat "$rw_err")"; rm -f "$rw_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry project add: $rw_msg" "$rc"
    return "$rc"
  fi

  local file; file="$(registry_project_dir)/$slug.conf"
  if [ -n "$want_json" ]; then
    _json ok true kind project slug "$slug" name "$name" parent "$parent" file "$file"
  else
    printf 'steward: wrote projects.d/%s.conf (project '\''%s'\'', parent %s)\n' "$slug" "$name" "$parent"
  fi
  return 0
}

# cmd_registry_session_add --account <slug> ( --project <slug> | --entity
# <slug> ) --slug <per-account-slug> --repo /abs/path [--host <host>] [--json]
#
# THE CAPSTONE OF THE IDENTITY MODEL: the one verb where account, target,
# derived display and the composite (ACCOUNT, SLUG) uniqueness all meet.
# Writes sessions.d/<minted-id>.conf through the SAME serializer and writer
# transaction as the four org verbs above — registry_session_write is a thin
# wrapper over registry_row_write, and the readback is registry_load itself,
# so a row this verb publishes is by construction a row every reader loads.
#
# WHAT THE ROW STORES, AND WHAT IT DOES NOT. It stores REFERENCES — the
# account, the per-account slug, exactly one target — plus HOST, REPO_PATH,
# OWNER and the permission mode. It stores NO RC_LABEL (the display DERIVES
# from the target at read time; a stored label would be a second truth that
# rots). It DOES store DOMAIN, derived to the target slug: the Linux
# supervisor sources the conf raw and refuses a session with no DOMAIN, so the
# line must be on disk (registry_load would derive the same value, but the
# supervisor never sees that). `migrate-session` writes the identical value.
#
# THE OWNER BRIDGE. visibility.sh and the cockpit's enter gate key on OWNER,
# so a new-shape row MUST carry OWNER = its account's PRINCIPAL to stay
# visible and enterable exactly like an old-shape one. The principal is
# snapshotted out of the subshelled account load — never trusted from a
# flag, never re-read after other loads have run.
#
# EVERY RESOLVING LOAD IS SUBSHELLED — the same lesson every org verb above
# carries: registry_account_load, registry_project_load and
# registry_entity_load all SOURCE an untrusted conf, and a hostile row
# assigning this function's own lowercase locals (slug, repo, account, id…)
# would clobber them via bash's dynamic scoping the moment it sourced.
cmd_registry_session_add() {
  local want_json="" account="" project="" entity="" slug="" repo="" host="" a
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) shift ;;
      --account)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry session add: --account needs a value" 64; return 64; }
        account="$2"; shift 2 ;;
      --project)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry session add: --project needs a value" 64; return 64; }
        project="$2"; shift 2 ;;
      --entity)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry session add: --entity needs a value" 64; return 64; }
        entity="$2"; shift 2 ;;
      --slug)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry session add: --slug needs a value" 64; return 64; }
        slug="$2"; shift 2 ;;
      --repo)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry session add: --repo needs a value" 64; return 64; }
        repo="$2"; shift 2 ;;
      --host)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry session add: --host needs a value" 64; return 64; }
        host="$2"; shift 2 ;;
      -*)
        _reg_fail "$want_json" "steward registry session add: unknown flag '$1'" 64; return 64 ;;
      *)
        # No positional operand exists on this verb: the row's name is the
        # MINTED id, never something the operator hands in.
        _reg_fail "$want_json" "steward registry session add: unexpected argument '$1' (the id is minted, never given)" 64
        return 64 ;;
    esac
  done

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  # 1. THE ACCOUNT — required, must RESOLVE, and its PRINCIPAL is the OWNER.
  [ -n "$account" ] || { _reg_fail "$want_json" "steward registry session add: --account is required" 64; return 64; }
  if ! [[ "$account" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry session add: invalid --account '$account' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  # SUBSHELLED, and the principal SNAPSHOTTED out through the substitution —
  # the load's own stdout (including anything a hostile conf prints) goes to
  # /dev/null; only the loader's validated ACCOUNT_PRINCIPAL crosses back.
  local principal
  principal="$( registry_account_load "$account" >/dev/null 2>&1 && printf '%s' "$ACCOUNT_PRINCIPAL" )"
  if [ -z "$principal" ]; then
    _reg_fail "$want_json" "steward registry session add: --account '$account' does not resolve to a known account" 78
    return 78
  fi
  # Belt on the snapshot: the loader validated this form already, but the
  # value crossed a process boundary and becomes the row's OWNER — re-check.
  if ! [[ "$principal" =~ ^[a-z][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry session add: account '$account' carries an invalid principal" 70
    return 70
  fi

  # 2. THE TARGET — a TYPED UNION: exactly one of --project/--entity. Both is
  # two contradictory claims about the same session; neither is no claim.
  if [ -n "$project" ] && [ -n "$entity" ]; then
    _reg_fail "$want_json" "steward registry session add: --project and --entity are a typed union — give exactly one" 64
    return 64
  fi
  if [ -z "$project" ] && [ -z "$entity" ]; then
    _reg_fail "$want_json" "steward registry session add: a target is required — --project <slug> or --entity <slug>" 64
    return 64
  fi
  local tkind tslug
  if [ -n "$project" ]; then tkind="project"; tslug="$project"; else tkind="entity"; tslug="$entity"; fi
  if ! [[ "$tslug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry session add: invalid --$tkind '$tslug' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  # SUBSHELLED resolve — the display will be DERIVED from this reference on
  # every read, so a target that does not resolve today would mint a row
  # whose display refuses tomorrow.
  local load_rc
  if [ "$tkind" = "project" ]; then
    ( registry_project_load "$tslug" >/dev/null 2>&1 ); load_rc=$?
  else
    ( registry_entity_load "$tslug" >/dev/null 2>&1 ); load_rc=$?
  fi
  if [ "$load_rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry session add: --$tkind '$tslug' does not resolve to a valid $tkind" 78
    return 78
  fi

  # 3. THE SLUG, and THE COMPOSITE GATE — (ACCOUNT, SLUG) is unique. The
  # helper was built and tested ahead of this verb (lib/registry.sh); this
  # is the step that finally wires it in.
  [ -n "$slug" ] || { _reg_fail "$want_json" "steward registry session add: --slug is required" 64; return 64; }
  if ! [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry session add: invalid --slug '$slug' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  if ! registry_account_slug_available "$account" "$slug"; then
    _reg_fail "$want_json" "steward registry session add: slug '$slug' is already taken in account '$account'" 65
    return 65
  fi

  # 4. THE REPO — an absolute path, no dot-dot, no control bytes. The value
  # is stored verbatim (escaped by the serializer), never interpreted here.
  [ -n "$repo" ] || { _reg_fail "$want_json" "steward registry session add: --repo is required" 64; return 64; }
  case "$repo" in
    *[[:cntrl:]]*)
      _reg_fail "$want_json" "steward registry session add: --repo contains a control character or newline" 64
      return 64 ;;
    *..*)
      _reg_fail "$want_json" "steward registry session add: --repo must not contain '..'" 64
      return 64 ;;
    /*) ;;
    *)
      _reg_fail "$want_json" "steward registry session add: --repo must be an absolute path" 64
      return 64 ;;
  esac

  # 5. THE HOST — default is the estate's hub; an explicit one is checked
  # for form (the same shape registry_load enforces on every read).
  if [ -z "$host" ]; then
    host="$(registry_hub_host)" || {
      _reg_fail "$want_json" "steward registry session add: the estate declares no usable HUB_HOST to default --host from" 78
      return 78
    }
  fi
  if ! [[ "$host" =~ ^[a-z][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry session add: invalid --host '$host' (allowed: a-z, then a-z0-9-)" 64
    return 64
  fi

  # 6. MINT THE ID — opaque, immutable, and NEVER derived from account or
  # slug (the design's one-way door: an id that encoded either would change
  # identity on an account move). Sixteen hex digits from urandom behind the
  # fixed "s-" mark. The shared writer below is create-only and refuses an
  # existing file anyway; the remint loop here is the belt on top — a
  # colliding mint retries instead of surfacing as a writer refusal, and a
  # machine whose entropy source cannot produce a fresh id in a handful of
  # tries refuses loudly rather than looping forever.
  #
  # FLAT STORAGE, CHOSEN EXPLICITLY: the minted id is the FILENAME, and the
  # account-scoped slug lives as a FIELD — see registry_session_write
  # (lib/registry.sh) for the full note.
  local dir id="" candidate tries=0
  dir="$(registry_dir)"
  while [ "$tries" -lt 5 ]; do
    candidate="s-$(head -c 8 /dev/urandom 2>/dev/null | od -An -tx1 | tr -d ' \n')"
    if [[ "$candidate" =~ ^s-[0-9a-f]{16}$ ]] && [ ! -e "$dir/$candidate.conf" ]; then
      id="$candidate"; break
    fi
    tries=$((tries+1))
  done
  if [ -z "$id" ]; then
    _reg_fail "$want_json" "steward registry session add: could not mint a unique id" 70
    return 70
  fi

  # 7. SERIALIZE — every value through _registry_emit_kv, its refusal
  # captured, never leaked to real stderr. Only --repo can still carry a
  # byte the serializer refuses (everything else is shape-locked above);
  # any other refusal here is a bug, reported as one (rc 70).
  local kv_id kv_account kv_slug kv_target kv_domain kv_host kv_repo kv_owner kv_pm rc kv_err
  kv_err="$(mktemp)" || { _reg_fail "$want_json" "steward registry session add: cannot create a temporary file" 70; return 70; }
  kv_repo="$(_registry_emit_kv REPO_PATH "$repo" 2>"$kv_err")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$kv_err"
    _reg_fail "$want_json" "steward registry session add: --repo contains a control character or newline" 64
    return 64
  fi
  kv_id="$(_registry_emit_kv ID "$id" 2>"$kv_err")"; rc=$?
  [ "$rc" -eq 0 ] && { kv_account="$(_registry_emit_kv ACCOUNT "$account" 2>"$kv_err")"; rc=$?; }
  [ "$rc" -eq 0 ] && { kv_slug="$(_registry_emit_kv SLUG "$slug" 2>"$kv_err")"; rc=$?; }
  if [ "$rc" -eq 0 ]; then
    if [ "$tkind" = "project" ]; then
      kv_target="$(_registry_emit_kv TARGET_PROJECT "$tslug" 2>"$kv_err")"; rc=$?
    else
      kv_target="$(_registry_emit_kv TARGET_ENTITY "$tslug" 2>"$kv_err")"; rc=$?
    fi
  fi
  # DOMAIN DERIVES TO THE TARGET SLUG. The display derives from the target, but
  # DOMAIN is NOT dropped: the Linux supervisor sources the conf raw and refuses
  # a session with no DOMAIN (it builds the per-domain credential directory from
  # it). `migrate-session` writes the same derived value, so the two verbs agree.
  [ "$rc" -eq 0 ] && { kv_domain="$(_registry_emit_kv DOMAIN "$tslug" 2>"$kv_err")"; rc=$?; }
  [ "$rc" -eq 0 ] && { kv_host="$(_registry_emit_kv HOST "$host" 2>"$kv_err")"; rc=$?; }
  [ "$rc" -eq 0 ] && { kv_owner="$(_registry_emit_kv OWNER "$principal" 2>"$kv_err")"; rc=$?; }
  [ "$rc" -eq 0 ] && { kv_pm="$(_registry_emit_kv PERMISSION_MODE "bypassPermissions" 2>"$kv_err")"; rc=$?; }
  rm -f "$kv_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry session add: could not serialize the row" 70
    return 70
  fi

  _REGW_EXPECT_ID="$id"
  _REGW_EXPECT_ACCOUNT="$account"
  _REGW_EXPECT_SLUG="$slug"
  if [ "$tkind" = "project" ]; then
    _REGW_EXPECT_TARGET_PROJECT="$tslug"; _REGW_EXPECT_TARGET_ENTITY=""
  else
    _REGW_EXPECT_TARGET_ENTITY="$tslug"; _REGW_EXPECT_TARGET_PROJECT=""
  fi
  _REGW_EXPECT_HOST="$host"
  _REGW_EXPECT_REPO_PATH="$repo"
  _REGW_EXPECT_OWNER="$principal"
  _REGW_EXPECT_PERMISSION_MODE="bypassPermissions"
  local rw_err; rw_err="$(mktemp)" || {
    _reg_fail "$want_json" "steward registry session add: cannot create a temporary file" 70
    return 70
  }
  # HEADER + TRAILING NEWLINE — see the matching comment in
  # cmd_registry_team_add. No RC_LABEL line — deliberate (the display derives).
  # DOMAIN IS written, derived to the target slug — see the emit above.
  local content
  content="$(printf '# %s — session, written by steward registry session add.\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s' \
    "$id" "$kv_id" "$kv_account" "$kv_slug" "$kv_target" "$kv_domain" "$kv_host" "$kv_repo" "$kv_owner" "$kv_pm")"$'\n'
  registry_session_write "$id" "$content" _registry_validate_session_stage 2>"$rw_err"
  rc=$?
  local rw_msg; rw_msg="$(cat "$rw_err")"; rm -f "$rw_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry session add: $rw_msg" "$rc"
    return "$rc"
  fi

  local file="$dir/$id.conf"
  if [ -n "$want_json" ]; then
    jq -cn --arg id "$id" --arg account "$account" --arg slug "$slug" \
      --arg tkind "$tkind" --arg tslug "$tslug" --arg host "$host" \
      --arg owner "$principal" --arg repo "$repo" --arg file "$file" \
      '{ok:true,kind:"session",id:$id,account:$account,slug:$slug,target:{kind:$tkind,slug:$tslug},host:$host,owner:$owner,repo:$repo,file:$file}'
  else
    printf 'steward: wrote %s.conf into the session register (slug %s in account %s, on %s %s, host %s)\n' \
      "$id" "$slug" "$account" "$tkind" "$tslug" "$host"
  fi
  return 0
}

# _migrate_snap <conf> <FIELD> — prints the value FIELD holds after sourcing
# <conf>, IN A SUBSHELL. The subshelled source is the whole safety story: a
# hostile conf is sourced in a child process, so nothing it assigns reaches
# this verb's own locals (bash's dynamic scoping cannot cross the fork), and
# any command substitution it carries executes and dies there. Only the ONE
# named field crosses back, through `${!name}` indirection. Reset to empty
# before the source so a field the conf omits reads as empty, never as a
# value the parent environment happened to hold.
#
# BASH 3.2: no arrays of the modern kind, no mapfile — so each field is
# snapshotted with its own call rather than a NUL-delimited bulk read. A
# session conf is a handful of fields and this is a rare admin operation;
# the cost is a few extra subshelled sources, and the payoff is the exact
# containment the account-slug scanner already relies on.
_migrate_snap() {
  local __conf="$1" __name="$2"
  ( eval "$__name=''"; unset "$__name" 2>/dev/null; eval "$__name=''"
    # shellcheck source=/dev/null
    source "$__conf" 2>/dev/null; printf '%s' "${!__name}" )
}

# cmd_registry_migrate_session <old-slug> --account <slug> ( --project <slug>
# | --entity <slug> ) --slug <per-account-slug> [--json]
#
# THE NAMING-MODEL CUTOVER'S ONE-WAY CONVERTER. An OLD-SHAPE session conf
# (legacy DOMAIN/OWNER/RC_LABEL, no identity fields) becomes a NEW-SHAPE
# identity row IN PLACE, then the old row is unlinked — but ONLY after the
# new one reads back green through registry_load. Anything that fails before
# that leaves the old conf exactly as it was: the migration is abortable
# with no loss.
#
# WHAT IT CARRIES, AND WHAT IT CHANGES. Every OPERATIONAL field on the old
# row is carried forward UNCHANGED — RUNTIME, MODEL, OPENCODE_*, AUTO_APPROVE,
# CLAUDE_MEMORY_ROOT, ASSETS, REPO_PATH, HOST, the browser rig, the env and
# permission fields, the lifecycle. Dropping any one of them would break a
# working session, so the carry set is registry_load's OWN field-reset list,
# minus the fields this verb replaces. It ADDS the identity fields (a minted
# opaque ID, ACCOUNT, SLUG, exactly one TARGET_*) and rewrites OWNER to the
# account's PRINCIPAL — the visibility/enter bridge, which keys on OWNER. It
# REMOVES the legacy RC_LABEL: the display now DERIVES from the target, and a
# stale RC_LABEL would override that derivation. It DERIVES DOMAIN to the
# target slug and writes it as a literal line — the Linux supervisor sources
# the conf raw and refuses a session with no DOMAIN, so `session add`'s derived
# DOMAIN and this verb's must agree.
#
# EVERY RESOLVING LOAD IS SUBSHELLED — the same lesson `session add` carries:
# registry_account_load, registry_project_load, registry_entity_load and the
# old-conf snapshot all SOURCE an untrusted conf, and a hostile row assigning
# this function's own lowercase locals would clobber them the moment it
# sourced. The writer transaction and the atomic (ACCOUNT, SLUG) gate are the
# SAME registry_session_write / _registry_validate_session_stage that
# `session add` publishes through — a row this verb writes is by construction
# a row every reader loads.
cmd_registry_migrate_session() {
  local want_json="" old="" account="" project="" entity="" slug="" a
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) shift ;;
      --account)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry migrate-session: --account needs a value" 64; return 64; }
        account="$2"; shift 2 ;;
      --project)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry migrate-session: --project needs a value" 64; return 64; }
        project="$2"; shift 2 ;;
      --entity)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry migrate-session: --entity needs a value" 64; return 64; }
        entity="$2"; shift 2 ;;
      --slug)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry migrate-session: --slug needs a value" 64; return 64; }
        slug="$2"; shift 2 ;;
      -*)
        _reg_fail "$want_json" "steward registry migrate-session: unknown flag '$1'" 64; return 64 ;;
      *)
        # The one positional operand is the OLD slug — the row to convert.
        if [ -n "$old" ]; then
          _reg_fail "$want_json" "steward registry migrate-session: unexpected argument '$1' (the new id is minted, never given)" 64
          return 64
        fi
        old="$1"; shift ;;
    esac
  done

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  # 0. THE OLD SLUG — required, form-checked before any path is built from it.
  [ -n "$old" ] || { _reg_fail "$want_json" "steward registry migrate-session: an old session slug is required" 64; return 64; }
  if ! [[ "$old" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry migrate-session: invalid old slug '$old' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  local dir; dir="$(registry_dir)"
  local old_conf="$dir/$old.conf"
  # 1. THE OLD ROW MUST EXIST. rc 78 — a missing subject is an environment
  # fault (the wrong slug, the wrong estate), not a usage error.
  if [ ! -f "$old_conf" ]; then
    _reg_fail "$want_json" "steward registry migrate-session: no such session '$old' (no $old_conf)" 78
    return 78
  fi
  # 1b. IT MUST BE OLD-SHAPE. A row that already carries ACCOUNT= or an opaque
  # ID=s-… has been migrated; converting it again would mint a SECOND identity
  # for one session. Refuse rc 65, and touch nothing. Detected by LINE
  # presence, the same way registry_load detects a present-but-empty label.
  if grep -qE '^ACCOUNT=' "$old_conf" || grep -qE '^ID="?s-[0-9a-f]' "$old_conf"; then
    _reg_fail "$want_json" "steward registry migrate-session: '$old' is already new-shape (carries ACCOUNT/opaque ID) — refusing to double-migrate" 65
    return 65
  fi

  # 1c. SNAPSHOT the old row's fields, each through a subshelled source. REPO
  # is required (registry_load refuses a row without it); everything else is
  # carried only when present.
  local old_repo old_host
  old_repo="$(_migrate_snap "$old_conf" REPO_PATH)"
  old_host="$(_migrate_snap "$old_conf" HOST)"
  if [ -z "$old_repo" ]; then
    _reg_fail "$want_json" "steward registry migrate-session: '$old' carries no REPO_PATH — not a migratable session" 65
    return 65
  fi

  # 2. THE ACCOUNT — required, must RESOLVE, and its PRINCIPAL becomes OWNER.
  # SUBSHELLED, principal SNAPSHOTTED out through the substitution.
  [ -n "$account" ] || { _reg_fail "$want_json" "steward registry migrate-session: --account is required" 64; return 64; }
  if ! [[ "$account" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry migrate-session: invalid --account '$account' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  local principal
  principal="$( registry_account_load "$account" >/dev/null 2>&1 && printf '%s' "$ACCOUNT_PRINCIPAL" )"
  if [ -z "$principal" ]; then
    _reg_fail "$want_json" "steward registry migrate-session: --account '$account' does not resolve to a known account" 78
    return 78
  fi
  if ! [[ "$principal" =~ ^[a-z][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry migrate-session: account '$account' carries an invalid principal" 70
    return 70
  fi

  # 3. THE TARGET — a TYPED UNION: exactly one of --project/--entity, and it
  # must resolve (the display is DERIVED from it on every read).
  if [ -n "$project" ] && [ -n "$entity" ]; then
    _reg_fail "$want_json" "steward registry migrate-session: --project and --entity are a typed union — give exactly one" 64
    return 64
  fi
  if [ -z "$project" ] && [ -z "$entity" ]; then
    _reg_fail "$want_json" "steward registry migrate-session: a target is required — --project <slug> or --entity <slug>" 64
    return 64
  fi
  local tkind tslug
  if [ -n "$project" ]; then tkind="project"; tslug="$project"; else tkind="entity"; tslug="$entity"; fi
  if ! [[ "$tslug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry migrate-session: invalid --$tkind '$tslug' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  local load_rc
  if [ "$tkind" = "project" ]; then
    ( registry_project_load "$tslug" >/dev/null 2>&1 ); load_rc=$?
  else
    ( registry_entity_load "$tslug" >/dev/null 2>&1 ); load_rc=$?
  fi
  if [ "$load_rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry migrate-session: --$tkind '$tslug' does not resolve to a valid $tkind" 78
    return 78
  fi

  # 4. THE SLUG, and THE COMPOSITE GATE — (ACCOUNT, SLUG) is unique. The old
  # row carries no ACCOUNT/SLUG, so it never collides with itself here.
  [ -n "$slug" ] || { _reg_fail "$want_json" "steward registry migrate-session: --slug is required" 64; return 64; }
  if ! [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry migrate-session: invalid --slug '$slug' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  if ! registry_account_slug_available "$account" "$slug"; then
    _reg_fail "$want_json" "steward registry migrate-session: slug '$slug' is already taken in account '$account'" 65
    return 65
  fi

  # 5. THE HOST — carried from the old row when present, else the estate hub
  # (registry_load's own default), and form-checked either way.
  local host="$old_host"
  if [ -z "$host" ]; then
    host="$(registry_hub_host)" || {
      _reg_fail "$want_json" "steward registry migrate-session: the estate declares no usable HUB_HOST to default HOST from" 78
      return 78
    }
  fi
  if ! [[ "$host" =~ ^[a-z][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry migrate-session: '$old' carries an invalid HOST '$host'" 65
    return 65
  fi

  # 6. MINT THE ID — opaque, immutable, NEVER derived from account or slug.
  # Sixteen hex digits from urandom behind the fixed "s-" mark; the shared
  # writer is create-only, and this remint loop is the belt on top.
  local id="" candidate tries=0
  while [ "$tries" -lt 5 ]; do
    candidate="s-$(head -c 8 /dev/urandom 2>/dev/null | od -An -tx1 | tr -d ' \n')"
    if [[ "$candidate" =~ ^s-[0-9a-f]{16}$ ]] && [ ! -e "$dir/$candidate.conf" ]; then
      id="$candidate"; break
    fi
    tries=$((tries+1))
  done
  if [ -z "$id" ]; then
    _reg_fail "$want_json" "steward registry migrate-session: could not mint a unique id" 70
    return 70
  fi

  # 7. SERIALIZE — every value through _registry_emit_kv (escaping); its
  # refusal is captured to a temp file, never leaked to real stderr. The
  # carry set is registry_load's field-reset list MINUS what this verb
  # replaces: OWNER (rewritten to the principal), RC_LABEL (removed), DOMAIN
  # (derived to the target slug), and the identity fields (added below).
  # REPO_PATH and HOST are always emitted; the rest only when the old row
  # carried them.
  local kv_err; kv_err="$(mktemp)" || { _reg_fail "$want_json" "steward registry migrate-session: cannot create a temporary file" 70; return 70; }
  local body="" _mig_rc=0
  # _mig_add KEY VALUE [required] — appends one escaped kv line to $body,
  # skipping an empty optional value. On a serializer refusal it records the
  # rc and every later call short-circuits.
  _mig_add() {
    local key="$1" val="$2" required="${3:-}" line
    [ "$_mig_rc" -eq 0 ] || return
    if [ -z "$val" ] && [ -z "$required" ]; then return; fi
    line="$(_registry_emit_kv "$key" "$val" 2>>"$kv_err")" || { _mig_rc=$?; return; }
    body="$body$line
"
  }
  # Identity first, then the OWNER bridge, then every carried operational
  # field. Order is immaterial to sourcing; this order reads top-down as
  # "who it is, then what it runs".
  _mig_add ID "$id" required
  _mig_add ACCOUNT "$account" required
  _mig_add SLUG "$slug" required
  if [ "$tkind" = "project" ]; then _mig_add TARGET_PROJECT "$tslug" required
  else _mig_add TARGET_ENTITY "$tslug" required; fi
  # DOMAIN IS CARRIED, NOT DERIVED — credential continuity across the cut.
  # The Linux supervisor SOURCES the conf raw (not through registry_load),
  # refuses a session with no DOMAIN, and builds the per-domain credential
  # directory from it with NO inheritance chain. Deriving the LEAF target
  # slug here (the first shape of this fix) silently moved that directory
  # for every session migrated to a sub-project: the migrated session
  # started against an EMPTY credential dir, the tools read "not logged
  # in", and the estate's own findings record that symptom minting second
  # identities against customer tenants. The same drift narrowed the bus
  # same-DOMAIN gate between sessions that share an entity. So the OLD
  # conf's DOMAIN survives the migration verbatim; only a conf with no
  # DOMAIN at all falls back to the target slug, so the supervisor's
  # DOMAIN-required start never refuses. `session add` still derives the
  # target slug — a FRESH session has no credential history to preserve.
  local old_domain; old_domain="$(_migrate_snap "$old_conf" DOMAIN)"
  _mig_add DOMAIN "${old_domain:-$tslug}" required
  _mig_add OWNER "$principal" required
  _mig_add REPO_PATH "$old_repo" required
  _mig_add HOST "$host" required
  # THE CARRIED OPERATIONAL FIELDS — every one registry_load resets and reads,
  # save those replaced above. Snapshotted from the old conf, emitted only
  # when present.
  local _cf
  for _cf in PERMISSION_MODE ENV_REFRESH OP_RUN ENV_FILE ENV_SOURCE OP_TOKEN_FILE \
             KIND LIFECYCLE ASSETS VISIBILITY VISIBLE_TO \
             BROWSER_RIG BROWSER_DISPLAY BROWSER_CDP BROWSER_VNC BROWSER_PROFILE \
             RUNTIME MODEL OPENCODE_VERSION OPENCODE_PORT AUTO_APPROVE CLAUDE_MEMORY_ROOT; do
    _mig_add "$_cf" "$(_migrate_snap "$old_conf" "$_cf")"
  done
  local carried_pm; carried_pm="$(_migrate_snap "$old_conf" PERMISSION_MODE)"
  rm -f "$kv_err"
  if [ "$_mig_rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry migrate-session: could not serialize the row (a field carries a control character or newline)" 70
    return 70
  fi

  # 8. WRITE through the shared hardened writer; the validate_fn runs the
  # atomic (ACCOUNT, SLUG) gate inside the sessions.d lock. Same expectations
  # `session add` sets, so the SAME validator applies.
  _REGW_EXPECT_ID="$id"
  _REGW_EXPECT_ACCOUNT="$account"
  _REGW_EXPECT_SLUG="$slug"
  if [ "$tkind" = "project" ]; then
    _REGW_EXPECT_TARGET_PROJECT="$tslug"; _REGW_EXPECT_TARGET_ENTITY=""
  else
    _REGW_EXPECT_TARGET_ENTITY="$tslug"; _REGW_EXPECT_TARGET_PROJECT=""
  fi
  _REGW_EXPECT_HOST="$host"
  _REGW_EXPECT_REPO_PATH="$old_repo"
  _REGW_EXPECT_OWNER="$principal"
  _REGW_EXPECT_PERMISSION_MODE="$carried_pm"
  # A LITERAL newline joins the header to the body — a command substitution
  # would strip it and glue the first field onto the comment line, hiding it
  # from every reader that sources the row.
  local content
  content="# $id — session, migrated from $old by steward registry migrate-session.
$body"
  local rw_err; rw_err="$(mktemp)" || {
    _reg_fail "$want_json" "steward registry migrate-session: cannot create a temporary file" 70
    return 70
  }
  registry_session_write "$id" "$content" _registry_validate_session_stage 2>"$rw_err"
  local rc=$?
  local rw_msg; rw_msg="$(cat "$rw_err")"; rm -f "$rw_err"
  if [ "$rc" -ne 0 ]; then
    # THE OLD ROW IS UNTOUCHED — nothing has removed it, so the migration is
    # abortable with no loss. Report and stop.
    _reg_fail "$want_json" "steward registry migrate-session: $rw_msg" "$rc"
    return "$rc"
  fi

  # 9. ONLY NOW, after the new row reads back green, remove the old one.
  rm -f "$old_conf"

  local file="$dir/$id.conf"
  local display; display="$(registry_session_display "$id" 2>/dev/null)"
  if [ -n "$want_json" ]; then
    jq -cn --arg from "$old" --arg id "$id" --arg account "$account" --arg slug "$slug" \
      --arg tkind "$tkind" --arg tslug "$tslug" --arg display "$display" --arg file "$file" \
      '{ok:true,kind:"migrate-session",from:$from,id:$id,account:$account,slug:$slug,target:{kind:$tkind,slug:$tslug},display:$display,file:$file}'
  else
    printf 'migrated %s -> %s (display: %s)\n' "$old" "$id" "$display"
  fi
  return 0
}

# cmd_assets <session> [--json] — the declared list joined with probed health.
# Presentation-free: json or one line per asset, never ANSI.
cmd_assets() {
  local want_json="" session="" a err_msg

  # Detect --json anywhere in argv before validating other arguments
  for a in "$@"; do
    [ "$a" = "--json" ] && want_json=1
  done

  # Parse and validate arguments
  for a in "$@"; do
    case "$a" in
      --json) ;; # Already detected above
      -*)
        err_msg="steward: unknown flag '$a'"
        if [ -n "$want_json" ]; then
          jq -cn --arg reason "$err_msg" '{ok:false, reason:$reason}'
        else
          printf '%s\n' "$err_msg" >&2
        fi
        return 64
        ;;
      *)
        [ -n "$session" ] && {
          err_msg="steward: one session at a time"
          if [ -n "$want_json" ]; then
            jq -cn --arg reason "$err_msg" '{ok:false, reason:$reason}'
          else
            printf '%s\n' "$err_msg" >&2
          fi
          return 64
        }
        session="$a"
        ;;
    esac
  done

  [ -n "$session" ] || {
    err_msg="steward: assets requires a session name"
    if [ -n "$want_json" ]; then
      jq -cn --arg reason "$err_msg" '{ok:false, reason:$reason}'
    else
      printf '%s\n' "$err_msg" >&2
    fi
    return 64
  }
  # shellcheck source=lib/assets.sh
  . "$HERE/lib/assets.sh"
  # PRODUCTION WIRING. asset_probe reads STEWARD_ASSET_PROBE_CMD and reports
  # `unknown no-probe-command` when it is unset — correct as a contract, useless
  # as a product. Aim it at the dispatcher unless a caller (or the suite) has
  # already chosen one; an explicit setting always wins.
  : "${STEWARD_ASSET_PROBE_CMD:=$HERE/bin/probe-dispatch}"
  export STEWARD_ASSET_PROBE_CMD
  # AND A DEADLINE WITH ROOM FOR A REAL ROUND TRIP. The library's own default
  # (5s) is sized for a prober that hangs, not for one that talks to another
  # machine: a measured run of the real ssh path took ~1.75s per session, so a
  # loaded host tips a WORKING probe into `unknown probe-timeout` — the same
  # non-measurement-dressed-as-measurement this model exists to prevent, only
  # with the honest word on it.
  #
  # Raised here rather than in lib/assets.sh because this is the command that
  # wires the ssh-based dispatcher in; a caller embedding asset_probe with its
  # own fast prober should keep the tighter default. The ordering that must
  # hold, smallest first: the prober's own connect bound (3s, probes/chromium-rig)
  # < the library backstop (5s) <= this.
  : "${STEWARD_ASSET_PROBE_TIMEOUT:=10}"
  export STEWARD_ASSET_PROBE_TIMEOUT
  # THE PROBER NEEDS TO KNOW WHOSE ASSET IT IS MEASURING. asset_probe's signature
  # carries the asset, not the session, and a rig prober cannot measure a rig
  # without knowing which session declares it. The name rides in the environment
  # rather than in the asset string so the registry stays a derivation
  # (BROWSER_RIG implies chromium-rig) instead of a transcription.
  export STEWARD_PROBE_SESSION="$session"
  local list rc
  list="$(session_assets "$session" 2>&1)"; rc=$?
  if [ "$rc" -ne 0 ]; then
    if [ -n "$want_json" ]; then jq -cn --arg reason "$list" '{ok:false, reason:$reason}'
    else printf '%s\n' "$list" >&2; fi
    return "$rc"
  fi
  local lines="" one
  while IFS= read -r one || [ -n "$one" ]; do
    [ -n "$one" ] || continue
    lines="$lines$(asset_probe "$one")
"
  done <<EOF
$list
EOF
  if [ -n "$want_json" ]; then
    printf '%s' "$lines" | jq -Rn --arg session "$session" '
      {ok:true, session:$session,
       assets: [inputs | select(length>0) | split(" ")
                | {asset:.[0], status:.[1], detail:(.[2:] | join(" "))}]}'
  else
    printf '%s' "$lines"
  fi
  return 0
}

# cmd_sessions [--json] — every session's identity joined with its liveness.
#
# TWO LAYERS, JOINED HERE AND NOWHERE ELSE. Identity is a free local read;
# liveness shells out and can fail. They are measured separately so a failure in
# one cannot erase the other — a session whose liveness could not be measured
# still appears, with its identity intact and every liveness field `unknown`.
#
# REACH IS NOT HERE. Whether a session's declared assets actually answer costs a
# remote round trip each and is `steward assets`' job. A view asks for that
# separately and asynchronously; folding it in would make this command take half
# a minute for a fleet of twenty.
cmd_sessions() {
  local want_json="" a
  # DETECT --json BEFORE VALIDATING ANYTHING ELSE. A refusal must come back in
  # the format the caller asked for; discovering the flag only after rejecting
  # an earlier argument would answer a json request with a bare sentence, and a
  # consumer reads that as a broken tool rather than a bad argument.
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done
  for a in "$@"; do
    case "$a" in
      --json) ;;
      *) if [ -n "$want_json" ]; then jq -cn --arg r "steward: unknown argument '$a'" '{ok:false,reason:$r}'
         else printf 'steward: unknown argument %s\n' "$a" >&2; fi
         return 64 ;;
    esac
  done

  # shellcheck source=lib/sessions.sh
  . "$HERE/lib/sessions.sh"
  # shellcheck source=lib/liveness.sh
  . "$HERE/lib/liveness.sh"
  # SOURCED EXPLICITLY HERE, not left to lib/sessions.sh's lazy load below —
  # that load only fires once session_identity_rows runs, and the estate
  # fallback just below needs registry_liveness_cmd before then. Sourcing
  # twice is harmless: the file has no side effects on source, only function
  # definitions.
  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  # ── THE ESTATE FALLBACK, RESOLVED BEFORE ANY LIVENESS MEASUREMENT RUNS ──
  #
  # THE ENVIRONMENT ALWAYS WINS. By the time this line runs, that "environment"
  # already includes whatever _operator_config_load filled in from the
  # operator's own config file — an operator who set STEWARD_LIVENESS_CMD by
  # hand, or through a future `config set`, gets exactly that shim, never a
  # second guess. Only when NEITHER has an opinion does the estate's own
  # LIVENESS_CMD get a turn: it is a claim about the ESTATE's shim, not about
  # this operator's choice, so it must never override one already made.
  #
  # A REFUSAL HERE IS AN INVOCATION REFUSAL, IN THE REQUESTED FORMAT — the
  # same shape as the missing-HUB_HOST refusal further down. An operator who
  # wrote a relative path into the estate's LIVENESS_CMD gets told so; a
  # `sessions` table that quietly rendered every liveness column as `unknown`
  # would hide exactly the mistake this guard exists to surface.
  if [ -z "${STEWARD_LIVENESS_CMD:-}" ]; then
    local _lv_out _lv_err _lv_rc
    _lv_err="$(mktemp)" || {
      if [ -n "$want_json" ]; then jq -cn --arg r "steward: cannot create a temporary file" '{ok:false,reason:$r}'
      else printf 'steward: cannot create a temporary file\n' >&2; fi
      return 70
    }
    _lv_out="$(registry_liveness_cmd 2>"$_lv_err")"; _lv_rc=$?
    if [ "$_lv_rc" -ne 0 ]; then
      local _lv_diag; _lv_diag="$(cat "$_lv_err")"; rm -f "$_lv_err"
      if [ -n "$want_json" ]; then jq -cn --arg r "$_lv_diag" '{ok:false,reason:$r}'
      else printf '%s\n' "$_lv_diag" >&2; fi
      return "$_lv_rc"
    fi
    rm -f "$_lv_err"
    # AN ESTATE THAT NAMES NO SHIM IS NOT A REFUSAL — it is the common,
    # unconfigured state, and liveness_rows already renders that as
    # `seam-not-configured` further down. Only a NON-EMPTY answer is wired in.
    if [ -n "$_lv_out" ]; then
      STEWARD_LIVENESS_CMD="$_lv_out"; export STEWARD_LIVENESS_CMD
      # SAME PROVENANCE VARIABLE _operator_config_load ALREADY MAINTAINS — a
      # third source next to process-environment and config-file, so a future
      # `doctor` probe (and STEWARD_CFG_DEBUG today) can say WHERE the value
      # that ran came from, not just that one ran.
      _CFG_SOURCE_STEWARD_LIVENESS_CMD="estate"
    fi
  fi

  # STDOUT AND STDERR ARE CAPTURED SEPARATELY, ON PURPOSE. `$ident` below is
  # parsed as pure TSV data by both the jq join and the human-form `read`
  # loop — a single `2>&1` fold would land session_identity_rows' diagnostic
  # sentence ("sessions: skipping '<name>' ...") inside that same variable
  # as if it were a data row. That diagnostic is not rare: it fires on rc 0
  # whenever some sessions load and one does not, which is a realistic fleet,
  # not an edge case. Measured live before this fix: `--json` fed the merged
  # text into jq's split() and produced no JSON at all, `jq: error ... split
  # input and separator must be strings`, while still exiting 0 — silent
  # corruption reported as success. The human form spliced the sentence into
  # the middle of a table row. Route stderr to a temp file instead, so `$ident`
  # stays pure data on every path; do not "simplify" this back to `2>&1`.
  #
  # AND STDOUT GOES TO A FILE TOO, not into `$( )`. A command substitution is a
  # subshell: session_identity_rows sets SESSIONS_UNREADABLE and liveness_rows
  # sets LIVENESS_SEAM_REASON, and neither would survive the trip back. Those
  # two variables are how the names of unloadable sessions and the reason a
  # measurement could not be made reach the JSON document below, which is the
  # whole reason both exist — so the redirection is load-bearing, not a style.
  local ident_out ident_err
  ident_out="$(mktemp)" && ident_err="$(mktemp)" || {
    if [ -n "$want_json" ]; then jq -cn --arg r "steward: cannot create a temporary file" '{ok:false,reason:$r}'
    else printf 'steward: cannot create a temporary file\n' >&2; fi
    rm -f "$ident_out" "$ident_err"
    return 70
  }
  local ident rc diag unreadable hidden
  session_identity_rows >"$ident_out" 2>"$ident_err"; rc=$?
  ident="$(cat "$ident_out")"; diag="$(cat "$ident_err")"
  unreadable="${SESSIONS_UNREADABLE:-}"
  # SAME PRECEDENCE AS THE FILTER ITSELF, so the count printed here and the
  # rows it describes always agree on who was asking.
  hidden="${SESSIONS_HIDDEN:-0}"
  rm -f "$ident_out" "$ident_err"

  if [ "$rc" -ne 0 ]; then
    # A REFUSAL MUST STAY IN THE REQUESTED FORMAT. A consumer that asked for
    # json and got a bare sentence on stdout cannot parse the refusal, so it
    # reports a broken tool instead of an unreadable registry. The registry
    # could not be read at all here, so `$diag` — the captured stderr — IS the
    # reason text; stdout is empty in this branch (session_identity_rows never
    # emits a data row for a session it never loaded).
    if [ -n "$want_json" ]; then jq -cn --arg r "$diag" '{ok:false,reason:$r}'
    else printf '%s\n' "$diag" >&2; fi
    return "$rc"
  fi

  # rc 0 WITH DIAGNOSTICS PRESENT is the partial-failure case: some sessions
  # loaded, at least one did not, and that is diagnosis, not silence. Forward
  # it unchanged to THIS command's own stderr — never into stdout, and never
  # dropped. Dropping it here would re-create, one layer up, exactly the
  # silence the skip-and-report fix in lib/sessions.sh removed.
  [ -n "$diag" ] && printf '%s\n' "$diag" >&2

  # SAME REASON, SAME SHAPE: liveness_rows must not run in a subshell either, or
  # LIVENESS_SEAM_REASON never comes back and every `unknown` below loses its
  # reason — which is the exact silence this command exists to make impossible.
  local live live_out; live_out="$(mktemp)" || {
    if [ -n "$want_json" ]; then jq -cn --arg r "steward: cannot create a temporary file" '{ok:false,reason:$r}'
    else printf 'steward: cannot create a temporary file\n' >&2; fi
    return 70
  }
  liveness_rows >"$live_out"
  live="$(cat "$live_out")"; rm -f "$live_out"

  if [ -n "$want_json" ]; then
    # THE DOCUMENT DECLARES WHICH HOST IS HOME. Each session row carries its
    # own host, but a consumer deciding whether that session can be reached
    # LOCALLY (the cockpit's enter) needs the hub's name to compare against —
    # without it, the cockpit attached a remote-host session to the local tmux
    # and got "can't find session", measured on the real hub. HUB_HOST is a
    # required estate field (the all-fail refusal above names it), so by this
    # line it is readable; a failure here is still a refusal, never a guess.
    local hub
    hub="$(registry_hub_host)" || {
      jq -cn --arg r "steward: the estate file names no readable HUB_HOST" '{ok:false,reason:$r}'
      return 78
    }
    # Materialise one liveness row per IDENTIFIED session — including the ones
    # the command never mentioned, which liveness_for fills with `unknown`. No
    # temporary file: this writes nothing into the checkout and cannot leave
    # litter behind when a run is interrupted.
    local joined=""
    joined="$(printf '%s\n' "$ident" | while IFS=$'\t' read -r n _rest; do
        [ -n "$n" ] || continue
        liveness_for "$n" "$live"
      done)"
    # Join in jq rather than in shell string concatenation: the fields carry
    # names and timestamps, and hand-built json is where quoting bugs live.
    jq -Rn --arg _live "$joined" --arg _unreadable "$unreadable" --argjson _hidden "$hidden" --arg _hub "$hub" '
      ($_live | split("\n") | map(select(length>0) | split("\t"))
        | map({key: .[0], value: {daemon:.[1], tmux:.[2], agent:.[3],
                                  runtime:.[4],
                                  model:       (if .[5] == "-" then null else .[5] end),
                                  lastActivity:(if .[6] == "-" then null else .[6] end),
                                  # `reason` IS A DETAIL FIELD, LIKE THE REACH
                                  # LAYER"S `detail` — not a fifth status word.
                                  # null means the session was genuinely
                                  # measured and there is nothing to explain.
                                  reason:      (if (.[7] // "-") == "-" then null else .[7] end)}})
        | from_entries) as $L |
      {ok:true,
       # WHICH HOST IS HOME — the name each session"s own `host` is compared
       # against when a consumer asks "is this reachable locally?".
       hub: $_hub,
       # A PARTIAL FAILURE MUST BE VISIBLE IN THE DOCUMENT, not only on a second
       # stream. `ok:true` beside a shorter list asserts the answer is complete;
       # a session that vanished entirely is the spec"s founding complaint with
       # fewer rows. Always a list, empty when nothing failed, so a consumer
       # never has to tell absent from empty.
       unreadable: ($_unreadable | split("\n") | map(select(length>0))),
       # A COUNT, NEVER NAMES — see lib/sessions.sh. `hidden` is always a
       # number, even zero, so a consumer never has to guess whether the
       # engine simply does not report hiding.
       hidden: $_hidden,
       sessions: [ inputs | select(length>0) | split("\t") |
         {name:.[0], id:.[1], owner:.[2], domain:.[3], host:.[4],
          entity: (if .[5] == "-" then null else {name:.[5], relation:.[6]} end),
          assets: (if .[7] == "-" then [] else (.[7] | split(" ")) end),
          liveness: ($L[.[0]] // {daemon:"unknown",tmux:"unknown",agent:"unknown",
                                  runtime:"unknown",model:null,lastActivity:null,
                                  reason:"not-in-answer"})} ]}' \
      <<<"$ident"
  else
    printf '%-24s %-10s %-8s %-12s %-14s %s\n' SESSION OWNER TMUX AGENT MODEL ASSETS
    # id, dm, ho, en, er are read but intentionally unused — they exist only
    # to keep the read positionally aligned with the 8-field TSV; dropping
    # them from the read would silently shift every field after the gap.
    printf '%s\n' "$ident" | while IFS=$'\t' read -r n id ow dm ho en er as; do
      [ -n "$n" ] || continue
      local lrow; lrow="$(liveness_for "$n" "$live")"
      printf '%-24s %-10s %-8s %-12s %-14s %s\n' \
        "$n" "$ow" "$(printf '%s' "$lrow" | cut -f3)" \
        "$(printf '%s' "$lrow" | cut -f4)" "$(printf '%s' "$lrow" | cut -f6)" \
        "$([ "$as" = "-" ] && printf '(declares none)' || printf '%s' "$as")"
    done
    # SAME COUNT AS THE JSON FORM, said in a sentence instead of a field. A
    # zero-row table after every full listing would be noise nobody reads by
    # the second week, so this line is silent when nothing is hidden AND the
    # table itself has rows — but the one case that line would otherwise
    # leave ambiguous, an empty table, still gets it: "hidden" and "genuinely
    # no sessions" must not look the same on a blank screen.
    local _viewer_text; _viewer_text="${STEWARD_VIEWER:-$(id -un 2>/dev/null)}"
    # A BLANK NAME IS NOT A REASON. If `id -un` fails and STEWARD_VIEWER is
    # unset there is no viewer, so lib/sessions.sh hides everything — an empty
    # viewer is not a wildcard, and refusing is right. But the line then read
    # "not visible to )" with nothing in the gap, which tells a reader that
    # something is withheld and not that the tool could not work out who they
    # are. Name the failure instead of printing its absence.
    [ -n "$_viewer_text" ] || _viewer_text="an unidentified account — 'id -un' failed and STEWARD_VIEWER is unset"
    local _listed; _listed="$(printf '%s\n' "$ident" | sed '/^$/d' | wc -l | tr -d ' ')"
    if [ "$hidden" -gt 0 ] || [ "$_listed" -eq 0 ]; then
      printf '(%s session(s) not visible to %s)\n' "$hidden" "$_viewer_text"
    fi
    # A FULL COLUMN OF `unknown` WITH NO EXPLANATION IS THE SILENCE THIS
    # COMMAND EXISTS TO REMOVE. lib/liveness.sh keeps the unconfigured case
    # quiet on purpose — it is a normal state, and a warning on every run of
    # every command is a warning nobody reads by the second week. But a human
    # who just asked for this table and got an unmeasured column deserves the
    # one sentence that says why, and where to fix it. Stderr, so the table
    # stays pure data; only in the human form, so a consumer is not spammed.
    if [ "${LIVENESS_SEAM_REASON:-}" = "seam-not-configured" ]; then
      printf 'steward: no liveness command configured — set STEWARD_LIVENESS_CMD to the estate'"'"'s shim; the liveness columns above are UNMEASURED, not unhealthy\n' >&2
    fi
  fi
  return 0
}

# ---------------------------------------------------------------------------
# The bare invocation's own two resolvers — hub-local verification, then
# socket derivation from it. Both run inside the "" branch of the dispatcher
# below, after _operator_config_load and before the cockpit runs.
#
# HUB-LOCAL IS A CONVENIENCE GATE, NOT A SECURITY BOUNDARY. STEWARD_HOSTNAME_CMD
# exists purely as a test seam — it can "spoof" the check, but that buys an
# operator nothing they could not already get with an explicit
# STEWARD_TMUX_SOCKET. It guards against running on the wrong machine, not
# against a hostile one.
#
# NEVER A HARD FAILURE. When the registry cannot answer — no estate root
# resolvable, a missing or broken estate file — this is simply "not
# hub-local". The cockpit's own refusals downstream (missing socket, etc.)
# already say why; a bare invocation must not gain a NEW way to fail just
# because this convenience check could not be evaluated.
_resolve_hub_local() {
  local _hostcmd="${STEWARD_HOSTNAME_CMD:-}" _here_host _hub_host
  if [ -n "$_hostcmd" ]; then
    _here_host="$("$_hostcmd" 2>/dev/null)" || return 1
  else
    _here_host="$(hostname -s 2>/dev/null)" || return 1
  fi
  [ -n "$_here_host" ] || return 1
  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh" 2>/dev/null || return 1
  _hub_host="$(registry_hub_host 2>/dev/null)" || return 1
  [ "$_here_host" = "$_hub_host" ] || return 1
  STEWARD_HUB_LOCAL=1
  export STEWARD_HUB_LOCAL
  return 0
}

# _resolve_socket — fills STEWARD_TMUX_SOCKET for the cockpit child by
# deriving it from the estate's own TMUX_SOCKET, but only on a verified
# hub-local machine. An explicit value — from the process environment, or
# already filled in by _operator_config_load from the operator's config file
# — always wins untouched; its _CFG_SOURCE_STEWARD_TMUX_SOCKET already says
# which. Any failure along the way (not hub-local, registry unreadable,
# TMUX_SOCKET missing or invalid) simply leaves the variable unset — the
# cockpit's existing "refusing to guess a socket" refusal stands on Enter.
_resolve_socket() {
  [ -n "${STEWARD_TMUX_SOCKET:-}" ] && return 0
  _resolve_hub_local || return 0
  local _sock
  _sock="$(registry_tmux_socket 2>/dev/null)" || return 0
  STEWARD_TMUX_SOCKET="$HOME/.tmux/$_sock"
  export STEWARD_TMUX_SOCKET
  _CFG_SOURCE_STEWARD_TMUX_SOCKET="derived"
  return 0
}

# ---------------------------------------------------------------------------
# `steward doctor` — the operator's first read on a fresh checkout, before
# anything is trusted. Nine probes, in dependency order, each PASS/WARN/FAIL/
# SKIP: self-path, operator-config, estate-root, registry, hub-local (the
# core, 1-5), then liveness, socket, cockpit-binary, dependencies (6-9). Both
# `--json` (every probe result plus each value's provenance) and `--static`
# (no shim/socket calls — skips the liveness contract probe) are implemented
# below — see docs/superpowers/specs/2026-08-29-operatorens-vag-in-design.md
# section 5 for the full probe table and the rc contract.
#
# EVERY PROBE READS, NEVER WRITES. No file writes, no builds, no bus, git or
# network calls happen anywhere below — the one verb that mutates is
# `steward config init`/`set`, and every FAIL/WARN line names the exact
# command to run, never a raw `export` line an operator would have to
# remember and repeat by hand.
#
# ONE FUNCTION PER PROBE, `_doctor_probe_<id>`, IDs EXACTLY as the spec's
# table. Each probe prints a single `STATUS text` line on its own stdout and
# returns a class the runner folds into both that line's STATUS and the
# overall exit code: 0 for PASS/WARN, 78 for an unsafe or missing config
# value, 69 for a missing facility, 70 for a doctor-internal failure (e.g. it
# could not even create a temp file).
#
# THE DEPENDENCY CHAIN IS TWO RULES, NOT FIVE. A FAIL in operator-config
# blocks estate-root, registry AND hub-local — nothing downstream of a broken
# config can be measured honestly, because every one of those probes needs a
# resolved STEWARD_ESTATE_ROOT. A FAIL in estate-root blocks registry and
# hub-local the same way. self-path blocks nothing (it runs before anything
# else could need it) and hub-local blocks nothing further (nothing runs
# after it today). Every SKIP names the probe that blocked it, never a bare
# "skipped".
_DOCTOR_PROBE_IDS="self-path operator-config estate-root registry hub-local liveness socket cockpit-binary dependencies"

# _doctor_oneline <text> — flattens a possibly multi-line diagnostic (reused
# lib/registry.sh error text — e.g. registry_schema_check's schema-too-new
# refusal, or registry_list's missing-sessions.d refusal, both of which emit
# more than one line) to exactly one line before it enters a probe's
# `ID  STATUS  text` line. A raw embedded newline would leave a continuation
# line with no `ID  STATUS` prefix, breaking the one-line-per-probe contract
# every consumer of this output (including Task 5's --json) depends on.
#
# TABS ARE FLATTENED TOO, NOT JUST NEWLINES — a tab is the --json field
# separator cmd_doctor joins id/status/text with (`$id\t$status\t$text`), so
# an interpolated value carrying one would forge extra fields in that join
# the same way an embedded newline forges extra probe rows. Any raw value
# this file interpolates into probe text (STEWARD_ESTATE_ROOT,
# STEWARD_TMUX_SOCKET, STEWARD_LIVENESS_CMD, and the resolved estate root)
# must go through here first — a review found the operator-config probe
# forging a fake `{"id":"socket","status":"PASS"}` row from exactly this gap
# before this function was applied on that path.
_doctor_oneline() {
  printf '%s' "$1" | tr '\n\t' '  ' | tr -s ' ' | sed -e 's/^ *//' -e 's/ *$//'
}

# _doctor_mtime_of <path> — best-effort epoch mtime, BSD or GNU stat. Same
# shape as _CFG_MODE_OF above (portable stat is a mode-reader in that
# function, a clock-reader here); mtime is used by the cockpit-binary probe
# as a DIAGNOSIS ("does the binary look older than its sources"), never as
# provenance of anything — a touched file can lie in either direction.
_doctor_mtime_of() {
  local p="$1" m
  m="$(stat -f '%m' "$p" 2>/dev/null)"
  [ -n "$m" ] || m="$(stat -c '%Y' "$p" 2>/dev/null)"
  [ -n "$m" ] || return 1
  printf '%s' "$m"
}

# self-path — reports on the SAME symlink-resolution loop at the top of this
# file, never a second one. By the time this runs, $_selfpath and $HERE are
# already the resolved, canonical values every other command trusts; a
# dangling link or an unresolvable install root would already have made
# nearly everything below this line fail in stranger ways, so this probe
# exists to say so plainly, first.
_doctor_probe_self-path() {
  if [ -z "${_selfpath:-}" ] || [ ! -f "$_selfpath" ]; then
    printf 'FAIL the resolved self-path does not exist (a dangling symlink?): %s\n' "${_selfpath:-<empty>}"
    return 69
  fi
  if [ -z "${HERE:-}" ] || [ ! -d "$HERE" ]; then
    printf 'FAIL could not resolve the install root from %s\n' "$_selfpath"
    return 69
  fi
  printf 'PASS resolved to %s (install root %s)\n' "$_selfpath" "$HERE"
  return 0
}

# operator-config — syntax/owner/mode plus every effective value's
# provenance. _operator_config_load already ran at the top of this script
# (reused, never re-implemented); this probe only reports what it found.
#
# THE FOUNDING CASE: A VALUE FROM THE ENVIRONMENT WITH NO DURABLE FILE BEHIND
# IT. A session inherits STEWARD_ESTATE_ROOT from its supervisor every time
# it runs — that is correct and common, and it is also indistinguishable
# from real setup unless something says so. `ambient-only` is that word: it
# fires only when a value's source is process-environment AND no config
# file exists at all, never when the value merely differs from what a
# present file says (env always wins there too, but a durable file already
# exists to fall back to).
_doctor_probe_operator-config() {
  # A BROKEN FILE ALWAYS MEANS AN EXISTING FILE. _operator_config_load
  # returns rc 0 for "no file at all" unconditionally — every rc-78 branch in
  # it runs only after `[ -e "$f" ]` already passed. So the remedy here is
  # always `config set`, never `config init` (which refuses outright on a
  # file that exists): `set` rewrites the file atomically rather than
  # patching the broken line, so it clears whatever made the old one
  # unreadable.
  if [ "${_cfg_rc:-0}" -ne 0 ]; then
    # THE WRITABLE-DIRECTORY CASE DOES NOT CONVERGE ON 'config set'. That
    # remedy only ever repairs the FILE's own content — it never touches
    # the directory's mode — so prescribing it here would have `config
    # set` report success while the reader's FAIL persists forever. Mirror
    # the file-mode WARN's own remedy shape (chmod on the offending path)
    # instead, matched against the reader's own error text so this stays
    # one judgment, not a second copy of the predicate.
    case "$_CFG_ERROR" in
      *"directory holding the operator config is group- or other-writable"*)
        local baddir="${_CFG_ERROR##*: }"
        printf 'FAIL %s -- run: chmod 0700 %s\n' "$_CFG_ERROR" "$baddir"
        return 78
        ;;
    esac
    printf 'FAIL %s -- run: steward config set STEWARD_ESTATE_ROOT /abs/correct-estate-root (config set rewrites the file cleanly)\n' "$_CFG_ERROR"
    return 78
  fi

  local cfgfile="${STEWARD_CONFIG_FILE:-$HOME/.config/steward/config}"
  local have_file=""
  [ -e "$cfgfile" ] && have_file=1

  # EVERY RAW VALUE GOES THROUGH _doctor_oneline BEFORE IT EVER REACHES
  # PROBE TEXT. C1 (the config-FILE value shape gate) already refuses an
  # embedded newline/tab, but STEWARD_ESTATE_ROOT (and the other two) can
  # still arrive newline- or tab-bearing from the PROCESS ENVIRONMENT — the
  # plan's founding "a session inherits it from the supervisor" case — so
  # this flattening is needed independently of C1, not merely as a backstop
  # for it.
  local root_v sock_v live_v
  root_v="$(_doctor_oneline "${STEWARD_ESTATE_ROOT:-}")"
  sock_v="$(_doctor_oneline "${STEWARD_TMUX_SOCKET:-}")"
  live_v="$(_doctor_oneline "${STEWARD_LIVENESS_CMD:-}")"

  local root_txt sock_txt live_txt
  root_txt="STEWARD_ESTATE_ROOT=$root_v source=$_CFG_SOURCE_STEWARD_ESTATE_ROOT"
  sock_txt="STEWARD_TMUX_SOCKET=$sock_v source=$_CFG_SOURCE_STEWARD_TMUX_SOCKET"
  live_txt="STEWARD_LIVENESS_CMD=$live_v source=$_CFG_SOURCE_STEWARD_LIVENESS_CMD"

  local ambient=""
  if [ -z "$have_file" ]; then
    if [ "$_CFG_SOURCE_STEWARD_ESTATE_ROOT" = "process-environment" ]; then root_txt="$root_txt (ambient-only)"; ambient=1; fi
    if [ "$_CFG_SOURCE_STEWARD_TMUX_SOCKET" = "process-environment" ]; then sock_txt="$sock_txt (ambient-only)"; ambient=1; fi
    if [ "$_CFG_SOURCE_STEWARD_LIVENESS_CMD" = "process-environment" ]; then live_txt="$live_txt (ambient-only)"; ambient=1; fi
  fi

  # THE MODE CHECK THE PARSER ITSELF DOES NOT MAKE. 0644 is ACCEPTED for
  # reading (only group/other WRITE bits are refused) — but a config file
  # that names an estate root should not be world-readable either, so doctor
  # says so even where the loader stayed silent.
  local mode_warn=""
  if [ -n "$have_file" ] && [ ! -L "$cfgfile" ]; then
    local mode; mode="$(_CFG_MODE_OF "$cfgfile" 2>/dev/null)"
    if [ -n "$mode" ] && [ "$mode" != "600" ]; then
      mode_warn="config file mode is $mode, not 0600 (group/other can read it) -- run: chmod 0600 $cfgfile"
    fi
  fi

  local text="$root_txt; $sock_txt; $live_txt"

  if [ -n "$ambient" ]; then
    # REUSES root_v/sock_v/live_v (already flattened above) rather than the
    # raw env values — the remedy command text is part of the SAME
    # single-line probe text as $root_txt/$sock_txt/$live_txt, so it is
    # exactly as exposed to the newline/tab forgery C2 closes.
    local init_root="${root_v:-/abs/correct-estate-root}"
    local init_cmd="steward config init --estate-root $init_root"
    [ "$_CFG_SOURCE_STEWARD_TMUX_SOCKET" = "process-environment" ]  && init_cmd="$init_cmd --tmux-socket $sock_v"
    [ "$_CFG_SOURCE_STEWARD_LIVENESS_CMD" = "process-environment" ] && init_cmd="$init_cmd --liveness-cmd $live_v"
    if [ -n "$mode_warn" ]; then
      printf 'WARN %s -- run: %s; also: %s\n' "$text" "$init_cmd" "$mode_warn"
    else
      printf 'WARN %s -- run: %s\n' "$text" "$init_cmd"
    fi
    return 0
  fi

  if [ -n "$mode_warn" ]; then
    printf 'WARN %s -- %s\n' "$text" "$mode_warn"
    return 0
  fi

  printf 'PASS %s\n' "$text"
  return 0
}

# estate-root — the root directory, estate/steward.conf, and its schema.
# Reuses _registry_estate_root and registry_estate_file/registry_schema_check
# from lib/registry.sh rather than re-deriving any of it.
_doctor_probe_estate-root() {
  local root; root="$(_registry_estate_root)"
  # DISPLAY-ONLY, FLATTENED. $root is STEWARD_ESTATE_ROOT (or its
  # config-file value) verbatim — the same value that can arrive
  # newline/tab-bearing from the process environment that C2 closes on the
  # operator-config probe. The raw $root still drives every real
  # filesystem check below (-d, registry_estate_file); only what gets
  # printed into probe text is flattened.
  local root_disp; root_disp="$(_doctor_oneline "$root")"

  local cfgfile="${STEWARD_CONFIG_FILE:-$HOME/.config/steward/config}"
  local have_file=""
  [ -e "$cfgfile" ] && have_file=1
  # SAME RULE AS operator-config's OWN REMEDY: `init` only ever applies when
  # no config file exists yet; once one exists, `set` is the only verb that
  # will not refuse.
  local remedy
  if [ -n "$have_file" ]; then
    remedy="steward config set STEWARD_ESTATE_ROOT /abs/correct-estate-root"
  else
    remedy="steward config init --estate-root /abs/correct-estate-root"
  fi

  if [ ! -d "$root" ]; then
    printf 'FAIL estate root does not exist: %s -- run: %s\n' "$root_disp" "$remedy"
    return 78
  fi

  local estate_file; estate_file="$(registry_estate_file)"
  if [ ! -f "$estate_file" ]; then
    printf 'FAIL estate file missing: %s -- run: %s\n' "$(_doctor_oneline "$estate_file")" "$remedy"
    return 78
  fi

  local schema_out schema_rc
  schema_out="$(registry_schema_check 2>&1 >/dev/null)"
  schema_rc=$?
  if [ "$schema_rc" -ne 0 ]; then
    printf 'FAIL %s -- run: %s\n' "$(_doctor_oneline "$schema_out")" "$remedy"
    return 78
  fi

  printf 'PASS root=%s estate-file=%s\n' "$root_disp" "$(_doctor_oneline "$estate_file")"
  return 0
}

# registry — does the session registry load, and how many rows are
# unreadable. Reuses registry_list and registry_load; never re-parses a
# session conf itself.
_doctor_probe_registry() {
  local errf; errf="$(mktemp 2>/dev/null)"
  if [ -z "$errf" ]; then
    printf 'FAIL could not create a temporary file\n'
    return 70
  fi
  local list rc
  list="$(registry_list 2>"$errf")"
  rc=$?
  local err; err="$(cat "$errf" 2>/dev/null)"
  rm -f "$errf"
  if [ "$rc" -ne 0 ]; then
    printf 'FAIL %s -- if this estate root is wrong, run: steward config set STEWARD_ESTATE_ROOT /abs/correct-estate-root\n' "$(_doctor_oneline "$err")"
    return 78
  fi

  local total=0 unreadable=0 name
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    total=$((total+1))
    ( registry_load "$name" >/dev/null 2>&1 ) || unreadable=$((unreadable+1))
  done <<EOF
$list
EOF

  if [ "$unreadable" -gt 0 ]; then
    printf 'WARN %d/%d session(s) failed to load -- run: steward sessions to see which\n' "$unreadable" "$total"
    return 0
  fi
  printf 'PASS %d session(s) registered, all load\n' "$total"
  return 0
}

# hub-local — this machine's hostname against the estate's HUB_HOST. THE
# DECISION ITSELF IS _resolve_hub_local's, REUSED VERBATIM (same
# STEWARD_HOSTNAME_CMD test seam it already honors); this probe only prints
# the two names next to the same yes/no it already makes. Not being the hub
# is a normal state for an operator's own laptop, not a defect — so it is a
# WARN with no remedy, never a FAIL.
_doctor_probe_hub-local() {
  local hub_host; hub_host="$(registry_hub_host 2>/dev/null)"
  if [ -z "$hub_host" ]; then
    printf 'FAIL the estate names no readable HUB_HOST -- run: steward config set STEWARD_ESTATE_ROOT /abs/correct-estate-root\n'
    return 78
  fi

  local here_host
  if [ -n "${STEWARD_HOSTNAME_CMD:-}" ]; then here_host="$("$STEWARD_HOSTNAME_CMD" 2>/dev/null)"
  else here_host="$(hostname -s 2>/dev/null)"; fi
  if [ -z "$here_host" ]; then
    printf 'FAIL could not determine this machine'"'"'s hostname\n'
    return 69
  fi

  if _resolve_hub_local; then
    printf 'PASS this machine (%s) is the hub (HUB_HOST=%s)\n' "$here_host" "$hub_host"
  else
    printf 'WARN this machine (%s) is not the hub (HUB_HOST=%s) -- socket derivation and estate-local shortcuts stay off; an explicit STEWARD_TMUX_SOCKET is still honored\n' "$here_host" "$hub_host"
  fi
  return 0
}

# liveness — source+provenance of the effective STEWARD_LIVENESS_CMD, path
# safety, a BOUNDED contract probe (the shim actually runs, through the same
# liveness_rows/LIVENESS_SEAM_REASON machinery every other caller uses — this
# probe adds no timeout mechanism of its own), and registry parity: the
# session names the shim answered about, compared against the registry's own
# set.
#
# THE EFFECTIVE VALUE IS RESOLVED IN cmd_doctor, NOT HERE. This function runs
# inside a `$( )` command substitution — a subshell — so any mutation it made
# to STEWARD_LIVENESS_CMD or _CFG_SOURCE_STEWARD_LIVENESS_CMD (the estate
# fallback cmd_sessions performs) would vanish the instant it returned. The
# runner performs that same fallback once, in ITS OWN shell, before the probe
# loop starts, and leaves the result (and any refusal from it) in
# $STEWARD_LIVENESS_CMD / $_CFG_SOURCE_STEWARD_LIVENESS_CMD /
# $_DOCTOR_LIVENESS_RC / $_DOCTOR_LIVENESS_DIAG for this probe to only read.
#
# A VALID EMPTY ANSWER IS NOT PROOF OF AN EMPTY FLEET. A shim that returns
# `{"sessions":{}}` cleanly (rc 0, no seam reason) against a registry that
# lists real sessions is indistinguishable, on the wire, from a shim that
# is quietly pointed at the wrong estate — so it is a WARN, never a PASS.
# The same is true in reverse: a session name the shim mentions that the
# registry does not know is worth a WARN, not silent acceptance.
_doctor_probe_liveness() {
  if [ -n "${_DOCTOR_LIVENESS_RC:-}" ] && [ "$_DOCTOR_LIVENESS_RC" -ne 0 ]; then
    if [ "$_DOCTOR_LIVENESS_RC" -eq 70 ]; then
      printf 'FAIL %s\n' "$(_doctor_oneline "${_DOCTOR_LIVENESS_DIAG:-could not create a temporary file}")"
      return 70
    fi
    printf 'FAIL %s -- run: steward config set STEWARD_LIVENESS_CMD /abs/path (or fix LIVENESS_CMD in estate/steward.conf)\n' \
      "$(_doctor_oneline "${_DOCTOR_LIVENESS_DIAG:-registry: LIVENESS_CMD is invalid}")"
    return 78
  fi

  local cmd="${STEWARD_LIVENESS_CMD:-}" src="${_CFG_SOURCE_STEWARD_LIVENESS_CMD:-unset}"

  if [ -z "$cmd" ]; then
    printf 'WARN no liveness command configured (seam-not-configured) -- run: steward config set STEWARD_LIVENESS_CMD /abs/path/to/shim, or add LIVENESS_CMD to estate/steward.conf\n'
    return 0
  fi

  # THE SAME ABSOLUTE-PATH CONTRACT lib/liveness.sh ITSELF ENFORCES, checked
  # here too so the FAIL line names doctor's own remedy rather than making an
  # operator read liveness_rows' stderr to learn it.
  case "$cmd" in
    /*) ;;
    *)
      printf 'FAIL STEWARD_LIVENESS_CMD is not an absolute path (seam-not-absolute): %s -- run: steward config set STEWARD_LIVENESS_CMD /abs/path\n' "$cmd"
      return 78
      ;;
  esac

  if [ -n "${_DOCTOR_STATIC:-}" ]; then
    printf 'SKIP static -- shim not invoked under --static (source=%s cmd=%s)\n' "$src" "$cmd"
    return 0
  fi

  # SAID BEFORE THE SHIM RUNS, NOT AFTER. The shim reads a live multiplexer
  # socket; an operator watching doctor run deserves to know, in advance,
  # that this is the one probe that executes estate-owned code rather than
  # only reading files doctor itself can account for.
  echo "steward: about to run the estate's liveness code to measure it -- invoking the configured shim ($cmd)" >&2

  local _rows_out _rows_err
  _rows_out="$(mktemp 2>/dev/null)" && _rows_err="$(mktemp 2>/dev/null)" || {
    rm -f "$_rows_out"
    printf 'FAIL could not create a temporary file\n'
    return 70
  }
  liveness_rows >"$_rows_out" 2>"$_rows_err"
  local rows errtext reason
  rows="$(cat "$_rows_out")"; errtext="$(cat "$_rows_err")"
  rm -f "$_rows_out" "$_rows_err"
  reason="${LIVENESS_SEAM_REASON:-}"

  if [ "$reason" = "seam-timeout" ]; then
    printf 'FAIL %s (seam-timeout) -- source=%s cmd=%s -- a hung shim is "could not measure now", not misconfiguration; raise STEWARD_LIVENESS_TIMEOUT if this is expected, or fix the shim\n' \
      "$(_doctor_oneline "$errtext")" "$src" "$cmd"
    return 75
  fi
  if [ -n "$reason" ]; then
    printf 'FAIL %s (%s) -- source=%s cmd=%s\n' "$(_doctor_oneline "$errtext")" "$reason" "$src" "$cmd"
    return 78
  fi

  local reg_names shim_names reg_count=0 shim_count=0 name unknown_sessions=""
  reg_names="$(registry_list 2>/dev/null)"
  shim_names="$(printf '%s\n' "$rows" | awk -F'\t' 'NF{print $1}')"

  while IFS= read -r name; do [ -n "$name" ] || continue; reg_count=$((reg_count+1)); done <<EOF
$reg_names
EOF
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    shim_count=$((shim_count+1))
    if ! printf '%s\n' "$reg_names" | grep -Fxq -- "$name"; then
      unknown_sessions="$unknown_sessions $name"
    fi
  done <<EOF
$shim_names
EOF

  if [ "$shim_count" -eq 0 ] && [ "$reg_count" -gt 0 ]; then
    printf 'WARN the shim answered with zero sessions against a %d-session registry -- a valid empty JSON answer is not proof of an empty fleet; source=%s cmd=%s\n' \
      "$reg_count" "$src" "$cmd"
    return 0
  fi
  if [ -n "$unknown_sessions" ]; then
    printf 'WARN the shim reports session(s) the registry does not know:%s -- source=%s cmd=%s\n' "$unknown_sessions" "$src" "$cmd"
    return 0
  fi

  printf 'PASS source=%s cmd=%s answered %d session(s), registry has %d, parity ok\n' "$src" "$cmd" "$shim_count" "$reg_count"
  return 0
}

# socket — the derived-or-explicit tmux socket path (reusing _resolve_socket's
# own logic and provenance, called once in cmd_doctor's shell for the same
# subshell reason liveness above documents), then measured: exists, is a
# socket, nothing more.
#
# NEVER CREATES OR STARTS ANYTHING. This probe is a stat, not a connection —
# `nc -lU` or any other server-starting fixture is out of bounds even in
# tests; a missing socket is reported, never brought into existence.
_doctor_probe_socket() {
  local path="${STEWARD_TMUX_SOCKET:-}" src="${_CFG_SOURCE_STEWARD_TMUX_SOCKET:-unset}"

  if [ -z "$path" ]; then
    printf 'WARN no tmux socket resolved (not hub-local, and no explicit STEWARD_TMUX_SOCKET) -- run: steward config set STEWARD_TMUX_SOCKET /abs/path/under/.tmux/name, or run doctor on the hub\n'
    return 0
  fi

  if [ -n "${_DOCTOR_STATIC:-}" ]; then
    printf 'SKIP static -- filesystem probe not run under --static (path=%s source=%s)\n' "$path" "$src"
    return 0
  fi

  if [ ! -e "$path" ]; then
    printf 'FAIL tmux socket does not exist: %s (source=%s) -- this is normal before any session has started; doctor never creates or starts one\n' "$path" "$src"
    return 69
  fi
  if [ ! -S "$path" ]; then
    printf 'FAIL %s exists but is not a socket (source=%s)\n' "$path" "$src"
    return 69
  fi
  printf 'PASS %s is a socket (source=%s)\n' "$path" "$src"
  return 0
}

# cockpit-binary — missing/fresh/stale/unverifiable against the source set
# (src/, Cargo.toml, Cargo.lock) by mtime. mtime is DIAGNOSIS, never
# provenance — a touched file can lie in either direction, so every
# non-`missing` state says so and hands back the exact build command rather
# than acting on what it saw.
#
# STEWARD_COCKPIT_DIR is a TEST SEAM, same spirit as STEWARD_HOSTNAME_CMD —
# it lets a fixture aim this probe at a FAKE cockpit tree instead of the
# real product checkout's cockpit/, which this probe must never read from
# inside a test. STEWARD_COCKPIT_BIN (already used by the bare invocation)
# is honored the same way here: an explicit binary always wins over the
# derived target/release/cockpit path.
_doctor_probe_cockpit-binary() {
  local dir="${STEWARD_COCKPIT_DIR:-$HERE/cockpit}"
  local bin="${STEWARD_COCKPIT_BIN:-$dir/target/release/cockpit}"
  local build_cmd="cargo build --release --manifest-path $dir/Cargo.toml"

  local have_src=""
  [ -d "$dir/src" ] && [ -f "$dir/Cargo.toml" ] && [ -f "$dir/Cargo.lock" ] && have_src=1

  if [ ! -e "$bin" ]; then
    if [ -n "$have_src" ]; then
      printf 'WARN cockpit binary missing: %s -- run: %s\n' "$bin" "$build_cmd"
      return 0
    fi
    printf 'FAIL cockpit binary missing and no source tree found at %s -- run: %s, or set STEWARD_COCKPIT_BIN to a prebuilt binary\n' "$dir" "$build_cmd"
    return 69
  fi

  if [ -z "$have_src" ]; then
    printf 'WARN cockpit binary present but unverifiable: no source tree at %s to compare mtimes against (this looks like a deployed install without source) -- freshness cannot be measured\n' "$dir"
    return 0
  fi

  local newest_src=0 newest_src_file="$dir/Cargo.toml" f mt
  for f in "$dir/Cargo.toml" "$dir/Cargo.lock"; do
    mt="$(_doctor_mtime_of "$f" 2>/dev/null)" || continue
    if [ "$mt" -gt "$newest_src" ]; then newest_src="$mt"; newest_src_file="$f"; fi
  done
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    mt="$(_doctor_mtime_of "$f" 2>/dev/null)" || continue
    if [ "$mt" -gt "$newest_src" ]; then newest_src="$mt"; newest_src_file="$f"; fi
  done < <(find "$dir/src" -type f 2>/dev/null)

  local bin_mt; bin_mt="$(_doctor_mtime_of "$bin" 2>/dev/null)" || bin_mt=0

  if [ "$bin_mt" -ge "$newest_src" ]; then
    printf 'PASS cockpit binary is fresh: %s (mtime diagnosis, not provenance) is not older than any file under %s\n' "$bin" "$dir"
    return 0
  fi
  printf 'WARN cockpit binary is stale: %s is older than %s (mtime diagnosis, not provenance -- stale does NOT trigger an automatic rebuild) -- run: %s\n' \
    "$bin" "$newest_src_file" "$build_cmd"
  return 0
}

# dependencies — exact resolved paths for jq, tmux, cargo. NO PATH-GUESSING:
# this reports exactly what `command -v` resolved in THIS environment, which
# is what matters under cron or ssh, where PATH is not a login shell's PATH
# — never a claim about where an operator's shell would find it.
_doctor_probe_dependencies() {
  local jq_path tmux_path cargo_path
  jq_path="$(command -v jq 2>/dev/null)"
  tmux_path="$(command -v tmux 2>/dev/null)"
  cargo_path="$(command -v cargo 2>/dev/null)"

  local text="jq=${jq_path:-MISSING} tmux=${tmux_path:-MISSING} cargo=${cargo_path:-MISSING}"

  # jq IS LOAD-BEARING FOR THE PRODUCT ITSELF -- steward sessions --json and
  # this very doctor --json both build their documents with it. Its absence
  # is a missing facility, not a preference.
  if [ -z "$jq_path" ]; then
    printf 'FAIL %s -- jq is required (steward sessions --json and doctor --json both need it) -- install jq so it resolves on PATH\n' "$text"
    return 69
  fi

  local warn=""
  if [ -z "$tmux_path" ]; then
    warn="tmux missing: attach/peek and the tmux socket probe will not work"
  fi
  if [ -z "$cargo_path" ]; then
    [ -n "$warn" ] && warn="$warn; "
    warn="${warn}cargo missing: the cockpit cannot be built from source here (aim STEWARD_COCKPIT_BIN at a prebuilt binary instead)"
  fi
  if [ -n "$warn" ]; then
    printf 'WARN %s -- %s\n' "$text" "$warn"
    return 0
  fi
  printf 'PASS %s\n' "$text"
  return 0
}

# cmd_doctor — the runner. Prints one `ID  STATUS  text` line per probe, in
# dependency order, and returns 0 only when nothing FAILed (worst rc wins:
# 0 PASS/WARN/SKIP, 78 unsafe/missing config, 69 missing facility, 75
# temporary measurement unknown, 70 internal doctor error).
cmd_doctor() {
  local want_json="" a
  _DOCTOR_STATIC=""
  for a in "$@"; do
    case "$a" in
      --json) want_json=1 ;;
      --static) _DOCTOR_STATIC=1 ;;
      *) fel "doctor: unknown argument '$a'" 64 ;;
    esac
  done

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh" || { echo "steward: could not load lib/registry.sh" >&2; return 70; }
  # shellcheck source=lib/liveness.sh
  . "$HERE/lib/liveness.sh" || { echo "steward: could not load lib/liveness.sh" >&2; return 70; }

  # ── THE TWO RESOLUTIONS THAT MUST HAPPEN IN THIS SHELL, ONCE ──────────
  # See the liveness/socket probes' own comments for why: each probe runs
  # inside a `$( )` subshell, so a mutation made there never reaches the
  # sources object this runner builds after the loop. Resolving here, before
  # any probe runs, means every probe (and --json's sources block) reads the
  # SAME already-settled values — never re-derives them, never disagrees.
  _DOCTOR_LIVENESS_RC=0
  _DOCTOR_LIVENESS_DIAG=""
  if [ -z "${STEWARD_LIVENESS_CMD:-}" ]; then
    local _lv_out _lv_err
    _lv_err="$(mktemp 2>/dev/null)"
    if [ -z "$_lv_err" ]; then
      _DOCTOR_LIVENESS_RC=70
      _DOCTOR_LIVENESS_DIAG="steward: cannot create a temporary file"
    else
      _lv_out="$(registry_liveness_cmd 2>"$_lv_err")"; _DOCTOR_LIVENESS_RC=$?
      _DOCTOR_LIVENESS_DIAG="$(cat "$_lv_err" 2>/dev/null)"
      rm -f "$_lv_err"
      if [ "$_DOCTOR_LIVENESS_RC" -eq 0 ] && [ -n "$_lv_out" ]; then
        STEWARD_LIVENESS_CMD="$_lv_out"; export STEWARD_LIVENESS_CMD
        _CFG_SOURCE_STEWARD_LIVENESS_CMD="estate"
      fi
    fi
  fi
  _resolve_socket

  local worst=0 blocked_by="" id out status text rc
  for id in $_DOCTOR_PROBE_IDS; do
    if [ -n "$blocked_by" ]; then
      case "$id" in
        # cockpit-binary and dependencies are LOCAL, ESTATE-INDEPENDENT
        # checks -- a broken operator config or estate root says nothing
        # about whether cargo or jq are even on this machine, so they run
        # regardless of what blocked everything else.
        cockpit-binary|dependencies) ;;
        *)
          status="SKIP"; text="blocked by $blocked_by"
          # --json PRINTS NOTHING TO STDOUT UNTIL THE ONE DOCUMENT AT THE
          # END. The human `ID  STATUS  text` lines and the JSON document
          # are two different renderings of the same probe list, never
          # both at once -- a consumer piping doctor --json into jq must
          # see ONLY the document.
          [ -n "$want_json" ] || printf '%s  %s  %s\n' "$id" "$status" "$text"
          if [ -n "$want_json" ]; then
            _doctor_json_probes="${_doctor_json_probes:-}$id	$status	$text
"
          fi
          continue
          ;;
      esac
    fi
    # CALLED DIRECTLY, NEVER THROUGH `$( )`. A command substitution forks a
    # subshell whose $$ still reads as THIS process's pid (bash does not
    # renumber it) but whose `trap` table is its own, private copy — so the
    # liveness probe's outer-deadline watchdog (lib/liveness.sh, `kill -USR1
    # $$`) would signal the right pid with the wrong process listening,
    # and the signal's default disposition (terminate) would kill this
    # entire doctor run instead of only unblocking the one `wait`. MEASURED:
    # a hanging stub under `$( )` exited the whole script at rc 158 (128+30,
    # SIGUSR1) instead of the probe returning 75. Capturing through a temp
    # file instead keeps the probe in THIS shell, where the trap lib/liveness.sh
    # sets is the one `kill -USR1 $$` actually reaches.
    local _probe_outf; _probe_outf="$(mktemp 2>/dev/null)" || {
      printf '%s  FAIL  could not create a temporary file\n' "$id"
      rc=70; [ "$rc" -gt "$worst" ] && worst="$rc"
      continue
    }
    _doctor_probe_"$id" >"$_probe_outf"; rc=$?
    out="$(cat "$_probe_outf")"; rm -f "$_probe_outf"
    status="${out%% *}"
    text="${out#* }"
    [ -n "$want_json" ] || printf '%s  %s  %s\n' "$id" "$status" "$text"
    [ "$rc" -gt "$worst" ] && worst="$rc"
    case "$id" in
      operator-config|estate-root)
        [ "$status" = "FAIL" ] && blocked_by="$id"
        ;;
    esac
    if [ -n "$want_json" ]; then
      _doctor_json_probes="${_doctor_json_probes:-}$id	$status	$text
"
    fi
  done

  if [ -n "$want_json" ]; then
    jq -Rn \
      --arg probes "${_doctor_json_probes:-}" \
      --arg root_val "${STEWARD_ESTATE_ROOT:-}" --arg root_src "${_CFG_SOURCE_STEWARD_ESTATE_ROOT:-unset}" \
      --arg sock_val "${STEWARD_TMUX_SOCKET:-}" --arg sock_src "${_CFG_SOURCE_STEWARD_TMUX_SOCKET:-unset}" \
      --arg live_val "${STEWARD_LIVENESS_CMD:-}" --arg live_src "${_CFG_SOURCE_STEWARD_LIVENESS_CMD:-unset}" \
      --argjson rc "$worst" '
      ($probes | split("\n") | map(select(length>0) | split("\t"))
        | map({id: .[0], status: .[1], text: .[2]})) as $probelist |
      { ok: ($rc == 0),
        rc: $rc,
        probes: $probelist,
        sources: {
          root:     {value: $root_val, source: $root_src},
          socket:   {value: $sock_val, source: $sock_src},
          liveness: {value: $live_val, source: $live_src}
        } }'
  fi

  return "$worst"
}

# ---------------------------------------------------------------------------
# `steward login [session]` — hands the operator to the runtime's OWN
# interactive login flow, in their own tty. Defaults to the estate's hub
# session when no name is given. Steward never touches, parses or stores the
# credential; this verb only decides which flow to start and gets out of the
# way before it runs.
#
# TWO GATES, IN THIS ORDER — the same reasoning the cockpit already applies:
# ownership is the durable truth, reach is a capability.
#   1. OWNERSHIP: the session's OWNER must be this viewer, or login stays
#      with whoever it belongs to.
#   2. HUB-LOCAL: login runs on the machine the session actually lives on,
#      never dialed in from a laptop over ssh.
#
# THE RECIPE LIVES IN THIS CASE STATEMENT AND NOWHERE ELSE. A LOGIN_CMD read
# out of a session conf would be the exact execution path the operator-config
# parser exists to refuse — a file an operator can edit steering which binary
# their own credentials go through. STEWARD_LOGIN_CMD_CLAUDE and
# STEWARD_LOGIN_CMD_OPENCODE are test seams only; production always resolves
# the bare runtime name on PATH.
cmd_login() {
  if [ $# -gt 1 ]; then
    echo "steward: login takes at most one session name" >&2
    return 64
  fi
  local session="${1:-}"
  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  if [ -z "$session" ]; then
    session="$(registry_hub_session)" || return 78
  fi

  # THE REGISTRY'S OWN MESSAGE PASSES THROUGH, UNCAPTURED — stderr is never
  # redirected here. The exit code is house style regardless of what
  # registry_load itself returns for "no such session" (a bare 1): every
  # other caller in this file that wraps a registry-layer failure reports it
  # as 78, and a session name is exactly that layer.
  registry_load "$session" || return 78

  local viewer="${STEWARD_VIEWER:-}"
  [ -n "$viewer" ] || viewer="$(id -un 2>/dev/null)"
  # AN EMPTY VIEWER MATCHES NO ONE. registry_load already guarantees a
  # non-empty, regex-validated OWNER, so empty==empty cannot happen today —
  # but that guarantee lives in another file, and this comparison must not
  # silently reopen if the loader ever relaxes. Same construction as the
  # cockpit's enter_allowed: non-empty first, equality second.
  if [ -z "$viewer" ] || [ "$OWNER" != "$viewer" ]; then
    printf 'steward: %s is owned by %s — login stays with the owner\n' "$session" "$OWNER" >&2
    return 77
  fi

  if ! _resolve_hub_local; then
    local hub; hub="$(registry_hub_host 2>/dev/null)"
    printf 'steward: login runs on the hub (%s) — this machine is not it\n' "${hub:-the hub}" >&2
    return 69
  fi

  # NON-TTY IS AN HONEST REFUSAL, NOT A HANG. Both recipes below are
  # interactive; started with stdin piped or redirected they would either
  # hang waiting for input that never comes, or silently run a partial
  # credential flow with nobody watching it.
  #
  # STEWARD_LOGIN_ASSUME_TTY is a TEST SEAM ONLY, documented here because
  # nowhere else in this file names it: it lets a fixture drive this far
  # without a real terminal. No production path ever sets it.
  if [ -z "${STEWARD_LOGIN_ASSUME_TTY:-}" ] && [ ! -t 0 ]; then
    echo "steward: login is interactive — run it in a terminal" >&2
    return 64
  fi

  local cmd
  local -a args
  case "$RUNTIME" in
    claude-code)
      cmd="${STEWARD_LOGIN_CMD_CLAUDE:-claude}"
      args=(/login)
      ;;
    opencode)
      cmd="${STEWARD_LOGIN_CMD_OPENCODE:-opencode}"
      args=(auth login)
      ;;
    *)
      # BELT AND BRACES. registry_load already refuses any RUNTIME outside
      # claude-code|opencode before this line can run — this case exists so
      # a future closed-vocabulary addition that outpaces this file's own
      # recipes fails by naming itself, rather than falling through with an
      # empty $cmd.
      printf "steward: no login recipe for runtime '%s'\n" "$RUNTIME" >&2
      return 69
      ;;
  esac

  local resolved
  resolved="$(command -v "$cmd" 2>/dev/null)"
  # THE INSTALLER'S OWN SHELF COUNTS. install.sh places the runtime binary
  # in ~/.local/bin, but a non-login shell (sudo, cron, an ssh command)
  # often lacks that on PATH — the first real operator hit exactly this:
  # refused "not found on PATH" while the binary sat where the product
  # itself had put it. A bare name falls back to the shelf before refusing.
  if [ -z "$resolved" ]; then
    case "$cmd" in
      */*) ;;
      *) [ -x "$HOME/.local/bin/$cmd" ] && resolved="$HOME/.local/bin/$cmd" ;;
    esac
  fi
  if [ -z "$resolved" ]; then
    case "$cmd" in
      */*) printf 'steward: login binary not found: %s (looked for it at that exact path)\n' "$cmd" >&2 ;;
      *)   printf 'steward: login binary not found: %s (looked for it on PATH and in ~/.local/bin)\n' "$cmd" >&2 ;;
    esac
    return 69
  fi

  printf "steward: login for '%s' (runtime %s) — running: %s %s\n" "$session" "$RUNTIME" "$cmd" "${args[*]}"
  exec "$resolved" "${args[@]}"
}

# CALLED FIRST IN THE DISPATCHER, BEFORE ANY SUBCOMMAND — every path below
# (add, ls, sessions, the bare cockpit invocation, an <estate> verb) must
# see the same, already-resolved environment, and a broken config must
# refuse before any of them has a chance to run.
_operator_config_load; _cfg_rc=$?

# `doctor` IS THE ONE EXCEPTION TO THE GATE JUST BELOW. Its whole purpose is
# to diagnose a broken operator config, which it cannot do if the dispatcher
# has already exited on that same brokenness — so it runs on $_cfg_rc/
# $_CFG_ERROR/$_CFG_SOURCE_* exactly as _operator_config_load left them,
# reused rather than re-derived, whether or not the load itself succeeded.
if [ "${1:-}" = "doctor" ]; then
  shift
  cmd_doctor "$@"
  exit $?
fi

# `config` IS THE OTHER EXCEPTION, FOR THE SAME REASON. doctor's own
# prescribed remedy for a broken file is `steward config set ...` — it must
# be able to repair a file the loader just refused, so it cannot sit behind
# a gate that exits on that exact refusal first.
if [ "${1:-}" = "config" ]; then
  shift
  cmd_config "$@"
  exit $?
fi

if [ "$_cfg_rc" -ne 0 ]; then
  _cfg_json=""
  for _cfg_a in "$@"; do [ "$_cfg_a" = "--json" ] && _cfg_json=1; done
  if [ -n "$_cfg_json" ]; then
    jq -cn --arg r "$_CFG_ERROR" '{ok:false,reason:$r}'
  else
    printf '%s\n' "$_CFG_ERROR" >&2
  fi
  exit "$_cfg_rc"
fi
# TEST-ONLY SEAM. Prints the three allowlisted values and their provenance,
# then exits — before any subcommand dispatch. Nothing user-facing sets
# this; it exists so operator-config.test.sh can observe
# _CFG_SOURCE_<KEY> from outside the process without a `steward config get`
# verb, which belongs to a later task (config init/set).
if [ -n "${STEWARD_CFG_DEBUG:-}" ]; then
  printf 'STEWARD_ESTATE_ROOT=%s source=%s\n'  "${STEWARD_ESTATE_ROOT:-}"  "$_CFG_SOURCE_STEWARD_ESTATE_ROOT"
  printf 'STEWARD_TMUX_SOCKET=%s source=%s\n'  "${STEWARD_TMUX_SOCKET:-}" "$_CFG_SOURCE_STEWARD_TMUX_SOCKET"
  printf 'STEWARD_LIVENESS_CMD=%s source=%s\n' "${STEWARD_LIVENESS_CMD:-}" "$_CFG_SOURCE_STEWARD_LIVENESS_CMD"
  exit 0
fi

case "${1:-}" in
  add)      shift; cmd_add "$@" ;;
  ls)       shift; cmd_ls "${1:-}" ;;
  init)     shift; cmd_init "$@" ;;
  scaffold) shift; cmd_scaffold "$@" ;;
  assets)   shift; cmd_assets "$@"; exit $? ;;
  sessions) shift; cmd_sessions "$@"; exit $? ;;
  login)    shift; cmd_login "$@"; exit $? ;;
  # NAMESPACED, NOT TOP-LEVEL. `steward team` or `steward client` at the top
  # would collide with the estate-client fallback in the `*)` branch below
  # (`steward <estate> attach|peek|ls`) the moment an operator's own estate
  # happened to be named "team" or "client". `registry` is the one word this
  # dispatcher does not already use for a dispatch route into an estate.
  registry) shift; cmd_registry "$@"; exit $? ;;
  -h|--help) usage 0 ;;
  "")
    # No subcommand at all is the bare invocation — it starts the
    # interactive cockpit (a Rust TUI) rather than falling into --help.
    #
    # BUILT ON FIRST USE, NOT VENDORED — AND HONEST WHEN THERE IS NOTHING TO
    # BUILD. A fresh checkout has no cockpit/target/ at all, and a bare
    # invocation there must not look like the same refusal a genuinely broken
    # build would produce — nothing attempted vs. something failed are
    # different problems and get different messages and exit codes. A
    # DEPLOYED install is a further state again: the script copied into a
    # home carries no cockpit/ source at all, and attempting a build there
    # hands the operator cargo's raw missing-manifest error, which reads like
    # a broken build when the truth is "this install was never given the
    # source". Measured on the real hub the first day an operator typed a
    # bare `steward` outside the checkout. So: an explicit
    # STEWARD_COCKPIT_BIN always wins; a checkout builds on first use; an
    # install with no source refuses and names both ways forward.
    #
    # SOCKET DERIVATION RUNS FOR EVERY PATH BELOW, including
    # STEWARD_COCKPIT_BIN — a stub or a real binary should see the same
    # environment a built-in-place cockpit would.
    _resolve_socket
    if [ -n "${STEWARD_COCKPIT_BIN:-}" ]; then
      [ -x "$STEWARD_COCKPIT_BIN" ] || fel "STEWARD_COCKPIT_BIN is set but not an executable: $STEWARD_COCKPIT_BIN" 69
      exec "$STEWARD_COCKPIT_BIN"
    fi
    _cockpit_bin="$HERE/cockpit/target/release/cockpit"
    if [ ! -x "$_cockpit_bin" ]; then
      if [ ! -f "$HERE/cockpit/Cargo.toml" ]; then
        fel "this install has no cockpit source (looked in $HERE/cockpit) — run bin/steward from a product checkout, or aim STEWARD_COCKPIT_BIN at a built cockpit binary" 69
      fi
      _cargo="${STEWARD_CARGO_BIN:-$HOME/.cargo/bin/cargo}"
      command -v "$_cargo" >/dev/null 2>&1 || _cargo="$(command -v cargo 2>/dev/null || true)"
      if [ -z "$_cargo" ]; then
        fel "the cockpit is not built and no cargo was found to build it with (looked for \$STEWARD_CARGO_BIN, ~/.cargo/bin/cargo, and cargo on PATH) — install Rust, or set STEWARD_CARGO_BIN" 69
      fi
      echo "steward: the cockpit is not built yet — building it now ($_cargo build --release)..." >&2
      "$_cargo" build --release --manifest-path "$HERE/cockpit/Cargo.toml" \
        || fel "the cockpit failed to build — see the cargo output above" 70
    fi
    exec "$_cockpit_bin"
    ;;
  *)
    est="$1"; shift
    case "${1:-}" in
      attach) shift; cmd_attach "$est" "${1:-}" ;;
      peek)   shift; cmd_peek "$est" "${1:-}" ;;
      ls)     cmd_ls "$est" ;;
      *) fel "unknown command '${1:-}' for estate '$est' — see steward --help" 64 ;;
    esac ;;
esac
