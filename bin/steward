#!/bin/bash
# bin/steward — the operator's laptop client (a personal estate list and four
# verbs over plain ssh) PLUS a thin dispatcher onto the local bash engine for
# commands that build an estate rather than reach one. Runs on macOS bash 3.2
# as well as Linux — no arrays of the modern kind, no mapfile. A bare
# invocation (no subcommand) starts the interactive cockpit (a Rust TUI under
# cockpit/), building it with cargo first if this checkout has never built it.
#
# THE LIST IS PERSONAL, AND THAT IS THE DESIGN. Estates do not know about each
# other; only the operator's own machine holds the list, and two operators of
# the same estate each hold their own file under their own word for it. The
# client never becomes a channel between estates — it fans out, one ssh at a
# time, and failures are reported per estate rather than aborting the sweep.
#
#   steward add <estate> <ssh-target> [estate-root] [product-dir]
#   steward ls [<estate>] [--sort name|slug|display|owner|host|lineage]
#   steward <estate> ls [--sort name|slug|display|owner|host|lineage]
#   steward <estate> attach <session>
#   steward <estate> peek <session>
#   steward <estate> login [session]      (lands you at the runtime's /login, in the owner's home)
#   steward init <estate> <ssh-target>
#   steward scaffold <dir> org=<> team=<> owner=<> session=<> [assets=<>] [--json]
#   steward assets <session> [--json]
#   steward sessions [--json] [--sort name|slug|display|owner|host|lineage]
#   steward mcp render <session-id>
#   steward mcp surface <session-id> --json
#   steward doctor
#   steward config init --estate-root /abs [--tmux-socket /abs] [--liveness-cmd /abs] [--usage-cmd /abs]
#   steward config set KEY /abs/value
#   steward login [session]
#   steward job start|cancel|reconcile (start reads SUBMIT_* from the environment)
#   steward job show <id>
#   steward jobs [--json]
#   steward selfupdate
#   steward registry principal add <slug> --name N [--tailscale-login L]... [--oidc-login <issuer>:<sub>]... [--oidc-email E] [--read-all] [--json]
#   steward registry team add <slug> --name "Display Name" [--member p]... [--json]
#   steward registry client add <slug> --managed-by <team-slug> --name "Display Name" [--json]
#   steward registry account add <slug> --principal <p> --host <h> [--username <u>] [--json]
#   steward registry project add <slug> --parent <entity-slug> --name "Display Name" [--json]
#   steward registry session add --account <slug> ( --project <slug> | --entity <slug> ) --slug <slug> --repo /abs/path [--host <host>] [--json]
#   steward registry session check <session> [--json]
#   steward registry session realign <session> [--host <host>] [--json]
#   steward registry migrate-session <old-slug> --account <slug> ( --project <slug> | --entity <slug> ) --slug <slug> [--json]
#   steward invite issue --name N --principal P --entity E --host H [--runtime R] [--provider V] [--days D] [--issued-by P] [--json]
#   steward invite ls [--json]
#   steward invite revoke <inv-id> [--json]
#   steward invite redeem ( <token> | - | --token-file <path> ) --identity <tailscale|oidc>:<value> [--email E] [--json]
#   steward offboard <principal> [--keep-home] [--json]
set -uo pipefail

# THE ROOT IS WHERE THE FILE LIVES, NOT WHERE IT WAS CALLED FROM. Operators
# put a symlink to this script on PATH (~/.local/bin/steward -> the
# checkout), and BASH_SOURCE[0] carries the CALLING path, symlink and all.
# Rooting on that made every "$HERE/lib/..." source and the cockpit crate
# resolve under the symlink's home, where none of it exists — measured on the
# real hub the first day a bare `steward` ran from PATH. Resolve the symlink
# chain first (plain readlink in a loop: bash 3.2 has no readlink -f, and a
# link target may itself be relative to the link's own directory).
_selfpath="${BASH_SOURCE[0]}"
while [ -L "$_selfpath" ]; do
  _selfdir="$(CDPATH= cd -- "$(dirname "$_selfpath")" && pwd)"
  _selfpath="$(readlink "$_selfpath")"
  case "$_selfpath" in /*) ;; *) _selfpath="$_selfdir/$_selfpath" ;; esac
done
HERE="$(CDPATH= cd -- "$(dirname "$_selfpath")/.." && pwd)"
ESTATES_D="${STEWARD_ESTATES_D:-$HOME/.config/steward/estates.d}"
SSH_BIN="${STEWARD_SSH:-ssh}"
REPO_URL="${STEWARD_REPO_URL:-https://github.com/kindell/steward}"

fel() { echo "steward: $1" >&2; exit "${2:-65}"; }

usage() {
  sed -n 's/^#   //p' "${BASH_SOURCE[0]}"
  exit "${1:-64}"
}

# ---------------------------------------------------------------------------
# The operator config — ~/.config/steward/config (or $STEWARD_CONFIG_FILE).
#
# THE FILE IS NEVER SOURCED. A shell `source` on a file an operator can edit
# is an invitation to run whatever gets written there; this reader instead
# does the minimum a config file needs — read a line, split on the first
# `=`, check it against an allowlist, assign by hand through an explicit
# `case`. No `eval`, no `source`, no expansion of a value once read. A key
# outside the allowlist (COCKPIT_ENGINE_CMD, STEWARD_SSH, any other
# STEWARD_*) is refused outright — those are a different authority class,
# run via `bash -c`/argv elsewhere, and the file must never become a way to
# steer them.
#
# PRECEDENCE: the process environment always wins; the file only fills in
# what is unset. Every one of the allowlisted variables gets a
# _CFG_SOURCE_<KEY> of process-environment | config-file | unset, set
# unconditionally so a caller never has to ask "did this even run."
#
# A BROKEN FILE IS A REFUSAL FOR THE WHOLE INVOCATION, never "skip the
# line" — the caller (the dispatcher, just below) exits before any
# subcommand runs. rc 0 covers both "no file" (the normal, unconfigured
# state) and "valid file"; rc 78 is a broken file, with a reason left in
# $_CFG_ERROR naming the file and line.

# THE ALLOWLIST IS ONE LIST, NOT TWO. `_operator_config_load` below and
# `steward config init`/`set` (further down) both decide "is this key
# writable" through this one predicate and this one piece of text — never
# two independently maintained copies that could quietly drift apart.
_CFG_ALLOWED_KEYS_TEXT="STEWARD_ESTATE_ROOT, STEWARD_TMUX_SOCKET, STEWARD_LIVENESS_CMD, STEWARD_USAGE_CMD, STEWARD_CREDENTIAL_CMD"
_CFG_ALLOWED_KEY() { # <key> - true iff key is one of the writable operator-config keys.
  case "$1" in
    STEWARD_ESTATE_ROOT|STEWARD_TMUX_SOCKET|STEWARD_LIVENESS_CMD|STEWARD_USAGE_CMD|STEWARD_CREDENTIAL_CMD) return 0 ;;
    *) return 1 ;;
  esac
}

# _CFG_VALUE_OK <key> <value> — the value-shape contract shared by the
# parser and the writer: no quotes/escapes, no command or variable
# substitution, no CR, no leading/trailing whitespace, absolute path only.
# On failure this sets $_CFG_VALUE_REASON (no file:line prefix — the parser
# and the writer each build their own message around it) and returns 1.
# THE ROUND-TRIP CONTRACT LIVES HERE: anything `config` writes must be
# something this function accepts, and anything it refuses at parse time it
# refuses at write time too — one judgment, not two.
_CFG_VALUE_OK() {
  local key="$1" value="$2"
  case "$value" in
    *\"*|*\'*)
      _CFG_VALUE_REASON="$key: value must not be quoted"; return 1 ;;
  esac
  # BACKTICKS AND ${ ARE THE SAME SHAPE CLASS AS $(. Refusing only one
  # spelling of substitution leaves the invariant depending on every future
  # consumer staying argv-only; all three are refused at the door instead.
  case "$value" in
    *'$('*|*\`*|*'${'*)
      _CFG_VALUE_REASON="$key: value must not contain command or variable substitution"; return 1 ;;
  esac
  # CONTROL BYTES ARE INVISIBLE VALUE BYTES -- not just the CR a
  # Windows-saved file leaves behind, but an embedded NEWLINE (which turns
  # one config-file value into a second, operator-never-named line the
  # parser reads back as its own key -- the STEWARD_TMUX_SOCKET/
  # STEWARD_LIVENESS_CMD smuggle a review found against `config init`/`set`,
  # both of which take this value straight from argv) and a TAB (the
  # --json field separator downstream in doctor). Refusing the whole
  # 0x00-0x1F control range in one glob character class, rather than CR
  # alone, closes all of these at the one value-shape gate the parser and
  # the writer both call -- never two independently maintained checks that
  # could drift.
  case "$value" in
    *[[:cntrl:]]*)
      _CFG_VALUE_REASON="$key: value contains a newline or other control character (was the file saved with Windows line endings, or does the value smuggle a second line?)"; return 1 ;;
  esac
  local _tab; _tab="$(printf '\t')"
  case "$value" in
    " "*|*" "|"$_tab"*|*"$_tab")
      _CFG_VALUE_REASON="$key: value has leading or trailing whitespace"; return 1 ;;
  esac
  case "$value" in
    /*) ;;
    *)
      _CFG_VALUE_REASON="$key must be an absolute path (leading '/'): '$value'"; return 1 ;;
  esac
  return 0
}

_CFG_MODE_OF() { # <path> — best-effort octal mode, BSD or GNU stat.
  # ONLY AN OCTAL ANSWER COUNTS. On GNU/Linux, `stat -f` means FILESYSTEM
  # status — the BSD-first probe "succeeds" (rc 0) with a multi-line
  # filesystem report instead of a mode, so a non-empty check alone lets
  # garbage through and the GNU fallback is never reached. Measured
  # 2026-08-30 on a fresh Ubuntu host: the first `config init` a new
  # operator ran refused a normal 0755 directory with the ext4 report
  # pasted into the refusal. Each answer is accepted only if it looks
  # like a mode; anything else falls through to the next form.
  local p="$1" m
  for m in "$(stat -f '%Lp' "$p" 2>/dev/null)" "$(stat -c '%a' "$p" 2>/dev/null)"; do
    case "$m" in
      [0-7]|[0-7][0-7]|[0-7][0-7][0-7]|[0-7][0-7][0-7][0-7]) printf '%s' "$m"; return 0 ;;
    esac
  done
  return 1
}

_CFG_GROUP_OR_OTHER_WRITABLE() { # <octal mode> — true if group or other carries the write bit.
  local m="$1" len grp oth
  len=${#m}
  [ "$len" -ge 2 ] || return 1
  grp="${m:$((len-2)):1}"
  oth="${m:$((len-1)):1}"
  [ $(( 8#$grp & 2 )) -ne 0 ] && return 0
  [ $(( 8#$oth & 2 )) -ne 0 ] && return 0
  return 1
}

_operator_config_load() {
  _CFG_ERROR=""
  local f="${STEWARD_CONFIG_FILE:-$HOME/.config/steward/config}"

  _CFG_SOURCE_STEWARD_ESTATE_ROOT="unset"
  _CFG_SOURCE_STEWARD_TMUX_SOCKET="unset"
  _CFG_SOURCE_STEWARD_LIVENESS_CMD="unset"
  _CFG_SOURCE_STEWARD_USAGE_CMD="unset"
  _CFG_SOURCE_STEWARD_CREDENTIAL_CMD="unset"
  [ -n "${STEWARD_ESTATE_ROOT:-}" ]  && _CFG_SOURCE_STEWARD_ESTATE_ROOT="process-environment"
  [ -n "${STEWARD_TMUX_SOCKET:-}" ]  && _CFG_SOURCE_STEWARD_TMUX_SOCKET="process-environment"
  [ -n "${STEWARD_LIVENESS_CMD:-}" ] && _CFG_SOURCE_STEWARD_LIVENESS_CMD="process-environment"
  [ -n "${STEWARD_USAGE_CMD:-}" ]    && _CFG_SOURCE_STEWARD_USAGE_CMD="process-environment"
  [ -n "${STEWARD_CREDENTIAL_CMD:-}" ] && _CFG_SOURCE_STEWARD_CREDENTIAL_CMD="process-environment"

  # A SYMLINK IS REFUSED OUTRIGHT, before anything else is asked of it —
  # including the "no file at all" check just below. `-L` does NOT follow
  # the link (unlike `-e`), so this also catches a DANGLING symlink (target
  # does not exist): checked here, ahead of `-e`, a dangling link is the
  # same refusal a live one is, rather than reading as "no file yet" and
  # being certified WARN(ambient-only) with no mention of the symlink at
  # all — the target could otherwise be swapped out from under an
  # owner/mode check that ran a moment earlier, too.
  if [ -L "$f" ]; then
    _CFG_ERROR="steward: operator config is a symlink, refusing: $f"
    return 78
  fi

  # NO FILE AT ALL IS THE NORMAL STATE. Most operators never write one — the
  # environment (a session conf, a supervisor) supplies everything. rc 0.
  [ -e "$f" ] || return 0

  if [ ! -f "$f" ]; then
    _CFG_ERROR="steward: operator config is not a regular file: $f"
    return 78
  fi
  # OWNED BY THE EFFECTIVE USER. Cannot be fixtured without root, so this
  # branch has no dedicated test — but a file another account can write is
  # exactly the injection this whole reader exists to close off.
  if [ ! -O "$f" ]; then
    _CFG_ERROR="steward: operator config is not owned by the current user, refusing: $f"
    return 78
  fi

  local mode
  mode="$(_CFG_MODE_OF "$f")" || { _CFG_ERROR="steward: cannot read the mode of operator config: $f"; return 78; }
  if _CFG_GROUP_OR_OTHER_WRITABLE "$mode"; then
    _CFG_ERROR="steward: operator config is group- or other-writable (mode $mode), refusing: $f"
    return 78
  fi

  local dir dirmode
  dir="$(dirname "$f")"
  dirmode="$(_CFG_MODE_OF "$dir")" || { _CFG_ERROR="steward: cannot read the mode of $dir"; return 78; }
  if _CFG_GROUP_OR_OTHER_WRITABLE "$dirmode"; then
    _CFG_ERROR="steward: the directory holding the operator config is group- or other-writable (mode $dirmode), refusing: $dir"
    return 78
  fi

  local lineno=0 saw_format="" line key value
  local have_root="" have_socket="" have_liveness="" have_usage="" have_credential=""
  while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno+1))

    case "$line" in
      ''|'#'*) continue ;;
    esac

    key=""; value=""
    IFS='=' read -r key value <<EOF
$line
EOF

    if [ -z "$saw_format" ]; then
      if [ "$line" != "FORMAT=1" ]; then
        if [ "$key" = "FORMAT" ]; then
          _CFG_ERROR="steward: $f:$lineno: unknown FORMAT value '$value' (only FORMAT=1 is supported)"
        else
          _CFG_ERROR="steward: $f:$lineno: the file must start with FORMAT=1"
        fi
        return 78
      fi
      saw_format=1
      continue
    fi

    if [ "$key" = "FORMAT" ]; then
      _CFG_ERROR="steward: $f:$lineno: FORMAT may only appear once, as the first line"
      return 78
    fi
    if ! _CFG_ALLOWED_KEY "$key"; then
      _CFG_ERROR="steward: $f:$lineno: unknown key '$key' (allowed: $_CFG_ALLOWED_KEYS_TEXT)"
      return 78
    fi

    if ! _CFG_VALUE_OK "$key" "$value"; then
      _CFG_ERROR="steward: $f:$lineno: $_CFG_VALUE_REASON"
      return 78
    fi

    case "$key" in
      STEWARD_ESTATE_ROOT)
        if [ -n "$have_root" ]; then
          _CFG_ERROR="steward: $f:$lineno: duplicate key 'STEWARD_ESTATE_ROOT'"
          return 78
        fi
        have_root=1
        if [ -z "${STEWARD_ESTATE_ROOT:-}" ]; then
          STEWARD_ESTATE_ROOT="$value"; export STEWARD_ESTATE_ROOT
          _CFG_SOURCE_STEWARD_ESTATE_ROOT="config-file"
        fi
        ;;
      STEWARD_TMUX_SOCKET)
        if [ -n "$have_socket" ]; then
          _CFG_ERROR="steward: $f:$lineno: duplicate key 'STEWARD_TMUX_SOCKET'"
          return 78
        fi
        have_socket=1
        if [ -z "${STEWARD_TMUX_SOCKET:-}" ]; then
          STEWARD_TMUX_SOCKET="$value"; export STEWARD_TMUX_SOCKET
          _CFG_SOURCE_STEWARD_TMUX_SOCKET="config-file"
        fi
        ;;
      STEWARD_LIVENESS_CMD)
        if [ -n "$have_liveness" ]; then
          _CFG_ERROR="steward: $f:$lineno: duplicate key 'STEWARD_LIVENESS_CMD'"
          return 78
        fi
        have_liveness=1
        if [ -z "${STEWARD_LIVENESS_CMD:-}" ]; then
          STEWARD_LIVENESS_CMD="$value"; export STEWARD_LIVENESS_CMD
          _CFG_SOURCE_STEWARD_LIVENESS_CMD="config-file"
        fi
        ;;
      # THE USAGE SEAM IS THE SAME CLASS OF KEY AS THE LIVENESS SEAM: an
      # absolute path to a program the estate supplies. Same duplicate
      # refusal, same "the environment wins" rule, same provenance.
      STEWARD_USAGE_CMD)
        if [ -n "$have_usage" ]; then
          _CFG_ERROR="steward: $f:$lineno: duplicate key 'STEWARD_USAGE_CMD'"
          return 78
        fi
        have_usage=1
        if [ -z "${STEWARD_USAGE_CMD:-}" ]; then
          STEWARD_USAGE_CMD="$value"; export STEWARD_USAGE_CMD
          _CFG_SOURCE_STEWARD_USAGE_CMD="config-file"
        fi
        ;;
      # THE CREDENTIAL SEAM IS THE THIRD KEY OF THE SAME CLASS: an absolute
      # path to a program the estate supplies. Same duplicate refusal, same
      # "the environment wins" rule, same provenance - and no new grammar,
      # because three keys for one idea must not acquire three rules.
      STEWARD_CREDENTIAL_CMD)
        if [ -n "$have_credential" ]; then
          _CFG_ERROR="steward: $f:$lineno: duplicate key 'STEWARD_CREDENTIAL_CMD'"
          return 78
        fi
        have_credential=1
        if [ -z "${STEWARD_CREDENTIAL_CMD:-}" ]; then
          STEWARD_CREDENTIAL_CMD="$value"; export STEWARD_CREDENTIAL_CMD
          _CFG_SOURCE_STEWARD_CREDENTIAL_CMD="config-file"
        fi
        ;;
    esac
  done < "$f"

  if [ -z "$saw_format" ]; then
    _CFG_ERROR="steward: $f: the file must start with FORMAT=1 (file is empty or only comments)"
    return 78
  fi

  return 0
}

# estate_las <name> — source the estate file into SSH/ESTATE_ROOT/PRODUCT_DIR,
# refusing (not guessing) when a field is missing. A list entry that cannot be
# read must not look like a reachable estate.
estate_las() {
  local f="$ESTATES_D/$1.conf"
  [ -f "$f" ] || fel "unknown estate '$1' — nothing at $f (see: steward ls)"
  SSH=""; ESTATE_ROOT=""; PRODUCT_DIR=""
  # shellcheck source=/dev/null
  . "$f" || fel "the estate file could not be read: $f" 78
  [ -n "$SSH" ]         || fel "SSH missing in $f" 78
  [ -n "$ESTATE_ROOT" ] || fel "ESTATE_ROOT missing in $f" 78
  [ -n "$PRODUCT_DIR" ] || fel "PRODUCT_DIR missing in $f" 78
}

# ---------------------------------------------------------------------------
# `steward config init`/`set` — the ONE writing verb over the operator
# config (~/.config/steward/config, see the reader above). Everything else
# in this file only ever reads that file; these two subcommands are the
# whole surface that ever puts bytes into it.
#
# VALUES COME FROM ARGV ONLY. Neither verb ever picks between candidates —
# no fallback, no environment scan, no guessing between two paths that both
# look plausible. An operator names the value; this only ever writes what
# it was told.
#
# ATOMIC BY CONSTRUCTION: every write goes through _cfg_atomic_write, a temp
# file created in the SAME directory as the real one (so the final rename is
# same-filesystem and therefore atomic) and moved into place with `mv`. A
# reader can only ever see the old file or the new one, never a partial
# write, and no temp file survives a failed attempt.

# _cfg_atomic_write <path> <content> — writes content to path atomically.
# Sets $_CFG_WRITE_ERROR and returns non-zero on any failure; the caller
# turns that into a `fel` refusal in the requested exit-code class.
_cfg_atomic_write() {
  local path="$1" content="$2" dir tmp
  dir="$(dirname "$path")"
  if [ -L "$dir" ]; then
    _CFG_WRITE_ERROR="the directory holding the operator config is a symlink, refusing: $dir"
    return 78
  fi
  tmp="$( (umask 077; mktemp "$dir/.config.tmp.XXXXXX" 2>/dev/null) )"
  if [ -z "$tmp" ]; then
    _CFG_WRITE_ERROR="could not create a temporary file in $dir"
    return 70
  fi
  if ! printf '%s' "$content" > "$tmp"; then
    rm -f "$tmp"
    _CFG_WRITE_ERROR="could not write $tmp"
    return 70
  fi
  if ! chmod 0600 "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    _CFG_WRITE_ERROR="could not set mode 0600 on $tmp"
    return 70
  fi
  # RECHECKED RIGHT BEFORE THE RENAME — the window between the caller's own
  # create-only/symlink check and here is exactly where a concurrent
  # writer could have swapped the target for a symlink. `mv` onto a symlink
  # replaces the link itself rather than following it, so this is
  # belt-and-braces rather than load-bearing, but it keeps the invariant
  # honest under a hostile concurrent writer too.
  if [ -L "$path" ]; then
    rm -f "$tmp"
    _CFG_WRITE_ERROR="operator config path is a symlink, refusing: $path"
    return 78
  fi
  if ! mv -f "$tmp" "$path"; then
    rm -f "$tmp"
    _CFG_WRITE_ERROR="could not rename the temp file into place: $path"
    return 70
  fi
  return 0
}

# _cfg_file — the same seam $STEWARD_CONFIG_FILE/$HOME/.config/steward/config
# _operator_config_load reads, named once so init/set can never drift from it.
_cfg_file() { printf '%s\n' "${STEWARD_CONFIG_FILE:-$HOME/.config/steward/config}"; }

# _cfg_lock_acquire <dir> — an mkdir-based lock around the operator config's
# read-modify-write. mkdir is atomic on every filesystem this runs on and
# needs no helper binary; flock is not portable to macOS. A held lock is
# never stolen: a few short retries, then a refusal that names the lock
# path so an operator can tell a genuinely stuck lock from a slow one. On
# success sets $_CFG_LOCK_DIR (what the caller's trap releases); on failure
# sets $_CFG_LOCK_ERROR.
_cfg_lock_acquire() {
  local dir="$1" lock="$dir/.steward-config.lock" tries=0
  while ! mkdir "$lock" 2>/dev/null; do
    tries=$((tries+1))
    if [ "$tries" -ge 10 ]; then
      _CFG_LOCK_ERROR="another 'steward config' command holds the lock, refusing: $lock"
      return 1
    fi
    sleep 0.1
  done
  _CFG_LOCK_DIR="$lock"
  return 0
}

# _cfg_lock_release <lock-dir> — rmdir on a path that was never created (the
# empty-string case, when acquire itself failed) is a silent no-op, so a
# single `trap _cfg_lock_release ... EXIT` covers every return and every
# `fel` exit in the caller without a matching if/else at each one.
_cfg_lock_release() {
  [ -n "${1:-}" ] && rmdir "$1" 2>/dev/null
  return 0
}

# _cfg_refuse_writable_dir <dir> — the SAME parent-dir group/other-writable
# predicate _operator_config_load's reader enforces (_CFG_GROUP_OR_OTHER_
# WRITABLE), run by the writer too, before it creates the lock or touches
# the file. Without this the reader FAILs on a 0775 config directory
# forever, while `config set`'s own remedy text ("run: steward config set
# ...") reports success and never converges — the writer never checked the
# one thing that was actually broken. `fel`s directly (rc 78), naming the
# directory, so callers just call this ahead of the lock.
_cfg_refuse_writable_dir() {
  local dir="$1" dirmode
  dirmode="$(_CFG_MODE_OF "$dir")" || fel "could not read the mode of $dir" 70
  if _CFG_GROUP_OR_OTHER_WRITABLE "$dirmode"; then
    fel "the directory holding the operator config is group- or other-writable (mode $dirmode), refusing: $dir" 78
  fi
}

cmd_config_init() {
  local estate_root="" tmux_socket="" liveness_cmd="" usage_cmd=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --estate-root)
        [ $# -ge 2 ] || fel "config init: --estate-root needs a value" 64
        estate_root="$2"; shift 2 ;;
      --tmux-socket)
        [ $# -ge 2 ] || fel "config init: --tmux-socket needs a value" 64
        tmux_socket="$2"; shift 2 ;;
      --liveness-cmd)
        [ $# -ge 2 ] || fel "config init: --liveness-cmd needs a value" 64
        liveness_cmd="$2"; shift 2 ;;
      --usage-cmd)
        [ $# -ge 2 ] || fel "config init: --usage-cmd needs a value" 64
        usage_cmd="$2"; shift 2 ;;
      *) fel "config init: unknown flag '$1' (allowed: --estate-root, --tmux-socket, --liveness-cmd, --usage-cmd)" 64 ;;
    esac
  done
  [ -n "$estate_root" ] || fel "config init: --estate-root is required" 64

  # VALUE SHAPE IS CHECKED BEFORE ANYTHING TOUCHES THE FILESYSTEM. The lock
  # below needs the config directory to exist, so a bad --estate-root must
  # be caught first — otherwise a doomed `init` would still create an empty
  # directory on its way to refusing.
  _CFG_VALUE_OK STEWARD_ESTATE_ROOT "$estate_root" || fel "config init: $_CFG_VALUE_REASON" 64
  [ -z "$tmux_socket" ]  || { _CFG_VALUE_OK STEWARD_TMUX_SOCKET "$tmux_socket"   || fel "config init: $_CFG_VALUE_REASON" 64; }
  [ -z "$liveness_cmd" ] || { _CFG_VALUE_OK STEWARD_LIVENESS_CMD "$liveness_cmd" || fel "config init: $_CFG_VALUE_REASON" 64; }
  [ -z "$usage_cmd" ]    || { _CFG_VALUE_OK STEWARD_USAGE_CMD "$usage_cmd"       || fel "config init: $_CFG_VALUE_REASON" 64; }

  local f; f="$(_cfg_file)"
  local dir; dir="$(dirname "$f")"

  # A SYMLINK IS REFUSED BEFORE THE PLAIN -e CHECK — the same ordering the
  # reader uses, so a swapped-in symlink can never look like "no file yet"
  # for a moment longer than it has to.
  if [ -L "$f" ]; then
    fel "operator config path is a symlink, refusing: $f" 78
  fi
  if [ -L "$dir" ]; then
    fel "operator config directory is a symlink, refusing: $dir" 78
  fi
  # 0700, ONLY WHEN THIS CALL IS THE ONE CREATING IT. An already-present
  # directory (estates.d lives here too) is left exactly as it is —
  # `mkdir -p` never touches a directory that already exists. The
  # directory must exist before the lock can live in it, so this runs
  # ahead of the lock rather than inside it.
  ( umask 077; mkdir -p "$dir" ) || fel "could not create $dir" 70

  # SAME PREDICATE THE READER ENFORCES, CHECKED BEFORE THE LOCK. A
  # pre-existing 0775 directory (this call's own `mkdir -p` is a no-op on
  # it) must not be allowed to accept a lock or a write it can never pass
  # back through the reader.
  _cfg_refuse_writable_dir "$dir"

  # THE LOCK COVERS THE EXISTS-CHECK AND THE CREATE TOGETHER — a concurrent
  # `init`/`set` racing on the same file is refused, never raced.
  _cfg_lock_acquire "$dir" || fel "config init: $_CFG_LOCK_ERROR" 75
  trap '_cfg_lock_release "$_CFG_LOCK_DIR"' EXIT

  # CREATE-ONLY. Checked here, inside the lock, so a concurrent `init`
  # cannot both see "no file yet" and both write.
  if [ -e "$f" ]; then
    fel "operator config already exists: $f — use 'steward config set KEY VALUE' to change it (config init only ever creates a new file)" 65
  fi

  local content="FORMAT=1
STEWARD_ESTATE_ROOT=$estate_root
"
  [ -z "$tmux_socket" ]  || content="${content}STEWARD_TMUX_SOCKET=$tmux_socket
"
  [ -z "$liveness_cmd" ] || content="${content}STEWARD_LIVENESS_CMD=$liveness_cmd
"
  [ -z "$usage_cmd" ] || content="${content}STEWARD_USAGE_CMD=$usage_cmd
"

  _cfg_atomic_write "$f" "$content" || fel "$_CFG_WRITE_ERROR" 70
  echo "steward: wrote $f"
}

cmd_config_set() {
  local key="${1:-}" value="${2:-}"
  [ -n "$key" ] && [ -n "$value" ] || fel "usage: steward config set KEY /abs/value" 64
  if ! _CFG_ALLOWED_KEY "$key"; then
    fel "config set: unknown key '$key' (allowed: $_CFG_ALLOWED_KEYS_TEXT)" 64
  fi
  _CFG_VALUE_OK "$key" "$value" || fel "config set: $_CFG_VALUE_REASON" 64

  local f; f="$(_cfg_file)"
  if [ -L "$f" ]; then
    fel "operator config path is a symlink, refusing: $f" 78
  fi
  if [ ! -e "$f" ]; then
    fel "operator config does not exist: $f — run 'steward config init --estate-root /abs/estate-root' first" 65
  fi
  if [ ! -f "$f" ]; then
    fel "operator config is not a regular file: $f" 78
  fi

  local dir; dir="$(dirname "$f")"
  # SAME PREDICATE THE READER ENFORCES, CHECKED BEFORE THE LOCK — see
  # _cfg_refuse_writable_dir.
  _cfg_refuse_writable_dir "$dir"
  _cfg_lock_acquire "$dir" || fel "config set: $_CFG_LOCK_ERROR" 75
  trap '_cfg_lock_release "$_CFG_LOCK_DIR"' EXIT

  # REPAIR FOR REAL, NOT JUST THE TOUCHED KEY. The old behavior only ever
  # rewrote the target key's own line(s) and carried every other line
  # through unchanged — including a line the parser would refuse, so a
  # file broken by something `set` never touched stayed broken after `set`
  # claimed success. The contract now: KEEP FORMAT=1 first (always
  # synthesized fresh — a corrupt or missing first line is silently
  # replaced, since it is not a value line and there is nothing meaningful
  # to quote), every comment and blank line, and the first occurrence of
  # every line that passes the SAME predicates the parser itself enforces
  # (_CFG_ALLOWED_KEY + _CFG_VALUE_OK). DROP everything else — an unknown
  # key, a bad value shape, or a later duplicate of an already-kept key —
  # LOUDLY: each dropped line is echoed to stderr, quoted, with its line
  # number, as it is dropped. Nothing is dropped silently. This is what
  # makes doctor's own remedy text ("config set rewrites the file cleanly")
  # true: the file _operator_config_load refused before this call is one
  # this call's own output is guaranteed to pass.
  local body="" line lineno=0 is_first=1 lkey lvalue
  local saw_STEWARD_ESTATE_ROOT="" saw_STEWARD_TMUX_SOCKET="" saw_STEWARD_LIVENESS_CMD="" saw_STEWARD_USAGE_CMD=""
  while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno+1))
    # COMMENTS/BLANKS ARE CHECKED BEFORE "is_first", MATCHING THE PARSER
    # EXACTLY (_operator_config_load's own `case "$line" in ''|'#'*)
    # continue ;; esac` runs before its saw_format check too). Without
    # this ordering, "is_first" was keyed to the physical first line —
    # so a valid file whose first line is a comment had that comment
    # treated as "not FORMAT=1" and dropped, is_first then flipped false,
    # and the REAL FORMAT=1 line on line 2 fell through to the key=value
    # branch below, where FORMAT is not an allowed key — dropping FORMAT=1
    # itself as "unreadable" too. A leading comment/blank is preserved
    # verbatim and never counts as "the first line" for the FORMAT check.
    case "$line" in
      ''|'#'*) body="$body$line
"; continue ;;
    esac
    if [ -n "$is_first" ]; then
      is_first=""
      # The old first (non-comment/blank) line is never carried through
      # as-is — FORMAT=1 is always synthesized below — but a first line
      # that was NOT already exactly "FORMAT=1" is genuinely being
      # dropped, so that gets the same loud treatment as any other
      # refused line.
      [ "$line" = "FORMAT=1" ] || echo "steward: config set: dropping unreadable line $lineno: '$line'" >&2
      continue
    fi
    lkey="${line%%=*}"
    lvalue="${line#*=}"
    if ! _CFG_ALLOWED_KEY "$lkey" || ! _CFG_VALUE_OK "$lkey" "$lvalue"; then
      echo "steward: config set: dropping unreadable line $lineno: '$line'" >&2
      continue
    fi
    case "$lkey" in
      STEWARD_ESTATE_ROOT)
        if [ -n "$saw_STEWARD_ESTATE_ROOT" ]; then
          echo "steward: config set: dropping unreadable line $lineno: '$line'" >&2
          continue
        fi
        saw_STEWARD_ESTATE_ROOT=1 ;;
      STEWARD_TMUX_SOCKET)
        if [ -n "$saw_STEWARD_TMUX_SOCKET" ]; then
          echo "steward: config set: dropping unreadable line $lineno: '$line'" >&2
          continue
        fi
        saw_STEWARD_TMUX_SOCKET=1 ;;
      STEWARD_LIVENESS_CMD)
        if [ -n "$saw_STEWARD_LIVENESS_CMD" ]; then
          echo "steward: config set: dropping unreadable line $lineno: '$line'" >&2
          continue
        fi
        saw_STEWARD_LIVENESS_CMD=1 ;;
      STEWARD_USAGE_CMD)
        if [ -n "$saw_STEWARD_USAGE_CMD" ]; then
          echo "steward: config set: dropping unreadable line $lineno: '$line'" >&2
          continue
        fi
        saw_STEWARD_USAGE_CMD=1 ;;
    esac
    if [ "$lkey" = "$key" ]; then
      body="$body$key=$value
"
    else
      body="$body$line
"
    fi
  done < "$f"
  case "$key" in
    STEWARD_ESTATE_ROOT)  [ -n "$saw_STEWARD_ESTATE_ROOT" ]  || body="$body$key=$value
" ;;
    STEWARD_TMUX_SOCKET)  [ -n "$saw_STEWARD_TMUX_SOCKET" ]  || body="$body$key=$value
" ;;
    STEWARD_LIVENESS_CMD) [ -n "$saw_STEWARD_LIVENESS_CMD" ] || body="$body$key=$value
" ;;
    STEWARD_USAGE_CMD)    [ -n "$saw_STEWARD_USAGE_CMD" ]    || body="$body$key=$value
" ;;
  esac

  _cfg_atomic_write "$f" "FORMAT=1
$body" || fel "$_CFG_WRITE_ERROR" 70
  echo "steward: updated $key in $f"
}

cmd_config() {
  case "${1:-}" in
    init) shift; cmd_config_init "$@" ;;
    set)  shift; cmd_config_set "$@" ;;
    *) fel "usage: steward config init --estate-root /abs [--tmux-socket /abs] [--liveness-cmd /abs] [--usage-cmd /abs] | steward config set KEY /abs/value" 64 ;;
  esac
}

cmd_add() {
  local name="${1:-}" target="${2:-}"
  local root="${3:-\$HOME/estate}" prod="${4:-\$HOME/Projects/steward}"
  [ -n "$name" ] && [ -n "$target" ] || usage
  case "$name" in
    *[!abcdefghijklmnopqrstuvwxyz0123456789-]*|"") fel "estate name: [a-z0-9-] only" 64 ;;
  esac
  [ ! -f "$ESTATES_D/$name.conf" ] || fel "'$name' is already in the list — remove $ESTATES_D/$name.conf deliberately first"
  # ADOPTION READS BEFORE IT WRITES. The remote estate file is the proof that
  # an estate actually lives there; a list entry written on faith would make
  # every later 'ls' failure look like a network problem.
  local remote_root remote_prod
  remote_root="$("$SSH_BIN" "$target" "eval echo $root" 2>/dev/null)" \
    || fel "could not reach $target over ssh" 70
  "$SSH_BIN" "$target" "[ -f \"$remote_root/estate/steward.conf\" ]" 2>/dev/null \
    || fel "no estate at $remote_root on $target (estate/steward.conf missing) — is the root right?"
  remote_prod="$("$SSH_BIN" "$target" "eval echo $prod" 2>/dev/null)" || remote_prod="$prod"
  mkdir -p "$ESTATES_D"
  cat > "$ESTATES_D/$name.conf" <<EOF
# $name — added by steward add $(date -u +%Y-%m-%dT%H:%M:%SZ), after reading the estate back.
SSH="$target"
ESTATE_ROOT="$remote_root"
PRODUCT_DIR="$remote_prod"
EOF
  echo "steward: '$name' added ($target, estate at $remote_root)"
}

# The remote status command, both layouts: a checkout carries linux/, a
# deployed image is flat under the estate root. Found in neither is a refusal
# with the paths named — not a guess, and not a silent empty table.
_status_cmd() { # <extra estate-status args...>
  printf 'for c in "%s/linux/estate-status.sh" "%s/estate-status.sh"; do [ -f "$c" ] && exec env STEWARD_ESTATE_ROOT="%s" bash "$c" %s; done; echo "estate-status.sh found in neither layout (%s/linux/, %s/)" >&2; exit 78' \
    "$PRODUCT_DIR" "$ESTATE_ROOT" "$ESTATE_ROOT" "$*" "$PRODUCT_DIR" "$ESTATE_ROOT"
}

# One estate's block for ls. Never lets a failure escape the block — the sweep
# must survive an unreachable machine and SAY so, per estate.
# THE ESTATE IS A COLUMN, NOT ONLY A HEADING.
#
# Measured 2026-08-24: reading a row in `steward ls` does not tell you what to
# type as ARGUMENT ONE to reach that session. The estate stands in the section
# heading, and the SAME session can appear under two estates — a session on a
# Linux host shows up under the hub's estate and under the host's. The heading
# answers the question only until you have scrolled past it.
#
# THE PREFIX IS FIXED-WIDTH AND GOES ON EVERY ROW. The far side sends a
# `column -t`-aligned table; prefixing rows unevenly would break the alignment
# and make the table harder to read than it was without the column.
#
# ONLY THE TABLE IS PREFIXED. estate-status ends with a blank line and a note
# ("* = yours ..."); prefixing prose with an estate name would read as a row.
# The first blank line is the boundary, which is the format's own structure
# rather than a guess about the text.
_prefix_estate() { # <estate-name>
  awk -v e="$1" '
    BEGIN { intable = 1 }
    /^[[:space:]]*$/ { intable = 0; print; next }
    { if (intable) printf "%-10s %s\n", (NR == 1 ? "ESTATE" : e), $0; else print }
  '
}

_ls_en() { # <estate-name> [extra estate-status args, e.g. --sort <key>]
  local name="$1"; shift
  estate_las "$name"
  echo "== $name ($SSH) =="
  # THE STATUS IS CAPTURED, THEN PREFIXED — not piped.
  #
  # `if ! ssh ... | _prefix_estate` tests the PIPELINE's status, which is awk's.
  # It happens to work because this file sets `pipefail`, and that is exactly the
  # kind of dependency that dies silently: remove the option for any other reason
  # and an unreachable estate renders as a section with no rows and no warning —
  # a dead machine that reads as an empty one. Capturing makes the status the
  # one thing it is about.
  #
  # AND THE TWO STREAMS ARE KEPT APART. `2>&1` here is not the inert kind: the
  # producing process is ssh, which writes to stderr on SUCCESS routinely —
  # "Warning: Permanently added ... to the list of known hosts", banners,
  # "Pseudo-terminal will not be allocated", locale warnings. Merged, every one
  # of those went through the prefixer and rendered as a table row, and a line
  # that arrived first could take the header slot. The comment below reasons
  # carefully about the rc != 0 case and never considered rc == 0 with stderr,
  # which is the same hazard through the same line.
  local _out _err _rc _errf
  _errf="$(mktemp)" || { echo "  could not create a temporary file — skipping $name" >&2; return 1; }
  # EXTRA ARGS (e.g. --sort <key>) TRAVEL STRAIGHT THROUGH to the remote
  # estate-status.sh, unexamined here — this client already validated the
  # --sort key itself, in cmd_ls, before ever reaching ssh (see there for why).
  _out="$("$SSH_BIN" "$SSH" "$(_status_cmd "$@")" 2>"$_errf")"; _rc=$?
  _err="$(cat "$_errf")"; rm -f "$_errf"
  # ONLY A SUCCESSFUL ANSWER IS A TABLE. A failed call returns ssh's error
  # lines, and prefixing those makes an error look like data: the first line
  # gets the ESTATE heading and the rest line up as rows. Measured 2026-08-24
  # against an estate whose key could not be used — "ESTATE  Permission denied,
  # please try again." A reader skims that as a session list.
  if [ "$_rc" -eq 0 ]; then
    # ON SUCCESS, ssh's STDERR IS DIAGNOSIS, NOT DATA. It is forwarded rather
    # than dropped — a host key that was just added is worth seeing — but it
    # goes to this command's own stderr, where it cannot become a row.
    [ -z "$_err" ] || printf '%s\n' "$_err" >&2
    printf '%s\n' "$_out" | _prefix_estate "$name"
  else
    [ -z "$_out" ] || printf '%s\n' "$_out"
    [ -z "$_err" ] || printf '%s\n' "$_err"
    echo "  UNREACHABLE or refused — the rows above (if any) are partial."
  fi
}

cmd_peek() {
  local name="$1" sess="${2:-}"
  [ -n "$sess" ] || usage
  case "$sess" in
    *[!abcdefghijklmnopqrstuvwxyz0123456789-]*) fel "session name: [a-z0-9-] only" 64 ;;
  esac
  estate_las "$name"
  "$SSH_BIN" "$SSH" "$(_status_cmd peek "$sess")"
}

# cmd_ls [<estate>] [--sort name|slug|display|owner|host|lineage] — the personal
# estate list (or one estate of it, over ssh). --sort reaches the SAME table
# `steward <estate> ls` renders, whichever way that estate is named: as
# `steward ls <estate>` here, or as `steward <estate> ls` through the
# estate-client fallback at the bottom of this file — both call this function.
#
# --sort IS VALIDATED HERE, BEFORE SSH EVER RUNS. `_ls_en` shells out to a
# remote host per estate; a bad key discovered only after that round trip
# would either refuse late (slow, and only for the FIRST estate in a sweep) or
# — worse — get folded into `_ls_en`'s own "UNREACHABLE or refused" handling,
# which exists for network failures and does not propagate an exit code. A
# silently-swallowed flag was exactly the bug this fixes; a flag that refuses
# late, or refuses without an rc, would just be a slower version of the same
# defect. Client-side validation costs nothing (no network) and refuses fast.
# `_sessions_sort_field` is reused for the validity CHECK only — cmd_sessions'
# and estate-status.sh's tables are shaped differently, so the FIELD NUMBER it
# returns is meaningless here; only its rc (valid key vs. not) is read. The key
# STRING is what actually crosses the wire — the remote estate-status.sh maps
# it to its own field number, over its own row shape, using the SAME reorder
# (lib/sort.sh's _field_sort_rows) so the two --sort flags can never silently
# mean different things.
#
# ANY OTHER FLAG REFUSES, rc 64 — the silent-swallow class this whole fix
# exists to close. `cmd_ls` accepts exactly one flag (--sort) and at most one
# bare positional (the estate name); today, before this fix, it accepted no
# flags at all.
cmd_ls() {
  local one="" sort_key="" a
  local -a _ls_argv=( "$@" )
  local _ls_i=0 _ls_n=${#_ls_argv[@]}
  while [ "$_ls_i" -lt "$_ls_n" ]; do
    a="${_ls_argv[$_ls_i]}"
    case "$a" in
      --sort)
        _ls_i=$((_ls_i + 1))
        sort_key="${_ls_argv[$_ls_i]:-}"
        _sessions_sort_field "$sort_key" >/dev/null \
          || fel "unknown --sort key '$sort_key' — valid keys: $_SESSIONS_SORT_KEYS" 64
        ;;
      -*) fel "unknown option '$a' for ls" 64 ;;
      *)
        [ -z "$one" ] || fel "unexpected argument '$a' for ls" 64
        one="$a"
        ;;
    esac
    _ls_i=$((_ls_i + 1))
  done

  # A PLAIN CONDITIONAL, NOT AN EMPTY ARRAY. bash 3.2 (this file also runs as
  # macOS's stock /bin/bash) treats `"${arr[@]}"` on a zero-element array as an
  # unbound variable under `set -u` — fixed only in bash 4.4. Two call shapes,
  # chosen once per estate, is the portable way to make "--sort was not given"
  # pass zero extra words through rather than one empty one.
  if [ -n "$one" ]; then
    if [ -n "$sort_key" ]; then _ls_en "$one" --sort "$sort_key"; else _ls_en "$one"; fi
    return
  fi
  [ -d "$ESTATES_D" ] || fel "no estate list yet at $ESTATES_D — start with: steward add <estate> <ssh-target>"
  local any="" f
  for f in "$ESTATES_D"/*.conf; do
    [ -f "$f" ] || continue
    any=1
    # subshell: one estate's refusal must not kill the sweep
    if [ -n "$sort_key" ]; then ( _ls_en "$(basename "$f" .conf)" --sort "$sort_key" )
    else ( _ls_en "$(basename "$f" .conf)" ); fi
  done
  [ -n "$any" ] || fel "the estate list at $ESTATES_D is empty — start with: steward add <estate> <ssh-target>"
}

# The remote attach command. TMUX IS RESOLVED, NOT ASSUMED — the same lesson
# estate-status.sh carries, and attach was written without it. Over ssh the PATH
# is bare (a package-manager prefix is a login-shell luxury) and the estate may
# run its server on a NAMED socket under ~/.tmux. Measured 2026-08-21 against a
# hub: plain `tmux attach` found neither the binary (zsh: command not found:
# tmux) nor, once given the binary, the server (the default socket path was
# missing) although the session was up on the estate's named socket the whole
# time.
#
# TMUX_SOCKET is READ, not sourced: the estate file is configuration, and a
# client that executes a remote conf to learn a filename has made every estate
# in the personal list a way to run code here. The named socket is used only
# when it EXISTS — an estate may name a socket its machinery never created, and
# attaching to a nonexistent server hides a live session behind a connect error.
_attach_cmd() { # <session> [verb]
  # The sed script travels as a %s ARGUMENT, never inside the format: printf
  # reads \1 in a format as an octal escape and the capture group vanishes,
  # which strips the socket to empty and sends attach to the default server —
  # measured here before this reached an ssh line.
  local _sed='s/^TMUX_SOCKET="\{0,1\}\([^"]*\)"\{0,1\}.*/\1/p'
  # THE HANDLE IS RESOLVED ON THE HUB, WHERE THE REGISTRY IS. After the naming
  # model the tmux session is named by the opaque id while people say the SLUG —
  # measured 2026-08-31: attaching by slug answered "can't find session"
  # while the id worked. estate-status.sh carries the one resolver (exact
  # filename, then SLUG, ambiguity refused); we call it rather than grow a
  # fourth copy. If it is missing (an older deployed image) the raw name is used
  # exactly as before, so this can never make attach worse than it was.
  printf 'T=tmux; command -v tmux >/dev/null 2>&1 || { for c in /opt/homebrew/bin/tmux /usr/local/bin/tmux /usr/bin/tmux; do [ -x "$c" ] && { T="$c"; break; }; done; }; R="%s"; N="%s"; [ -x "$R/estate-status.sh" ] && K=$("$R/estate-status.sh" resolve "$N" 2>/dev/null) && [ -n "$K" ] && N="$K"; S=$(sed -n '"'"'%s'"'"' "$R/estate/steward.conf" 2>/dev/null | tail -1); if [ -n "$S" ] && [ -S "$HOME/.tmux/$S" ]; then exec "$T" -S "$HOME/.tmux/$S" %s -t "=$N"; else exec "$T" %s -t "=$N"; fi' \
    "$ESTATE_ROOT" "$1" "$_sed" "${2:-attach}" "${2:-attach}"
}

cmd_attach() {
  local name="$1" sess="${2:-}"
  [ -n "$sess" ] || usage
  # THE SEAT FIRST. The tmux server runs in the OWNER's home under the
  # owner's socket; the card's ssh target is one home on the machine, not
  # necessarily that one — measured 2026-09-05 when the hub session moved
  # into the machine steward's account and attach answered "can't find
  # session" one home over. _seat_resolve validates the name and refuses
  # unknown handles with the estate's own words.
  _seat_resolve "$name" "$sess"
  # =name: tmux -t prefix-matches, and attaching to the wrong session because
  # its name extends yours is exactly the trap measured 2026-08-21.
  ESTATE_ROOT="$SEAT_ROOT"
  exec "$SSH_BIN" -t "$SEAT_TARGET" "$(_attach_cmd "$SEAT_KEY")"
}

# `steward <estate> login [session]` — the laptop-side login. Two hops:
#
#   1. READ-ONLY, to the estate's own ssh target: "where does this session
#      sit?" — the row's key, OWNER, HOST, and the answering account's HOME.
#   2. INTERACTIVE, as the OWNER on the HOST: the hub-side `steward login`,
#      which refuses unless it is that owner on that machine — so hop 2 goes
#      exactly where hop 1 said, or it goes nowhere.
#
# WHY TWO HOPS AND NOT ONE. A session's home is not the estate's ssh account:
# the machine steward is the owner's SECOND account, a colleague's session is
# a colleague's home, and homes are 750. Hopping from the estate account into
# the owner's home would need every estate account to hold a key into every
# home on the machine — the exact key sprawl the federation exists to end.
# The person's own laptop key already opens the homes they may enter; the
# product only has to say which one.
#
# THE SECOND HOP IS THE ANSWER TO "how do I even get to /login?", measured
# 2026-09-05: without it the instruction was a hand-dictated ssh + tmux -S
# <socket> attach line, and the product had every fact needed to print it.
_seat_cmd() { # <handle-or-empty> -> the remote read-only line
  # THE HUB SESSION IS THE DEFAULT, read off the estate remotely — the same
  # rule the hub-side verb applies when it gets no name.
  printf 'R="%s"; P="%s"; N="%s"; [ -n "$N" ] || N=$(sed -n '"'"'s/^HUB_SESSION="\([a-z0-9-]*\)"$/\\1/p'"'"' "$R/estate/steward.conf" | tail -1); for c in "$P/linux/estate-status.sh" "$R/estate-status.sh"; do [ -f "$c" ] || continue; K=$(STEWARD_ESTATE_ROOT="$R" bash "$c" resolve "$N") || exit $?; F="$R/sessions.d/$K.conf"; printf '"'"'%%s\\n%%s\\n%%s\\n%%s\\n'"'"' "$K" "$(sed -n '"'"'s/^OWNER="\([^"]*\)"$/\\1/p'"'"' "$F" | head -1)" "$(sed -n '"'"'s/^HOST="\([^"]*\)"$/\\1/p'"'"' "$F" | head -1)" "$HOME"; exit 0; done; echo "estate-status.sh found in neither layout (%s/linux/, %s/)" >&2; exit 78' \
    "$ESTATE_ROOT" "$PRODUCT_DIR" "$1" "$PRODUCT_DIR" "$ESTATE_ROOT"
}

# _seat_resolve <estate> <handle-or-empty> — hop 1. Fills SEAT_KEY,
# SEAT_OWNER, SEAT_HOST, SEAT_TARGET (the ssh target for hop 2) and SEAT_ROOT
# (the estate root as seen from the owner's home). Refuses with the estate's
# own rc and words when the handle is unknown.
_seat_resolve() { # <estate> <handle-or-empty>
  local name="$1" sess="${2:-}"
  case "$sess" in
    *[!abcdefghijklmnopqrstuvwxyz0123456789-]*) fel "session name: [a-z0-9-] only" 64 ;;
  esac
  estate_las "$name"

  local seat rc
  seat="$("$SSH_BIN" "$SSH" "$(_seat_cmd "$sess")")"; rc=$?
  [ "$rc" -eq 0 ] || fel "could not place '${sess:-the hub session}' in estate '$name' — see the message above" "$rc"

  # THE ANSWER IS INPUT INTO AN SSH TARGET AND A REMOTE LINE, so every field
  # is validated to its own shape before either is built. A row that sneaks
  # a shell metacharacter into OWNER would otherwise become a command.
  local home
  SEAT_KEY="$(printf '%s\n' "$seat" | sed -n 1p)"
  SEAT_OWNER="$(printf '%s\n' "$seat" | sed -n 2p)"
  SEAT_HOST="$(printf '%s\n' "$seat" | sed -n 3p)"
  home="$(printf '%s\n' "$seat" | sed -n 4p)"
  case "$SEAT_KEY"   in ''|*[!abcdefghijklmnopqrstuvwxyz0123456789-]*)  fel "could not read the estate's answer for '$sess' (key '$SEAT_KEY')" 78 ;; esac
  case "$SEAT_OWNER" in ''|*[!abcdefghijklmnopqrstuvwxyz0123456789_-]*) fel "could not read the estate's answer for '$sess' (owner '$SEAT_OWNER')" 78 ;; esac
  case "$SEAT_HOST"  in ''|*[!abcdefghijklmnopqrstuvwxyz0123456789.-]*) fel "could not read the estate's answer for '$sess' (host '$SEAT_HOST')" 78 ;; esac
  case "$home"       in /*) ;; *) fel "could not read the estate's answer for '$sess' (home '$home')" 78 ;; esac

  # THE CARD'S OWN TARGET WINS WHEN IT IS THE SAME ACCOUNT — it may be an ssh
  # alias, a tailnet name, a port; owner@HOST is the derived form for every
  # OTHER account, whose door the card knows nothing about.
  SEAT_TARGET="$SEAT_OWNER@$SEAT_HOST"
  case "$SSH" in "$SEAT_OWNER@"*) SEAT_TARGET="$SSH" ;; esac

  # THE ESTATE ROOT IN THE OWNER'S HOME. A root under the answering HOME is
  # the deployed image, present in every home the estate deploys to — so it
  # is the same path relative to $HOME there. A root elsewhere is shared and
  # goes through as it is.
  case "$ESTATE_ROOT" in
    "$home"/*) SEAT_ROOT='$HOME/'"${ESTATE_ROOT#"$home"/}" ;;
    *)         SEAT_ROOT="$ESTATE_ROOT" ;;
  esac
}

cmd_estate_login() { # <estate> [session]
  local sess="${2:-}"
  _seat_resolve "$1" "$sess"
  echo "steward: ${sess:-$SEAT_KEY} sits in $SEAT_OWNER's home on $SEAT_HOST — taking you there for the login"
  # THE SHELF, THEN THE CHECKOUT: install.sh links ~/.local/bin/steward, and a
  # home the estate deployed to by hand has only the checkout. Not on PATH —
  # a non-login ssh command rarely has ~/.local/bin on it.
  exec "$SSH_BIN" -t "$SEAT_TARGET" \
    'S="$HOME/.local/bin/steward"; [ -x "$S" ] || S="$HOME/Projects/steward/bin/steward"; [ -x "$S" ] || { echo "steward: no steward binary in this home (looked in ~/.local/bin and ~/Projects/steward/bin)" >&2; exit 69; }; exec env STEWARD_ESTATE_ROOT="'"$SEAT_ROOT"'" "$S" login '"$SEAT_KEY"
}

cmd_init() {
  local name="${1:-}" target="${2:-}"
  [ -n "$name" ] && [ -n "$target" ] || usage
  [ ! -f "$ESTATES_D/$name.conf" ] || fel "'$name' is already in the list — init creates, add adopts"
  echo "steward: bootstrapping on $target — the run stops at the agent login, which is yours."
  "$SSH_BIN" -t "$target" "/bin/bash -c \"\$(curl -fsSL $REPO_URL/raw/main/install.sh)\"" \
    || fel "the bootstrap did not finish on $target — nothing added locally" 70
  cmd_add "$name" "$target"
}

# emit a one-line JSON object from key=value pairs; values are strings, bools
# are the literals true/false. Uses jq so quoting is correct for any value
# (spaces, embedded quotes — a refusal reason is free text).
_json() { # <k> <v> [<k> <v> ...]  — bools are the literals true/false
  local args=() k v
  while [ "$#" -ge 2 ]; do
    k="$1"; v="$2"; shift 2
    case "$v" in true|false) args+=(--argjson "$k" "$v") ;; *) args+=(--arg "$k" "$v") ;; esac
  done
  jq -cn "${args[@]}" '$ARGS.named'
}

# _json_secret <secret-key> <secret-value> <k> <v> [...] - _json's object, plus
# ONE value that must never appear in a process's command line.
#
# ARGV IS NOT A PRIVATE CHANNEL. Every `--arg k v` pair _json builds becomes a
# word in jq's argv, and on the multi-user hosts this product exists for any
# local account can read another process's argv (/proc/<pid>/cmdline is
# world-readable, and `ps` prints it). A one-time invitation link handed to jq
# that way is a credential published to everybody on the machine for as long as
# the process lives - and a redemption by the wrong reader is indistinguishable
# from the right one, because the digest still matches.
#
# The environment is the narrow channel next door: /proc/<pid>/environ is
# readable only by the owner, and the assignment below applies to THIS jq alone,
# never to the shell that runs it. Every non-secret value keeps _json's --arg
# path, so only the value that needs the narrow door goes through it.
_json_secret() {
  local skey="$1" sval="$2"; shift 2
  local args=() k v
  while [ "$#" -ge 2 ]; do
    k="$1"; v="$2"; shift 2
    case "$v" in true|false) args+=(--argjson "$k" "$v") ;; *) args+=(--arg "$k" "$v") ;; esac
  done
  args+=(--arg _secret_key "$skey")
  _STEWARD_JSON_SECRET="$sval" jq -cn "${args[@]}" \
    '($ARGS.named | del(._secret_key)) + {($ARGS.named._secret_key): $ENV._STEWARD_JSON_SECRET}'
}

# `steward scaffold <dir> org=... team=... owner=... session=... [assets=...] [--json]`
# runs the local scaffold engine (lib/scaffold.sh) — no ssh, no remote estate;
# this is the command that BUILDS an estate, as opposed to the verbs above
# that operate on one already reachable over ssh. --json makes the report
# structured (estate, team, session, assets, loadable) so a future front end
# can consume it instead of scraping stderr prose. A refusal is JSON too, with
# ok=false and a reason — never a bare non-zero the caller has to interpret.
cmd_scaffold() {
  local want_json="" eng_args=() a
  for a in "$@"; do
    case "$a" in --json) want_json=1 ;; *) eng_args+=("$a") ;; esac
  done
  # shellcheck source=lib/scaffold.sh
  . "$HERE/lib/scaffold.sh"
  local err rc
  err="$(estate_scaffold "${eng_args[@]}" 2>&1 >/dev/null)"; rc=$?
  # recover the parsed values for the report by re-reading the same args —
  # the engine does not hand them back, and re-parsing is cheaper than
  # threading a second return channel through it.
  local dir="" org="" team="" owner="" session="" assets=""
  dir="${eng_args[0]:-}"
  for a in "${eng_args[@]:1}"; do case "$a" in
    org=*) org="${a#org=}";; team=*) team="${a#team=}";; owner=*) owner="${a#owner=}";;
    session=*) session="${a#session=}";; assets=*) assets="${a#assets=}";; esac
  done
  if [ -n "$want_json" ]; then
    if [ "$rc" -eq 0 ]; then
      local loadable=false
      ( export STEWARD_ESTATE_ROOT="$dir"; . "$HERE/lib/registry.sh"; registry_estate_name >/dev/null 2>&1 ) \
        && loadable=true
      _json ok true estate "$org" team "$team" owner "$owner" session "$session" \
            assets "$assets" loadable "$loadable"
    else
      _json ok false reason "$err"
    fi
  else
    [ "$rc" -ne 0 ] && printf '%s\n' "$err" >&2
  fi
  return "$rc"
}

# ── `steward registry team|client add` — THE TWO ORG VERBS ────────────────
#
# CREATE-ONLY, DELIBERATELY. Changing a team's membership or a client's
# manager is a different verb (`member add/remove`, a later scope) with a
# different safety story (an existing row, not a fresh one) — folding that
# into `add` would make one verb answer two questions.
#
# Both write entities.d/<slug>.conf through the ONE shared serializer and the
# ONE shared writer transaction in lib/registry.sh (_registry_emit_kv,
# registry_entity_write) — see that file for the injection story and the
# writer's eight-step sequence. Nothing here builds a KV line, a lock, or a
# staged file by hand.

# _reg_fail <want_json> <message> — prints the refusal in the requested
# shape (json {ok:false,reason:...} or a plain stderr line), the same
# json-or-stderr shape cmd_assets already repeats inline at each of its own
# refusals, pulled out once here so the two org verbs share it instead of
# copying it a second time. Does NOT return an exit code — every call site
# still does its own `return N` right after, so the rc lives at the call
# site next to the condition that produced it, not buried in this helper.
_reg_fail() {
  local wj="$1" msg="$2"
  if [ -n "$wj" ]; then jq -cn --arg r "$msg" '{ok:false,reason:$r}'
  else printf '%s\n' "$msg" >&2; fi
}

# _registry_validate_team_stage <staged-file> — the validate_fn
# registry_entity_write calls before publishing a team row. Re-reads the
# STAGED file (not the eventual final name) and confirms NAME and MEMBERS
# equal what cmd_registry_team_add meant to write, byte for byte — a defence
# against a bug in the serializer or the writer producing a row that quotes
# or truncates something differently than intended, never a defence against
# injection (the serializer already closed that before this file was ever
# written to disk). Reads its expectation from _REGW_EXPECT_NAME/_MEMBERS,
# set by the caller immediately before it calls registry_entity_write —
# bash has no closures, so a plain global is how this function learns what
# "correct" means for THIS call.
_registry_validate_team_stage() {
  local file="$1" NAME="" MEMBERS=""
  # shellcheck source=/dev/null
  source "$file" || { echo "registry: staged team file did not source: $file" >&2; return 70; }
  if [ "$NAME" != "$_REGW_EXPECT_NAME" ]; then
    echo "registry: staged team file's NAME does not match what was written: $file" >&2
    return 70
  fi
  if [ "$MEMBERS" != "$_REGW_EXPECT_MEMBERS" ]; then
    echo "registry: staged team file's MEMBERS does not match what was written: $file" >&2
    return 70
  fi
  return 0
}

# _registry_validate_client_stage <staged-file> — same shape as the team
# validator above, for the client row's NAME and MANAGED_BY.
_registry_validate_client_stage() {
  local file="$1" NAME="" MANAGED_BY=""
  # shellcheck source=/dev/null
  source "$file" || { echo "registry: staged client file did not source: $file" >&2; return 70; }
  if [ "$NAME" != "$_REGW_EXPECT_NAME" ]; then
    echo "registry: staged client file's NAME does not match what was written: $file" >&2
    return 70
  fi
  if [ "$MANAGED_BY" != "$_REGW_EXPECT_MANAGED_BY" ]; then
    echo "registry: staged client file's MANAGED_BY does not match what was written: $file" >&2
    return 70
  fi
  return 0
}

# _registry_validate_account_stage <staged-file> — same shape as the team
# and client validators above, for the account row's PRINCIPAL, HOST and
# USERNAME.
_registry_validate_account_stage() {
  local file="$1" PRINCIPAL="" HOST="" USERNAME=""
  # shellcheck source=/dev/null
  source "$file" || { echo "registry: staged account file did not source: $file" >&2; return 70; }
  if [ "$PRINCIPAL" != "$_REGW_EXPECT_PRINCIPAL" ]; then
    echo "registry: staged account file's PRINCIPAL does not match what was written: $file" >&2
    return 70
  fi
  if [ "$HOST" != "$_REGW_EXPECT_HOST" ]; then
    echo "registry: staged account file's HOST does not match what was written: $file" >&2
    return 70
  fi
  if [ "$USERNAME" != "$_REGW_EXPECT_USERNAME" ]; then
    echo "registry: staged account file's USERNAME does not match what was written: $file" >&2
    return 70
  fi
  return 0
}

# _principal_validate_row <staged-file> — the validate_fn registry_principal_write
# calls before publishing a principal row. Same shape as the team/client/
# account validators above: re-reads the STAGED file and confirms NAME,
# TAILSCALE_LOGIN, OIDC_LOGIN, OIDC_EMAIL and DESK_READ_ALL equal what
# cmd_registry_principal_add meant to write, byte for byte.
#
# THEN ASKS THE REGISTER-WIDE QUESTION, UNDER THE LOCK, PER WORD — same shape
# as _registry_validate_session_stage's (ACCOUNT,SLUG) recheck above.
# TAILSCALE_LOGIN and OIDC_LOGIN are both lists; uniqueness holds per word and
# per SOURCE, not per row, so every
# word of the staged row's list is checked against the register in turn — a
# row may not carry an identity that any OTHER row carries, in any position.
# The verb's own pre-check (registry_principal_for_identity, called before any
# lock is taken) is a FAST PATH ONLY: two concurrent `principal add` calls for
# the SAME NEW identity can both pass it before either has staged anything. This is
# the GUARANTEE — it runs after registry_row_write has taken
# principals.d/.write.lock, so a concurrent winner's row (if any) is
# guaranteed to already be on disk by the time this runs: the winner cannot
# release the lock until AFTER its own publish completes (registry_row_write
# steps 6-8). The staged file's name is `.stage.XXXXXX`, never `<slug>.conf`,
# so registry_principal_for_identity's *.conf scan never matches the row being
# written — any hit it finds here is necessarily some OTHER principal.
#
# THE RC A REFUSAL REPORTS HERE IS 70, NOT 65 — registry_row_write hardcodes
# 70 for every validate_fn failure (its own step 4), the same as every other
# validator in this file (the session-add verb's under-lock refusal is left
# at 70 too). 65 means "refused before the lock" (the verb's pre-check);
# 70 means "refused under it" (here). No remapping between the two.
_principal_validate_row() {
  # EVERY FIELD THE ROW CAN CARRY IS DECLARED local BEFORE THE source. A field
  # left out of this list would be published into the CALLER's shell by the
  # first row that carries it - the two OIDC fields are here for exactly that
  # reason, not for symmetry.
  local file="$1" NAME="" TAILSCALE_LOGIN="" DESK_READ_ALL="" OIDC_LOGIN="" OIDC_EMAIL=""
  # shellcheck source=/dev/null
  source "$file" || { echo "registry: staged principal file did not source: $file" >&2; return 70; }
  if [ "$NAME" != "${_REGW_EXPECT_NAME:-}" ]; then
    echo "registry: staged principal file's NAME does not match what was written: $file" >&2
    return 70
  fi
  if [ "$TAILSCALE_LOGIN" != "${_REGW_EXPECT_TAILSCALE_LOGIN:-}" ]; then
    echo "registry: staged principal file's TAILSCALE_LOGIN does not match what was written: $file" >&2
    return 70
  fi
  if [ "$OIDC_LOGIN" != "${_REGW_EXPECT_OIDC_LOGIN:-}" ]; then
    echo "registry: staged principal file's OIDC_LOGIN does not match what was written: $file" >&2
    return 70
  fi
  if [ "$OIDC_EMAIL" != "${_REGW_EXPECT_OIDC_EMAIL:-}" ]; then
    echo "registry: staged principal file's OIDC_EMAIL does not match what was written: $file" >&2
    return 70
  fi
  if [ "$DESK_READ_ALL" != "${_REGW_EXPECT_DESK_READ_ALL:-}" ]; then
    echo "registry: staged principal file's DESK_READ_ALL does not match what was written: $file" >&2
    return 70
  fi
  # THE REGISTER-WIDE QUESTION, ASKED UNDER THE LOCK, PER WORD, PER SOURCE.
  # Both lists are lists, and uniqueness holds per word in either of them.
  local w other rc2 src
  for src in tailscale oidc; do
    case "$src" in
      tailscale) _registry_words "$TAILSCALE_LOGIN" ;;
      *)         _registry_words "$OIDC_LOGIN" ;;
    esac
    for w in "${REGISTRY_WORDS[@]+"${REGISTRY_WORDS[@]}"}"; do
      other="$(registry_principal_for_identity "$src" "$w" 2>/dev/null)"; rc2=$?
      case "$rc2" in
        0)
          echo "registry: the identity '$w' already belongs to principal '$other' - one identity, one human - refusing" >&2
          return 70
          ;;
        65)
          echo "registry: the identity '$w' already maps to more than one principal - refusing to add a third - one identity, one human" >&2
          return 70
          ;;
      esac
    done
  done
  return 0
}

# _registry_validate_login_stage <staged-file> — the ONLY stage validator in
# this file that does NOT source what it validates.
#
# Its four neighbours source the staged row, which is safe for them: a row they
# just serialised themselves, in a register whose readers source too. This
# register's readers do NOT source, and a validator that did would be the one
# place in the chain where a login row gets executed — the single exception
# defeating the rule. It reads through registry_login_load, the same parser
# every consumer uses.
_registry_validate_login_stage() {
  local file="$1" dir base
  # registry_login_load takes a SLUG in its own register; the stage is a
  # temporary name in that same directory, so it is loaded by its basename.
  base="$(basename "$file")"; base="${base%.conf}"
  # The stage's name is .stage.XXXXXX — not a slug. Read it through a
  # one-shot register whose only member is a copy of the stage, so the parser
  # is exercised on the exact bytes that will be published.
  dir="$(mktemp -d)" || { echo "registry: cannot stage-validate a login row" >&2; return 70; }
  cp "$file" "$dir/stage.conf" || { rm -rf "$dir"; return 70; }
  chmod 600 "$dir/stage.conf"
  local rc=0
  ( STEWARD_LOGINS_DIR="$dir"; registry_login_load stage >/dev/null 2>&1 ) || rc=70
  if [ "$rc" -ne 0 ]; then
    rm -rf "$dir"
    echo "registry: the staged login row does not parse with the register's own reader: $file" >&2
    return 70
  fi
  # THE FIELD NAME IS RESOLVED THROUGH INDIRECT EXPANSION (${!varname}), NOT A
  # `case` STATEMENT WRITTEN INLINE INSIDE $( ). The obvious form — a `case`
  # as the first command inside a command substitution — is mis-parsed by the
  # bash 3.2 shipped on macOS (measured: it reads past `esac` as literal text
  # instead of executing the branches), and this library runs on that shell.
  # The `case` below still runs, but as an ordinary top-level statement, which
  # bash 3.2 parses correctly; only the NAME LOOKUP crosses into the
  # substitution, as one indirect expansion.
  local got varname k
  for k in PRINCIPAL ACCOUNT PROVIDER CONFIG_DIR LEGAL_OWNER; do
    case "$k" in
      CONFIG_DIR) varname="LOGIN_CONFIG_DIR_RAW" ;;
      *)          varname="LOGIN_$k" ;;
    esac
    got="$( STEWARD_LOGINS_DIR="$dir"; registry_login_load stage >/dev/null 2>&1; printf '%s' "${!varname}" )"
    eval "local want=\"\$_REGW_EXPECT_$k\""
    if [ "$got" != "$want" ]; then
      rm -rf "$dir"
      echo "registry: staged login row's $k does not match what was written: $file" >&2
      return 70
    fi
  done
  rm -rf "$dir"

  # THE REGISTER-WIDE QUESTION, ASKED UNDER THE LOCK. registry_row_write calls
  # this validator while it still holds the register's write lock, so this is the
  # ONE moment where the register PLUS the pending row can be judged together and
  # a refusal costs nothing: the stage is discarded and nothing was published.
  #
  # THE PENDING ROW IS JUDGED AS THE SLUG IT WILL BECOME, not as the stage's
  # mktemp name — a collision is a question about (PRINCIPAL, relative dir), and
  # the answer must not depend on what mktemp happened to call the file.
  local probe existing real
  probe="$(mktemp -d)" || return 70
  real="$(registry_login_dir)"
  if [ -d "$real" ]; then
    for existing in "$real"/*.conf; do
      [ -e "$existing" ] || continue
      cp "$existing" "$probe/" 2>/dev/null || true
    done
  fi
  cp "$file" "$probe/$_REGW_EXPECT_SLUG.conf" || { rm -rf "$probe"; return 70; }
  chmod 600 "$probe"/*.conf 2>/dev/null
  if ! ( STEWARD_LOGINS_DIR="$probe"; registry_login_check ) >/dev/null 2>&1; then
    ( STEWARD_LOGINS_DIR="$probe"; registry_login_check ) 2>&1 >/dev/null | sed 's/^/  /' >&2
    echo "registry: the register would NOT be sound with this row — refusing to publish it." >&2
    rm -rf "$probe"
    return 70
  fi
  rm -rf "$probe"
  return 0
}

# _registry_validate_session_stage <staged-file> — same shape as the team,
# client, account and project validators around it, for the session row's
# full field set: the minted ID, the identity pair (ACCOUNT, SLUG), the
# typed-union target, HOST, REPO_PATH, the OWNER bridge and the permission
# mode. Every field is compared — a row where any of them drifted from what
# the verb meant to write must never publish.
_registry_validate_session_stage() {
  local file="$1" ID="" ACCOUNT="" SLUG="" TARGET_ENTITY="" TARGET_PROJECT="" \
        HOST="" REPO_PATH="" OWNER="" PERMISSION_MODE="" LOGIN=""
  # shellcheck source=/dev/null
  source "$file" || { echo "registry: staged session file did not source: $file" >&2; return 70; }
  local k v
  for k in ID ACCOUNT SLUG TARGET_ENTITY TARGET_PROJECT HOST REPO_PATH OWNER PERMISSION_MODE LOGIN; do
    eval "v=\"\$_REGW_EXPECT_$k\""
    if [ "${!k}" != "$v" ]; then
      echo "registry: staged session file's $k does not match what was written: $file" >&2
      return 70
    fi
  done
  # THE (ACCOUNT, SLUG) GATE MUST BE ATOMIC, AND THIS IS WHERE. cmd's pre-check
  # is only advisory: it scans sessions.d BEFORE any lock, so two concurrent
  # adds of the same pair both pass it and both write (each under a DIFFERENT
  # opaque-id filename, so the writer's no-clobber never fires) — the
  # uniqueness the model swears is broken. This validate_fn runs INSIDE
  # registry_row_write's sessions.d lock, before publish, so re-checking here
  # makes scan+write one critical section: a concurrent winner has already
  # published its row by the time the loser reaches this line, and the scan
  # sees it. Exactly one wins; the loser refuses. (The staged file is a
  # .stage.* name, so the *.conf scan never matches the row being written.)
  if ! registry_account_slug_available "$ACCOUNT" "$SLUG"; then
    echo "registry: slug '$SLUG' was taken in account '$ACCOUNT' by a concurrent write — refusing" >&2
    return 70
  fi
  return 0
}

# _registry_validate_project_stage <staged-file> — same shape as the team,
# client and account validators above, for the project row's NAME and
# PARENT.
_registry_validate_project_stage() {
  local file="$1" NAME="" PARENT=""
  # shellcheck source=/dev/null
  source "$file" || { echo "registry: staged project file did not source: $file" >&2; return 70; }
  if [ "$NAME" != "$_REGW_EXPECT_NAME" ]; then
    echo "registry: staged project file's NAME does not match what was written: $file" >&2
    return 70
  fi
  if [ "$PARENT" != "$_REGW_EXPECT_PARENT" ]; then
    echo "registry: staged project file's PARENT does not match what was written: $file" >&2
    return 70
  fi
  return 0
}

# cmd_registry — the `registry` noun's own tiny dispatcher: team|client,
# account, login, project, session — add (login also has ls). A later scope
# adds non-`add` verbs; this refuses anything else by name rather than
# falling through to the estate-client fallback the top-level dispatcher owns.
cmd_registry() {
  case "${1:-}" in
    team)
      shift
      case "${1:-}" in
        add) shift; cmd_registry_team_add "$@" ;;
        *) fel "steward registry team: unknown verb '${1:-}' (allowed: add)" 64 ;;
      esac ;;
    client)
      shift
      case "${1:-}" in
        add) shift; cmd_registry_client_add "$@" ;;
        *) fel "steward registry client: unknown verb '${1:-}' (allowed: add)" 64 ;;
      esac ;;
    account)
      shift
      case "${1:-}" in
        add) shift; cmd_registry_account_add "$@" ;;
        *) fel "steward registry account: unknown verb '${1:-}' (allowed: add)" 64 ;;
      esac ;;
    login)
      shift
      case "${1:-}" in
        add) shift; cmd_registry_login_add "$@" ;;
        ls)  shift; cmd_registry_login_ls "$@" ;;
        shell) shift; cmd_registry_login_shell "$@" ;;
        *)   _reg_fail "" "steward registry login: add|ls|shell" 64; return 64 ;;
      esac ;;
    principal)
      shift
      case "${1:-}" in
        add) shift; cmd_registry_principal_add "$@" ;;
        *) fel "steward registry principal: unknown verb '${1:-}' (allowed: add)" 64 ;;
      esac ;;
    project)
      shift
      case "${1:-}" in
        add) shift; cmd_registry_project_add "$@" ;;
        *) fel "steward registry project: unknown verb '${1:-}' (allowed: add)" 64 ;;
      esac ;;
    session)
      shift
      case "${1:-}" in
        add) shift; cmd_registry_session_add "$@" ;;
        check) shift; cmd_registry_session_check "$@" ;;
        realign) shift; cmd_registry_session_realign "$@" ;;
        *) fel "steward registry session: unknown verb '${1:-}' (allowed: add, check, realign)" 64 ;;
      esac ;;
    migrate-session) shift; cmd_registry_migrate_session "$@" ;;
    *) fel "steward registry: unknown noun '${1:-}' (allowed: team, client, account, login, principal, project, session, migrate-session)" 64 ;;
  esac
}

# cmd_registry_team_add <slug> --name "Display Name" [--member p]... [--json]
#
# MEMBERS DEFAULTS TO THE VIEWER, NEVER TO EMPTY. An entity with nobody in it
# is not a team (registry_entity_load's own MANAGED_BY check treats "no
# members" as "not a team" for exactly this reason) — so a team add with no
# --member at all still has to produce a team, and the only name it can use
# without asking is whoever is running the command. --json reports which
# happened (membersSource: default|flags) so a caller never has to guess.
cmd_registry_team_add() {
  local want_json="" slug="" name="" saw_member="" a
  local members=()
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) shift ;;
      --name)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry team add: --name needs a value" 64; return 64; }
        name="$2"; shift 2 ;;
      --member)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry team add: --member needs a value" 64; return 64; }
        members+=("$2"); saw_member=1; shift 2 ;;
      -*)
        _reg_fail "$want_json" "steward registry team add: unknown flag '$1'" 64; return 64 ;;
      *)
        if [ -n "$slug" ]; then
          _reg_fail "$want_json" "steward registry team add: one slug at a time" 64; return 64
        fi
        slug="$1"; shift ;;
    esac
  done

  [ -n "$slug" ] || { _reg_fail "$want_json" "steward registry team add: a slug is required" 64; return 64; }
  if ! [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry team add: invalid slug '$slug' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  [ -n "$name" ] || { _reg_fail "$want_json" "steward registry team add: --name is required" 64; return 64; }

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  local members_source="default"
  if [ -z "$saw_member" ]; then
    # MEMBERS ARE PRINCIPALS, SO THE DEFAULT MUST BE ONE TOO. `id -un` names a
    # unix account, and a unix account is not a person: the same human can own
    # two of them on two hosts, and a login can be spelled like SOME OTHER
    # person's principal id. Writing the raw login into MEMBERS would put this
    # row in a different namespace from every rule that reads it - visibility,
    # the desk, the mate levels - and the row would look right while granting
    # the wrong human. Resolve it the way lib/sessions.sh resolves the viewer:
    # accounts.d USERNAME (and HOST) to PRINCIPAL, the login itself only when
    # the estate has no account register.
    #
    # STEWARD_VIEWER IS ALREADY A PRINCIPAL - the same contract docs/client-spec.md
    # states for it - so it is never resolved a second time.
    local viewer="${STEWARD_VIEWER:-}" viewer_login="" viewer_host=""
    if [ -z "$viewer" ]; then
      viewer_login="$(id -un 2>/dev/null)"
      if [ -n "${STEWARD_HOSTNAME_CMD:-}" ]; then
        viewer_host="$("$STEWARD_HOSTNAME_CMD" 2>/dev/null)"
      else
        viewer_host="$(hostname -s 2>/dev/null)"
      fi
      [ -z "$viewer_login" ] || viewer="$(registry_principal_for_username "$viewer_login" "$viewer_host")" || viewer=""
    fi
    if [ -z "$viewer" ]; then
      _reg_fail "$want_json" "steward registry team add: no --member given and no viewer could be determined (set STEWARD_VIEWER)" 64
      return 64
    fi
    members=("$viewer")
  else
    members_source="flags"
  fi
  local m
  for m in "${members[@]}"; do
    if ! [[ "$m" =~ ^[a-z][a-z0-9-]*$ ]]; then
      _reg_fail "$want_json" "steward registry team add: invalid member '$m' (allowed: a-z, then a-z0-9-)" 64
      return 64
    fi
  done
  local members_joined=""
  for m in "${members[@]}"; do
    members_joined="${members_joined:+$members_joined }$m"
  done

  # _registry_emit_kv's own refusal goes to stderr. CAPTURED here (the same
  # way rw_err captures registry_entity_write's below), never left to leak
  # onto whatever real stderr this process has — a --json caller combining
  # stdout+stderr must see exactly one JSON value, never a bare prose line
  # ahead of it.
  local kv_name kv_members rc kv_err
  kv_err="$(mktemp)" || { _reg_fail "$want_json" "steward registry team add: cannot create a temporary file" 70; return 70; }
  kv_name="$(_registry_emit_kv NAME "$name" 2>"$kv_err")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$kv_err"
    _reg_fail "$want_json" "steward registry team add: --name contains a control character or newline" 64
    return 64
  fi
  kv_members="$(_registry_emit_kv MEMBERS "$members_joined" 2>"$kv_err")"; rc=$?
  rm -f "$kv_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry team add: an invalid member slipped past validation" 64
    return 64
  fi

  _REGW_EXPECT_NAME="$name"
  _REGW_EXPECT_MEMBERS="$members_joined"
  local rw_err; rw_err="$(mktemp)" || {
    _reg_fail "$want_json" "steward registry team add: cannot create a temporary file" 70
    return 70
  }
  # HEADER + TRAILING NEWLINE, matching lib/scaffold.sh's shape — the
  # register has one row form, not one shape for scaffold-written rows and
  # another for these. $slug is already validated against the entity-id
  # form above, so interpolating it into a comment carries nothing unsafe.
  local content
  content="$(printf '# %s — team, written by steward registry team add.\n%s\n%s' \
    "$slug" "$kv_name" "$kv_members")"$'\n'
  registry_entity_write "$slug" "$content" _registry_validate_team_stage 2>"$rw_err"
  rc=$?
  local rw_msg; rw_msg="$(cat "$rw_err")"; rm -f "$rw_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry team add: $rw_msg" "$rc"
    return "$rc"
  fi

  local file; file="$(registry_entity_dir)/$slug.conf"
  if [ -n "$want_json" ]; then
    _json ok true kind team slug "$slug" name "$name" file "$file" membersSource "$members_source"
  else
    printf 'steward: wrote entities.d/%s.conf (team '\''%s'\'', members: %s)\n' "$slug" "$name" "$members_joined"
  fi
  return 0
}

# cmd_registry_client_add <slug> --managed-by <team-slug> --name "Display Name" [--json]
#
# THE MANAGER MUST ALREADY RESOLVE AS A TEAM. Not "a file with that name
# exists" — registry_entity_load must succeed AND report at least one
# member. An entity with no members is not a team, and a MANAGED_BY pointing
# at one would read as structure while carrying none — the same distinction
# registry_entity_load itself already draws for MANAGED_BY resolution.
cmd_registry_client_add() {
  local want_json="" slug="" name="" managed_by="" a
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) shift ;;
      --name)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry client add: --name needs a value" 64; return 64; }
        name="$2"; shift 2 ;;
      --managed-by)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry client add: --managed-by needs a value" 64; return 64; }
        managed_by="$2"; shift 2 ;;
      -*)
        _reg_fail "$want_json" "steward registry client add: unknown flag '$1'" 64; return 64 ;;
      *)
        if [ -n "$slug" ]; then
          _reg_fail "$want_json" "steward registry client add: one slug at a time" 64; return 64
        fi
        slug="$1"; shift ;;
    esac
  done

  [ -n "$slug" ] || { _reg_fail "$want_json" "steward registry client add: a slug is required" 64; return 64; }
  if ! [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry client add: invalid slug '$slug' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  [ -n "$name" ] || { _reg_fail "$want_json" "steward registry client add: --name is required" 64; return 64; }
  [ -n "$managed_by" ] || { _reg_fail "$want_json" "steward registry client add: --managed-by is required" 64; return 64; }
  if ! [[ "$managed_by" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry client add: invalid --managed-by slug '$managed_by'" 64
    return 64
  fi

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  # SUBSHELLED, NEVER DIRECT. registry_entity_load SOURCES the manager's
  # conf. Called un-subshelled in this shell, a manager conf that happens to
  # assign a variable sharing a name with one of THIS function's own locals
  # (slug, name — lowercase; not the uppercase ENTITY_* names
  # registry_entity_load itself declares local) would overwrite that local
  # via bash's dynamic scoping — the same never-source-unsubshelled class of
  # danger as the WRITE side below, but arriving through the READ. The
  # command-substitution subshell confines any such clobbering to a process
  # that exits before this function sees another line of its own — the same
  # pattern lib/visibility.sh:108 already uses for exactly this reason.
  local mgr_members load_rc
  mgr_members="$( registry_entity_load "$managed_by" >/dev/null 2>&1 && printf '%s' "$ENTITY_MEMBERS" )"
  load_rc=$?
  if [ "$load_rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry client add: --managed-by '$managed_by' does not resolve to a valid entity" 78
    return 78
  fi
  if [ -z "$mgr_members" ]; then
    _reg_fail "$want_json" "steward registry client add: --managed-by '$managed_by' has no members — it is not a team" 78
    return 78
  fi

  # See the matching comment in cmd_registry_team_add: _registry_emit_kv's
  # own refusal is CAPTURED, never left to leak onto whatever real stderr
  # this process has.
  local kv_name kv_managed rc kv_err
  kv_err="$(mktemp)" || { _reg_fail "$want_json" "steward registry client add: cannot create a temporary file" 70; return 70; }
  kv_name="$(_registry_emit_kv NAME "$name" 2>"$kv_err")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$kv_err"
    _reg_fail "$want_json" "steward registry client add: --name contains a control character or newline" 64
    return 64
  fi
  kv_managed="$(_registry_emit_kv MANAGED_BY "$managed_by" 2>"$kv_err")"; rc=$?
  rm -f "$kv_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry client add: --managed-by contains a control character or newline" 64
    return 64
  fi

  _REGW_EXPECT_NAME="$name"
  _REGW_EXPECT_MANAGED_BY="$managed_by"
  local rw_err; rw_err="$(mktemp)" || {
    _reg_fail "$want_json" "steward registry client add: cannot create a temporary file" 70
    return 70
  }
  # HEADER + TRAILING NEWLINE — see the matching comment in
  # cmd_registry_team_add.
  local content
  content="$(printf '# %s — client, written by steward registry client add.\n%s\n%s' \
    "$slug" "$kv_name" "$kv_managed")"$'\n'
  registry_entity_write "$slug" "$content" _registry_validate_client_stage 2>"$rw_err"
  rc=$?
  local rw_msg; rw_msg="$(cat "$rw_err")"; rm -f "$rw_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry client add: $rw_msg" "$rc"
    return "$rc"
  fi

  local file; file="$(registry_entity_dir)/$slug.conf"
  if [ -n "$want_json" ]; then
    _json ok true kind client slug "$slug" name "$name" file "$file" managedBy "$managed_by"
  else
    printf 'steward: wrote entities.d/%s.conf (client '\''%s'\'', managed by %s)\n' "$slug" "$name" "$managed_by"
  fi
  return 0
}

# _registry_host_form <value> / _registry_username_form <value> - the account
# register's OWN grammar for the two fields registry_account_load does not
# check the form of, in one place per field.
#
# BOTH SIDES ASK THE SAME PREDICATE. The writer below is where these values
# enter the register; `steward offboard` is where they are read back out, and
# its refusal is literally "a value this register's own writer would have
# refused". Said from a COPY of the regex, that sentence stops being true the
# first time the writer's grammar moves - and the failure mode is a refusal to
# offboard a person whose row the product itself wrote. Nothing else catches
# that drift, so the grammar lives here and is called, never transcribed.
_registry_host_form()     { [[ "${1:-}" =~ ^[a-z0-9][a-z0-9-]*$ ]]; }
_registry_username_form() { [[ "${1:-}" =~ ^[a-z][a-z0-9-]*$ ]]; }

# cmd_registry_account_add <slug> --principal <p> --host <h> [--username <u>] [--json]
#
# Writes accounts.d/<slug>.conf through the same shared serializer and
# writer transaction as team/client add — registry_account_write is a thin
# wrapper over the ONE writer core (registry_row_write, lib/registry.sh),
# not a second implementation.
#
# THE HOST MUST ALREADY RESOLVE. Not "a file with that name exists" any
# more than client add's --managed-by is — a relation aiming at a host that
# does not resolve reads as structure while carrying none. registry_host_load
# reports that by itself (it fails on a missing/unreadable conf).
cmd_registry_account_add() {
  local want_json="" slug="" principal="" host="" username="" a
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) shift ;;
      --principal)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry account add: --principal needs a value" 64; return 64; }
        principal="$2"; shift 2 ;;
      --host)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry account add: --host needs a value" 64; return 64; }
        host="$2"; shift 2 ;;
      --username)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry account add: --username needs a value" 64; return 64; }
        username="$2"; shift 2 ;;
      -*)
        _reg_fail "$want_json" "steward registry account add: unknown flag '$1'" 64; return 64 ;;
      *)
        if [ -n "$slug" ]; then
          _reg_fail "$want_json" "steward registry account add: one slug at a time" 64; return 64
        fi
        slug="$1"; shift ;;
    esac
  done

  [ -n "$slug" ] || { _reg_fail "$want_json" "steward registry account add: a slug is required" 64; return 64; }
  if ! [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry account add: invalid slug '$slug' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  [ -n "$principal" ] || { _reg_fail "$want_json" "steward registry account add: --principal is required" 64; return 64; }
  if ! [[ "$principal" =~ ^[a-z][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry account add: invalid --principal '$principal' (allowed: a-z, then a-z0-9-)" 64
    return 64
  fi
  [ -n "$host" ] || { _reg_fail "$want_json" "steward registry account add: --host is required" 64; return 64; }
  if ! _registry_host_form "$host"; then
    _reg_fail "$want_json" "steward registry account add: invalid --host '$host' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  if [ -z "$username" ]; then
    username="$principal"
  elif ! _registry_username_form "$username"; then
    _reg_fail "$want_json" "steward registry account add: invalid --username '$username' (allowed: a-z, then a-z0-9-)" 64
    return 64
  fi

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  # SUBSHELLED, NEVER DIRECT — same reasoning as client add's --managed-by
  # lookup above. registry_host_load SOURCES the host's own conf and does
  # NOT declare its own fields `local` (OWNER, LEGAL_OWNER, …); called
  # un-subshelled, a hosts.d row carrying `slug=`/`principal=` (lowercase,
  # matching this function's own locals) would clobber them via bash's
  # dynamic scoping the moment this line ran — the exact class of bug the
  # entity writer's C1 case closed on the write side, arriving here through
  # the READ.
  local hostdir hostconf load_rc
  hostdir="$(registry_host_dir)"
  hostconf="$hostdir/$host.conf"
  ( registry_host_load "$hostconf" >/dev/null 2>&1 )
  load_rc=$?
  if [ "$load_rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry account add: --host '$host' does not resolve to a known host" 78
    return 78
  fi

  # See the matching comment in cmd_registry_team_add: _registry_emit_kv's
  # own refusal is CAPTURED, never left to leak onto whatever real stderr
  # this process has.
  local kv_principal kv_host kv_username rc kv_err
  kv_err="$(mktemp)" || { _reg_fail "$want_json" "steward registry account add: cannot create a temporary file" 70; return 70; }
  kv_principal="$(_registry_emit_kv PRINCIPAL "$principal" 2>"$kv_err")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$kv_err"
    _reg_fail "$want_json" "steward registry account add: --principal contains a control character or newline" 64
    return 64
  fi
  kv_host="$(_registry_emit_kv HOST "$host" 2>"$kv_err")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$kv_err"
    _reg_fail "$want_json" "steward registry account add: --host contains a control character or newline" 64
    return 64
  fi
  kv_username="$(_registry_emit_kv USERNAME "$username" 2>"$kv_err")"; rc=$?
  rm -f "$kv_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry account add: --username contains a control character or newline" 64
    return 64
  fi

  _REGW_EXPECT_PRINCIPAL="$principal"
  _REGW_EXPECT_HOST="$host"
  _REGW_EXPECT_USERNAME="$username"
  local rw_err; rw_err="$(mktemp)" || {
    _reg_fail "$want_json" "steward registry account add: cannot create a temporary file" 70
    return 70
  }
  # HEADER + TRAILING NEWLINE — see the matching comment in
  # cmd_registry_team_add.
  local content
  content="$(printf '# %s — account, written by steward registry account add.\n%s\n%s\n%s' \
    "$slug" "$kv_principal" "$kv_host" "$kv_username")"$'\n'
  registry_account_write "$slug" "$content" _registry_validate_account_stage 2>"$rw_err"
  rc=$?
  local rw_msg; rw_msg="$(cat "$rw_err")"; rm -f "$rw_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry account add: $rw_msg" "$rc"
    return "$rc"
  fi

  local file; file="$(registry_account_dir)/$slug.conf"
  if [ -n "$want_json" ]; then
    _json ok true kind account slug "$slug" principal "$principal" host "$host" username "$username" file "$file"
  else
    printf 'steward: wrote accounts.d/%s.conf (account for %s@%s, username %s)\n' "$slug" "$principal" "$host" "$username"
  fi
  return 0
}

# cmd_registry_principal_add <slug> --name N [--tailscale-login L]...
#                            [--oidc-login <issuer-slug>:<subject>]...
#                            [--oidc-email E] [--read-all] [--json]
#
# Writes principals.d/<slug>.conf through the same shared serializer and
# writer transaction as team/client/account add — registry_principal_write is
# a thin wrapper over the ONE writer core (registry_row_write, lib/registry.sh),
# not a second implementation.
#
# --tailscale-login MAY BE REPEATED, the same shape as --member on
# `registry team add`, and a single value may itself carry several
# space-separated words — both forms are collected into one list, every word
# validated individually, and duplicates within the row collapsed before the
# write (so `--tailscale-login a --tailscale-login a` and a bare `a` both
# write one word).
#
# --oidc-login IS THE SECOND IDENTITY SOURCE and is collected exactly the same
# way, with one difference that is the whole reason it is a separate list: its
# words are NOT case-folded, because the subject half is the provider's opaque
# string (see _registry_oidc_login_valid). AT LEAST ONE SOURCE IS REQUIRED -
# neither flag alone is - which is the rule registry_principal_load already
# enforces on the read side; refusing here keeps the verb from writing a row
# its own reader would then refuse to load. --oidc-email is a DISPLAY value
# only: nothing is ever matched on it, so it is not part of the uniqueness
# question below.
#
# EVERY IDENTITY MUST BE UNIQUE ACROSS THE REGISTER, PER WORD, PER SOURCE. Two
# rows sharing one login word — in any position — is exactly the ambiguity
# registry_principal_for_login refuses at lookup time (rc 65) — checking it
# HERE, before anything is staged, means the ORDINARY case (no race, just a
# duplicate) is refused with a useful message naming the other principal
# instead of a generic "already exists".
#
# THIS CHECK IS THE FAST PATH, NOT THE GUARANTEE. It runs before
# registry_row_write ever takes principals.d/.write.lock, so two concurrent
# `principal add` calls sharing a login word can both pass it before either
# has staged anything. THE GUARANTEE is `_principal_validate_row` (above),
# the validate_fn registry_principal_write calls WHILE THE LOCK IS HELD —
# see its own comment for why that timing makes the recheck reliable, not
# merely "narrower window". A refusal caught here is rc 65; a refusal caught
# under the lock surfaces as rc 70 (registry_row_write's own hardcoded rc for
# every validate_fn failure — no remapping between the two, see the comment
# above _principal_validate_row).
cmd_registry_principal_add() {
  local want_json="" slug="" name="" read_all="" oidc_email="" a
  local logins=() oidcs=()
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) shift ;;
      --name)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry principal add: --name needs a value" 64; return 64; }
        name="$2"; shift 2 ;;
      --tailscale-login)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry principal add: --tailscale-login needs a value" 64; return 64; }
        logins+=("$2"); shift 2 ;;
      --oidc-login)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry principal add: --oidc-login needs a value" 64; return 64; }
        oidcs+=("$2"); shift 2 ;;
      --oidc-email)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry principal add: --oidc-email needs a value" 64; return 64; }
        oidc_email="$2"; shift 2 ;;
      --read-all)
        read_all="yes"; shift ;;
      -*)
        _reg_fail "$want_json" "steward registry principal add: unknown flag '$1'" 64; return 64 ;;
      *)
        if [ -n "$slug" ]; then
          _reg_fail "$want_json" "steward registry principal add: one principal at a time" 64; return 64
        fi
        slug="$1"; shift ;;
    esac
  done

  [ -n "$slug" ] || { _reg_fail "$want_json" "steward registry principal add: a slug is required" 64; return 64; }
  if ! [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry principal add: invalid slug '$slug' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  [ -n "$name" ] || { _reg_fail "$want_json" "steward registry principal add: --name is required" 64; return 64; }

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  # COLLECT, SPLIT, VALIDATE EVERY WORD, DE-DUPLICATE — every value collected
  # from every --tailscale-login occurrence is joined with a space and
  # re-split through _registry_words (the same MEMBERS/MCP_ASSETS idiom), so
  # a value that itself carries several words behaves exactly like several
  # occurrences of the flag. A malformed word anywhere refuses before
  # anything is staged.
  local joined="" one
  for one in "${logins[@]+"${logins[@]}"}"; do
    joined="${joined:+$joined }$one"
  done
  _registry_words "$joined"
  local w lw seen="" login_words=()
  for w in "${REGISTRY_WORDS[@]+"${REGISTRY_WORDS[@]}"}"; do
    if ! _registry_login_valid "$w"; then
      _reg_fail "$want_json" "steward registry principal add: --tailscale-login '$(registry_printable "$w")' must look like user@domain" 64
      return 64
    fi
    lw="$(printf '%s' "$w" | tr '[:upper:]' '[:lower:]')"
    case " $seen " in *" $lw "*) continue ;; esac
    seen="$seen $lw"
    login_words+=("$lw")
  done
  local login_joined=""
  for w in "${login_words[@]+"${login_words[@]}"}"; do
    login_joined="${login_joined:+$login_joined }$w"
  done

  # THE OIDC LIST, COLLECTED THE SAME WAY: repeated flags and space-separated
  # values are one list, every word validated on its own, duplicates within the
  # row collapsed. No case folding - the subject half is the provider's.
  local ojoined="" oone
  for oone in "${oidcs[@]+"${oidcs[@]}"}"; do
    ojoined="${ojoined:+$ojoined }$oone"
  done
  _registry_words "$ojoined"
  local oseen="" oidc_words=()
  for w in "${REGISTRY_WORDS[@]+"${REGISTRY_WORDS[@]}"}"; do
    if ! _registry_oidc_login_valid "$w"; then
      _reg_fail "$want_json" "steward registry principal add: --oidc-login '$(registry_printable "$w")' must look like <issuer-slug>:<subject>" 64
      return 64
    fi
    case " $oseen " in *" $w "*) continue ;; esac
    oseen="$oseen $w"
    oidc_words+=("$w")
  done
  local oidc_joined=""
  for w in "${oidc_words[@]+"${oidc_words[@]}"}"; do
    oidc_joined="${oidc_joined:+$oidc_joined }$w"
  done
  # AT LEAST ONE SOURCE, the same rule the reader enforces. Checked here so the
  # verb refuses before staging rather than writing a row its own reader will
  # not load.
  if [ -z "$login_joined" ] && [ -z "$oidc_joined" ]; then
    _reg_fail "$want_json" "steward registry principal add: an identity is required - give --tailscale-login, --oidc-login, or both" 64
    return 64
  fi
  if [ -n "$oidc_email" ]; then
    case "$oidc_email" in
      *[[:space:]]*) _reg_fail "$want_json" "steward registry principal add: --oidc-email must not contain whitespace" 64; return 64 ;;
    esac
  fi

  # DUPLICATE, BEFORE THE WRITE, PER WORD, PER SOURCE - see the comment above
  # this function. This is the FAST PATH; _principal_validate_row is the
  # guarantee.
  local other
  for w in "${login_words[@]+"${login_words[@]}"}"; do
    other="$(registry_principal_for_identity tailscale "$w" 2>/dev/null)"
    if [ -n "$other" ]; then
      _reg_fail "$want_json" "steward registry principal add: the login '$w' already belongs to principal '$other' - one identity, one human" 65
      return 65
    fi
  done
  for w in "${oidc_words[@]+"${oidc_words[@]}"}"; do
    other="$(registry_principal_for_identity oidc "$w" 2>/dev/null)"
    if [ -n "$other" ]; then
      _reg_fail "$want_json" "steward registry principal add: the identity '$w' already belongs to principal '$other' - one identity, one human" 65
      return 65
    fi
  done

  # See the matching comment in cmd_registry_team_add: _registry_emit_kv's
  # own refusal is CAPTURED, never left to leak onto whatever real stderr
  # this process has.
  local kv_name kv_login kv_oidc kv_omail rc kv_err
  kv_err="$(mktemp)" || { _reg_fail "$want_json" "steward registry principal add: cannot create a temporary file" 70; return 70; }
  kv_name="$(_registry_emit_kv NAME "$name" 2>"$kv_err")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$kv_err"
    _reg_fail "$want_json" "steward registry principal add: --name contains a control character or newline" 64
    return 64
  fi
  kv_login="$(_registry_emit_kv TAILSCALE_LOGIN "$login_joined" 2>"$kv_err")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$kv_err"
    _reg_fail "$want_json" "steward registry principal add: --tailscale-login contains a control character or newline" 64
    return 64
  fi
  kv_oidc="$(_registry_emit_kv OIDC_LOGIN "$oidc_joined" 2>"$kv_err")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$kv_err"
    _reg_fail "$want_json" "steward registry principal add: --oidc-login contains a control character or newline" 64
    return 64
  fi
  kv_omail="$(_registry_emit_kv OIDC_EMAIL "$oidc_email" 2>"$kv_err")"; rc=$?
  rm -f "$kv_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry principal add: --oidc-email contains a control character or newline" 64
    return 64
  fi

  _REGW_EXPECT_NAME="$name"
  _REGW_EXPECT_TAILSCALE_LOGIN="$login_joined"
  _REGW_EXPECT_OIDC_LOGIN="$oidc_joined"
  _REGW_EXPECT_OIDC_EMAIL="$oidc_email"
  _REGW_EXPECT_DESK_READ_ALL="$read_all"
  local rw_err; rw_err="$(mktemp)" || {
    _reg_fail "$want_json" "steward registry principal add: cannot create a temporary file" 70
    return 70
  }
  # HEADER + TRAILING NEWLINE — see the matching comment in
  # cmd_registry_team_add.
  #
  # A FIELD THAT WAS NOT GIVEN GETS NO LINE. A row with only a tailnet login
  # must be byte-identical to what this verb wrote before OIDC existed - the
  # register is in git, and a diff on every row would hide the one that
  # changed meaning. The header line is byte-for-byte the one it always was,
  # for the same reason.
  local content
  content="$(printf '# %s — principal, written by steward registry principal add.\n%s' "$slug" "$kv_name")"
  [ -n "$login_joined" ] && content="$content"$'\n'"$kv_login"
  [ -n "$oidc_joined" ]  && content="$content"$'\n'"$kv_oidc"
  [ -n "$oidc_email" ]   && content="$content"$'\n'"$kv_omail"
  [ -n "$read_all" ]     && content="$content"$'\n''DESK_READ_ALL="yes"'
  content="$content"$'\n'
  registry_principal_write "$slug" "$content" _principal_validate_row 2>"$rw_err"
  rc=$?
  local rw_msg; rw_msg="$(cat "$rw_err")"; rm -f "$rw_err"
  if [ "$rc" -ne 0 ]; then
    # registry_row_write hardcodes rc 70 for every validate_fn refusal (its
    # own step 4) — reported as-is, not remapped: 65 means refused before
    # the lock (the pre-check above), 70 means refused under it (see the
    # comment above _principal_validate_row).
    _reg_fail "$want_json" "steward registry principal add: $rw_msg" "$rc"
    return "$rc"
  fi

  local file; file="$(registry_principal_dir)/$slug.conf"
  if [ -n "$want_json" ]; then
    local ra_bool=false; [ -n "$read_all" ] && ra_bool=true
    _json ok true kind principal slug "$slug" name "$name" \
      tailscaleLogin "$login_joined" oidcLogin "$oidc_joined" oidcEmail "$oidc_email" \
      readAll "$ra_bool" file "$file"
  else
    printf 'steward: wrote principals.d/%s.conf (principal %s, identities %s%s)\n' \
      "$slug" "$name" "${login_joined:-none}${oidc_joined:+ $oidc_joined}" \
      "$( [ -n "$read_all" ] && printf ', read-all' )"
  fi
  return 0
}

# cmd_registry_login_add <slug> --principal P --account A --provider V
#                        --config-dir D --legal-owner O [--json]
#
# THE SAME SHAPE as account add — flag loop, form validation BEFORE any write,
# _registry_emit_kv per field, _REGW_EXPECT_*, one writer core — with three
# differences that are the reason the verb is worth having:
#
#   1. --config-dir is validated against THE GRAMMAR, before the write. A verb
#      that writes a row the register's own reader then refuses produces rubbish
#      that looks like data.
#   2. --provider is validated against the closed vocabulary, before the write.
#   3. registry_login_check runs INSIDE the stage validator, UNDER THE
#      REGISTER'S WRITE LOCK, before publication — so a row whose resolved
#      directory collides with an existing one is refused before it is ever
#      published. There is no publish-then-remove step: registry_row_write
#      has no undo path, so the collision is decided at the one moment a
#      refusal costs nothing (see _registry_validate_login_stage).
cmd_registry_login_add() {
  local want_json="" slug="" principal="" account="" provider="" configdir="" legal="" a
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) shift ;;
      --principal)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry login add: --principal needs a value" 64; return 64; }
        principal="$2"; shift 2 ;;
      --account)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry login add: --account needs a value" 64; return 64; }
        account="$2"; shift 2 ;;
      --provider)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry login add: --provider needs a value" 64; return 64; }
        provider="$2"; shift 2 ;;
      --config-dir)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry login add: --config-dir needs a value" 64; return 64; }
        configdir="$2"; shift 2 ;;
      --legal-owner)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry login add: --legal-owner needs a value" 64; return 64; }
        legal="$2"; shift 2 ;;
      -*)
        _reg_fail "$want_json" "steward registry login add: unknown flag '$1'" 64; return 64 ;;
      *)
        if [ -n "$slug" ]; then
          _reg_fail "$want_json" "steward registry login add: one slug at a time" 64; return 64
        fi
        slug="$1"; shift ;;
    esac
  done

  [ -n "$slug" ] || { _reg_fail "$want_json" "steward registry login add: a slug is required" 64; return 64; }
  if ! [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry login add: invalid slug '$slug' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  [ -n "$principal" ] || { _reg_fail "$want_json" "steward registry login add: --principal is required" 64; return 64; }
  if ! [[ "$principal" =~ ^[a-z][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry login add: invalid --principal '$principal' (allowed: a-z, then a-z0-9-)" 64
    return 64
  fi
  # ACCOUNT is the account's REAL name: non-empty, no whitespace. Deliberately
  # NOT required to be an address — the field is the account's name on whatever
  # provider it belongs to, and it must stay updatable without moving a
  # directory of live credentials.
  case "$account" in
    '') _reg_fail "$want_json" "steward registry login add: --account is required (the account's real name)" 64; return 64 ;;
    *[[:space:]]*) _reg_fail "$want_json" "steward registry login add: --account must not contain whitespace" 64; return 64 ;;
  esac
  [ -n "$legal" ] || { _reg_fail "$want_json" "steward registry login add: --legal-owner is required (who pays, and who answers for it?)" 64; return 64; }

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  # THE CLOSED VOCABULARY, CHECKED HERE TOO. The reader refuses an unknown
  # provider, but a verb that can only be caught by the reader is a verb that
  # writes rubbish and reports success.
  # EXACT MEMBERSHIP: the needle is a COMMAND-LINE ARGUMENT - free text from
  # outside - and the list is the whole vocabulary, so the substring form let
  # `--provider "claude-max claude-team"` through this gate. No bad row reached
  # disk (the staging re-read refuses it), which is why the damage is small and
  # the DIAGNOSTIC is the real defect: the person who mistyped a provider was
  # told that a temporary file would not parse. The comment two lines up says
  # exactly why that is not good enough.
  if ! _registry_word_in_list "$provider" "$_REGISTRY_LOGIN_PROVIDERS"; then
    _reg_fail "$want_json" "steward registry login add: invalid --provider '$provider' (one of: $_REGISTRY_LOGIN_PROVIDERS)" 64
    return 64
  fi

  # THE GRAMMAR, CHECKED BEFORE THE WRITE. Same two forms, same reasons — see
  # registry_login_config_dir. The legacy form additionally has to BE the estate's
  # named row, and that is checked here rather than left to first read.
  local legacy leaf
  case "$configdir" in
    '~/.claude')
      legacy="$(registry_legacy_login)" || {
        _reg_fail "$want_json" "steward registry login add: the estate's LEGACY_LOGIN is malformed" 78; return 78; }
      if [ "$legacy" != "$slug" ]; then
        _reg_fail "$want_json" "steward registry login add: '~/.claude' is reserved for the estate's LEGACY_LOGIN (currently: ${legacy:-none}), not for '$slug'" 64
        return 64
      fi ;;
    '~/.claude-logins/'*)
      leaf="${configdir#\~/.claude-logins/}"
      case "$leaf" in
        ''|*/*) _reg_fail "$want_json" "steward registry login add: --config-dir must name exactly one directory under ~/.claude-logins/" 64; return 64 ;;
      esac
      if ! [[ "$leaf" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
        _reg_fail "$want_json" "steward registry login add: --config-dir leaf '$leaf' is not a slug (a-z 0-9 and hyphen)" 64
        return 64
      fi ;;
    *)
      _reg_fail "$want_json" "steward registry login add: --config-dir must be '~/.claude-logins/<slug>' (or '~/.claude' for the estate's LEGACY_LOGIN); got '$configdir'" 64
      return 64 ;;
  esac

  # See the matching comment in cmd_registry_team_add: _registry_emit_kv's own
  # refusal is CAPTURED, never left to leak onto this process's real stderr.
  local kv_err rc kv_principal kv_account kv_provider kv_configdir kv_legal k v K
  kv_err="$(mktemp)" || { _reg_fail "$want_json" "steward registry login add: cannot create a temporary file" 70; return 70; }
  for k in principal account provider configdir legal; do
    case "$k" in
      principal) v="$principal"; K=PRINCIPAL ;;
      account)   v="$account";   K=ACCOUNT ;;
      provider)  v="$provider";  K=PROVIDER ;;
      configdir) v="$configdir"; K=CONFIG_DIR ;;
      legal)     v="$legal";     K=LEGAL_OWNER ;;
    esac
    eval "kv_$k=\"\$(_registry_emit_kv \"\$K\" \"\$v\" 2>\"\$kv_err\")\""; rc=$?
    if [ "$rc" -ne 0 ]; then
      rm -f "$kv_err"
      _reg_fail "$want_json" "steward registry login add: --${k} contains a control character or newline" 64
      return 64
    fi
  done
  rm -f "$kv_err"

  # _REGW_EXPECT_SLUG IS THE SIXTH VARIABLE THIS VERB MUST SET — the stage
  # validator's collision probe judges the pending row AS THE SLUG IT WILL
  # BECOME (see _registry_validate_login_stage), and needs the slug itself,
  # not just the five row fields, to build that probe's filename.
  _REGW_EXPECT_SLUG="$slug"
  _REGW_EXPECT_PRINCIPAL="$principal"
  _REGW_EXPECT_ACCOUNT="$account"
  _REGW_EXPECT_PROVIDER="$provider"
  _REGW_EXPECT_CONFIG_DIR="$configdir"
  _REGW_EXPECT_LEGAL_OWNER="$legal"

  local rw_err content
  rw_err="$(mktemp)" || { _reg_fail "$want_json" "steward registry login add: cannot create a temporary file" 70; return 70; }
  # HEADER + TRAILING NEWLINE — see the matching comment in cmd_registry_team_add.
  content="$(printf '# %s — login, written by steward registry login add.\n%s\n%s\n%s\n%s\n%s' \
    "$slug" "$kv_principal" "$kv_account" "$kv_provider" "$kv_configdir" "$kv_legal")"$'\n'
  registry_login_write "$slug" "$content" _registry_validate_login_stage 2>"$rw_err"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry login add: $(tr '\n' ' ' < "$rw_err")" "$rc"
    rm -f "$rw_err"
    return "$rc"
  fi
  rm -f "$rw_err"

  # THE COLLISION IS DECIDED UNDER THE LOCK, BEFORE PUBLICATION — see
  # _registry_validate_login_stage. The first draft published first and removed
  # the row again on failure, and that is a defect and not a tidiness matter:
  # between the publish and the removal the register is OBSERVABLY INVALID, and
  # every reader in the fleet is a concurrent reader. A supervisor spawning in
  # that window resolves a register that refuses, exits 78, and launchd restarts
  # it every ten seconds. The window is short and the fleet is large; "short" is
  # not a guarantee.
  #
  # registry_row_write already holds the register's write lock while it calls the
  # stage validator, so the validator is the ONE place where "would the register
  # still be sound WITH this row" can be asked without a window — and the only
  # place with no undo problem, because a refused stage was never published.

  local file; file="$(registry_login_dir)/$slug.conf"
  if [ -n "$want_json" ]; then
    # SAME SHAPE AS `account add --json`: kind, slug, the row's own fields,
    # then file — through the shared _json/jq helper, never a raw printf.
    # This verb's success line was the only JSON emitter in the file that
    # bypassed _json; nothing here needed a hand-built string.
    _json ok true kind login slug "$slug" principal "$principal" account "$account" \
      provider "$provider" config_dir "$configdir" legal_owner "$legal" file "$file"
  else
    echo "login '$slug' registered: principal $principal · account $account · $configdir · paid by $legal"
  fi
  return 0
}

# cmd_registry_login_ls [--json] - one line per row: slug, account, provider,
# the RESOLVED directory, whether that directory holds a credential, and who
# pays.
#
# THE RESOLVED DIRECTORY IS SHOWN, not the raw field. The raw one is a grammar
# fragment; what an operator needs to know before an interactive login is which
# directory on disk is about to be written. A row that does not resolve prints
# its refusal in place of the path rather than being skipped.
cmd_registry_login_ls() {
  local want_json="" a slug dir account_username cred _login_row _why first=1
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done
  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"
  local slugs; slugs="$(registry_login_list)" || return 78
  [ -n "$want_json" ] && printf '{"logins":['
  for slug in $slugs; do
    registry_login_load "$slug" >/dev/null 2>&1 || {
      # THE ROW IS NAMED, NOT DROPPED, in --json too. Text mode already said
      # so ("<slug>: UNREADABLE"); a machine consumer needs the same
      # distinction — a refused row is not the same fact as an absent one,
      # in the one register whose whole purpose is that a bad row is visible.
      # THE ROW'S OWN REFUSAL TRAVELS WITH THE WORD. `UNREADABLE` alone sends a
      # reader looking for a permission problem when the cause is a field in the
      # row, and the parser has already said which field - it was being thrown
      # away one line above. Measured the hard way: a `2>&1` on a deciding line
      # cost a cross-platform hunt for a message the code had produced all along.
      _why="$(registry_login_load "$slug" 2>&1 >/dev/null | tr '\n' ' ' | sed -e 's/[[:space:]]*$//')"
      if [ -n "$want_json" ]; then
        [ "$first" = 1 ] || printf ','
        first=0
        printf '{"login":"%s","unreadable":true,"why":"%s"}' "$slug" "$(printf '%s' "${_why:-unreadable}" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
      else
        printf '%s: UNREADABLE -- %s\n' "$slug" "${_why:-no reason given}"
      fi
      continue
    }
    # registry_login_config_dir's second argument is a UNIX ACCOUNT, not the
    # login's PRINCIPAL (the human) — registry_login_check's own docstring
    # names this exact confusion. The row's ACCOUNT_USERNAME is the unix
    # account the login actually rides on; PRINCIPAL and USERNAME coincide
    # today wherever this register runs, but the account row is the field
    # that carries the difference when they do not. Loaded in a subshell,
    # the same isolation registry_login_principal_gate uses, so a load run
    # on the side never touches this loop's own locals.
    # THE JOIN IS THE PRINCIPAL, NOT THE ACCOUNT FIELD. LOGIN_ACCOUNT is the
    # account's REAL NAME - an address - and registry_account_load takes an
    # accounts.d SLUG, so handing it one could only ever fail: every correct row
    # in a sound register printed "(account does not resolve)". The link between
    # a login and a unix account is the human, which is the join
    # registry_login_principal_gate already makes. registry_login_state does it
    # once and also answers the question an operator actually has before typing
    # /login: is this directory already logged in?
    # COUNT FIRST, THEN READ. `IFS=$'\t' read ... <<<"$(fn)"` runs the
    # substitution with that temporary IFS on bash 3.2 - the assignment is
    # visible inside it there, though not on 5.x - so the whole of
    # registry_login_state ran with IFS=TAB and every space-separated list it
    # touched stopped splitting. Two lines, and the substitution keeps a normal
    # IFS. The same "capture first" shape this file already uses elsewhere.
    _login_row="$(registry_login_state "$slug")"
    IFS=$'\t' read -r account_username dir cred <<<"$_login_row"
    if [ -n "$want_json" ]; then
      [ "$first" = 1 ] || printf ','
      first=0
      printf '{"login":"%s","account":"%s","provider":"%s","unix_account":"%s","config_dir":"%s","credential":"%s","legal_owner":"%s"}' \
        "$slug" "$LOGIN_ACCOUNT" "$LOGIN_PROVIDER" "$account_username" "$dir" "$cred" "$LOGIN_LEGAL_OWNER"
    else
      printf '%-16s %-28s %-12s %-40s %-10s %s\n' \
        "$slug" "$LOGIN_ACCOUNT" "$LOGIN_PROVIDER" "$dir" "$cred" "$LOGIN_LEGAL_OWNER"
    fi
  done
  [ -n "$want_json" ] && printf ']}\n'
  return 0
}

# cmd_registry_login_shell <login> [-- command...] - a shell with the login's own
# CLAUDE_CONFIG_DIR, after printing which directory and which account it is.
#
# WHY THIS VERB EXISTS, and it is one measured evening: every login is just a
# directory in CLAUDE_CONFIG_DIR, and nothing tells a person which one they are
# standing in until after they have typed /login. On 2026-09-09 a login meant
# for `~/.claude-logins/<login>` landed in `~/.claude` instead - the estate's
# LEGACY_LOGIN, a different subscription - and every session on that account was
# signed out mid-work. The directory was never wrong; the person could not see
# it. So this verb says it BEFORE the prompt, on stderr, where a pipe cannot
# swallow it.
#
# IT REFUSES ANOTHER PERSON'S LOGIN. The directory is inside their home and
# their credentials are in it; a shell aimed there from this account would at
# best fail on 0750 and at worst be someone spending another person's seat. The
# refusal names the human, because that is who has to run it instead.
#
# EXEC, NOT A SUBSHELL: what follows is the caller's own session, so ^C, job
# control and the exit status all belong to them.
cmd_registry_login_shell() {
  local slug="" a
  while [ $# -gt 0 ]; do
    case "$1" in
      --) shift; break ;;
      -*) fel "steward registry login shell: unknown flag '$1'" 64 ;;
      *) [ -z "$slug" ] || fel "steward registry login shell: one login at a time" 64; slug="$1"; shift ;;
    esac
  done
  [ -n "$slug" ] || fel "usage: steward registry login shell <login> [-- command...]" 64
  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"
  registry_login_load "$slug" >/dev/null || fel "login '$slug' does not resolve" 78
  local user dir cred _login_row
  # Capture first - see cmd_registry_login_ls for the bash 3.2 reason.
  _login_row="$(registry_login_state "$slug")"
  IFS=$'\t' read -r user dir cred <<<"$_login_row"
  case "$dir" in
    '('*) fel "login '$slug': $dir" 78 ;;
  esac
  local me; me="$(id -un)"
  if [ "$user" != "$me" ]; then
    fel "login '$slug' belongs to $LOGIN_PRINCIPAL and lives in ${user}'s home ($dir). Run it as $user; a shell aimed at another person's credentials is not this account's to open." 77
  fi
  # THE THREE FACTS A PERSON NEEDS BEFORE TYPING /login, and the one they cannot
  # see from the prompt: which directory, whose subscription pays for it, and
  # whether it is already logged in. ON STDERR so `login shell x -- cmd` in a
  # pipeline still carries them to the terminal.
  {
    printf 'login    %s (%s, paid by %s)\n' "$slug" "$LOGIN_ACCOUNT" "$LOGIN_LEGAL_OWNER"
    printf 'dir      %s\n' "$dir"
    case "$cred" in
      yes) printf 'state    already logged in - /login here would RE-authenticate or switch account\n' ;;
      no)  printf 'state    no credential yet - /login here is the first sign-in for this account\n' ;;
      *)   printf 'state    %s\n' "$cred" ;;
    esac
  } >&2
  export CLAUDE_CONFIG_DIR="$dir" STEWARD_LOGIN="$slug"
  if [ "$#" -gt 0 ]; then exec "$@"; fi
  exec "${SHELL:-/bin/bash}"
}

# cmd_registry_project_add <slug> --parent <entity-slug> --name "Display Name" [--json]
#
# Writes projects.d/<slug>.conf through the same shared serializer and
# writer transaction as the other three registry verbs above —
# registry_project_write is a thin wrapper over the ONE writer core
# (registry_row_write, lib/registry.sh), not a second implementation.
#
# THE PARENT MUST ALREADY RESOLVE AS AN ENTITY. Not "a file with that name
# exists" — registry_entity_load must succeed. UNLIKE client add's
# --managed-by, a project's PARENT does NOT have to be a team with
# members: a project can hang directly under a client just as well as
# under a team (registry_project_load itself makes only that one check,
# and this verb makes no stronger one than its own loader will enforce on
# every future read).
#
# THE SLUG IS GLOBALLY UNIQUE IN projects.d TODAY, not parent-scoped. The
# model this register is heading toward (2026-08-30 design spec, the
# section on what it deliberately leaves open) is a slug unique only
# WITHIN its parent — two clients may each want a project called
# "website" — but projects.d today is a
# flat directory keyed on slug alone, the same create-only writer every
# other register here uses. That is a stricter constraint than the model
# calls for, not a looser one, and it relaxes only once a storage layout
# is chosen for the register as a whole (a later, separate step) — it is
# forward-compatible, never a correctness gap in the meantime.
cmd_registry_project_add() {
  local want_json="" slug="" name="" parent="" a
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) shift ;;
      --name)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry project add: --name needs a value" 64; return 64; }
        name="$2"; shift 2 ;;
      --parent)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry project add: --parent needs a value" 64; return 64; }
        parent="$2"; shift 2 ;;
      -*)
        _reg_fail "$want_json" "steward registry project add: unknown flag '$1'" 64; return 64 ;;
      *)
        if [ -n "$slug" ]; then
          _reg_fail "$want_json" "steward registry project add: one slug at a time" 64; return 64
        fi
        slug="$1"; shift ;;
    esac
  done

  [ -n "$slug" ] || { _reg_fail "$want_json" "steward registry project add: a slug is required" 64; return 64; }
  if ! [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry project add: invalid slug '$slug' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  [ -n "$name" ] || { _reg_fail "$want_json" "steward registry project add: --name is required" 64; return 64; }
  [ -n "$parent" ] || { _reg_fail "$want_json" "steward registry project add: --parent is required" 64; return 64; }
  if ! [[ "$parent" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry project add: invalid --parent slug '$parent'" 64
    return 64
  fi

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  # SUBSHELLED, NEVER DIRECT — same reasoning as client add's --managed-by
  # lookup and account add's --host lookup above: registry_entity_load
  # SOURCES the parent's conf, and a parent conf that happens to assign a
  # variable sharing a name with one of THIS function's own locals (slug,
  # name, parent — lowercase; not the uppercase ENTITY_* names
  # registry_entity_load itself declares local) would overwrite that local
  # via bash's dynamic scoping if the load ran un-subshelled. The
  # command-substitution subshell confines any such clobbering to a
  # process that exits before this function sees another line of its own.
  local load_rc
  ( registry_entity_load "$parent" >/dev/null 2>&1 )
  load_rc=$?
  if [ "$load_rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry project add: --parent '$parent' does not resolve to a valid entity" 78
    return 78
  fi

  # See the matching comment in cmd_registry_team_add: _registry_emit_kv's
  # own refusal is CAPTURED, never left to leak onto whatever real stderr
  # this process has.
  local kv_name kv_parent rc kv_err
  kv_err="$(mktemp)" || { _reg_fail "$want_json" "steward registry project add: cannot create a temporary file" 70; return 70; }
  kv_name="$(_registry_emit_kv NAME "$name" 2>"$kv_err")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$kv_err"
    _reg_fail "$want_json" "steward registry project add: --name contains a control character or newline" 64
    return 64
  fi
  kv_parent="$(_registry_emit_kv PARENT "$parent" 2>"$kv_err")"; rc=$?
  rm -f "$kv_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry project add: --parent contains a control character or newline" 64
    return 64
  fi

  _REGW_EXPECT_NAME="$name"
  _REGW_EXPECT_PARENT="$parent"
  local rw_err; rw_err="$(mktemp)" || {
    _reg_fail "$want_json" "steward registry project add: cannot create a temporary file" 70
    return 70
  }
  # HEADER + TRAILING NEWLINE — see the matching comment in
  # cmd_registry_team_add.
  local content
  content="$(printf '# %s — project, written by steward registry project add.\n%s\n%s' \
    "$slug" "$kv_name" "$kv_parent")"$'\n'
  registry_project_write "$slug" "$content" _registry_validate_project_stage 2>"$rw_err"
  rc=$?
  local rw_msg; rw_msg="$(cat "$rw_err")"; rm -f "$rw_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry project add: $rw_msg" "$rc"
    return "$rc"
  fi

  local file; file="$(registry_project_dir)/$slug.conf"
  if [ -n "$want_json" ]; then
    _json ok true kind project slug "$slug" name "$name" parent "$parent" file "$file"
  else
    printf 'steward: wrote projects.d/%s.conf (project '\''%s'\'', parent %s)\n' "$slug" "$name" "$parent"
  fi
  return 0
}

# cmd_registry_session_add --account <slug> ( --project <slug> | --entity
# <slug> ) --slug <per-account-slug> --repo /abs/path [--host <host>] [--json]
#
# THE CAPSTONE OF THE IDENTITY MODEL: the one verb where account, target,
# derived display and the composite (ACCOUNT, SLUG) uniqueness all meet.
# Writes sessions.d/<minted-id>.conf through the SAME serializer and writer
# transaction as the four org verbs above — registry_session_write is a thin
# wrapper over registry_row_write, and the readback is registry_load itself,
# so a row this verb publishes is by construction a row every reader loads.
#
# WHAT THE ROW STORES, AND WHAT IT DOES NOT. It stores REFERENCES — the
# account, the per-account slug, exactly one target — plus HOST, REPO_PATH,
# OWNER and the permission mode. It stores NO RC_LABEL (the display DERIVES
# from the target at read time; a stored label would be a second truth that
# rots). It DOES store DOMAIN, derived to the target slug: the Linux
# supervisor sources the conf raw and refuses a session with no DOMAIN, so the
# line must be on disk (registry_load would derive the same value, but the
# supervisor never sees that). `migrate-session` writes the identical value.
#
# THE OWNER BRIDGE. visibility.sh and the cockpit's enter gate key on OWNER,
# so a new-shape row MUST carry OWNER = its account's PRINCIPAL to stay
# visible and enterable exactly like an old-shape one. The principal is
# snapshotted out of the subshelled account load — never trusted from a
# flag, never re-read after other loads have run.
#
# EVERY RESOLVING LOAD IS SUBSHELLED — the same lesson every org verb above
# carries: registry_account_load, registry_project_load and
# registry_entity_load all SOURCE an untrusted conf, and a hostile row
# assigning this function's own lowercase locals (slug, repo, account, id…)
# would clobber them via bash's dynamic scoping the moment it sourced.
cmd_registry_session_add() {
  local want_json="" account="" project="" entity="" slug="" repo="" host="" login="" a
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) shift ;;
      --account)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry session add: --account needs a value" 64; return 64; }
        account="$2"; shift 2 ;;
      --project)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry session add: --project needs a value" 64; return 64; }
        project="$2"; shift 2 ;;
      --entity)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry session add: --entity needs a value" 64; return 64; }
        entity="$2"; shift 2 ;;
      --slug)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry session add: --slug needs a value" 64; return 64; }
        slug="$2"; shift 2 ;;
      --repo)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry session add: --repo needs a value" 64; return 64; }
        repo="$2"; shift 2 ;;
      --host)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry session add: --host needs a value" 64; return 64; }
        host="$2"; shift 2 ;;
      --login)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry session add: --login needs a value" 64; return 64; }
        login="$2"; shift 2 ;;
      -*)
        _reg_fail "$want_json" "steward registry session add: unknown flag '$1'" 64; return 64 ;;
      *)
        # No positional operand exists on this verb: the row's name is the
        # MINTED id, never something the operator hands in.
        _reg_fail "$want_json" "steward registry session add: unexpected argument '$1' (the id is minted, never given)" 64
        return 64 ;;
    esac
  done

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  # 1. THE ACCOUNT — required and resolved once. PRINCIPAL authorizes the
  # human; USERNAME and HOST are the session row's Unix identity.
  [ -n "$account" ] || { _reg_fail "$want_json" "steward registry session add: --account is required" 64; return 64; }
  if ! [[ "$account" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry session add: invalid --account '$account' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  # SUBSHELLED, and all three fields SNAPSHOTTED out through the substitution —
  # the load's own stdout (including anything a hostile conf prints) goes to
  # /dev/null; only the loader's validated ACCOUNT_PRINCIPAL crosses back.
  local account_data principal account_username account_host account_rest account_rc
  account_data="$( registry_account_load "$account" >/dev/null 2>&1 && printf '%s\n%s\n%s\nok\n' "$ACCOUNT_PRINCIPAL" "$ACCOUNT_USERNAME" "$ACCOUNT_HOST" )"; account_rc=$?
  if [ "$account_rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry session add: --account '$account' does not resolve to a known account" 78
    return 78
  fi
  principal="${account_data%%$'\n'*}"; account_rest="${account_data#*$'\n'}"
  account_username="${account_rest%%$'\n'*}"; account_rest="${account_rest#*$'\n'}"
  account_host="${account_rest%%$'\n'*}"
  # Belt on the snapshot: the loader validated this form already, but the
  # value crossed a process boundary and becomes the row's OWNER — re-check.
  if ! [[ "$principal" =~ ^[a-z][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry session add: account '$account' carries an invalid principal" 70
    return 70
  fi
  if ! [[ "$account_username" =~ ^[a-z][a-z0-9-]*$ ]] || ! [[ "$account_host" =~ ^[a-z][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry session add: account '$account' carries an invalid username or host" 78
    return 78
  fi

  # 1b. THE LOGIN — GATE 1: the login's PRINCIPAL must be the SAME HUMAN as the
  # account's. This is the gate that makes "one human on another's credentials"
  # impossible to WRITE, rather than merely visible afterwards.
  #
  # COMPARED AGAINST ACCOUNT_PRINCIPAL, NEVER AGAINST OWNER-AS-TYPED. The row's
  # OWNER is DERIVED from the account two lines above; comparing against a raw
  # unix name would let a row whose account resolves to somebody else pass as
  # long as the strings happened to match. accounts.d carries USERNAME
  # separately precisely because a human and a unix account may differ.
  #
  # OPTIONAL UNTIL THE SCHEMA SAYS OTHERWISE. Below the estate's LOGIN schema an
  # absent --login writes no LOGIN line, which is the transition, byte for byte.
  # At the schema the ROW's own reader refuses it — the requirement lives in one
  # place (registry_load), and this verb enforces CORRECTNESS, not presence.
  # Two gates for two questions: "is it stated?" is the schema's, "is it a lie?"
  # is this one.
  #
  # THE COMPARISON ITSELF IS SHARED — registry_login_principal_gate
  # (lib/registry.sh), so this verb and the hub's enroll enforce the SAME
  # pair rule instead of two copies that can drift. It re-resolves the
  # account (subshelled, snapshotted, exactly like `principal` two steps
  # above) so it stays self-contained: no LOGIN_*/ACCOUNT_* global is left
  # behind by either load.
  local login_gate_err="" login_gate_rc=0
  if [ -n "$login" ]; then
    if ! [[ "$login" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
      _reg_fail "$want_json" "steward registry session add: invalid --login '$login' (allowed: a-z0-9-, must start a-z0-9)" 64
      return 64
    fi
    login_gate_err="$( registry_login_principal_gate "$login" "$account" --login 2>&1 )"; login_gate_rc=$?
    if [ "$login_gate_rc" -ne 0 ]; then
      _reg_fail "$want_json" "steward registry session add: $login_gate_err" "$login_gate_rc"
      return "$login_gate_rc"
    fi
  fi

  # 2. THE TARGET — a TYPED UNION: exactly one of --project/--entity. Both is
  # two contradictory claims about the same session; neither is no claim.
  if [ -n "$project" ] && [ -n "$entity" ]; then
    _reg_fail "$want_json" "steward registry session add: --project and --entity are a typed union — give exactly one" 64
    return 64
  fi
  if [ -z "$project" ] && [ -z "$entity" ]; then
    _reg_fail "$want_json" "steward registry session add: a target is required — --project <slug> or --entity <slug>" 64
    return 64
  fi
  local tkind tslug
  if [ -n "$project" ]; then tkind="project"; tslug="$project"; else tkind="entity"; tslug="$entity"; fi
  if ! [[ "$tslug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry session add: invalid --$tkind '$tslug' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  # SUBSHELLED resolve — the display will be DERIVED from this reference on
  # every read, so a target that does not resolve today would mint a row
  # whose display refuses tomorrow.
  local load_rc
  if [ "$tkind" = "project" ]; then
    ( registry_project_load "$tslug" >/dev/null 2>&1 ); load_rc=$?
  else
    ( registry_entity_load "$tslug" >/dev/null 2>&1 ); load_rc=$?
  fi
  if [ "$load_rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry session add: --$tkind '$tslug' does not resolve to a valid $tkind" 78
    return 78
  fi

  # 3. THE SLUG, and THE COMPOSITE GATE — (ACCOUNT, SLUG) is unique. The
  # helper was built and tested ahead of this verb (lib/registry.sh); this
  # is the step that finally wires it in.
  [ -n "$slug" ] || { _reg_fail "$want_json" "steward registry session add: --slug is required" 64; return 64; }
  if ! [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry session add: invalid --slug '$slug' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  if ! registry_account_slug_available "$account" "$slug"; then
    _reg_fail "$want_json" "steward registry session add: slug '$slug' is already taken in account '$account'" 65
    return 65
  fi

  # 4. THE REPO — an absolute path, no dot-dot, no control bytes. The value
  # is stored verbatim (escaped by the serializer), never interpreted here.
  [ -n "$repo" ] || { _reg_fail "$want_json" "steward registry session add: --repo is required" 64; return 64; }
  case "$repo" in
    *[[:cntrl:]]*)
      _reg_fail "$want_json" "steward registry session add: --repo contains a control character or newline" 64
      return 64 ;;
    *..*)
      _reg_fail "$want_json" "steward registry session add: --repo must not contain '..'" 64
      return 64 ;;
    /*) ;;
    *)
      _reg_fail "$want_json" "steward registry session add: --repo must be an absolute path" 64
      return 64 ;;
  esac

  # 5. THE HOST — the account's host. An explicit different host would create
  # a row that the strict reader immediately refuses.
  if [ -z "$host" ]; then
    host="$account_host"
  fi
  if ! [[ "$host" =~ ^[a-z][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry session add: invalid --host '$host' (allowed: a-z, then a-z0-9-)" 64
    return 64
  fi
  if [ "$host" != "$account_host" ]; then
    _reg_fail "$want_json" "steward registry session add: --host '$host' does not match account '$account' host '$account_host'" 78
    return 78
  fi

  # 6. MINT THE ID — opaque, immutable, and NEVER derived from account or
  # slug (the design's one-way door: an id that encoded either would change
  # identity on an account move). Sixteen hex digits from urandom behind the
  # fixed "s-" mark. The shared writer below is create-only and refuses an
  # existing file anyway; the remint loop here is the belt on top — a
  # colliding mint retries instead of surfacing as a writer refusal, and a
  # machine whose entropy source cannot produce a fresh id in a handful of
  # tries refuses loudly rather than looping forever.
  #
  # FLAT STORAGE, CHOSEN EXPLICITLY: the minted id is the FILENAME, and the
  # account-scoped slug lives as a FIELD — see registry_session_write
  # (lib/registry.sh) for the full note.
  local dir id="" candidate tries=0
  dir="$(registry_dir)"
  while [ "$tries" -lt 5 ]; do
    candidate="s-$(head -c 8 /dev/urandom 2>/dev/null | od -An -tx1 | tr -d ' \n')"
    if [[ "$candidate" =~ ^s-[0-9a-f]{16}$ ]] && [ ! -e "$dir/$candidate.conf" ]; then
      id="$candidate"; break
    fi
    tries=$((tries+1))
  done
  if [ -z "$id" ]; then
    _reg_fail "$want_json" "steward registry session add: could not mint a unique id" 70
    return 70
  fi

  # 7. SERIALIZE — every value through _registry_emit_kv, its refusal
  # captured, never leaked to real stderr. Only --repo can still carry a
  # byte the serializer refuses (everything else is shape-locked above);
  # any other refusal here is a bug, reported as one (rc 70).
  local kv_id kv_account kv_slug kv_target kv_domain kv_host kv_repo kv_owner kv_pm rc kv_err
  kv_err="$(mktemp)" || { _reg_fail "$want_json" "steward registry session add: cannot create a temporary file" 70; return 70; }
  kv_repo="$(_registry_emit_kv REPO_PATH "$repo" 2>"$kv_err")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$kv_err"
    _reg_fail "$want_json" "steward registry session add: --repo contains a control character or newline" 64
    return 64
  fi
  kv_id="$(_registry_emit_kv ID "$id" 2>"$kv_err")"; rc=$?
  [ "$rc" -eq 0 ] && { kv_account="$(_registry_emit_kv ACCOUNT "$account" 2>"$kv_err")"; rc=$?; }
  [ "$rc" -eq 0 ] && { kv_slug="$(_registry_emit_kv SLUG "$slug" 2>"$kv_err")"; rc=$?; }
  if [ "$rc" -eq 0 ]; then
    if [ "$tkind" = "project" ]; then
      kv_target="$(_registry_emit_kv TARGET_PROJECT "$tslug" 2>"$kv_err")"; rc=$?
    else
      kv_target="$(_registry_emit_kv TARGET_ENTITY "$tslug" 2>"$kv_err")"; rc=$?
    fi
  fi
  # DOMAIN DERIVES TO THE TARGET SLUG. The display derives from the target, but
  # DOMAIN is NOT dropped: the Linux supervisor sources the conf raw and refuses
  # a session with no DOMAIN (it builds the per-domain credential directory from
  # it). `migrate-session` writes the same derived value, so the two verbs agree.
  [ "$rc" -eq 0 ] && { kv_domain="$(_registry_emit_kv DOMAIN "$tslug" 2>"$kv_err")"; rc=$?; }
  [ "$rc" -eq 0 ] && { kv_host="$(_registry_emit_kv HOST "$host" 2>"$kv_err")"; rc=$?; }
  [ "$rc" -eq 0 ] && { kv_owner="$(_registry_emit_kv OWNER "$account_username" 2>"$kv_err")"; rc=$?; }
  [ "$rc" -eq 0 ] && { kv_pm="$(_registry_emit_kv PERMISSION_MODE "bypassPermissions" 2>"$kv_err")"; rc=$?; }
  # EMPTY SLUG => NO LINE. `_registry_emit_kv LOGIN ""` would write LOGIN="",
  # and an EMPTY row is not the same as a MISSING one: registry_load reads
  # both as empty today, but the schema gate should be able to tell "nobody
  # said anything" from "somebody wrote an empty value" the day that question
  # is asked.
  local kv_login=""
  if [ "$rc" -eq 0 ] && [ -n "$login" ]; then
    kv_login="$(_registry_emit_kv LOGIN "$login" 2>"$kv_err")"; rc=$?
  fi
  rm -f "$kv_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry session add: could not serialize the row" 70
    return 70
  fi

  _REGW_EXPECT_ID="$id"
  _REGW_EXPECT_ACCOUNT="$account"
  _REGW_EXPECT_SLUG="$slug"
  if [ "$tkind" = "project" ]; then
    _REGW_EXPECT_TARGET_PROJECT="$tslug"; _REGW_EXPECT_TARGET_ENTITY=""
  else
    _REGW_EXPECT_TARGET_ENTITY="$tslug"; _REGW_EXPECT_TARGET_PROJECT=""
  fi
  _REGW_EXPECT_HOST="$host"
  _REGW_EXPECT_REPO_PATH="$repo"
  _REGW_EXPECT_OWNER="$account_username"
  _REGW_EXPECT_PERMISSION_MODE="bypassPermissions"
  _REGW_EXPECT_LOGIN="$login"
  local rw_err; rw_err="$(mktemp)" || {
    _reg_fail "$want_json" "steward registry session add: cannot create a temporary file" 70
    return 70
  }
  # HEADER + TRAILING NEWLINE — see the matching comment in
  # cmd_registry_team_add. No RC_LABEL line — deliberate (the display derives).
  # DOMAIN IS written, derived to the target slug — see the emit above. LOGIN
  # is LAST and only present when kv_login is non-empty — see the emit above;
  # its ORDER does not matter to the reader but keeps the diff readable, and
  # matches where task 11 writes the field by hand.
  local content
  content="$(printf '# %s — session, written by steward registry session add.\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s' \
    "$id" "$kv_id" "$kv_account" "$kv_slug" "$kv_target" "$kv_domain" "$kv_host" "$kv_repo" "$kv_owner" "$kv_pm" "$kv_login")"$'\n'
  registry_session_write "$id" "$content" _registry_validate_session_stage 2>"$rw_err"
  rc=$?
  local rw_msg; rw_msg="$(cat "$rw_err")"; rm -f "$rw_err"
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry session add: $rw_msg" "$rc"
    return "$rc"
  fi

  local file="$dir/$id.conf"
  # THE RECEIPT SAYS THE ROW IS MUTE. This verb writes the row and nothing
  # else: no relay key under the owner's ~/.ssh, no line in the hub's
  # authorized_keys — and no verb mints those for an already written row
  # (session-new.sh mints conf and key together, through enroll). A session
  # started on this row alone reads its mail and can never answer it. The
  # fact is constant — the id was minted this very call — so it is STATED,
  # not measured: relay_key:false in --json, a second line in text.
  if [ -n "$want_json" ]; then
    # login IS PRESENT IN THE REPORT ONLY WHEN IT WAS GIVEN — same "no line
    # without --login" symmetry the row itself carries. A present-but-empty
    # key would say "this session declared an empty login", which is not
    # what an absent --login means.
    if [ -n "$login" ]; then
      jq -cn --arg id "$id" --arg account "$account" --arg slug "$slug" \
        --arg tkind "$tkind" --arg tslug "$tslug" --arg host "$host" \
        --arg owner "$account_username" --arg repo "$repo" --arg file "$file" --arg login "$login" \
        '{ok:true,kind:"session",id:$id,account:$account,slug:$slug,target:{kind:$tkind,slug:$tslug},host:$host,owner:$owner,repo:$repo,file:$file,login:$login,relay_key:false}'
    else
      jq -cn --arg id "$id" --arg account "$account" --arg slug "$slug" \
        --arg tkind "$tkind" --arg tslug "$tslug" --arg host "$host" \
        --arg owner "$account_username" --arg repo "$repo" --arg file "$file" \
        '{ok:true,kind:"session",id:$id,account:$account,slug:$slug,target:{kind:$tkind,slug:$tslug},host:$host,owner:$owner,repo:$repo,file:$file,relay_key:false}'
    fi
  else
    printf 'steward: wrote %s.conf into the session register (slug %s in account %s, on %s %s, host %s)\n' \
      "$id" "$slug" "$account" "$tkind" "$tslug" "$host"
    printf 'steward: the row has no relay key — it cannot send on the bus until ~/.ssh/id_busrelay_%s exists in the owner'"'"'s home and the hub'"'"'s authorized_keys carries it; this verb never mints either (session-new.sh, run from a registered pane, mints conf and key together)\n' \
      "$id"
  fi
  return 0
}

# cmd_registry_session_check <id> [--json] — MEASURE a row's ability to speak,
# and say plainly what could not be measured from here.
#
# WHY IT EXISTS. `registry session add` writes a row and mints nothing: no relay
# key in the owner's home, no line in the hub's authorized_keys. Such a row
# RECEIVES mail perfectly and cannot answer, which reads as a silent session
# rather than as a missing key - measured twice in one day on this estate, once
# on each of two hosts, and both times the cause was found only after somebody
# waited for a reply that was never coming.
#
# WHAT IT REFUSES TO GUESS. Homes are 0750. Run as the hub, this verb CANNOT see
# /home/<somebody>/.ssh, and an unreadable directory is not an absent key. So
# every line says measured / not measured, and the second kind names why. A
# check that reported "key missing" for a key it merely could not see would send
# its reader to mint a second key over a working one.
cmd_registry_session_check() {
  local want_json="" args=() a
  for a in "$@"; do
    case "$a" in --json) want_json=1 ;; *) args+=("$a") ;; esac
  done
  local id="${args[0]:-}"
  [ -n "$id" ] || { _reg_fail "$want_json" "steward registry session check: needs a session id"; return 64; }

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  local conf conf_state="missing" owner="" slug="" host="" load_err="" load_rc=0 load_errf=""
  local _sc_row="" _sc_rest=""
  conf="$(registry_dir)/$id.conf"
  if [ -f "$conf" ]; then
    load_errf="$(mktemp 2>/dev/null)" || {
      _reg_fail "$want_json" "steward registry session check: cannot create a temporary file" 70
      return 70
    }
    # THE ROW IS SOURCED IN A CHILD PROCESS, NOT IN THIS FRAME. The loader's
    # own wall (_registry_source_row) stops a row from reaching the LOADER's
    # locals; it cannot stop one from reaching THIS verb's, because bash scope
    # is dynamic and every local declared above registry_load is still live
    # beneath it. Both of the ones read after the load were writable by the
    # row: `id`, which names the session in every line of output and builds
    # the relay-key path, and `want_json`, which decides the FORMAT - so a row
    # carrying id="<another row>" and want_json=1 made this verb report
    # another session's id and relay key in JSON nobody asked for. Measured on
    # the real CLI against a fixture.
    #
    # THE SUBSHELL IS THE CODEBASE'S OWN ANSWER - the shape
    # registry_session_display uses for the same reason. Only the three fields
    # named below cross back, as text; nothing the conf assigns survives the
    # fork. HOST is validated non-empty by the loader, so the trailing field
    # cannot be collapsed by command substitution stripping newlines, and SLUG
    # may be empty without shifting the ones around it.
    _sc_row="$( registry_load "$id" >/dev/null 2>"$load_errf" \
                && printf '%s\n%s\n%s\n' "${OWNER:-}" "${SLUG:-}" "${HOST:-}" )"
    load_rc=$?
    load_err="$(cat "$load_errf" 2>/dev/null)"; rm -f "$load_errf"
    if [ "$load_rc" -eq 0 ]; then
      conf_state="ok"
      owner="${_sc_row%%$'\n'*}"
      _sc_rest="${_sc_row#*$'\n'}"
      slug="${_sc_rest%%$'\n'*}"
      host="${_sc_rest#*$'\n'}"
    elif [ "$load_rc" -eq 78 ]; then
      _reg_fail "$want_json" "steward registry session check: $load_err" 78
      return 78
    else
      conf_state="unreadable"
    fi
  fi

  # THE HUB'S authorized_keys LIVES IN THE HUB'S HOME, and $HOME is whoever ran
  # this. Run in a person's own account the file read was THEIRS, and a line
  # that sits with the hub was reported as absent - the exact fault this verb
  # exists to avoid, in the verb itself. Measured 2026-09-07 by running the
  # check as its own subject.
  local hub_row="no" ak="" hub_user="" hub_host="" hub_why=""
  # THE ESTATE'S OWN ACCESSORS, not a name I guessed. My first attempt called a
  # function that does not exist; it failed quietly through 2>/dev/null and the
  # guard below never fired - the check then read the caller's own file again
  # and would have gone on reporting the hub's line as absent. A guard that
  # cannot fail loudly is not a guard.
  hub_host="$(registry_hub_host 2>/dev/null)" || hub_host=""
  hub_user="$(registry_hub_ssh 2>/dev/null)" || hub_user=""
  hub_user="${hub_user%%@*}"
  if [ -n "$hub_user" ] && [ "$hub_user" != "$(id -un)" ]; then
    hub_row="unmeasured"
    hub_why="the hub's authorized_keys is in ${hub_user}'s home${hub_host:+ on $hub_host}, which is not readable from here"
  elif [ -n "$hub_host" ] && [ "$hub_host" != "$(hostname -s 2>/dev/null)" ]; then
    hub_row="unmeasured"
    hub_why="the hub is $hub_host, not this machine"
  fi
  ak="$HOME/.ssh/authorized_keys"
  if [ "$hub_row" = "unmeasured" ]; then :
  elif [ -r "$ak" ]; then
    # THE CLOSING QUOTE IS PART OF THE MATCH. Without it this is a prefix test,
    # and a prefix test on identifiers is how one row answers for another. Ids
    # are fixed-length hex today, so nothing could have collided - but a check
    # that happens to be safe is not the same as one that is.
    grep -q "bus-relay-in $id\"" "$ak" 2>/dev/null && hub_row="yes"
  elif [ -e "$ak" ]; then
    # THE FILE IS THERE AND THIS PROCESS MAY NOT READ IT - which is not the same
    # as "there is no line". Only the second is an answer.
    hub_row="unmeasured"
  fi

  # The key lives in the OWNER's home. Readable only when this process is that
  # owner - which it is when a person runs the check in their own account.
  # WITHOUT A ROW THERE IS NO OWNER, and "the owner's home is not readable" is
  # then the wrong reason for the wrong question - the row is what is missing.
  local key_state="unmeasured" key_why="the owner's home is not readable from here (homes are 0750)"
  [ "$conf_state" = "ok" ] || key_why="there is no row, so there is no owner whose key to look for"
  local keyfile=""
  if [ -n "$owner" ]; then
    # THE CURRENT PROCESS'S OWN HOME when it IS the owner - not a lookup of the
    # name. `~name` answers what the passwd file says, which is right for
    # somebody else and wrong for us: a person running this in their own account
    # (the only way the key is measurable at all) should have their own HOME
    # honoured, fixtures included.
    local home_dir
    if [ "$owner" = "$(id -un)" ]; then home_dir="$HOME"; else home_dir="$(eval echo "~$owner" 2>/dev/null)"; fi
    keyfile="$home_dir/.ssh/id_busrelay_$id"
    if [ -r "$home_dir/.ssh" ]; then
      if [ -e "$keyfile" ]; then key_state="yes"; else key_state="no"; fi
      key_why=""
    fi
  fi

  local speaks="no"
  [ "$conf_state" = "ok" ] && [ "$hub_row" = "yes" ] && [ "$key_state" = "yes" ] && speaks="yes"
  [ "$key_state" = "unmeasured" ] || [ "$hub_row" = "unmeasured" ] && [ "$speaks" = "no" ] && speaks="unknown"

  if [ -n "$want_json" ]; then
    jq -cn --arg id "$id" --arg conf "$conf_state" --arg owner "$owner" --arg slug "$slug" \
      --arg host "$host" --arg hub "$hub_row" --arg key "$key_state" --arg keyfile "$keyfile" \
      --arg why "$key_why" --arg hubwhy "$hub_why" --arg speaks "$speaks" \
      '{ok:true,kind:"session-check",id:$id,conf:$conf,owner:$owner,slug:$slug,host:$host,hub_row:$hub,hub_row_note:$hubwhy,relay_key:$key,relay_key_path:$keyfile,relay_key_note:$why,can_send:$speaks}'
  else
    printf 'session %s%s\n' "$id" "$( [ -n "$slug" ] && printf ' (%s, owner %s, host %s)' "$slug" "$owner" "$host" )"
    printf '  row              %s\n' "$conf_state"
    if [ -n "$hub_why" ]; then
      printf '  hub relay line   not measured - %s\n' "$hub_why"
    else
      printf '  hub relay line   %s\n' "$hub_row"
    fi
    if [ -n "$key_why" ]; then
      printf '  relay key        not measured - %s\n' "$key_why"
      printf '                   run this check in %s'"'"'s own account to measure it\n' "${owner:-the owner}"
    else
      printf '  relay key        %s%s\n' "$key_state" "$( [ -n "$keyfile" ] && printf ' (%s)' "$keyfile" )"
    fi
    case "$speaks" in
      yes) printf '  can send         yes\n' ;;
      no)  printf '  can send         NO - this row receives mail and cannot answer\n'
           printf '                   a sending session is made with session-new.sh from a registered pane;\n'
           printf '                   registry session add never mints a key or a hub line\n' ;;
      *)   printf '  can send         unknown - see the unmeasured lines above\n' ;;
    esac
  fi
  return 0
}

# -- INVITATIONS ------------------------------------------------------------
#
# Registration is CLOSED. `invite issue` records the operator's word, prints
# the one-time link ONCE, and stores only the digest; `invite ls` reads the
# register; `invite revoke` moves a row to revoked. Redemption is its own verb.

# _invite_validate_row <staged-file> - the validate_fn both the invite writer
# and the invite replace call under the register's write lock. It does NOT
# source what it validates (this register's reader never does either): the
# staged bytes are copied into a one-row register and read back through
# registry_invite_load, so "valid" means exactly what every later reader will
# see. Same technique as _registry_validate_login_stage.
_invite_validate_row() {
  local file="$1" dir rc=0
  # THE ROW ON DISK IS RE-READ HERE, AND ONLY HERE. Every in-place update
  # (revoke today, redeem next) reads the row, recomposes all thirteen fields
  # from that read, and only then asks for the write lock - so a change that
  # lands in between is invisible to the caller and would be published straight
  # over. The validate_fn is the one place that runs INSIDE the lock while the
  # current bytes are still on disk, which makes it the only place that can
  # compare against them. A row that moved is refused, never merged: the caller
  # measured its decision against a state that no longer exists, so the right
  # answer is to run the verb again, not to guess which half to keep.
  #
  # Empty _REGW_INV_RECHECK_ID means "this row is new" (registry_invite_write's
  # path) - there is nothing on disk to compare against, and the writer already
  # refuses a destination that exists.
  local rid="${_REGW_INV_RECHECK_ID:-}"
  if [ -n "$rid" ]; then
    local rk rvar rgot rwant
    for rk in STATE TOKEN_SHA256 REDEEMED_LOGIN REDEEMED_AT; do
      rvar="INVITE_$rk"
      rgot="$( registry_invite_load "$rid" >/dev/null 2>&1; printf '%s' "${!rvar}" )"
      eval "rwant=\"\${_REGW_RECHECK_INV_$rk:-}\""
      if [ "$rgot" != "$rwant" ]; then
        echo "registry: invitation '$rid' changed on disk while this update was being prepared - $rk is now '$rgot', was '$rwant'; refusing to overwrite it, run the verb again" >&2
        return 70
      fi
    done
  fi
  dir="$(mktemp -d)" || { echo "registry: cannot stage-validate an invite row" >&2; return 70; }
  cp "$file" "$dir/inv-00000000.conf" || { rm -rf "$dir"; return 70; }
  chmod 600 "$dir/inv-00000000.conf"
  ( STEWARD_INVITE_DIR="$dir"; registry_invite_load inv-00000000 >/dev/null 2>&1 ) || rc=70
  if [ "$rc" -ne 0 ]; then
    rm -rf "$dir"
    echo "registry: the staged invite row does not parse with the register's own reader: $file" >&2
    return 70
  fi
  # THE FIELD NAME IS RESOLVED THROUGH INDIRECT EXPANSION, NOT AN INLINE `case`
  # INSIDE $( ) - bash 3.2 (macOS) mis-parses that shape, and this file runs on
  # it. See the same note in _registry_validate_login_stage.
  local got k varname want
  for k in NAME PRINCIPAL ENTITY HOST RUNTIME PROVIDER TOKEN_SHA256 ISSUED_BY \
           ISSUED_AT EXPIRES_AT STATE REDEEMED_LOGIN REDEEMED_AT; do
    varname="INVITE_$k"
    got="$( STEWARD_INVITE_DIR="$dir"; registry_invite_load inv-00000000 >/dev/null 2>&1; printf '%s' "${!varname}" )"
    eval "want=\"\${_REGW_EXPECT_INV_$k:-}\""
    if [ "$got" != "$want" ]; then
      rm -rf "$dir"
      echo "registry: staged invite row's $k does not match what was written: $file" >&2
      return 70
    fi
  done
  rm -rf "$dir"
  return 0
}

# _invite_compose - the row's bytes, from the _REGW_EXPECT_INV_* values the
# caller has already set. ONE serializer for issue, revoke and redeem, so the
# three can never write three different shapes of the same row.
#
# The optional pair is written only when it has a value: a redeemed row carries
# REDEEMED_LOGIN/REDEEMED_AT, an open one carries no empty lines for them.
_invite_compose() { # <id>
  local id="$1" k kv line body="" kv_err rc
  kv_err="$(mktemp)" || return 70
  for k in NAME PRINCIPAL ENTITY HOST RUNTIME PROVIDER TOKEN_SHA256 ISSUED_BY \
           ISSUED_AT EXPIRES_AT STATE REDEEMED_LOGIN REDEEMED_AT; do
    eval "kv=\"\${_REGW_EXPECT_INV_$k:-}\""
    case "$k" in
      REDEEMED_LOGIN|REDEEMED_AT) [ -n "$kv" ] || continue ;;
    esac
    line="$(_registry_emit_kv "$k" "$kv" 2>"$kv_err")"; rc=$?
    if [ "$rc" -ne 0 ]; then rm -f "$kv_err"; return 64; fi
    body="$body$line
"
  done
  rm -f "$kv_err"
  printf '# %s - invitation, written by steward invite.\n%s' "$id" "$body"
}

# _invite_load_expect <id> - load a row and copy every field into the
# _REGW_EXPECT_INV_* values, so a caller can change ONE of them and recompose
# the whole row without retyping the rest.
#
# IT ALSO RECORDS WHAT IT SAW, in _REGW_INV_RECHECK_ID and the
# _REGW_RECHECK_INV_* snapshot. This read happens outside the write lock, so
# _invite_validate_row re-takes it under the lock and refuses if the row moved
# in between. Recording it HERE rather than in each verb means every future
# in-place update inherits the guard by using the loader, instead of having to
# remember it.
_invite_load_expect() { # <id>
  registry_invite_load "$1" || return $?
  _REGW_EXPECT_INV_NAME="$INVITE_NAME"
  _REGW_EXPECT_INV_PRINCIPAL="$INVITE_PRINCIPAL"
  _REGW_EXPECT_INV_ENTITY="$INVITE_ENTITY"
  _REGW_EXPECT_INV_HOST="$INVITE_HOST"
  _REGW_EXPECT_INV_RUNTIME="$INVITE_RUNTIME"
  _REGW_EXPECT_INV_PROVIDER="$INVITE_PROVIDER"
  _REGW_EXPECT_INV_TOKEN_SHA256="$INVITE_TOKEN_SHA256"
  _REGW_EXPECT_INV_ISSUED_BY="$INVITE_ISSUED_BY"
  _REGW_EXPECT_INV_ISSUED_AT="$INVITE_ISSUED_AT"
  _REGW_EXPECT_INV_EXPIRES_AT="$INVITE_EXPIRES_AT"
  _REGW_EXPECT_INV_STATE="$INVITE_STATE"
  _REGW_EXPECT_INV_REDEEMED_LOGIN="$INVITE_REDEEMED_LOGIN"
  _REGW_EXPECT_INV_REDEEMED_AT="$INVITE_REDEEMED_AT"
  # The snapshot the under-lock recheck compares against. STATE and the
  # REDEEMED pair are what a concurrent redemption moves; TOKEN_SHA256 is what
  # a re-issue would move, and it is the field that decides whose link opens
  # this row.
  _REGW_INV_RECHECK_ID="$1"
  _REGW_RECHECK_INV_STATE="$INVITE_STATE"
  _REGW_RECHECK_INV_TOKEN_SHA256="$INVITE_TOKEN_SHA256"
  _REGW_RECHECK_INV_REDEEMED_LOGIN="$INVITE_REDEEMED_LOGIN"
  _REGW_RECHECK_INV_REDEEMED_AT="$INVITE_REDEEMED_AT"
  return 0
}

# _invite_self_principal - which principal is running this verb, measured from
# the register rather than typed. The unix account this process runs as is
# matched against accounts.d; its PRINCIPAL is the answer.
#
# A UNIX USERNAME IS UNIQUE ON A HOST, NEVER ACROSS AN ESTATE. `alice` on two
# machines is two accounts.d rows and may be two different humans, so matching
# on the username alone leaves a set, and taking the first member of that set
# means taking whichever slug sorts first. ISSUED_BY is the only record of who
# let a stranger into the estate; a field that can name the wrong human is worse
# than no field. So the set is narrowed by ACCOUNT_HOST against this machine,
# and an answer that is still not unique is REFUSED - the same shape every other
# lookup in this register uses (registry_invite_for_digest,
# registry_invite_open_for_principal, registry_principal_for_login all refuse
# rather than choose).
#
#   rc 0  - the principal, on stdout
#   rc 1  - no account row names this unix username
#   rc 2  - more than one does, and this machine's host row does not separate
#           them; the candidates are on stdout, one per line, so the caller's
#           refusal can name them next to --issued-by
#   rc 78 - the account register cannot be resolved
_invite_self_principal() {
  local me self d f slug u h p cands="" hits=0 last_p="" here_p="" here_n=0
  me="$(id -un)"
  self="$(_registry_self_host)"
  d="$(registry_account_dir)" || return 78
  [ -d "$d" ] || return 1
  for f in "$d"/*.conf; do
    [ -e "$f" ] || continue
    slug="$(basename "$f" .conf)"
    # ONE SUBSHELLED LOAD PER FIELD. The loader sources the row, so a hostile
    # accounts.d file gets a child process of its own and only the one named
    # value crosses back into these locals.
    u="$( registry_account_load "$slug" >/dev/null 2>&1 && printf '%s' "$ACCOUNT_USERNAME" )"
    [ "$u" = "$me" ] || continue
    p="$( registry_account_load "$slug" >/dev/null 2>&1 && printf '%s' "$ACCOUNT_PRINCIPAL" )"
    [ -n "$p" ] || continue
    h="$( registry_account_load "$slug" >/dev/null 2>&1 && printf '%s' "$ACCOUNT_HOST" )"
    hits=$((hits+1)); last_p="$p"
    cands="$cands$p (account $slug on host $h)
"
    if [ -n "$self" ] && [ "$h" = "$self" ]; then here_p="$p"; here_n=$((here_n+1)); fi
  done
  [ "$hits" -gt 0 ] || return 1
  # ONE MATCH NEEDS NO HOST. A single account for this unix username is not
  # ambiguous whatever the machine is called, and requiring the host to agree
  # would refuse every estate whose hosts.d slug is not this machine's
  # hostname - a naming choice, not a safety property.
  if [ "$hits" -eq 1 ]; then printf '%s\n' "$last_p"; return 0; fi
  if [ "$here_n" -eq 1 ]; then printf '%s\n' "$here_p"; return 0; fi
  printf '%s' "$cands"
  return 2
}

cmd_invite_issue() {
  local want_json="" name="" principal="" entity="" host="" runtime="claude-code" \
        provider="claude-max" days="7" issued_by="" a
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) shift ;;
      --name)      [ $# -ge 2 ] || { _reg_fail "$want_json" "steward invite issue: --name needs a value"; return 64; };      name="$2"; shift 2 ;;
      --principal) [ $# -ge 2 ] || { _reg_fail "$want_json" "steward invite issue: --principal needs a value"; return 64; }; principal="$2"; shift 2 ;;
      --entity)    [ $# -ge 2 ] || { _reg_fail "$want_json" "steward invite issue: --entity needs a value"; return 64; };    entity="$2"; shift 2 ;;
      --host)      [ $# -ge 2 ] || { _reg_fail "$want_json" "steward invite issue: --host needs a value"; return 64; };      host="$2"; shift 2 ;;
      --runtime)   [ $# -ge 2 ] || { _reg_fail "$want_json" "steward invite issue: --runtime needs a value"; return 64; };   runtime="$2"; shift 2 ;;
      --provider)  [ $# -ge 2 ] || { _reg_fail "$want_json" "steward invite issue: --provider needs a value"; return 64; };  provider="$2"; shift 2 ;;
      --days)      [ $# -ge 2 ] || { _reg_fail "$want_json" "steward invite issue: --days needs a value"; return 64; };      days="$2"; shift 2 ;;
      --issued-by) [ $# -ge 2 ] || { _reg_fail "$want_json" "steward invite issue: --issued-by needs a value"; return 64; }; issued_by="$2"; shift 2 ;;
      *) _reg_fail "$want_json" "steward invite issue: unexpected argument '$1'"; return 64 ;;
    esac
  done

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  [ -n "$name" ] || { _reg_fail "$want_json" "steward invite issue: --name is required (the invited person's display name)"; return 64; }
  case "$name" in
    *'$'*|*'`'*|*'\'*|*'"'*)
      _reg_fail "$want_json" "steward invite issue: --name must not contain a quote, a backslash or a substitution character"; return 64 ;;
  esac
  local nm v
  for nm in principal entity host; do
    eval "v=\$$nm"
    [ -n "$v" ] || { _reg_fail "$want_json" "steward invite issue: --$nm is required"; return 64; }
    if ! [[ "$v" =~ ^[a-z][a-z0-9-]*$ ]]; then
      _reg_fail "$want_json" "steward invite issue: invalid --$nm '$v' (a-z, then a-z 0-9 and hyphen)"; return 64
    fi
  done
  case "$runtime" in
    claude-code|opencode|codex) ;;
    *) _reg_fail "$want_json" "steward invite issue: invalid --runtime '$runtime' (one of: claude-code opencode codex)"; return 64 ;;
  esac
  # EXACT MEMBERSHIP, same reason as `registry login add`: a command-line
  # argument is free text, and the substring form accepted a value spanning
  # two entries.
  if ! _registry_word_in_list "$provider" "$_REGISTRY_LOGIN_PROVIDERS"; then
    _reg_fail "$want_json" "steward invite issue: invalid --provider '$provider' (one of: $_REGISTRY_LOGIN_PROVIDERS)"; return 64
  fi
  if ! [[ "$days" =~ ^[0-9]+$ ]] || [ "$days" -lt 1 ] || [ "$days" -gt 365 ]; then
    _reg_fail "$want_json" "steward invite issue: --days must be a whole number of days between 1 and 365"; return 64
  fi

  # THE PRINCIPAL MUST NOT EXIST. An invitation MINTS a principal; aiming one at
  # a person who already has a row would bind a second identity to them through
  # a door meant for strangers.
  if [ -e "$(registry_principal_dir)/$principal.conf" ]; then
    _reg_fail "$want_json" "steward invite issue: principal '$principal' already exists - an invitation mints a principal, it does not extend one"
    return 65
  fi
  if ! ( registry_entity_load "$entity" >/dev/null 2>&1 ); then
    _reg_fail "$want_json" "steward invite issue: no such entity '$entity' - register the entity before inviting somebody into it"
    return 65
  fi
  if ! ( registry_host_load "$(registry_host_dir)/$host.conf" >/dev/null 2>&1 ); then
    _reg_fail "$want_json" "steward invite issue: no such host '$host' - the account and the first session live on a host the register knows"
    return 65
  fi
  local open_id
  open_id="$(registry_invite_open_for_principal "$principal" 2>/dev/null)" || open_id=""
  if [ -n "$open_id" ]; then
    _reg_fail "$want_json" "steward invite issue: an open invitation for '$principal' already exists: $open_id - revoke it or let it expire"
    return 65
  fi
  if [ -z "$issued_by" ]; then
    local self_out self_rc
    self_out="$(_invite_self_principal)"; self_rc=$?
    if [ "$self_rc" -eq 2 ]; then
      _reg_fail "$want_json" "steward invite issue: more than one account names the unix user running this verb and none of them belongs to this machine, so who is issuing cannot be measured - pass --issued-by <slug>; candidates: $(printf '%s' "$self_out" | tr '\n' ' ')"
      return 65
    fi
    if [ "$self_rc" -eq 0 ]; then issued_by="$self_out"; else issued_by=""; fi
  fi
  if [ -z "$issued_by" ]; then
    _reg_fail "$want_json" "steward invite issue: could not resolve which principal is issuing this invitation from the account register - pass --issued-by <slug>"
    return 65
  fi
  if ! [[ "$issued_by" =~ ^[a-z][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward invite issue: invalid --issued-by '$issued_by'"; return 64
  fi

  # THE LIBRARY'S MESSAGE, IN THIS VERB'S SHAPE. A missing DESK_ORIGIN is the
  # refusal a fresh estate is most likely to hit, and it used to be the one
  # refusal a --json caller got as rc 78 with an empty stdout - a front end
  # parsing that gets a parse error where every other refusal hands it
  # {ok:false,reason}. The reason text stays the library's; only the envelope
  # is this verb's.
  local origin oerr
  oerr="$(mktemp)" || { _reg_fail "$want_json" "steward invite issue: cannot create a temporary file"; return 70; }
  origin="$(registry_desk_origin 2>"$oerr")" || {
    _reg_fail "$want_json" "steward invite issue: $(tr '\n' ' ' < "$oerr")"
    rm -f "$oerr"; return 78; }
  rm -f "$oerr"

  # THE SAME ENVELOPE FOR THE THREE THAT FOLLOW, and for the same reason. All
  # three were `|| return 70/78` with the library's prose on stderr and an empty
  # stdout, which is precisely what the origin refusal above was fixed for
  # eleven lines earlier in this function. The reason text stays the library's;
  # only the envelope is this verb's. NOTHING HERE ECHOES THE TOKEN: the mint's
  # own refusals name what it could not do, never what it made.
  local id token digest now expires merr
  merr="$(mktemp)" || { _reg_fail "$want_json" "steward invite issue: cannot create a temporary file"; return 70; }
  id="$(registry_invite_mint_id 2>"$merr")" || {
    _reg_fail "$want_json" "steward invite issue: $(tr '\n' ' ' < "$merr")"
    rm -f "$merr"; return 70; }
  token="$(registry_invite_mint_token 2>"$merr")" || {
    _reg_fail "$want_json" "steward invite issue: $(tr '\n' ' ' < "$merr")"
    rm -f "$merr"; return 70; }
  digest="$(printf '%s' "$token" | _registry_sha256 2>"$merr")" || {
    _reg_fail "$want_json" "steward invite issue: $(tr '\n' ' ' < "$merr")"
    rm -f "$merr"; return 78; }
  rm -f "$merr"
  now="$(date -u +%s)"
  expires=$((now + days * 86400))

  _REGW_EXPECT_INV_NAME="$name"
  _REGW_EXPECT_INV_PRINCIPAL="$principal"
  _REGW_EXPECT_INV_ENTITY="$entity"
  _REGW_EXPECT_INV_HOST="$host"
  _REGW_EXPECT_INV_RUNTIME="$runtime"
  _REGW_EXPECT_INV_PROVIDER="$provider"
  _REGW_EXPECT_INV_TOKEN_SHA256="$digest"
  _REGW_EXPECT_INV_ISSUED_BY="$issued_by"
  _REGW_EXPECT_INV_ISSUED_AT="$now"
  _REGW_EXPECT_INV_EXPIRES_AT="$expires"
  _REGW_EXPECT_INV_STATE="open"
  _REGW_EXPECT_INV_REDEEMED_LOGIN=""
  _REGW_EXPECT_INV_REDEEMED_AT=""
  # NOTHING TO RECHECK: this row does not exist yet, and the writer refuses a
  # destination that does. Set explicitly rather than left unset, so the
  # validator's guard is off by decision and not by accident.
  _REGW_INV_RECHECK_ID=""

  local content rc rw_err
  content="$(_invite_compose "$id")" || {
    _reg_fail "$want_json" "steward invite issue: a field carries a control character or newline"; return 64; }
  rw_err="$(mktemp)" || { _reg_fail "$want_json" "steward invite issue: cannot create a temporary file"; return 70; }
  registry_invite_write "$id" "$content" _invite_validate_row 2>"$rw_err"; rc=$?
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward invite issue: $(tr '\n' ' ' < "$rw_err")"
    rm -f "$rw_err"
    return "$rc"
  fi
  rm -f "$rw_err"

  # THE LINK IS PRINTED HERE AND NOWHERE ELSE, EVER. The row holds the digest;
  # there is no path in the product that can print this string a second time.
  local link="$origin/desk/invite/$token"
  if [ -n "$want_json" ]; then
    # _json_secret, NOT _json: the link is the one value in this object that
    # must not reach jq's argv, where every account on the host could read it.
    _json_secret link "$link" \
      ok true kind invite id "$id" principal "$principal" entity "$entity" host "$host" \
      runtime "$runtime" provider "$provider" expires "$expires"
  else
    printf 'steward: invitation %s for %s (%s) on %s, valid %s day(s)\n' \
      "$id" "$principal" "$name" "$host" "$days"
    printf 'steward: this link is shown ONCE and is stored nowhere - send it now:\n'
    printf '%s\n' "$link"
  fi
  return 0
}

# _invite_ls_unreadable <id> <errfile> - one stderr line for a row the register
# lists but its reader refuses. The reader's own words are carried through
# (folded to one line), because "not owned by the current user" and "missing
# required key" call for different repairs.
_invite_ls_unreadable() {
  local id="$1" ef="$2" why=""
  [ -f "$ef" ] && why="$(tr '\n' ' ' < "$ef")"
  [ -n "$why" ] || why="the register's own reader refused it"
  printf 'steward invite ls: invitation %s could not be read and is NOT listed above as a normal row: %s\n' \
    "$id" "$why" >&2
}

# cmd_invite_ls - the register, as columns or as JSON.
#
# THE TOKEN CANNOT APPEAR HERE, and not because this function is careful: the
# register holds a digest and nothing else, so there is no token in scope to
# print. Storing only the digest is what makes that true.
#
# EXPIRES IS PRINTED IN THE REGISTER'S OWN UNIT (epoch seconds). Formatting it
# would need a date(1) whose flags differ between the two systems this file
# runs on, and the operational answer - is this invitation still good - is
# already in STATE, which reads `expired` the moment the clock passes it.
#
# NAME IS LAST because it is the one free-text field: a display name carries
# spaces, and a column of them anywhere but the end would break every column
# after it.
#
# A ROW THE READER REFUSES IS NAMED, NEVER DROPPED. registry_invite_list globs
# the register, so this verb KNOWS the row is there; printing nothing about it
# is the worst of the three options. That row is a live invitation - its digest
# still matches, so redemption may still find it and the open-invite gate skips
# it, which lets issue mint a SECOND invitation for the same person - and the
# operator's only enumeration verb would show neither the row nor a hint that
# anything was skipped. There would be nothing to revoke and nothing to repair.
# The listing still prints every row it CAN read, and the run ends rc 78.
cmd_invite_ls() {
  # --json IS SETTLED BEFORE ANY REFUSAL. The scan below can itself refuse, and
  # a refusal that answers in prose because it had not reached the --json
  # argument yet is a refusal in the wrong shape. issue and revoke pre-scan for
  # the same reason.
  local want_json="" a
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done
  for a in "$@"; do
    case "$a" in
      --json) ;;
      *) _reg_fail "$want_json" "steward invite ls: unexpected argument '$a'"; return 64 ;;
    esac
  done
  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"
  local ids rc=0 lerr bad=0
  lerr="$(mktemp)" || { _reg_fail "$want_json" "steward invite ls: cannot create a temporary file"; return 70; }
  ids="$(registry_invite_list 2>"$lerr")" || {
    rc=$?
    _reg_fail "$want_json" "steward invite ls: $(tr '\n' ' ' < "$lerr")"
    rm -f "$lerr"; return "$rc"; }
  if [ -n "$want_json" ]; then
    local tmp; tmp="$(mktemp)" || { rm -f "$lerr"; return 70; }
    local id
    for id in $ids; do
      ( registry_invite_load "$id" >/dev/null 2>"$lerr" || exit 78
        _json id "$INVITE_ID" name "$INVITE_NAME" principal "$INVITE_PRINCIPAL" \
          entity "$INVITE_ENTITY" host "$INVITE_HOST" runtime "$INVITE_RUNTIME" \
          provider "$INVITE_PROVIDER" state "$INVITE_EFFECTIVE_STATE" \
          issuedBy "$INVITE_ISSUED_BY" issuedAt "$INVITE_ISSUED_AT" \
          expiresAt "$INVITE_EXPIRES_AT" redeemedLogin "$INVITE_REDEEMED_LOGIN" ) >> "$tmp"
      if [ $? -ne 0 ]; then bad=1; _invite_ls_unreadable "$id" "$lerr"; fi
    done
    jq -s . < "$tmp"; rc=$?
    rm -f "$tmp" "$lerr"
    [ "$rc" -eq 0 ] || return "$rc"
    [ "$bad" -eq 0 ] || return 78
    return 0
  fi
  printf '%-12s %-12s %-10s %-10s %-12s %-14s %-9s %-12s %s\n' \
    ID PRINCIPAL ENTITY HOST RUNTIME PROVIDER STATE EXPIRES NAME
  local id
  for id in $ids; do
    ( registry_invite_load "$id" >/dev/null 2>"$lerr" || exit 78
      printf '%-12s %-12s %-10s %-10s %-12s %-14s %-9s %-12s %s\n' \
        "$INVITE_ID" "$INVITE_PRINCIPAL" "$INVITE_ENTITY" "$INVITE_HOST" \
        "$INVITE_RUNTIME" "$INVITE_PROVIDER" "$INVITE_EFFECTIVE_STATE" \
        "$INVITE_EXPIRES_AT" "$INVITE_NAME" )
    if [ $? -ne 0 ]; then
      bad=1
      _invite_ls_unreadable "$id" "$lerr"
      # A PLACEHOLDER ROW, so the count of lines on stdout still matches the
      # count of rows in the register: a listing that is silently one short is
      # the defect this branch exists to end.
      printf '%-12s %-12s %-10s %-10s %-12s %-14s %-9s %-12s %s\n' \
        "$id" "?" "?" "?" "?" "?" "?" "?" "?"
    fi
  done
  rm -f "$lerr"
  [ "$bad" -eq 0 ] || return 78
  return 0
}

cmd_invite_revoke() {
  local want_json="" id="" a
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) shift ;;
      -*) _reg_fail "$want_json" "steward invite revoke: unknown flag '$1'"; return 64 ;;
      *) if [ -n "$id" ]; then _reg_fail "$want_json" "steward invite revoke: one invitation at a time"; return 64; fi
         id="$1"; shift ;;
    esac
  done
  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"
  if ! registry_invite_id_valid "$id"; then
    _reg_fail "$want_json" "steward invite revoke: invalid invitation id '$id' (expected inv- and eight hex digits)"
    return 64
  fi
  if [ ! -f "$(registry_invite_dir)/$id.conf" ]; then
    _reg_fail "$want_json" "steward invite revoke: no such invitation '$id'"
    return 78
  fi
  _invite_load_expect "$id" >/dev/null 2>&1 || {
    _reg_fail "$want_json" "steward invite revoke: invitation '$id' does not load - repair the row"
    return 78; }
  if [ "$INVITE_STATE" = "revoked" ]; then
    if [ -n "$want_json" ]; then _json ok true kind invite id "$id" state revoked changed false
    else printf 'steward: invitation %s is already revoked\n' "$id"; fi
    return 0
  fi
  if [ "$INVITE_STATE" = "redeemed" ]; then
    _reg_fail "$want_json" "steward invite revoke: invitation '$id' was already redeemed - it stays as history; offboard the principal instead"
    return 65
  fi
  _REGW_EXPECT_INV_STATE="revoked"
  local content rc rw_err
  content="$(_invite_compose "$id")" || {
    _reg_fail "$want_json" "steward invite revoke: a field carries a control character or newline"; return 64; }
  rw_err="$(mktemp)" || { _reg_fail "$want_json" "steward invite revoke: cannot create a temporary file"; return 70; }
  registry_invite_replace "$id" "$content" _invite_validate_row 2>"$rw_err"; rc=$?
  if [ "$rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward invite revoke: $(tr '\n' ' ' < "$rw_err")"
    rm -f "$rw_err"; return "$rc"
  fi
  rm -f "$rw_err"
  if [ -n "$want_json" ]; then _json ok true kind invite id "$id" state revoked changed true
  else printf 'steward: invitation %s revoked - the link no longer opens anything\n' "$id"; fi
  return 0
}

# -- REDEMPTION -------------------------------------------------------------
#
# Twelve steps, each with a MARK of its own on disk. The verb never remembers
# where it was: it ASKS, step by step, whether that step's mark is already
# there. A step that fails leaves every earlier mark standing and exits
# non-zero, and the next run continues at the first step whose mark is absent.
# That is the whole resumption design - a progress file could disagree with the
# machine, and the machine is what the next step depends on.
#
# THE FIRST SESSION IS NOT STARTED HERE. It cannot run before the person's own
# model login exists, and that is the Desk's first button, not this verb's job.
#
# EVERY LOCAL IN cmd_invite_redeem IS LOWER CASE, ON PURPOSE. bash scopes
# dynamically, so a local named ACCOUNT or SLUG in this function is visible
# inside every register loader it calls, and a loader that sources a conf
# without declaring that same name local would overwrite it mid-run. The
# registers' own field names are upper case; keeping this verb's names lower
# case means the two sets can never collide.

_REDEEM_LINES=""
_REDEEM_RECEIPT=""
_REDEEM_INVITE=""
_REDEEM_PRINCIPAL=""
_REDEEM_JSON=""
_REDEEM_ENT_RECHECK=""
_REDEEM_ENT_MEMBERS_SEEN=""

# _redeem_note <n> <label> <text> - one receipt line, printed and recorded.
#
# UNDER --json THE LINES GO TO STDERR. The estate's convention for a --json
# verb is one JSON value on stdout and nothing else; twelve prose lines in
# front of it is a parse error for every caller that reads stdout as JSON.
# The lines are not lost - they are the receipt file's whole content, and the
# JSON names that file.
_redeem_note() {
  local line; line="$1/12 $2: $3"
  if [ -n "$_REDEEM_JSON" ]; then printf '%s\n' "$line" >&2
  else printf '%s\n' "$line"; fi
  _REDEEM_LINES="$_REDEEM_LINES$line
"
}

# _redeem_receipt <state> - the receipt file, rewritten after every step so an
# interrupted run leaves the lines it did reach. 0700 directory, 0600 file,
# and never a token: the digest is the only thing about the link that is ever
# written down.
_redeem_receipt() {
  local state="$1"
  [ -n "$_REDEEM_RECEIPT" ] || return 0
  local dir; dir="$(dirname "$_REDEEM_RECEIPT")"
  mkdir -p "$dir" 2>/dev/null || return 0
  chmod 700 "$dir" 2>/dev/null
  local tmp; tmp="$(mktemp "$dir/.receipt.XXXXXX")" || return 0
  printf '%s' "$_REDEEM_LINES" | jq -R -s -c \
    --arg inv "$_REDEEM_INVITE" --arg p "$_REDEEM_PRINCIPAL" --arg st "$state" \
    --argjson at "$(date -u +%s)" \
    '{schemaVersion:1,invite:$inv,principal:$p,state:$st,at:$at,
      lines:(split("\n")|map(select(length>0)))}' > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  chmod 600 "$tmp" 2>/dev/null
  mv "$tmp" "$_REDEEM_RECEIPT" 2>/dev/null
  return 0
}

# _redeem_fail <msg> <rc> - a refusal that writes the receipt before it leaves.
#
# THE REFUSAL GOES INTO THE RECEIPT TOO. The receipt is what the Desk's apply
# step reads back, and a receipt that carried only the steps that worked left
# the reader with "state: failed" and no way to tell WHICH machine said no -
# the sudo refusals below are the case that matters, because the repair is on
# the host and not in the register.
#
# THE REFUSAL WEARS THE SAME SHAPE AS EVERY OTHER ONE THIS VERB MAKES: under
# --json it is _reg_fail's {ok:false,reason}, exactly what the refusals before
# step 1 emit. The Desk's apply step is the specified caller, and one verb
# handing it two different failure shapes depending on which step failed is a
# parser bug waiting in the caller.
_redeem_fail() {
  local msg="steward invite redeem: $1"
  _REDEEM_LINES="$_REDEEM_LINES$msg
"
  _reg_fail "$_REDEEM_JSON" "$msg"
  _redeem_receipt failed
  return "${2:-70}"
}

# _redeem_runas_fail <what-failed> <user> <output> - the refusal for one of the
# five `sudo -n -u <user> ...` calls that write inside the new account's home.
#
# SUDO'S REFUSAL AND THE COMMAND'S REFUSAL ARE DIFFERENT REPAIRS, and only the
# output tells them apart: sudo prefixes its own complaints "sudo:", and a
# command that ran never does. The estate's sudoers line covers the account
# helper and nothing else, so a host set up exactly to the spec refuses every
# one of these five - and reporting that as "could not generate the relay key"
# sends the reader looking at ssh-keygen instead of at sudoers.
_redeem_runas_fail() {
  local what="$1" user="$2" out="$3"
  if printf '%s\n' "$out" | grep -q '^sudo:'; then
    _redeem_fail "$what - and sudo, not the command, is what refused: this host must let the account running the hub use 'sudo -n -u $user' to write inside that account's home, and the estate's sudoers line covers only the account helper. sudo said: $out" 77
    return 77
  fi
  _redeem_fail "$what: $out" 70
  return 70
}

# _account_helper_spoke <combined-output> - rc 0 when the words in that output
# are the ACCOUNT HELPER's own, rc 1 when they are sudo's. ONE classifier, two
# callers: `invite redeem` creates the account, `offboard` locks it, and both
# have to tell "the helper ran and refused" (a failed step, rc 70, quoting the
# helper) from "sudo could not run it at all" (rc 77, naming the sudoers line).
# A second copy of this rule is a second answer to the same question.
#
# rc 77 IS RESERVED FOR "sudo COULD NOT RUN IT AT ALL". The helper's own
# refusals are a step that RAN and said no - telling the operator to fix
# sudoers when the helper is already reachable sends them to the wrong repair.
#
# WHICH OF THE TWO HAPPENED IS READ OFF THE OUTPUT, because a shell has no
# other way to ask: sudo passes the command's exit status straight through, so
# the number alone cannot say whose it is. Nearly every line the helper prints
# - receipt and refusal alike - is prefixed "helper: ", so output with no line
# beginning "helper:" is nearly always output the helper never wrote.
#
# THE ONE THING IT PRINTS WITHOUT THAT PREFIX IS ITS USAGE BANNER, and that is
# not a corner: the helper answers with the banner, on rc 64, for a name
# outside its argument guard and for a sub-command it does not have - the two
# refusals a caller passing a bad argument actually produces. Read as sudo's
# words they became rc 77 "the estate has not installed the sudoers line",
# quoting the helper's own usage text as what sudo said, and sending the reader
# to /etc/sudoers on a host whose sudoers line is working exactly as designed.
# The banner's first line names the binary, so it is as recognisable as the
# prefix is.
#
# THE OUTPUT MUST BE CAPTURED WITH 2>&1 BY THE CALLER, because the receipts and
# refusals the helper writes go to STDERR by contract. A capture that took
# stdout alone would leave this classifier with nothing to read at all.
#
# THE MATCH IS ANCHORED TO THE START OF A LINE, and that anchor is the whole
# finding. The helper's binary is called steward-account-HELPER, so sudo's own
# "unable to execute /usr/local/sbin/steward-account-helper: No such file or
# directory" - the first thing a host without the helper says, and the exact
# case rc 77 exists for - contains the substring "helper: " and used to be
# reported as a helper that ran and refused, with the sudoers line never
# printed.
_account_helper_spoke() {
  printf '%s\n' "${1:-}" | grep -qE '^(helper:|usage: steward-account-helper)'
}

# _redeem_session_id <account> <slug> - the id of the row carrying that pair,
# or nothing. A resumed run has to find the session it created LAST time; the
# id was minted then and is not derivable from anything.
_redeem_session_id() {
  local account="$1" slug="$2" d f a s
  d="$(registry_dir)"
  [ -d "$d" ] || return 1
  for f in "$d"/*.conf; do
    [ -e "$f" ] || continue
    a="$( ACCOUNT=""; source "$f" 2>/dev/null; printf '%s' "$ACCOUNT" )"
    s="$( SLUG="";    source "$f" 2>/dev/null; printf '%s' "$SLUG" )"
    [ "$a" = "$account" ] && [ "$s" = "$slug" ] || continue
    basename "$f" .conf
    return 0
  done
  return 1
}

# _entity_validate_row <staged-file> - the validate_fn for the MEMBERS
# update. Every field of the row is compared, not only the one that changed: a
# serializer that silently dropped MANAGED_BY or MCP_ASSETS would take a
# relation with it, and the row would still look plausible.
#
# NAMED FOR WHAT IT VALIDATES, NOT FOR WHO CALLS IT. `invite redeem` was its
# first caller and `steward offboard` is its second; a shared function named
# for one of two callers is how the next reader learns the wrong ownership.
_entity_validate_row() {
  local file="$1" NAME="" MEMBERS="" MANAGED_BY="" MCP_ASSETS=""
  # shellcheck source=/dev/null
  source "$file" || { echo "registry: staged entity file did not source: $file" >&2; return 70; }
  # THE ROW ON DISK IS RE-READ HERE, UNDER THE LOCK, and compared against what
  # step 5 read before it composed. Step 5's read happens outside the lock, so
  # a second redemption into the same entity - or an operator's own membership
  # edit - landing in between is invisible to it, and the composed row would
  # publish straight over the other membership. A row that moved is refused,
  # never merged: this run measured its decision against a state that no
  # longer exists, and the right answer is to run the verb again. Same rule,
  # and the same reasoning, as _invite_validate_row's own recheck.
  if [ -n "${_REDEEM_ENT_RECHECK:-}" ]; then
    local ent_now
    ent_now="$( registry_entity_load "$_REDEEM_ENT_RECHECK" >/dev/null 2>&1; printf '%s' "$ENTITY_MEMBERS" )"
    if [ "$ent_now" != "${_REDEEM_ENT_MEMBERS_SEEN:-}" ]; then
      echo "registry: entity '$_REDEEM_ENT_RECHECK' changed while redeeming - MEMBERS is now '$ent_now', was '$_REDEEM_ENT_MEMBERS_SEEN'; nothing written, a rerun resumes" >&2
      return 70
    fi
  fi
  local k got want
  for k in NAME MEMBERS MANAGED_BY MCP_ASSETS; do
    eval "got=\$$k"
    eval "want=\"\${_REGW_EXPECT_ENT_$k:-}\""
    if [ "$got" != "$want" ]; then
      echo "registry: staged entity file's $k does not match what was written: $file" >&2
      return 70
    fi
  done
  return 0
}

# _entity_members_replace <slug> <new-members> <label> - rewrite one entity row
# with a new MEMBERS list, through the register's own replace.
#
# ONE BLOCK FOR BOTH CALLERS. `invite redeem` adds a member and `steward
# offboard` removes one, and either side of that single difference the two were
# identical to the character: the same four expectation globals, the same
# serializer loop, the same recheck snapshot, the same call. Two copies of a
# block that takes a register's write lock is two places for the lock
# discipline to drift apart.
#
# THE CALLER HAS ALREADY LOADED THE ROW. ENTITY_NAME, ENTITY_MEMBERS,
# ENTITY_MANAGED_BY and ENTITY_MCP_ASSETS are what registry_entity_load left
# behind, and ENTITY_MEMBERS is the snapshot _entity_validate_row measures the
# row on disk against under the lock. <label> names the verb in the row's own
# header comment and nowhere else.
#
# rc 0 and silence on success. Otherwise the rc and ONE LINE OF MESSAGE on
# stdout - rc 70 when no temporary file can be made, rc 64 when a field carries
# a control character, and otherwise whatever registry_entity_replace answered
# with, quoted. The caller wears its own refusal around that message, because
# only the caller knows which step it is in.
_entity_members_replace() {
  local slug="$1" new_members="$2" label="$3"
  local ec ent_key kv_err ent_content ent_line erc out
  _REDEEM_ENT_RECHECK="$slug"
  _REDEEM_ENT_MEMBERS_SEEN="$ENTITY_MEMBERS"
  _REGW_EXPECT_ENT_NAME="$ENTITY_NAME"
  _REGW_EXPECT_ENT_MEMBERS="$new_members"
  _REGW_EXPECT_ENT_MANAGED_BY="$ENTITY_MANAGED_BY"
  _REGW_EXPECT_ENT_MCP_ASSETS="$ENTITY_MCP_ASSETS"
  kv_err="$(mktemp)" || { echo "cannot create a temporary file"; return 70; }
  ent_content="# $slug - entity, updated by $label."
  for ent_key in NAME MEMBERS MANAGED_BY MCP_ASSETS; do
    eval "ec=\"\${_REGW_EXPECT_ENT_$ent_key:-}\""
    case "$ent_key" in
      MANAGED_BY|MCP_ASSETS) [ -n "$ec" ] || continue ;;
    esac
    ent_line="$(_registry_emit_kv "$ent_key" "$ec" 2>"$kv_err")"; erc=$?
    if [ "$erc" -ne 0 ]; then
      rm -f "$kv_err"
      echo "entity '$slug' carries a control character in $ent_key"
      return 64
    fi
    ent_content="$ent_content
$ent_line"
  done
  rm -f "$kv_err"
  ent_content="$ent_content
"
  out="$(registry_entity_replace "$slug" "$ent_content" _entity_validate_row 2>&1)"; erc=$?
  [ "$erc" -eq 0 ] || { printf '%s\n' "$out"; return "$erc"; }
  return 0
}

cmd_invite_redeem() {
  local want_json="" token="" identity="" email="" a
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done
  while [ $# -gt 0 ]; do
    case "$1" in
      # `--` ENDS THE FLAGS, the one convention that lets a caller hand over a
      # value it did not choose. Tokens are minted without a leading hyphen
      # (registry_invite_mint_token), so this is for the older ones that were
      # not, and for any caller that would rather be explicit than lucky.
      --) shift
          while [ $# -gt 0 ]; do
            if [ -n "$token" ]; then _reg_fail "$want_json" "steward invite redeem: one token at a time"; return 64; fi
            token="$1"; shift
          done ;;
      --json) shift ;;
      # THE TOKEN DOES NOT HAVE TO GO THROUGH argv, AND FOR A PROGRAM IT MUST
      # NOT. On Linux /proc/<pid>/cmdline is world-readable by default, and this
      # verb runs on the very host where every invited member has an account: a
      # positional token is a live one-time invitation link in the process table
      # for as long as the redemption takes, and anybody with a shell there who
      # runs `ps` during it can open that link and bind THEIR identity to the
      # invited principal. Everything else in this flow is already careful - the
      # row holds only TOKEN_SHA256, _json_secret keeps the link out of jq's
      # argv, the receipt carries the identity and never the token - so this was
      # the one live credential handed over in the clear.
      #
      # ADDITIVE, NOT A REPLACEMENT. The positional form is what a human at a
      # terminal types and it is unchanged; `--token-file` and `-` are what a
      # program uses. Either way the value stays in this shell: it is digested
      # here, and only the digest is ever passed on.
      --token-file) [ $# -ge 2 ] || { _reg_fail "$want_json" "steward invite redeem: --token-file needs a value"; return 64; }
                    if [ -n "$token" ]; then _reg_fail "$want_json" "steward invite redeem: one token at a time"; return 64; fi
                    # A DIRECTORY IS -r TOO, and reading one is a redirection
                    # error rather than an answer, so it is named here instead.
                    { [ -r "$2" ] && [ ! -d "$2" ]; } || { _reg_fail "$want_json" "steward invite redeem: cannot read the token file '$2'"; return 64; }
                    # A FILE WITH NO TRAILING NEWLINE IS STILL A FILE WITH A
                    # TOKEN IN IT: `read` returns non-zero at EOF and has
                    # already assigned the partial line, so the emptiness test
                    # below is the one that decides.
                    IFS= read -r token < "$2" || :
                    # AND A CRLF FILE IS AN ORDINARY TOKEN FILE. `read` splits
                    # on the newline alone, so a file written by an editor that
                    # kept CRLF line endings left the carriage return on the
                    # token - and the digest was then taken over a value nobody
                    # was ever given. The refusal that followed said no open
                    # invitation matched, which sends the operator to reissue an
                    # invitation that was never wrong. ONE carriage return, at
                    # the end: anything else in the value is the value.
                    token="${token%$'\r'}"
                    [ -n "$token" ] || { _reg_fail "$want_json" "steward invite redeem: the token file '$2' is empty - the token goes on its first line"; return 64; }
                    shift 2 ;;
      -)  if [ -n "$token" ]; then _reg_fail "$want_json" "steward invite redeem: one token at a time"; return 64; fi
          IFS= read -r token || :
          # AND A CRLF LINE IS AN ORDINARY TOKEN LINE, exactly as above: `-` is
          # the form a PROGRAM uses, and a program piping a line in ends it the
          # way its own source did. ONE carriage return, at the end: anything
          # else in the value is the value.
          token="${token%$'\r'}"
          [ -n "$token" ] || { _reg_fail "$want_json" "steward invite redeem: no token on stdin - '-' means the token is one line on standard input"; return 64; }
          shift ;;
      --identity) [ $# -ge 2 ] || { _reg_fail "$want_json" "steward invite redeem: --identity needs a value"; return 64; }
                  identity="$2"; shift 2 ;;
      --email)    [ $# -ge 2 ] || { _reg_fail "$want_json" "steward invite redeem: --email needs a value"; return 64; }
                  email="$2"; shift 2 ;;
      -*) _reg_fail "$want_json" "steward invite redeem: unknown flag '$1'"; return 64 ;;
      *) if [ -n "$token" ]; then _reg_fail "$want_json" "steward invite redeem: one token at a time"; return 64; fi
         token="$1"; shift ;;
    esac
  done
  [ -n "$token" ] || { _reg_fail "$want_json" "steward invite redeem: a token is required"; return 64; }
  [ -n "$identity" ] || { _reg_fail "$want_json" "steward invite redeem: --identity <source>:<value> is required"; return 64; }

  # THE SOURCE IS THE PART BEFORE THE FIRST COLON, AND ONLY THE FIRST. An OIDC
  # value is itself "<issuer>:<subject>", so splitting on the last colon (or on
  # every one) would hand the lookup half a subject.
  local src="${identity%%:*}" val="${identity#*:}"
  case "$src" in
    tailscale|oidc) ;;
    *) _reg_fail "$want_json" "steward invite redeem: --identity source must be tailscale or oidc, got '$src'"; return 64 ;;
  esac
  [ -n "$val" ] && [ "$val" != "$identity" ] || {
    _reg_fail "$want_json" "steward invite redeem: --identity must be <source>:<value>"; return 64; }

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  # EVERY REFUSAL FROM HERE ON WEARS THE SHAPE THE CALLER ASKED FOR - see
  # _redeem_fail, which reads this and nothing else.
  _REDEEM_JSON="$want_json"; _REDEEM_LINES=""; _REDEEM_RECEIPT=""

  # -- STEP 1: the token, the row, and the two refusals ---------------------
  local digest id
  digest="$(printf '%s' "$token" | _registry_sha256)" || {
    _redeem_fail "the token could not be digested on this machine - either no sha256 tool is on PATH, or the one that is there ran and failed; the refusal above says which" 78; return 78; }
  id="$(registry_invite_for_digest "$digest" 2>/dev/null)" || id=""
  if [ -z "$id" ]; then
    # THE SAME ANSWER FOR WRONG, USED AND EXPIRED. A refusal that distinguished
    # them would let anybody with a guess learn which tokens once existed.
    _reg_fail "$want_json" "steward invite redeem: no open invitation matches this token"
    return 65
  fi
  registry_invite_load "$id" >/dev/null 2>&1 || {
    _reg_fail "$want_json" "steward invite redeem: invitation '$id' does not load - repair the row"; return 78; }
  if [ "$INVITE_EFFECTIVE_STATE" != "open" ]; then
    _reg_fail "$want_json" "steward invite redeem: invitation '$id' is $INVITE_EFFECTIVE_STATE, not open"
    return 65
  fi

  # THE INVITATION MUST NAME THIS MACHINE, and that is decided here, before the
  # first side effect. Steps 3, 8, 9 and 10 all act LOCALLY - the helper
  # through local sudo, the local account database, files under a local home -
  # while the rows they write say the account lives on the invitation's host.
  # Redeeming an invitation for another machine therefore used to create a unix
  # account, two keys and the seeds HERE, and only then fail at the skeleton
  # deploy, which applies a machine gate of its own.
  local self_host; self_host="$(_registry_self_host)"
  if [ "$INVITE_HOST" != "$self_host" ]; then
    _reg_fail "$want_json" "steward invite redeem: invitation '$id' is for host '$INVITE_HOST' and this machine answers to '$self_host' - redeem it there; the account, the keys and the seeds are all made on the machine this verb runs on"
    return 65
  fi

  # THE ROW IS SNAPSHOTTED HERE, AND STEP 12 COMPARES AGAINST THIS SNAPSHOT -
  # not against a fresh read of its own. The decision this verb makes is
  # "open -> redeemed", and it is made HERE, before an account, a key and a
  # skeleton deploy that take seconds to minutes on a real host. Step 12 used
  # to re-take the recheck snapshot through _invite_load_expect, so a revoke
  # that landed in between was compared against itself and published straight
  # over: the row said revoked, the verb said redeemed, and the person was let
  # in. Carrying step 1's values into the under-lock recheck is what makes the
  # window between the two the register's problem instead of nobody's.
  local inv1_state="$INVITE_STATE" inv1_digest="$INVITE_TOKEN_SHA256"
  local inv1_login="$INVITE_REDEEMED_LOGIN" inv1_at="$INVITE_REDEEMED_AT"

  local p_slug="$INVITE_PRINCIPAL" ent_slug="$INVITE_ENTITY" host_slug="$INVITE_HOST"
  local runtime="$INVITE_RUNTIME" provider="$INVITE_PROVIDER" person="$INVITE_NAME"
  local acct_slug="$p_slug-$host_slug" unix_user="$p_slug"
  local login_slug="$p_slug-$provider" sess_slug="$ent_slug-$p_slug"

  # ONE IDENTITY, ONE HUMAN - AND THE INVITATION'S OWN PRINCIPAL IS NOT A
  # SECOND HUMAN. A resumed redemption finds the principal row its own earlier
  # attempt wrote, carrying exactly this identity; refusing on that would make
  # the verb un-resumable at step 2, which is the one place an interrupted run
  # is most likely to stop. Somebody ELSE holding the identity is still a hard
  # refusal, and so is an identity that resolves to more than one row.
  local bound brc
  bound="$(registry_principal_for_identity "$src" "$val" 2>/dev/null)"; brc=$?
  # A LOOKUP THAT COULD NOT ANSWER IS NOT AN ANSWER OF "nobody holds this".
  # rc 1 means the register was read and nothing matched; anything else means
  # the question was not settled, and a gate that falls through on an
  # unsettled question is not a gate.
  if [ "$brc" -ne 0 ] && [ "$brc" -ne 1 ] && [ "$brc" -ne 65 ]; then
    _reg_fail "$want_json" "steward invite redeem: the principal register could not be searched for '$identity' (rc $brc), so who holds this identity is unknown - repair the register before redeeming"
    return 78
  fi
  if [ "$brc" -eq 65 ]; then
    _reg_fail "$want_json" "steward invite redeem: the identity '$identity' maps to more than one principal - repair the principal register before redeeming"
    return 65
  fi
  if [ "$brc" -eq 0 ] && [ "$bound" != "$p_slug" ]; then
    _reg_fail "$want_json" "steward invite redeem: the identity '$identity' already belongs to a principal ('$bound') - one identity, one human"
    return 65
  fi

  _REDEEM_INVITE="$id"; _REDEEM_PRINCIPAL="$p_slug"; _REDEEM_LINES=""
  local state_dir; state_dir="$(registry_state_dir_name)" || {
    _redeem_fail "the estate does not name a state directory, so no receipt could be written" 78; return 78; }
  _REDEEM_RECEIPT="$HOME/.local/state/$state_dir/invites/$id.receipt.json"

  # THE ONE RUNTIME THIS PATH CAN FINISH. `registry session add` writes no
  # RUNTIME line, so a codex or opencode row would come out as the default and
  # the session would run the wrong agent - a silent wrong answer. Refused
  # here, before anything is written, naming the cause.
  if [ "$runtime" != "claude-code" ]; then
    _reg_fail "$want_json" "steward invite redeem: invitation '$id' names runtime '$runtime', and the session writer can only finish 'claude-code' - issue the invitation with --runtime claude-code"
    return 65
  fi

  _redeem_note 1 invite "$id for $p_slug on $host_slug, identity $identity"
  _redeem_receipt running

  local out rc runas_out=""

  # -- STEP 2: the principal ------------------------------------------------
  if [ -e "$(registry_principal_dir)/$p_slug.conf" ]; then
    # A ROW IS NOT A MARK UNTIL IT CARRIES THE IDENTITY. The gate at step 1
    # settles who may HOLD this identity; this settles whether the principal
    # this run is finishing actually has it. Without the check, a redemption
    # interrupted after step 2 could be finished with a DIFFERENT identity:
    # the new identity maps to no principal, so the gate passes; the row
    # exists, so this step reports "already done"; and step 12 then records
    # the new identity as bound to a principal that never received it.
    # THE WANTED VALUE IS FOLDED THE WAY THE LOOKUP FOLDS IT - a tailnet login
    # is compared lower case, an OIDC subject exactly - so this test and
    # registry_principal_for_identity can never disagree about the same row.
    local want_id="$val"
    [ "$src" = "tailscale" ] && want_id="$(printf '%s' "$val" | tr '[:upper:]' '[:lower:]')"
    local have_identity=""
    if ( registry_principal_load "$p_slug" >/dev/null 2>&1 && \
         case "$src" in
           tailscale) case " $PRINCIPAL_TAILSCALE_LOGIN " in *" $want_id "*) true ;; *) false ;; esac ;;
           *)         case " $PRINCIPAL_OIDC_LOGIN "      in *" $want_id "*) true ;; *) false ;; esac ;;
         esac ); then
      have_identity=1
    fi
    if [ -z "$have_identity" ]; then
      _redeem_fail "step 2 (principal): principal '$p_slug' exists with another identity - it does not carry '$identity', and a redemption may not bind an identity to a principal that never received it; repair the principal row or issue the invitation for another principal" 65
      return 65
    fi
    _redeem_note 2 principal "already done"
  else
    local idflag="--oidc-login"
    [ "$src" = "tailscale" ] && idflag="--tailscale-login"
    if [ "$src" = "oidc" ] && [ -n "$email" ]; then
      out="$(cmd_registry_principal_add "$p_slug" --name "$person" "$idflag" "$val" --oidc-email "$email" 2>&1)"; rc=$?
    else
      out="$(cmd_registry_principal_add "$p_slug" --name "$person" "$idflag" "$val" 2>&1)"; rc=$?
    fi
    [ "$rc" -eq 0 ] || { _redeem_fail "step 2 (principal) failed: $out" "$rc"; return "$rc"; }
    _redeem_note 2 principal "principals.d/$p_slug.conf written"
  fi
  _redeem_receipt running

  # -- STEP 3: the unix account, through the privileged helper --------------
  local home helper_out=""
  home="$(_registry_owner_home "$unix_user" 2>/dev/null)" || home=""
  # THE FLOOR APPLIES TO AN ACCOUNT THIS VERB DID NOT CREATE, TOO. The helper
  # refuses root, the calling account, a system uid and a home outside
  # /home/<name> - and an account that already exists skips the helper entirely
  # (the mark below is "a home exists"), so the same four questions are asked
  # here or they are asked nowhere. Measured before this gate: an invitation
  # naming an account that was already on the host wrote a principal row and an
  # account row for it, installed the hub's delivery key in its
  # ~/.ssh/authorized_keys, seeded its home and deployed the skeleton into it.
  # It is operator error being amplified rather than a stranger's escalation,
  # and amplifying exactly this operator error is the floor's whole job.
  #
  # ASKED LOCALLY AND WITHOUT sudo: the helper is a privileged account-CREATING
  # command and does not belong on a step with nothing to create, so the
  # questions are asked with `id` and the home path this verb already has.
  local existing_uid=""
  existing_uid="$(id -u "$unix_user" 2>/dev/null)" || existing_uid=""
  if [ -n "$existing_uid" ]; then
    # A UID THAT IS NOT A NUMBER IS NOT AN ANSWER EITHER: `[` fails on it, and
    # the negation makes that a refusal rather than a pass.
    if [ "$unix_user" = "root" ] || [ "$unix_user" = "$(id -un)" ] \
       || ! [ "$existing_uid" -ge 1000 ] 2>/dev/null \
       || [ "$home" != "/home/$unix_user" ]; then
      _redeem_fail "step 3 (unix account): '$unix_user' already exists on this host (uid $existing_uid, home $home) and is not an account this product may take over - the account helper would refuse it, and an invitation may not bind a person to an account it did not create" 65
      return 65
    fi
  fi
  if [ -n "$home" ] && [ -d "$home" ]; then
    _redeem_note 3 account-unix "already done ($home)"
  else
    helper_out="$(sudo -n /usr/local/sbin/steward-account-helper add "$unix_user" 2>&1)"; rc=$?
    if [ "$rc" -ne 0 ]; then
      # WHOSE WORDS THESE ARE DECIDES THE REPAIR, and the output is the only
      # thing that can say - see _account_helper_spoke above, the one
      # classifier this verb and `steward offboard` both call.
      if _account_helper_spoke "$helper_out"; then
        _redeem_fail "step 3 (unix account): the account helper ran and refused (rc $rc): $helper_out" 70
        return 70
      fi
      # The overwhelmingly likely cause is a host where the estate has not
      # installed the sudoers line, so the message names the line itself and
      # then quotes what sudo actually said, verbatim.
      _redeem_fail "step 3 (unix account) could not run the helper through 'sudo -n'. The estate installs exactly one line for it: steward ALL=(root) NOPASSWD: /usr/local/sbin/steward-account-helper. sudo said: $helper_out" 77
      return 77
    fi
    home="$(_registry_owner_home "$unix_user" 2>/dev/null)" || home=""
    [ -n "$home" ] || { _redeem_fail "step 3 (unix account): the helper reported success but the account database still has no home for '$unix_user'" 70; return 70; }
    # A PATH IS NOT A HOME. `offboard` never deletes the passwd row - it
    # expires, locks and archives the home - so a redemption for an offboarded
    # principal finds a home path with nothing at it, calls the helper, and the
    # helper's already-exists branch by design does not unlock the password,
    # re-enable lingering or recreate the home. The step used to report the
    # account created, and the run then died at step 8's ssh-keygen inside a
    # home that is not there. The refusal this step already knows how to make is
    # the honest answer.
    if [ ! -d "$home" ]; then
      _redeem_fail "step 3 (unix account): '$unix_user' exists in the account database but $home is not there - the helper configures only an account it created, so this account is left expired, locked and homeless (an offboarded account is the usual cause). Remove the account by hand, or restore its home, before redeeming again" 70
      return 70
    fi
    # AND THE RECEIPT SAYS WHICH OF THE TWO ANSWERS THE HELPER GAVE. Only
    # "account <u> created" is a creation; every other rc 0 it can answer with
    # is an account that was already there, and a receipt that says "created"
    # about one is the one thing the helper's own comments refuse to print.
    case "$helper_out" in
      *"helper: account $unix_user created"*) _redeem_note 3 account-unix "$unix_user created, home $home" ;;
      *) _redeem_note 3 account-unix "$unix_user already existed, home $home" ;;
    esac
  fi
  _redeem_receipt running

  # -- STEP 4: the account row ----------------------------------------------
  if [ -e "$(registry_account_dir)/$acct_slug.conf" ]; then
    _redeem_note 4 account "already done"
  else
    out="$(cmd_registry_account_add "$acct_slug" --principal "$p_slug" --host "$host_slug" --username "$unix_user" 2>&1)"; rc=$?
    [ "$rc" -eq 0 ] || { _redeem_fail "step 4 (account) failed: $out" "$rc"; return "$rc"; }
    _redeem_note 4 account "accounts.d/$acct_slug.conf written"
  fi
  _redeem_receipt running

  # -- STEP 5: membership of the entity -------------------------------------
  # THE ROW IS SOURCED IN A CHILD PROCESS, NOT IN THIS FRAME - the shape
  # `steward registry session check` uses. The loader's own wall stops a row
  # from reaching the LOADER's locals; it cannot stop one from reaching THIS
  # verb's, because bash scope is dynamic and every local declared above is
  # still live here. p_slug is read straight after this load, to decide whether
  # the member is already there and to compose the new list, and again by step
  # 6 to mint the login row - so an entities.d row line p_slug="operator" made
  # step 5 answer "already done" about somebody else's membership and minted
  # the invited person's login against the name the row had chosen. The fork
  # closes p_slug, ent_slug, login_slug, acct_slug, want_json and every other
  # local at once, not just the ones a reader thought to name.
  #
  # ALL FOUR FIELDS COME BACK, because _entity_members_replace composes the row
  # out of what the loader left behind: a crossing that carried only MEMBERS
  # would rewrite the entity with its NAME, MANAGED_BY and MCP_ASSETS emptied.
  # THE SENTINEL IS WHAT MAKES FOUR LINES READABLE AS FOUR: command
  # substitution strips trailing newlines, so an empty MCP_ASSETS would
  # otherwise collapse the last field into the one before it. A field carrying
  # a newline of its own pushes the sentinel off line five - refused here, in
  # the same words and with the same rc the writer's own emit would answer with
  # further down.
  local ent_row ent_end ent_over
  ent_row="$( registry_entity_load "$ent_slug" >/dev/null 2>&1 \
              && printf '%s\n%s\n%s\n%s\nok\n' \
                   "$ENTITY_NAME" "$ENTITY_MEMBERS" "$ENTITY_MANAGED_BY" "$ENTITY_MCP_ASSETS" )" || {
    _redeem_fail "step 5 (membership): entity '$ent_slug' does not load" 78; return 78; }
  { IFS= read -r ENTITY_NAME
    IFS= read -r ENTITY_MEMBERS
    IFS= read -r ENTITY_MANAGED_BY
    IFS= read -r ENTITY_MCP_ASSETS
    IFS= read -r ent_end
    IFS= read -r ent_over
  } <<EOF
$ent_row
EOF
  if [ "$ent_end" != "ok" ] || [ -n "$ent_over" ]; then
    _redeem_fail "step 5 (membership): entity '$ent_slug' carries a control character or newline in one of its fields" 64
    return 64
  fi
  case " $ENTITY_MEMBERS " in
    *" $p_slug "*) _redeem_note 5 membership "already done" ;;
    *)
      local new_members="${ENTITY_MEMBERS:+$ENTITY_MEMBERS }$p_slug"
      # THE COMPOSITION, THE RECHECK SNAPSHOT AND THE WRITE ARE ONE FUNCTION,
      # shared with `steward offboard` - see _entity_members_replace. The row
      # this step read a moment ago is what the under-lock recheck compares
      # against, so a second redemption into the same entity is refused rather
      # than published over.
      out="$(_entity_members_replace "$ent_slug" "$new_members" "steward invite redeem" 2>&1)"; rc=$?
      [ "$rc" -eq 0 ] || { _redeem_fail "step 5 (membership) failed: $out" "$rc"; return "$rc"; }
      _redeem_note 5 membership "$p_slug added to entity $ent_slug"
      ;;
  esac
  _redeem_receipt running

  # -- STEP 6: the login row ------------------------------------------------
  if [ -e "$(registry_login_dir)/$login_slug.conf" ]; then
    _redeem_note 6 login "already done"
  else
    # THE CONFIG DIRECTORY IS WRITTEN IN THE TILDE FORM the login register's own
    # resolver requires (registry_login_config_dir): the row names a directory
    # RELATIVE to the account's home, and the home is resolved at read time
    # against the account. An absolute path here would be refused by the reader.
    #
    # ACCOUNT is the provider-side name, not our slug. At redemption the person
    # has not logged in yet, so the best name we have is the one the identity
    # carries - the email when it was given, the identity value otherwise. It
    # is updatable later without moving any credentials.
    local provider_account="${email:-$val}"
    out="$(cmd_registry_login_add "$login_slug" --principal "$p_slug" --account "$provider_account" \
           --provider "$provider" --config-dir "~/.claude-logins/$provider" --legal-owner "$p_slug" 2>&1)"; rc=$?
    [ "$rc" -eq 0 ] || { _redeem_fail "step 6 (login) failed: $out" "$rc"; return "$rc"; }
    _redeem_note 6 login "logins.d/$login_slug.conf written"
  fi
  _redeem_receipt running

  # -- STEP 7: the first session row ----------------------------------------
  local sid
  sid="$(_redeem_session_id "$acct_slug" "$sess_slug" 2>/dev/null)" || sid=""
  if [ -n "$sid" ]; then
    _redeem_note 7 session "already done ($sid)"
  else
    # THE REPOSITORY IS THE ACCOUNT'S OWN HOME. An invitation names no repo, and
    # the first session's workspace is the person's own machine account - the
    # one directory that exists, belongs to them, and needs no further word.
    out="$(cmd_registry_session_add --account "$acct_slug" --entity "$ent_slug" --slug "$sess_slug" \
           --repo "$home" --host "$host_slug" --login "$login_slug" --json 2>&1)"; rc=$?
    [ "$rc" -eq 0 ] || { _redeem_fail "step 7 (session) failed: $out" "$rc"; return "$rc"; }
    sid="$(printf '%s' "$out" | jq -r '.id // empty' 2>/dev/null)"
    [ -n "$sid" ] || { _redeem_fail "step 7 (session): the writer reported success but named no id" 70; return 70; }
    _redeem_note 7 session "$sid (slug $sess_slug) written"
  fi
  _redeem_receipt running

  # -- STEP 8: relay key, relay row, delivery key ---------------------------
  # The three halves of the bus enrolment the hub's own enroll performs for a
  # session that asks for itself. Here the hub does all three, because the
  # person has no shell yet and nothing on their side can ask.
  local relay_key="$home/.ssh/id_busrelay_$sid"
  local hub_ak="${STEWARD_AUTHORIZED_KEYS:-$HOME/.ssh/authorized_keys}"
  local acct_ak="$home/.ssh/authorized_keys"
  local relay_root="$HOME/scripts"
  local hub_pub="$HOME/.ssh/id_ed25519.pub"
  local have_key="" have_row="" have_deliver=""
  [ -f "$relay_key" ] && have_key=1
  grep -q "bus-relay-in $sid\"" "$hub_ak" 2>/dev/null && have_row=1
  grep -q "bus-relay-deliver" "$acct_ak" 2>/dev/null && have_deliver=1
  if [ -n "$have_key" ] && [ -n "$have_row" ] && [ -n "$have_deliver" ]; then
    _redeem_note 8 bus "already done"
  else
    # THE RELAY MUST EXIST BEFORE THE ROW NAMES IT. enroll learned this the hard
    # way: a key line naming a path that is not there kills the new session's
    # OUTBOUND channel, and the only party who can see the failure is the one
    # party who cannot report it.
    if [ ! -f "$relay_root/bus/bin/bus-relay-in" ]; then
      _redeem_fail "step 8 (bus): the relay is missing at $relay_root/bus/bin/bus-relay-in - the key line would name a path that does not exist, and the new session's outbound channel would be dead without it being able to say so" 70
      return 70
    fi
    [ -f "$hub_pub" ] || { _redeem_fail "step 8 (bus): the hub has no public key at $hub_pub, so the delivery key cannot be installed" 70; return 70; }
    # EVERY `sudo -n -u` CALL BELOW KEEPS ITS OUTPUT, so the refusal can say
    # whether sudo or the command said no - see _redeem_runas_fail.
    if [ -z "$have_key" ]; then
      runas_out="$(sudo -n -u "$unix_user" ssh-keygen -q -t ed25519 -N "" -f "$relay_key" \
        -C "$host_slug-$unix_user-$sess_slug" 2>&1)" \
        || { _redeem_runas_fail "step 8 (bus): could not generate the relay key at $relay_key" "$unix_user" "$runas_out"; return $?; }
    fi
    local relay_pub relay_err
    relay_err="$(mktemp)" || { _redeem_fail "step 8 (bus): cannot create a temporary file" 70; return 70; }
    relay_pub="$(sudo -n -u "$unix_user" cat "$relay_key.pub" 2>"$relay_err")"
    if [ -z "$relay_pub" ]; then
      runas_out="$(cat "$relay_err")"; rm -f "$relay_err"
      _redeem_runas_fail "step 8 (bus): could not read the relay public key at $relay_key.pub" "$unix_user" "$runas_out"
      return $?
    fi
    rm -f "$relay_err"
    # THE .pub IS READ OUT OF THE NEW ACCOUNT'S HOME, so its owner can write
    # it - and the next few lines turn it into an authorization record on the
    # HUB. A second line in that file is a second authorized_keys line without
    # the forced command, i.e. a shell on the machine that runs the estate; a
    # first line of another shape is a key nobody meant to trust. The line is
    # therefore required to be exactly one ed25519 key, with at most a comment
    # after it, before anything is appended anywhere. This is the one place in
    # the verb where content from outside the hub's trust boundary becomes an
    # authorization record.
    if [ "$(printf '%s\n' "$relay_pub" | wc -l | tr -d ' ')" != "1" ] \
       || ! printf '%s\n' "$relay_pub" | grep -qE '^ssh-ed25519 [A-Za-z0-9+/]+=*( [^[:space:]]*)?$'; then
      _redeem_fail "step 8 (bus): the relay public key at $relay_key.pub is not a single 'ssh-ed25519 <key> [comment]' line - refusing to put it in an authorized_keys file" 70
      return 70
    fi
    if [ -z "$have_row" ]; then
      # THE LINE CARRIES THE ESTATE ROOT. sshd strips the environment from a
      # forced command, so a relay that resolved recipients through an unset
      # root would see only the hub's own rows and answer "unknown recipient"
      # for everybody else - the same fix the hub's enroll carries.
      printf 'restrict,command="STEWARD_ESTATE_ROOT=%s /bin/bash %s/bus/bin/bus-relay-in %s" %s\n' \
        "$(_registry_estate_root)" "$relay_root" "$sid" "$relay_pub" >> "$hub_ak" \
        || { _redeem_fail "step 8 (bus): could not append the relay row to $hub_ak" 70; return 70; }
    fi
    if [ -z "$have_deliver" ]; then
      local deliver_err; deliver_err="$(mktemp)" || { _redeem_fail "step 8 (bus): cannot create a temporary file" 70; return 70; }
      if ! printf 'restrict,command="%s/scripts/bus/bin/bus-relay-deliver" %s\n' \
             "$home" "$(cat "$hub_pub")" \
             | sudo -n -u "$unix_user" tee -a "$acct_ak" >/dev/null 2>"$deliver_err"; then
        runas_out="$(cat "$deliver_err")"; rm -f "$deliver_err"
        _redeem_runas_fail "step 8 (bus): could not install the delivery key in $acct_ak" "$unix_user" "$runas_out"
        return $?
      fi
      rm -f "$deliver_err"
    fi
    _redeem_note 8 bus "relay key, relay row and delivery key in place for $sid"
  fi
  _redeem_receipt running

  # -- STEP 9: the seeds the first ssh to the hub needs ---------------------
  # MEASURED ON A HOST 2026-09-08: without these the first ssh from the new
  # account to the hub fails on an unknown host key, and the skeleton deploy
  # stops there. The step was missing from the manual routine, which is why it
  # is a step here rather than a note in a document.
  local hub_host known_hosts="$home/.ssh/known_hosts" onboarding="$home/onboarding.env"
  hub_host="$(registry_hub_host)" || {
    _redeem_fail "step 9 (seeds): the estate does not name its hub host, so known_hosts cannot be seeded" 78; return 78; }
  local have_kh="" have_env=""
  grep -q "." "$known_hosts" 2>/dev/null && have_kh=1
  [ -f "$onboarding" ] && have_env=1
  if [ -n "$have_kh" ] && [ -n "$have_env" ]; then
    _redeem_note 9 seeds "already done"
  else
    local seed_err; seed_err="$(mktemp)" || { _redeem_fail "step 9 (seeds): cannot create a temporary file" 70; return 70; }
    if [ -z "$have_kh" ]; then
      # THE SCAN IS MEASURED BEFORE IT IS WRITTEN. ssh-keyscan exits 0 with
      # empty output for a host it cannot reach, and the pipeline's status
      # came from `tee` - so an unreachable hub used to leave known_hosts
      # empty while the receipt said it had been seeded, and the first ssh
      # from the new account failed on an unknown host key anyway.
      local scan
      scan="$(ssh-keyscan -H "$hub_host" 2>"$seed_err")"
      if [ -z "$scan" ]; then
        runas_out="$(cat "$seed_err")"; rm -f "$seed_err"
        _redeem_fail "step 9 (seeds): ssh-keyscan returned no host key for '$hub_host', so $known_hosts would stay empty and the first ssh from this account would fail on an unknown host key: $runas_out" 70
        return 70
      fi
      if ! printf '%s\n' "$scan" | sudo -n -u "$unix_user" tee -a "$known_hosts" >/dev/null 2>"$seed_err"; then
        runas_out="$(cat "$seed_err")"; rm -f "$seed_err"
        _redeem_runas_fail "step 9 (seeds): could not seed $known_hosts with the hub's host key" "$unix_user" "$runas_out"
        return $?
      fi
    fi
    if [ -z "$have_env" ]; then
      local hub_ssh; hub_ssh="$(registry_hub_ssh)" || { rm -f "$seed_err"; _redeem_fail "step 9 (seeds): the estate does not name its hub's ssh target" 78; return 78; }
      if ! printf 'STEWARD_ESTATE_ROOT=%s\nSTEWARD_HUB_HOST=%s\nSTEWARD_HUB_SSH=%s\n' \
             "$(_registry_estate_root)" "$hub_host" "$hub_ssh" \
             | sudo -n -u "$unix_user" tee "$onboarding" >/dev/null 2>"$seed_err"; then
        runas_out="$(cat "$seed_err")"; rm -f "$seed_err"
        _redeem_runas_fail "step 9 (seeds): could not write $onboarding" "$unix_user" "$runas_out"
        return $?
      fi
    fi
    rm -f "$seed_err"
    _redeem_note 9 seeds "known_hosts and onboarding.env written in $home"
  fi
  _redeem_receipt running

  # -- STEP 10: the rig socket directory ------------------------------------
  # The helper writes the per-account tmpfiles fragment as part of `add`, and
  # says so on its own output. This step ASKS FOR THAT SENTENCE rather than
  # reading /etc: the fragment is the helper's to place, and a step that went
  # looking for the file itself would report a directory nobody made.
  #
  # WHEN STEP 3 WAS SKIPPED THERE IS NO SENTENCE TO READ, AND THE HELPER IS NOT
  # CALLED AGAIN. The account already existed, so the `add` that created it
  # already placed the fragment; calling `add` a second time on a resumed run
  # would put a privileged, account-creating command on the path of a step that
  # has nothing left to create.
  if [ -z "$helper_out" ]; then
    _redeem_note 10 rig-socket-dir "already done"
  else
    local fragment
    fragment="$(printf '%s\n' "$helper_out" | sed -n 's/^helper: tmpfiles //p' | head -1)"
    if [ -z "$fragment" ]; then
      _redeem_fail "step 10 (rig socket directory): the helper reported no tmpfiles fragment for '$unix_user' - a rig for this account would have nowhere to put its socket" 70
      return 70
    fi
    _redeem_note 10 rig-socket-dir "$fragment"
  fi
  _redeem_receipt running

  # -- STEP 11: the skeleton, and the desk ----------------------------------
  if [ -f "$home/scripts/lib/registry.sh" ]; then
    _redeem_note 11 skeleton "already done"
  else
    out="$(bash "$HERE/linux/deploy-self.sh" "$host_slug" 2>&1)"; rc=$?
    [ "$rc" -eq 0 ] || { _redeem_fail "step 11 (skeleton) failed: $out" "$rc"; return "$rc"; }
    _redeem_note 11 skeleton "deployed into $home/scripts"
  fi
  # THE SNAPSHOT HAS NO MARK AND RUNS EVERY TIME. It is a projection of the
  # register, cheap and idempotent, and the register changed on the step above.
  bash "$HERE/bin/steward" desk snapshot >/dev/null 2>&1 || true
  _redeem_receipt running

  # -- STEP 12: close the invitation ----------------------------------------
  _invite_load_expect "$id" >/dev/null 2>&1 || {
    _redeem_fail "step 12 (invitation): '$id' no longer loads" 78; return 78; }
  # THE ONE STATE THIS STEP MAY FIND ALREADY DONE is the one it was going to
  # write: redeemed, by the identity in hand. Step 1 refuses a row that is not
  # effectively open, so anything else here is a row that MOVED under the run,
  # and the recheck below is what refuses it.
  if [ "$INVITE_STATE" = "redeemed" ] && [ "$INVITE_REDEEMED_LOGIN" = "$identity" ]; then
    _redeem_note 12 invitation "already done"
  else
    _REGW_EXPECT_INV_STATE="redeemed"
    _REGW_EXPECT_INV_REDEEMED_LOGIN="$identity"
    _REGW_EXPECT_INV_REDEEMED_AT="$(date -u +%s)"
    # _invite_load_expect re-took the recheck snapshot from ITS read; the
    # snapshot that decides this write is step 1's. Overwritten here, after
    # the loader and before the write, so _invite_validate_row compares the
    # row it finds under the lock against the row this run was allowed to
    # open - not against the row it read a moment ago.
    _REGW_RECHECK_INV_STATE="$inv1_state"
    _REGW_RECHECK_INV_TOKEN_SHA256="$inv1_digest"
    _REGW_RECHECK_INV_REDEEMED_LOGIN="$inv1_login"
    _REGW_RECHECK_INV_REDEEMED_AT="$inv1_at"
    local content
    content="$(_invite_compose "$id")" || { _redeem_fail "step 12 (invitation): a field carries a control character" 64; return 64; }
    out="$(registry_invite_replace "$id" "$content" _invite_validate_row 2>&1)"; rc=$?
    if [ "$rc" -ne 0 ]; then
      local now_state
      now_state="$( registry_invite_load "$id" >/dev/null 2>&1; printf '%s' "$INVITE_STATE" )"
      if [ "$now_state" != "$inv1_state" ]; then
        _redeem_fail "step 12 (invitation): the invitation changed while redeeming (STATE=$now_state); nothing further written - the steps already done are left in place and a rerun with a fresh invitation resumes them" 70
        return 70
      fi
      _redeem_fail "step 12 (invitation) failed: $out" "$rc"; return "$rc"
    fi
    _redeem_note 12 invitation "$id redeemed by $identity"
  fi
  _redeem_receipt done

  if [ -n "$want_json" ]; then
    _json ok true kind redeem invite "$id" principal "$p_slug" account "$acct_slug" \
      login "$login_slug" session "$sid" home "$home" receipt "$_REDEEM_RECEIPT"
  else
    printf 'steward: %s is redeemed - session %s exists and is NOT started; it starts once the person has logged in to their own model account.\n' \
      "$id" "$sid"
  fi
  return 0
}

cmd_invite() {
  case "${1:-}" in
    issue)  shift; cmd_invite_issue "$@" ;;
    ls)     shift; cmd_invite_ls "$@" ;;
    revoke) shift; cmd_invite_revoke "$@" ;;
    redeem) shift; cmd_invite_redeem "$@" ;;
    *) fel "steward invite: unknown verb '${1:-}' (allowed: issue, ls, revoke, redeem)" 64 ;;
  esac
}

# -- OFFBOARDING ------------------------------------------------------------
#
# The exact reverse of a redemption, in reverse order: stop the work, unbind
# the bus, remove the rows, lock the account, archive the home. It prints one
# line per thing removed, and THAT LIST IS WHY THE VERB EXISTS - a rehearsal
# is only worth running if it can be cleaned up afterwards, and a cleanup is
# only trustworthy if it says what it did.
#
# NOTHING IRREPLACEABLE IS DELETED. The home is MOVED, by the helper, under
# /home/.offboarded; the invitation row stays exactly as it is, redeemed, as
# the history of how the person arrived. Removing either is an operator's word,
# not a verb's.
#
# EVERY LOCAL IN cmd_offboard IS LOWER CASE, for the reason cmd_invite_redeem
# records: bash scopes dynamically, so a local named ACCOUNT or HOST here would
# be visible inside every register loader this verb calls, and a loader
# sourcing a conf that assigns the same name would overwrite it mid-run.

# THREE LISTS, BECAUSE THEY ANSWER THREE DIFFERENT QUESTIONS. `removed` is the
# promise the verb makes and the number a reader counts; a line saying the
# invitation was KEPT, or that a home was left in place, or that a row could not
# be read, is the OPPOSITE of a removal and belongs in `kept`; and something
# that went wrong without stopping the run - a snapshot that failed, the step
# the run stopped at - is a `warning`. They were one field until 2026-09-09,
# and a caller counting `removed` was being told the wrong number.
_OFFBOARD_REMOVED=""
_OFFBOARD_KEPT=""
_OFFBOARD_WARNINGS=""
_OFFBOARD_RECEIPT=""
_OFFBOARD_PRINCIPAL=""
_OFFBOARD_JSON=""

# _offboard_say <text> - one line of prose, printed and not recorded.
#
# UNDER --json IT GOES TO STDERR, the convention every verb on this branch
# follows: one JSON value on stdout and nothing else, because a caller that
# reads stdout as JSON gets a parse error from a list of prose in front of it.
# The lines are not lost - they are the receipt's whole content, and both the
# receipt and the JSON carry them.
_offboard_say() {
  if [ -n "$_OFFBOARD_JSON" ]; then printf 'offboard: %s\n' "$1" >&2
  else printf 'offboard: %s\n' "$1"; fi
}

# _offboard_flat <text> - one line out of however many were handed in. EVERY
# LIST IN THE RECEIPT IS A NEWLINE-SEPARATED ACCUMULATOR, split back apart when
# the file is written, so a recorded value carrying a newline of its own does
# not become one entry - it becomes as many entries as it has lines. The helper
# is the case that matters: it answers in four or five `helper:` lines, and a
# refusal recorded verbatim used to arrive as four separate entries, three of
# them claiming to be things this run had removed.
_offboard_flat() {
  local _t="${1//$'\n'/ | }"
  printf '%s' "$_t"
}

# _offboard_note <text> - one thing that was REMOVED, printed and recorded.
_offboard_note() {
  _offboard_say "$1"
  _OFFBOARD_REMOVED="$_OFFBOARD_REMOVED$(_offboard_flat "$1")
"
}

# _offboard_kept <text> [loud] - something deliberately NOT removed, or a row
# this run could not act on and left where it stood. With a second argument it
# goes to stderr instead of stdout: a row left behind is the operator's next
# piece of work, and it must not scroll past inside a list of successes.
_offboard_kept() {
  if [ -n "${2:-}" ]; then printf 'offboard: %s\n' "$1" >&2
  else _offboard_say "$1"; fi
  _OFFBOARD_KEPT="$_OFFBOARD_KEPT$(_offboard_flat "$1")
"
}

# _offboard_warn <text> - something that went wrong without stopping the
# offboarding. ALWAYS stderr, json or not: it is not part of the answer, and it
# must not be swallowed either.
_offboard_warn() {
  printf 'offboard: %s\n' "$1" >&2
  _OFFBOARD_WARNINGS="$_OFFBOARD_WARNINGS$(_offboard_flat "$1")
"
}

# _offboard_lists - the three lists as one json object. The receipt file and
# the --json value carry the SAME shape, and this is the one place that builds
# it: two copies of the split would be two answers to "what did this run do".
_offboard_lists() {
  printf '%s' "$_OFFBOARD_REMOVED" | jq -R -s -c \
    --arg kept "$_OFFBOARD_KEPT" --arg warn "$_OFFBOARD_WARNINGS" \
    'def lines: split("\n")|map(select(length>0));
     {removed:lines,kept:($kept|lines),warnings:($warn|lines)}'
}

# _offboard_receipt <state> - the receipt file. 0700 directory, 0600 file.
# Written when the run ends, and when it stops early: a run that locked one
# account and then met a refusal on the next must leave behind what it DID do,
# or the operator has to guess how far it got.
#
# RC 1 WHEN IT COULD NOT BE WRITTEN, AND THE CALLER MUST NOT SWALLOW THAT. This
# file is the second-run guard: the next run reads it to decide whether the
# person was already offboarded and how far the last attempt got. A run that
# emptied the register and left nothing on disk saying so is a run the next one
# reads as a person who was never offboarded at all.
_offboard_receipt() { # <state>
  [ -n "$_OFFBOARD_RECEIPT" ] || return 0
  local dir; dir="$(dirname "$_OFFBOARD_RECEIPT")"
  mkdir -p "$dir" 2>/dev/null || return 1
  chmod 700 "$dir" 2>/dev/null
  local tmp; tmp="$(mktemp "$dir/.receipt.XXXXXX")" || return 1
  _offboard_lists | jq -c \
    --arg p "$_OFFBOARD_PRINCIPAL" --arg st "$1" --argjson at "$(date -u +%s)" \
    '{schemaVersion:2,principal:$p,state:$st,at:$at} + .' > "$tmp" 2>/dev/null \
    || { rm -f "$tmp"; return 1; }
  chmod 600 "$tmp" 2>/dev/null
  mv "$tmp" "$_OFFBOARD_RECEIPT" 2>/dev/null || { rm -f "$tmp"; return 1; }
  return 0
}

# _offboard_json - the one value stdout carries under --json. It names the
# receipt AND repeats its lists: a caller that cannot read the hub's home still
# gets to see what went.
_offboard_json() {
  _offboard_lists | jq -c \
    --arg p "$_OFFBOARD_PRINCIPAL" --arg r "$_OFFBOARD_RECEIPT" \
    '{ok:true,kind:"offboard",principal:$p,receipt:$r} + .'
}

# _offboard_receipt_lost - the one line a failed receipt write leaves behind.
# Plain stderr even under --json: the JSON value has already been printed by
# then (or is about to be), and stdout carries exactly one value.
_offboard_receipt_lost() {
  printf 'steward offboard: receipt could not be written: %s\n' "$_OFFBOARD_RECEIPT" >&2
}

# _offboard_fail <msg> <rc> - a refusal that writes the receipt before it
# leaves, in the shape the caller asked for. The refusal goes INTO the receipt
# too, for _redeem_fail's reason: a receipt carrying only the steps that worked
# leaves the reader with "state: failed" and no way to tell what said no. It is
# recorded as a WARNING - the place a run stopped is not a thing it removed -
# and FLATTENED, because a helper's refusal is many lines and the receipt
# splits on newlines.
_offboard_fail() {
  local msg="steward offboard: $1"
  _OFFBOARD_WARNINGS="${_OFFBOARD_WARNINGS}stopped here: $(_offboard_flat "$msg")
"
  _reg_fail "$_OFFBOARD_JSON" "$msg"
  _offboard_receipt failed || _offboard_receipt_lost
  return "${2:-70}"
}

# _offboard_helper_fail <what> <rc> <output> - the two ways one `sudo -n
# steward-account-helper` call can go wrong, told apart by _account_helper_spoke
# and never by the exit status. Returns the rc it reported.
_offboard_helper_fail() {
  local what="$1" hrc="$2" out="$3"
  if _account_helper_spoke "$out"; then
    _offboard_fail "$what - the account helper ran and refused (rc $hrc): $out" 70
    return 70
  fi
  _offboard_fail "$what - and it could not be run through 'sudo -n' at all. The estate installs exactly one line for it: steward ALL=(root) NOPASSWD: /usr/local/sbin/steward-account-helper. sudo said: $out" 77
  return 77
}

# EVERY SCANNER ANSWERS IN TAGGED LINES, `<tag> <slug>`, because "the person's
# rows" is two questions, not one: the rows this verb can act on, and the rows
# that are just as much the person's but that the loader will not vouch for. A
# scanner that answered with the first list alone dropped the second in silence,
# and a row nobody was told about is a row nobody repairs. The slug is always
# through registry_valid_name, so a tagged line cannot carry a space.
#
# _offboard_accounts <principal>
#   row <slug>        - an account row of the person's that loads
#   unreadable <slug> - a row that NAMES the person and does not load. Its HOST
#                       and USERNAME are exactly what the loader refused to
#                       vouch for, so nothing can be locked or archived from it.
# SUBSHELLED SOURCE, the same reason registry_account_slug_available gives: a
# hostile or malformed row must not overwrite this loop's own operands.
_offboard_accounts() {
  local want="$1" d f slug p
  d="$(registry_account_dir)" || return 78
  [ -d "$d" ] || return 0
  for f in "$d"/*.conf; do
    [ -e "$f" ] || continue
    slug="$(basename "$f" .conf)"
    registry_valid_name "$slug" || continue
    if p="$( registry_account_load "$slug" >/dev/null 2>&1 && printf '%s' "$ACCOUNT_PRINCIPAL" )" \
       && [ "$p" = "$want" ]; then
      printf 'row %s\n' "$slug"
      continue
    fi
    # THE ROW IS STILL ASKED WHOSE IT IS. The loader refused it, so its own
    # answer is worth nothing as a fact - but it is enough to decide whether
    # THIS offboarding is the run that should be told about it.
    p="$( PRINCIPAL=""; source "$f" 2>/dev/null; printf '%s' "$PRINCIPAL" )"
    [ "$p" = "$want" ] && printf 'unreadable %s\n' "$slug"
  done
  return 0
}

# _offboard_sessions <account-slugs> <usernames> - the session rows of this
# offboarding, given the person's account slugs and unix names (space-joined).
#   row <id>    - filed under one of the person's accounts: this verb removes it
#   orphan <id> - a row that names the person in OWNER and is NOT filed under an
#                 account this run can act on: an old-shape row carrying no
#                 ACCOUNT at all, or one filed under an account row the loader
#                 refuses. No scan by account slug finds either, and both are a
#                 live session row for a person the register says is gone.
# The subshelled source is what _redeem_session_id does one screen up, for the
# same reason and with the same set -u-safe default: sessions.d has no
# single-row loader that leaves the caller's own names alone (registry_load
# sets two dozen globals in the caller's scope, ACCOUNT and HOST among them).
_offboard_sessions() {
  local accounts=" $1 " owners=" $2 " d f a o sid
  d="$(registry_dir)"
  [ -d "$d" ] || return 0
  for f in "$d"/*.conf; do
    [ -e "$f" ] || continue
    sid="$(basename "$f" .conf)"
    registry_valid_name "$sid" || continue
    a="$( ACCOUNT=""; source "$f" 2>/dev/null; printf '%s' "$ACCOUNT" )"
    if [ -n "$a" ]; then
      case "$accounts" in *" $a "*) printf 'row %s\n' "$sid"; continue ;; esac
    fi
    o="$( OWNER=""; source "$f" 2>/dev/null; printf '%s' "$OWNER" )"
    [ -n "$o" ] || continue
    case "$owners" in *" $o "*) printf 'orphan %s\n' "$sid" ;; esac
  done
  return 0
}

# _offboard_logins <principal>
#   row <slug>        - a login row of the person's that loads
#   unreadable <slug> - a row that names the person and does not (mode, owner,
#                       a missing required key, a symlink). A row whose own
#                       PRINCIPAL cannot be read either is left unsaid: nothing
#                       here can attribute it, and warning about every broken
#                       row in the register would bury the one that is the
#                       person's under the ones that are not.
_offboard_logins() {
  local want="$1" d slug p
  d="$(registry_login_dir)" || return 0
  registry_login_list 2>/dev/null | while IFS= read -r slug; do
    [ -n "$slug" ] || continue
    if p="$( registry_login_load "$slug" >/dev/null 2>&1 && printf '%s' "$LOGIN_PRINCIPAL" )" \
       && [ "$p" = "$want" ]; then
      printf 'row %s\n' "$slug"
      continue
    fi
    [ -f "$d/$slug.conf" ] || continue
    p="$( PRINCIPAL=""; source "$d/$slug.conf" 2>/dev/null; printf '%s' "$PRINCIPAL" )"
    [ "$p" = "$want" ] && printf 'unreadable %s\n' "$slug"
  done
  return 0
}

# _offboard_host_rows <principal>
#   row <host> <field>   - a host row naming the person in OWNER or OPERATOR
#
# A host row's OWNER and OPERATOR are the machine's own record of who answers
# for it, and this verb removes the principal row those two fields name:
# offboarding the person a host row names leaves that row naming a principal with no row
# anywhere. NOTHING IN THE FLEET WOULD REPORT THAT - the loaders check the FORM
# of the slug (registry_host_load, lib/registry.sh), not that a principal by
# that name exists - which is the reason to refuse here rather than to warn.
#
# Read by a subshelled source, not registry_host_load, for the reason
# _registry_host_hub_value gives - a reader must not silently acquire an OWNER
# from a file it only asked one key of. A CONF THAT CANNOT BE READ NEVER
# REACHES THIS SCAN: `source` on a mode-000 file fails quietly and leaves OWNER
# empty, so the one file that would have closed this gate is the one that reads
# as a row naming nobody - which is why _offboard_register_readable refuses
# every unreadable row in every register before this function is ever called.
_offboard_host_rows() {
  local want="$1" d f h owner operator
  d="$(registry_host_dir)"
  [ -d "$d" ] || return 0
  for f in "$d"/*.conf; do
    [ -e "$f" ] || continue
    h="$(basename "$f" .conf)"
    registry_valid_name "$h" || continue
    owner="$(   OWNER="";    source "$f" 2>/dev/null; printf '%s' "$OWNER" )"
    operator="$( OPERATOR=""; source "$f" 2>/dev/null; printf '%s' "$OPERATOR" )"
    [ "$owner" = "$want" ] && printf 'row %s OWNER\n' "$h"
    [ "$operator" = "$want" ] && printf 'row %s OPERATOR\n' "$h"
  done
  return 0
}

# _offboard_register_readable <principal> <json-flag> - every register this verb
# reads, checked before it acts.
#
# A DIRECTORY THAT CANNOT BE LISTED ANSWERS EVERY QUESTION WITH "NOTHING", and
# every question this verb asks is "does anything here still name this person" -
# so an unreadable register reads as a person with no rows in it, and the run
# reports a finished cleanup over rows it never saw. Measured before this gate
# existed: a mode-000 hosts.d walked straight past the operator refusal below
# and offboarded the machine's own operator at rc 0; a mode-000 sessions.d left
# the session row and the bus relay row in the hub's authorized_keys standing
# behind a receipt that said "done" with no warnings at all.
#
# AN ABSENT DIRECTORY IS A DIFFERENT ANSWER and stays legitimate for six of the
# seven: nothing that is not there can name anybody. That is the distinction
# registry_entity_list already draws in its own words - empty is a claim,
# unreadable supports none. The seventh is entities.d, and the third column of
# the list below says so: that one register this verb cannot finish without.
#
# THE ROWS INSIDE EACH REGISTER ARE CHECKED HERE TOO, in the same loop and for
# the same reason one level down - see the comment on the walk itself.
_offboard_register_readable() {
  local principal="$1" want_json="$2" reg_label reg_fn reg_need reg_dir reg_f bad_row_list
  while read -r reg_label reg_fn reg_need; do
    [ -n "$reg_label" ] || continue
    reg_dir="$("$reg_fn" 2>/dev/null)"
    # SOMETHING THAT IS THERE AND IS NOT A DIRECTORY IS NOT AN ABSENT REGISTER.
    # A plain file at a register's path is neither -L nor -d, so it used to land
    # in the "absent is legitimate" arm below: measured, a regular file at the
    # host register offboarded the machine's own OWNER and OPERATOR at rc 0 with
    # state "done" and warnings [] - the same harm as a register this run cannot
    # list, through the one shape the gate did not classify. It is worse than
    # the unreadable case, because a file at a register's path survives a mode
    # sweep and reads as "never set up".
    #
    # THIS ARM COMES FIRST, AND THAT ORDER IS THE MESSAGE. Below the `-L` arm,
    # every non-directory SYMLINK - a link to a regular file, a link loop -
    # answered "points at nothing" and sent the operator to repair a link that
    # `ls -lL` resolves perfectly. A dangling link is not `-e`, so it still
    # falls through to the arm that names it correctly.
    if [ -e "$reg_dir" ] && [ ! -d "$reg_dir" ]; then
      _reg_fail "$want_json" "steward offboard: $reg_dir is not a directory, so whether anything there still names '$principal' is unknown - a register that is something else is not a register with nothing in it. Restore the register directory and run offboard again."
      return 78
    fi
    # AND A LINK THAT POINTS AT NOTHING IS NOT AN ABSENT REGISTER EITHER.
    # `[ -d ]` is false for a dangling symlink, so without this it lands in the
    # "absent is legitimate" arm below and the run finishes at rc 0 - but an
    # estate that points a register somewhere has SAID something is there, and
    # what it named is gone. That is "something is there that I cannot use", the
    # same answer as a directory this run cannot list. A link to a readable
    # directory is a register like any other: `-d`, `-r` and `-x` all follow.
    if [ -L "$reg_dir" ] && [ ! -d "$reg_dir" ]; then
      _reg_fail "$want_json" "steward offboard: $reg_dir points at nothing, so whether anything there still names '$principal' is unknown - a register the estate points somewhere is not a register with nothing in it. Repair the link (or remove it, if that register really is gone) and run offboard again."
      return 78
    fi
    if [ ! -d "$reg_dir" ]; then
      # ABSENT, AND WHETHER THAT IS AN ANSWER OR A PROBLEM IS DATA, not a
      # special case: the third column above. Six of these registers may be
      # missing and the cleanup still finishes. The entity register may not -
      # registry_entity_list refuses a directory that is not there, and the
      # step that calls it runs AFTER the unix account is locked and its row
      # removed, so an absent entities.d used to leave a half-offboarded person
      # and a receipt in state "failed" behind a gate whose whole purpose is to
      # refuse before the first side effect.
      #
      # A MISRESOLVED ESTATE ROOT IS NOT DIAGNOSED HERE. Every registry_*_dir
      # is an unconditional printf and returns a non-empty path even when the
      # root does not resolve, so there is no "could not be resolved" answer to
      # give; a root that points nowhere is caught by registry_load's own
      # `no such principal` refusal, rc 78, before anything happens.
      # AND THE DEFAULT OF THAT COLUMN IS REFUSAL, NOT PERMISSION. Written as
      # `[ "$reg_need" = "required" ] || continue` a typo in the third column
      # meant "optional" in silence, which is the permissive answer for a gate
      # that exists to be strict. An unrecognised class is a bug in this file,
      # so it is answered here rather than walked past.
      case "$reg_need" in
        required) : ;;
        optional) continue ;;
        *) _reg_fail "$want_json" "steward offboard: internal: unknown register class '$reg_need' for the $reg_label register - the third column of this verb's register list must be 'required' or 'optional'."
           return 78 ;;
      esac
      _reg_fail "$want_json" "steward offboard: the $reg_label register is not there ($reg_dir), and this verb cannot finish without it - the step that reads it runs after the unix account is locked and its row is removed, so carrying on would leave '$principal' half offboarded. Restore the register directory (an estate with no rows in it still has the directory) and run offboard again."
      return 78
    fi
    if ! { [ -r "$reg_dir" ] && [ -x "$reg_dir" ]; }; then
      _reg_fail "$want_json" "steward offboard: $reg_dir cannot be listed, so whether anything there still names '$principal' is unknown - a register this run cannot read is not a register with nothing in it. Fix the mode or the owner of that directory and run offboard again."
      return 78
    fi
    # AND EVERY ROW INSIDE IT. A ROW NOBODY CAN READ MAY BE ANYBODY'S. Every
    # scanner in this verb reaches a row through a loader or a subshelled
    # `source`, and both fail QUIETLY on a file they cannot open - so a
    # mode-000 conf is not skipped-and-said, it is never attributed to anybody
    # at all. MEASURED 2026-09-09, all of it rc 0 with state "done" and empty
    # kept[] and warnings[]: a mode-000 accounts.d row left a second unix
    # account of the person's unlocked and its home unarchived; a mode-000
    # sessions.d row left the session row AND its bus relay row standing in the
    # hub's authorized_keys; a mode-000 entities.d row left the person a member
    # of that entity.
    #
    # WALKED INLINE, NEVER THROUGH A HELPER THAT PRINTS PATHS: a file name may
    # carry a newline, and a line-parsed helper would split it into two names
    # that are each a lie.
    bad_row_list=""
    for reg_f in "$reg_dir"/*.conf; do
      # -e IS FALSE FOR A DANGLING SYMLINK, and a row the estate points at
      # something that is gone is exactly the row this loop exists for:
      # measured, a dangling session row left its bus relay row standing in the
      # hub's authorized_keys behind a receipt that said "done" with no
      # warnings. (An unexpanded glob is neither -e nor -L, so the no-rows case
      # is unchanged.)
      [ -e "$reg_f" ] || [ -L "$reg_f" ] || continue
      # AND A ROW MUST BE A FILE. `-r` is true for a directory and for a fifo,
      # so both walk past the check this loop exists for. Measured: a fifo named
      # *.conf in sessions.d BLOCKED the run forever, after the unix account was
      # already locked and before any receipt was written - the loader's `source`
      # opens the pipe and waits for a writer that never comes. A directory named
      # *.conf came back rc 0, state "done", warnings []. (An unexpanded glob is
      # still neither -e nor -L, so the no-rows case is unchanged.)
      { [ -f "$reg_f" ] && [ -r "$reg_f" ]; } && continue
      bad_row_list="${bad_row_list:+$bad_row_list, }$reg_f"
    done
    if [ -n "$bad_row_list" ]; then
      _reg_fail "$want_json" "steward offboard: $bad_row_list is not a regular file this run can read, so whether it names '$principal' is unknown - a row nobody can read is not a row that names nobody. Fix the mode or the owner of that file (or repair the link, if it is one) and run offboard again."
      return 78
    fi
  done <<'EOF'
account registry_account_dir optional
principal registry_principal_dir optional
session registry_dir optional
login registry_login_dir optional
host registry_host_dir optional
entity registry_entity_dir required
invitation registry_invite_dir optional
EOF
  return 0
}

cmd_offboard() {
  local want_json="" principal="" keep_home="" a
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) shift ;;
      --keep-home) keep_home=1; shift ;;
      -*) _reg_fail "$want_json" "steward offboard: unknown flag '$1'"; return 64 ;;
      *) if [ -n "$principal" ]; then _reg_fail "$want_json" "steward offboard: one principal at a time"; return 64; fi
         principal="$1"; shift ;;
    esac
  done
  [ -n "$principal" ] || { _reg_fail "$want_json" "steward offboard: a principal is required"; return 64; }
  if ! [[ "$principal" =~ ^[a-z][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward offboard: invalid principal '$principal' (a-z, then a-z 0-9 and hyphen)"
    return 64
  fi

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  _OFFBOARD_JSON="$want_json"; _OFFBOARD_REMOVED=""; _OFFBOARD_KEPT=""
  _OFFBOARD_WARNINGS=""; _OFFBOARD_RECEIPT=""
  _OFFBOARD_PRINCIPAL="$principal"

  # BEFORE ANY QUESTION IS ASKED OF A REGISTER, THAT REGISTER IS READ-CHECKED.
  # This runs first because every gate below it - the host rows, the account
  # rows, the second-run receipt - reads a directory to reach its answer, and a
  # gate that cannot see is a gate that says yes.
  _offboard_register_readable "$principal" "$want_json" || return 78

  local pconf acct_scan accounts="" acct_dead="" tag val
  pconf="$(registry_principal_dir)/$principal.conf"
  acct_scan="$(_offboard_accounts "$principal")" || {
    _reg_fail "$want_json" "steward offboard: the account register could not be read, so who belongs to '$principal' is unknown"
    return 78; }
  while read -r tag val; do
    case "$tag" in
      row)        accounts="${accounts:+$accounts }$val" ;;
      unreadable) acct_dead="${acct_dead:+$acct_dead }$val" ;;
    esac
  done <<EOF
$acct_scan
EOF

  if [ ! -e "$pconf" ] && [ -z "$accounts" ] && [ -z "$acct_dead" ]; then
    local probe="" rfile="" rstate="" rstopped=""
    probe="$(registry_state_dir_name 2>/dev/null)" || probe=""
    [ -n "$probe" ] && rfile="$HOME/.local/state/$probe/offboards/$principal.receipt.json"
    if [ -n "$rfile" ] && [ -f "$rfile" ]; then
      # THE RECEIPT'S STATE, NOT ITS EXISTENCE. A receipt on disk says an
      # offboarding RAN, never that it FINISHED - and the steps that come last
      # are the ones outside the register: the account lock, the home. A run
      # that emptied the register and then met the helper's belt leaves exactly
      # this shape behind: no rows, a receipt, and a home still sitting under
      # the person's own name. Reading the file's existence alone answered the
      # next run with "nothing left to remove", rc 0 - to an operator who is
      # re-running the cleanup precisely to be sure it is clean.
      rstate="$(jq -r '.state // ""' "$rfile" 2>/dev/null)" || rstate=""
      if [ "$rstate" != "done" ]; then
        # BOTH LISTS ARE READ. `stopped here:` moved from removed[] to
        # warnings[] at schemaVersion 2, and a receipt written by the older
        # shape is exactly the one a reader is most likely to meet here.
        rstopped="$(jq -r '((.warnings // []) + (.removed // []))[]
                           | select(startswith("stopped here:"))' "$rfile" 2>/dev/null | head -1)"
        [ -n "$rstopped" ] || rstopped="(the receipt does not say where it stopped)"
        _reg_fail "$want_json" "steward offboard: the last offboarding of '$principal' did not finish - $rfile is in state '$rstate'. Its register rows are gone, so there is nothing left here to remove, but what that run had not done is still undone. Read the receipt, finish it by hand, and remove the receipt when it is: $rstopped"
        return 70
      fi
      # ALREADY OFFBOARDED, AND FINISHED. A second run is a no-op, not a
      # refusal: a cleanup somebody re-runs to be sure must be safe to re-run.
      # AND IT LEAVES THE RECEIPT ALONE - this run removed nothing, so writing
      # one from here would publish an empty list over the record of the first.
      _OFFBOARD_RECEIPT="$rfile"
      _offboard_say "nothing left to remove for $principal"
      [ -n "$want_json" ] && _offboard_json
      return 0
    fi
    _reg_fail "$want_json" "steward offboard: no such principal '$principal' - nothing to offboard"
    return 78
  fi

  # THE MACHINES' OWN RECORD OF WHO ANSWERS FOR THEM COMES FIRST. A host row
  # names an OWNER and an OPERATOR, and this verb removes the principal row those
  # two fields name - so offboarding the person a host row names leaves it naming
  # a principal that no longer has a row anywhere, and does it while reporting
  # rc 0. What the loaders check is the FORM of that slug, not that a principal
  # by that name exists, so nothing downstream would report the dangling name
  # either. This verb never edits hosts.d: who takes over a machine is not a
  # thing a cleanup gets to decide.
  #
  # EVERY MATCHING ROW IS NAMED, NOT THE FIRST. A refusal that named one row at
  # a time sent the operator to repair it, re-run, and be refused again by the
  # next - and the second refusal reads as a verb that changed its mind.
  #
  # A HOST CONF THIS RUN CANNOT OPEN IS NOT ANSWERED HERE ANY MORE. It used to
  # be, one register at a time; the register gate above now refuses every
  # unreadable row in all seven registers before this scan runs, so a second
  # refusal here would only send the operator round the same loop twice.
  local host_rows hr_tag hr_host hr_field hr_list=""
  host_rows="$(_offboard_host_rows "$principal")"
  while read -r hr_tag hr_host hr_field; do
    case "$hr_tag" in
      row) hr_list="${hr_list:+$hr_list, }hosts.d/$hr_host.conf as its $hr_field" ;;
    esac
  done <<EOF
$host_rows
EOF
  if [ -n "$hr_list" ]; then
    _reg_fail "$want_json" "steward offboard: the host register names '$principal' - $hr_list - and offboarding would leave those rows naming a principal that no longer exists. Name whoever takes each machine over in the host row first; this verb never edits hosts.d."
    return 65
  fi

  # THE HELPER IS LOCAL, AND SO IS EVERYTHING IT TOUCHES: it locks an account
  # in THIS machine's account database and moves a home on THIS machine's disk.
  # A person whose account row names another host would come out half
  # offboarded - rows gone here, account still open there - so the refusal
  # comes before the first side effect, exactly as `invite redeem` refuses an
  # invitation for another machine before it makes anything.
  #
  # OFFBOARDING A PERSON WHO HAS ACCOUNTS ON SEVERAL HOSTS IS LATER WORK. It
  # needs the verb to reach the other machines (or the operator to run it on
  # each), and the receipt to say which hosts it covered. Refusing is the
  # honest half of that until it exists.
  # THE ACCOUNT ROWS ARE READ ONCE, into one <slug> TAB <host> TAB <username>
  # list. The gate needs the host, the helper needs the username, and reading
  # the row again for each is another chance for it to have changed between the
  # decision and the act. TAB-SEPARATED, and every field that goes in is checked
  # against the writer's own grammar first - see below: the loader checks that
  # HOST is non-empty and lets USERNAME default, so the separators this list is
  # built on are exactly the characters neither field was ever checked for.
  #
  # THE ROW IS SOURCED IN A CHILD PROCESS, NOT IN THIS FRAME - the shape
  # `steward registry session check` uses, and for the same reason. The
  # loader's own wall stops a row from reaching the LOADER's locals; it cannot
  # stop one from reaching THIS verb's, because bash scope is dynamic and every
  # local declared above this loop is still live inside it. MEASURED: an
  # accounts.d row carrying the line keep_home="" cleared the operator's own
  # flag, so --archive-home went to the helper AGAINST --keep-home and a home
  # the operator asked to keep was moved; want_json="1" in the same row turned
  # the answer into JSON nobody asked for. The fork closes every local at once -
  # keep_home, want_json, accounts, rows, usernames, acct_bad, principal - and
  # not just the ones a reviewer thought to name.
  #
  # HOST COMES BACK FIRST AND USERNAME LAST, because the crossing is text and
  # the fields are exactly the two the loader does not check the FORM of. HOST
  # is loader-checked non-empty, so the first line cannot be collapsed. Printed
  # the other way round, a forged USERNAME would be reported as a bad HOST.
  #
  # AND A SENTINEL AFTER THEM, the same one the two entity crossings carry.
  # Command substitution strips EVERY trailing newline, so a USERNAME that is
  # nothing but newlines loses its whole line and a reader splitting on the
  # first newline finds none - leaving the HOST value standing in the USERNAME's
  # place. MEASURED: HOST="host-a" with an all-newline USERNAME passed both form
  # gates below as the username "host-a" and the run locked, and archived the
  # home of, a unix account no register row names, at rc 0. The sentinel tells a
  # line that was lost from a field that was short, and a miss is reported
  # against USERNAME - the field the collapse consumed.
  local acct rows="" usernames="" acct_bad="" ac_row ac_rc ac_host ac_user ac_end ac_over
  for acct in $accounts; do
    ac_row="$( registry_account_load "$acct" >/dev/null 2>&1 \
               && printf '%s\n%s\nok\n' "$ACCOUNT_HOST" "$ACCOUNT_USERNAME" )"
    ac_rc=$?
    if [ "$ac_rc" -eq 0 ]; then
      { IFS= read -r ac_host
        IFS= read -r ac_user
        IFS= read -r ac_end
        IFS= read -r ac_over
      } <<EOF
$ac_row
EOF
      if [ "$ac_end" != "ok" ] || [ -n "$ac_over" ]; then
        acct_bad="${acct_bad:+$acct_bad }$acct:USERNAME"
        continue
      fi
      # THE TWO FIELDS THE LOADER DOES NOT CHECK THE FORM OF, CHECKED HERE.
      # registry_account_load validates PRINCIPAL and asks only that HOST be
      # non-empty; USERNAME it lets default. THE WRITER'S OWN PREDICATES, CALLED
      # AND NOT TRANSCRIBED - _registry_host_form and _registry_username_form
      # are defined beside cmd_registry_account_add, which is where these values
      # enter the register - because a value the writer would have refused is
      # not a value a reader may act on, and a copy of the regex would go on
      # saying that after the writer's grammar had moved. MEASURED: a
      # hand-edited USERNAME carrying a newline and two tabs forged a second row
      # inside this very list, and the run locked a unix account NO register row
      # names and archived its home - rc 0, filed under this person's
      # offboarding.
      if ! _registry_host_form "$ac_host"; then
        acct_bad="${acct_bad:+$acct_bad }$acct:HOST"
      elif ! _registry_username_form "$ac_user"; then
        acct_bad="${acct_bad:+$acct_bad }$acct:USERNAME"
      else
        rows="$rows$acct	$ac_host	$ac_user
"
        usernames="${usernames:+$usernames }$ac_user"
      fi
    else
      # It loaded during the scan a moment ago and does not now. Treat it as
      # what it has become - a row nothing can vouch for - rather than reading
      # the fields the loader just refused.
      acct_dead="${acct_dead:+$acct_dead }$acct"
    fi
  done

  # REFUSED BEFORE THE LIST IS READ BACK, not after. The forged row would be a
  # line INSIDE the list, and every loop below - the host gate, the lock, the
  # archive - reads it as a row of its own; there is no later place where it is
  # still one row. Nothing has happened yet, so this is _reg_fail and not
  # _offboard_fail: no receipt exists to stamp "failed" over.
  local bad bad_list=""
  for bad in $acct_bad; do
    bad_list="${bad_list:+$bad_list, }accounts.d/${bad%:*}.conf (${bad##*:})"
  done
  if [ -n "$bad_list" ]; then
    _reg_fail "$want_json" "steward offboard: $bad_list carries a value this register's own writer would have refused (HOST a-z0-9 then a-z0-9 and hyphen, USERNAME a-z then a-z0-9 and hyphen). A field that was hand-edited past the writer is not a field this verb locks an account or moves a home on. Repair the row and run offboard again."
    return 78
  fi

  accounts=""
  local self_host racct rhost ruser
  self_host="$(_registry_self_host)"
  while IFS='	' read -r racct rhost ruser; do
    [ -n "$racct" ] || continue
    if [ "$rhost" != "$self_host" ]; then
      _reg_fail "$want_json" "steward offboard: account $racct lives on host $rhost, and this host is $self_host; run offboard on $rhost (this verb touches only the host it runs on)"
      return 65
    fi
    accounts="${accounts:+$accounts }$racct"
  done <<EOF
$rows
EOF

  # AN UNREADABLE ACCOUNT ROW IS AN UNLOCKED UNIX ACCOUNT. Its HOST and USERNAME
  # are exactly what the loader refused to vouch for, so nothing here can name
  # the account it stands for - the lock never happens, the home never moves,
  # and a run that carried on would put "state: done" over both. It was one loud
  # warning at rc 0 until 2026-09-09, which is the receipt telling an operator
  # who re-reads it that the cleanup finished. Refused where the host gate
  # refuses: before the first side effect, before a receipt exists - hence
  # _reg_fail, never _offboard_fail, which would stamp "failed" over the record
  # of a previous run that did happen.
  local dead dead_list=""
  for dead in $acct_dead; do dead_list="${dead_list:+$dead_list, }accounts.d/$dead.conf"; done
  if [ -n "$dead_list" ]; then
    _reg_fail "$want_json" "steward offboard: $dead_list names '$principal' and does not load, so nothing here can name the unix account it stands for - locking nothing and archiving nothing while reporting the person gone is the one answer this verb must not give. Repair the row (or remove it, if the account is already gone) and run offboard again."
    return 78
  fi

  local state_dir
  state_dir="$(registry_state_dir_name)" || {
    _reg_fail "$want_json" "steward offboard: the estate does not name a state directory, so no receipt could be written"
    return 78; }
  _OFFBOARD_RECEIPT="$HOME/.local/state/$state_dir/offboards/$principal.receipt.json"

  local out rc home locked=""
  local hub_ak="${STEWARD_AUTHORIZED_KEYS:-$HOME/.ssh/authorized_keys}"

  # 1. STOP THE WORK, THROUGH THE HELPER. `lock` disables lingering, which
  # takes the account's user manager down and every session unit with it. It is
  # the only way the steward account can stop another person's sessions without
  # a shell in their home.
  while IFS='	' read -r racct rhost ruser; do
    [ -n "$ruser" ] || continue
    # THE HOME IS RESOLVED WHILE THE ROW STILL EXISTS. Once the account row is
    # gone there is nothing left that names the unix account, and the archive
    # step below would have nothing to ask about.
    home="$(_registry_owner_home "$ruser" 2>/dev/null)" || home=""
    out="$(sudo -n /usr/local/sbin/steward-account-helper lock "$ruser" 2>&1)"; rc=$?
    if [ "$rc" -ne 0 ]; then
      _offboard_helper_fail "the unix account '$ruser' could not be locked" "$rc" "$out"
      return $?
    fi
    _offboard_note "unix account $ruser locked, lingering disabled (its session units are down)"
    locked="$locked$racct	$ruser	$home
"
  done <<EOF
$rows
EOF

  # 2. UNBIND THE BUS. The relay ROW lives in the hub's own authorized_keys and
  # is ours to remove; the relay KEY and the delivery key live in the person's
  # home and travel with it into the archive.
  local sid sids="" tmp_ak sess_scan
  # THE OWNER NAMES ARE HANDED IN ALONGSIDE THE ACCOUNT SLUGS. A session row
  # filed under one of the person's accounts is this verb's to remove; an
  # old-shape row that names them in OWNER and carries no ACCOUNT is not - the
  # register cannot tell whose account it ran under - but leaving it unsaid is
  # what turns a completed cleanup into a live session for a person the
  # register says is gone.
  sess_scan="$(_offboard_sessions "$accounts" "$usernames $principal")"
  while read -r tag val; do
    case "$tag" in
      row)    sids="${sids:+$sids }$val" ;;
      orphan) _offboard_kept "sessions.d/$val.conf names '$principal' in OWNER but is not filed under any account row this run could act on - left in place, realign it by hand" loud ;;
    esac
  done <<EOF
$sess_scan
EOF
  for sid in $sids; do
    if grep -q "bus-relay-in $sid\"" "$hub_ak" 2>/dev/null; then
      # ONE BACKUP, UNDER ONE NAME. A timestamped copy per offboarding turns
      # the hub's .ssh into a pile of files that each authorize something,
      # and the oldest of them authorizes everybody who ever left.
      if cp "$hub_ak" "$hub_ak.bak-offboard" 2>/dev/null; then
        chmod 600 "$hub_ak.bak-offboard" 2>/dev/null
      else
        _offboard_warn "no backup of $hub_ak could be made; the relay row for $sid is removed anyway - a row that stays is a channel that stays open"
      fi
      tmp_ak="$(mktemp "$(dirname "$hub_ak")/.authorized_keys.XXXXXX")" || {
        _offboard_fail "no temporary file could be made beside $hub_ak, so the relay row for $sid was left in place" 70
        return 70; }
      grep -v "bus-relay-in $sid\"" "$hub_ak" > "$tmp_ak" \
        || true   # grep exits 1 on an empty result, which is a valid outcome
      mv "$tmp_ak" "$hub_ak" || { rm -f "$tmp_ak"; _offboard_fail "could not rewrite $hub_ak" 70; return 70; }
      _offboard_note "relay row for $sid removed from $hub_ak"
    fi
  done

  # 3. THE ROWS, INNERMOST FIRST. A session references a login and an account;
  # removing the account first would leave a row referencing nothing, and every
  # reader in the fleet is a concurrent reader.
  for sid in $sids; do
    if [ -e "$(registry_dir)/$sid.conf" ]; then
      rm -f "$(registry_dir)/$sid.conf" || { _offboard_fail "could not remove sessions.d/$sid.conf" 70; return 70; }
      _offboard_note "sessions.d/$sid.conf removed"
    fi
  done
  local login_scan
  login_scan="$(_offboard_logins "$principal")"
  while read -r tag val; do
    case "$tag" in
      row) rm -f "$(registry_login_dir)/$val.conf" || { _offboard_fail "could not remove logins.d/$val.conf" 70; return 70; }
           _offboard_note "logins.d/$val.conf removed" ;;
      # A ROW THE LOADER REFUSES IS NOT A ROW TO DELETE ON A GUESS. What it is -
      # a wrong mode, a missing key, a symlink somebody planted - is exactly
      # what the loader would not vouch for, and removing a credential row on
      # the strength of a bare `source` is the reading this verb must not do.
      unreadable) _offboard_kept "logins.d/$val.conf names '$principal' and does not load, so nothing here can vouch for what it is - left in place, read it by hand" loud ;;
    esac
  done <<EOF
$login_scan
EOF
  for acct in $accounts; do
    if [ -e "$(registry_account_dir)/$acct.conf" ]; then
      rm -f "$(registry_account_dir)/$acct.conf" || { _offboard_fail "could not remove accounts.d/$acct.conf" 70; return 70; }
      _offboard_note "accounts.d/$acct.conf removed"
    fi
  done

  # 4. MEMBERSHIP, in every entity that carries the person. The rewrite goes
  # through the redemption's own validate_fn, and it is handed the SAME two
  # globals: a MEMBERS that moved between this read and the write under the
  # lock is refused rc 70, never merged and never published over. This run
  # measured its decision against a state that no longer exists, and the right
  # answer is to run the verb again.
  #
  # AND THE ROW IS SOURCED IN A CHILD PROCESS, the same shape and the same
  # reason as the account rows above. This load runs INSIDE cmd_offboard's own
  # frame, and the decisions this verb is still holding when it gets here -
  # keep_home is not read until step 6, want_json not until the last line - are
  # locals of that frame. MEASURED: an entities.d row carrying the line
  # keep_home="" moved a home the operator asked to keep, and want_json="1" in
  # the same row turned the answer into JSON nobody asked for; both of them
  # through the register this verb reads for EVERY person it offboards, whether
  # or not anybody has touched their account row. The fork closes principal,
  # locked, rows, accounts and the rest at once.
  #
  # ALL FOUR FIELDS COME BACK, AND A SENTINEL AFTER THEM - see the same
  # crossing at step 5 of `invite redeem`: _entity_members_replace composes the
  # row out of what the load left behind, so a crossing carrying MEMBERS alone
  # would publish the entity back with its NAME, MANAGED_BY and MCP_ASSETS
  # emptied, and command substitution strips trailing newlines, so an empty
  # MCP_ASSETS would otherwise collapse into the field before it. A field
  # carrying a newline of its own pushes the sentinel off line five, and is
  # refused here rather than read as a different field: a row whose fields
  # cannot be told apart is a row this run cannot say whether it names the
  # person, and by this step the account is already locked and its rows already
  # gone. Refusing is loud; the silent alternative leaves them a member of an
  # entity under a receipt that says done.
  local ent_ids eid newm w ent_row ent_end ent_over
  ent_ids="$(registry_entity_list 2>/dev/null)" || {
    _offboard_fail "the entity register could not be listed, so the memberships of '$principal' are unknown" 78
    return 78; }
  for eid in $ent_ids; do
    ent_row="$( registry_entity_load "$eid" >/dev/null 2>&1 \
                && printf '%s\n%s\n%s\n%s\nok\n' \
                     "$ENTITY_NAME" "$ENTITY_MEMBERS" "$ENTITY_MANAGED_BY" "$ENTITY_MCP_ASSETS" )" || continue
    { IFS= read -r ENTITY_NAME
      IFS= read -r ENTITY_MEMBERS
      IFS= read -r ENTITY_MANAGED_BY
      IFS= read -r ENTITY_MCP_ASSETS
      IFS= read -r ent_end
      IFS= read -r ent_over
    } <<EOF
$ent_row
EOF
    if [ "$ent_end" != "ok" ] || [ -n "$ent_over" ]; then
      _offboard_fail "entity '$eid' carries a control character or newline in one of its fields, so whether it still names '$principal' cannot be read" 64
      return 64
    fi
    case " $ENTITY_MEMBERS " in *" $principal "*) ;; *) continue ;; esac
    # SPLIT THROUGH _registry_words, NEVER BY A BARE EXPANSION. MEMBERS is
    # exposed by the loader without being validated word by word, so an
    # unquoted `for w in $ENTITY_MEMBERS` is word splitting AND pathname
    # expansion: a row carrying an asterisk would rewrite the entity with this
    # directory's file names as its members. Same lesson, same instrument, as
    # the grant lists in lib/visibility.sh.
    newm=""
    _registry_words "$ENTITY_MEMBERS"
    for w in "${REGISTRY_WORDS[@]+"${REGISTRY_WORDS[@]}"}"; do
      [ "$w" = "$principal" ] && continue
      newm="${newm:+$newm }$w"
    done
    # THE SAME FUNCTION `invite redeem` COMPOSES ITS MEMBERSHIP WITH, and for
    # the same reason: the row this loop read is the snapshot the under-lock
    # recheck compares against, so a membership change that lands in between is
    # refused rather than published over.
    out="$(_entity_members_replace "$eid" "$newm" "steward offboard" 2>&1)"; rc=$?
    [ "$rc" -eq 0 ] || { _offboard_fail "could not update entity '$eid': $out" "$rc"; return "$rc"; }
    _offboard_note "membership of entity $eid removed"
  done

  # 5. THE PRINCIPAL.
  if [ -e "$pconf" ]; then
    rm -f "$pconf" || { _offboard_fail "could not remove principals.d/$principal.conf" 70; return 70; }
    _offboard_note "principals.d/$principal.conf removed"
  fi

  # 6. THE HOME. Archived by the helper, never deleted, and only when there is
  # still a home to archive - a resumed run must not fail on a move that has
  # already happened. A SECOND `lock` CALL, on an account step 1 already
  # locked: the helper's lock is idempotent by contract, and keeping the two
  # apart is what lets the rows come out between them, in the reverse of the
  # order a redemption put them in.
  # FED BY A HEREDOC, NOT A PIPE. A `while ... done` on the right of a pipe
  # runs in a subshell, where this function's `return` would end the subshell
  # and the run would carry on as if the helper had never refused.
  local lacct lname lhome archived
  while IFS='	' read -r lacct lname lhome; do
    [ -n "$lname" ] || continue
    if [ -n "$keep_home" ]; then
      # AND THE KEY THAT STAYS WITH IT. Both keys live in the person's home and
      # were meant to travel with it into the archive; this is the one path
      # where the home does not travel, so the hub's delivery key is still
      # installed in a directory the register no longer describes. The account
      # is locked, so nothing can use it - but the receipt is the record.
      _offboard_kept "home of $lname kept in place (--keep-home); the hub's delivery key is still installed in that home" loud
    elif [ -n "$lhome" ] && [ -d "$lhome" ]; then
      out="$(sudo -n /usr/local/sbin/steward-account-helper lock "$lname" --archive-home 2>&1)"; rc=$?
      if [ "$rc" -ne 0 ]; then
        _offboard_helper_fail "the home of '$lname' could not be archived" "$rc" "$out"
        return $?
      fi
      archived="$(printf '%s\n' "$out" | sed -n 's/^helper: archived //p' | head -1)"
      [ -n "$archived" ] || archived="(the helper named no path)"
      _offboard_note "home of $lname archived, not deleted: $archived"
    fi
  done <<EOF
$locked
EOF

  # 7. THE INVITATION STAYS. Said out loud, because "the exact reverse" would
  # otherwise read as "the invitation goes too".
  local inv inv_state
  for inv in $(registry_invite_list 2>/dev/null); do
    inv_state="$( registry_invite_load "$inv" >/dev/null 2>&1 && \
                  [ "$INVITE_PRINCIPAL" = "$principal" ] && printf '%s' "$INVITE_STATE" )"
    [ -n "$inv_state" ] || continue
    _offboard_kept "invitation $inv KEPT as history (state $inv_state)"
  done

  # THE SNAPSHOT IS NOT FATAL AND NOT SILENT. It is a projection of the
  # register, and the register has already changed - so its failure undoes
  # nothing. It is still the operator's business: until somebody runs it, the
  # desk keeps showing a person who is gone.
  bash "$HERE/bin/steward" desk snapshot >/dev/null 2>&1; rc=$?
  if [ "$rc" -ne 0 ]; then
    _offboard_warn "desk snapshot failed (rc $rc); rows are removed, run 'steward desk snapshot' by hand"
  fi

  if [ -z "$_OFFBOARD_REMOVED" ]; then
    _offboard_say "nothing left to remove for $principal"
  fi
  # THE RECEIPT IS THE LAST THING, AND ITS FAILURE IS THE RUN'S. Everything
  # above has already happened; if nothing on disk says so, the next run reads
  # an empty register and a missing receipt as a person who was never
  # offboarded - and answers rc 78, "no such principal", over a home that is
  # already archived and an account that is already locked.
  if ! _offboard_receipt done; then
    _offboard_receipt_lost
    _reg_fail "$want_json" "steward offboard: '$principal' is out of the register, but the receipt could not be written: $_OFFBOARD_RECEIPT - nothing on disk records what this run did, and a later run cannot tell it finished"
    return 70
  fi
  [ -n "$want_json" ] && _offboard_json
  return 0
}

# _migrate_snap <conf> <FIELD> — prints the value FIELD holds after sourcing
# <conf>, IN A SUBSHELL. The subshelled source is the whole safety story: a
# hostile conf is sourced in a child process, so nothing it assigns reaches
# this verb's own locals (bash's dynamic scoping cannot cross the fork), and
# any command substitution it carries executes and dies there. Only the ONE
# named field crosses back, through `${!name}` indirection. Reset to empty
# before the source so a field the conf omits reads as empty, never as a
# value the parent environment happened to hold.
#
# BASH 3.2: no arrays of the modern kind, no mapfile — so each field is
# snapshotted with its own call rather than a NUL-delimited bulk read. A
# session conf is a handful of fields and this is a rare admin operation;
# the cost is a few extra subshelled sources, and the payoff is the exact
# containment the account-slug scanner already relies on.
_migrate_snap() {
  local __conf="$1" __name="$2"
  ( eval "$__name=''"; unset "$__name" 2>/dev/null; eval "$__name=''"
    # shellcheck source=/dev/null
    source "$__conf" 2>/dev/null; printf '%s' "${!__name}" )
}

# _realign_login_registered <login> — rc 0 when some accounts.d row names that
# login as its USERNAME.
#
# WHAT IT IS FOR. realign writes a LOGIN into OWNER, and every path derived from
# OWNER is a path in that login home. A row whose OWNER names a login the
# register does not know is a row whose home, log and op token path point at a
# person nothing in the register describes - and the read-back through
# registry_load cannot see it, because the loader builds those paths from the
# string without asking whether it belongs to anybody.
#
# THE SCAN IS THE MEASUREMENT, not the value already in hand. want_owner came
# out of one account row a moment earlier; asking the register again is what
# turns this from a restatement into a check, and it is the same walk
# registry_principal_for_username makes. Subshelled per row for the reason that
# scanner gives: a row is SOURCED, and a lowercase assignment in operator data
# must not reach this loop.
#
# IT ASKS THE REGISTER, NOT THE FILESYSTEM, AND THAT IS A LIMIT WORTH NAMING.
# The obvious stronger check - does the home the new OWNER implies actually
# exist - cannot be made from here today: lib/registry.sh derives OWNER_HOME as
# a fixed macOS path, so on a Linux estate that directory never exists and a
# refusal on it would refuse every realign on the machines the verb is most
# needed on. Measured on this checkout: the home root the loader builds from is
# absent on the Linux host this branch is developed on. A verb that refuses
# correct input everywhere is worse than one that measures what it can, so the
# register is what is asked, and this paragraph is here so the next reader does
# not mistake the gap for an oversight. The filesystem check belongs with the
# home-root question, not with this scan.
#
# THE COMPARISON READS THE LOCAL, NOT $1. It read $1 - which happens to hold
# the same string today, because the substitution inherits the function
# positionals and nothing shifts them. It is the same value by coincidence of
# the current body, not by anything the function states: one `shift`, one
# wrapper that forwards more arguments, and the scan starts matching a
# different string while every test still passes. The parameter is named on
# the first line; the check names it too.
_realign_login_registered() { # <login>
  local login="${1:-}" d f hit
  [ -n "$login" ] || return 1
  d="$(registry_account_dir)" || return 1
  [ -d "$d" ] || return 1
  for f in "$d"/*.conf; do
    [ -f "$f" ] || continue
    hit="$( registry_account_load "$(basename "$f" .conf)" >/dev/null 2>&1 &&
            [ "$ACCOUNT_USERNAME" = "$login" ] && printf 'y' )"
    [ -n "$hit" ] && return 0
  done
  return 1
}

# cmd_registry_session_realign <handle> [--json] — rewrite ONE row from the old
# identity shape to the one today's writers emit, and say what changed.
#
# THE TWO SHAPES, AND WHY THERE ARE TWO. `registry session add` and
# `registry migrate-session` wrote OWNER as the account's PRINCIPAL and HOST as
# the estate's HUB_HOST until the identity model landed; they write the
# account's USERNAME and its own HOST today. lib/registry.sh reads both - a
# reader that refused yesterday's rows would take down every session the
# product wrote itself, on exactly the estates where USERNAME and PRINCIPAL
# differ. This verb is the other half of that: the way a row stops being
# yesterday's without anyone editing a conf by hand.
#
# IT CHANGES OWNER, AND HOST ONLY WHEN ASKED. OWNER is taken from the account
# the row already names; the ACCOUNT itself is never chosen here, so this verb
# cannot move a session to another human. Everything else in the conf is
# carried through byte for byte, comments included.
#
# BUT OWNER IS NOT A LABEL, AND A RUNNING SESSION DOES NOT FOLLOW IT. OWNER is
# the unix login the session runs as, and lib/registry.sh derives the home from
# it, and from the home the log path and the op token path. Rewriting it moves
# all four for every reader from the next load onwards, while the process that
# is already up keeps the paths it was started with - so a realigned row and a
# running session disagree until that session is restarted. HOST got this
# warning when it stopped being rewritten silently; OWNER needs it more,
# because OWNER is the field this verb exists to change. The receipt says it
# too, in the conf, where the next reader of the file will find it.
#
# HOST IS NOT PART OF THE SHAPE THIS VERB ALIGNS. lib/registry.sh states that a
# session may live on a host the hub only deploys to - the account row names
# where the human's login is, not where their work runs - so a HOST that
# differs from the account's is a legitimate row, not yesterday's shape. A
# realign that rewrote it silently relocated a correct row: HOST is what the
# cockpit compares against the hub to decide locality, what the client ssh's
# to, and what supervision keys on. So HOST moves only when `--host <h>` says
# so, which is also the one supported way to STATE a remote host on an
# existing row.
#
# THE RECEIPT NAMES ONLY WHAT MOVED. A receipt reporting OWNER 'x' -> 'x' as a
# change teaches the reader that receipts are decoration; an audit trail is
# only worth reading if every line in it happened.
#
# IT VERIFIES BEFORE IT KEEPS. The rewritten conf is read back through
# registry_load, and a row that would not load is put back exactly as it was -
# a realign that leaves an unreadable row behind is worse than the old shape it
# replaced.
#
# THE RECEIPT IS THE POINT. A migration nobody can see afterwards is a
# migration nobody can audit: the verb prints the before and after of both
# fields, and writes the same sentence into the conf as a comment line, so the
# next reader of that file learns why OWNER changed without reading this code.
cmd_registry_session_realign() {
  local want_json="" host_flag="" host_given="" args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) want_json=1; shift ;;
      --host)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry session realign: --host needs a value" 64; return 64; }
        host_flag="$2"; host_given=1; shift 2 ;;
      -*)
        _reg_fail "$want_json" "steward registry session realign: unknown flag '$1'" 64; return 64 ;;
      *) args+=("$1"); shift ;;
    esac
  done
  local handle="${args[0]:-}"
  [ -n "$handle" ] || { _reg_fail "$want_json" "steward registry session realign: needs a session handle" 64; return 64; }
  if [ -n "$host_given" ] && ! [[ "$host_flag" =~ ^[a-z][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry session realign: invalid --host '$host_flag' (allowed: a-z, then a-z0-9-)" 64
    return 64
  fi

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  local key
  key="$(registry_resolve_session "$handle" 2>/dev/null)" || {
    _reg_fail "$want_json" "steward registry session realign: no such session '$handle'" 78; return 78; }
  local conf; conf="$(registry_dir)/$key.conf"

  # THE ROW IS SOURCED, SO IT IS SOURCED IN A CHILD. Same containment
  # `migrate-session` uses: only the three named values cross back.
  local snap snap_rc
  snap="$( registry_load "$key" >/dev/null 2>&1 \
           && printf '%s\n%s\n%s\n' "${ACCOUNT:-}" "${OWNER:-}" "${HOST:-}" )"; snap_rc=$?
  if [ "$snap_rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry session realign: '$key' does not load; realigning an unreadable row would only hide the cause" "$snap_rc"
    return "$snap_rc"
  fi
  local row_account row_owner row_host rest
  row_account="${snap%%$'\n'*}"; rest="${snap#*$'\n'}"
  row_owner="${rest%%$'\n'*}"; rest="${rest#*$'\n'}"
  row_host="${rest%%$'\n'*}"

  if [ -z "$row_account" ]; then
    _reg_fail "$want_json" "steward registry session realign: '$key' carries no ACCOUNT — a legacy row has no account shape to align to; use 'registry migrate-session'" 65
    return 65
  fi

  local acct acct_rc
  acct="$( registry_account_load "$row_account" >/dev/null 2>&1 \
           && printf '%s\n%s\n' "$ACCOUNT_USERNAME" "$ACCOUNT_HOST" )"; acct_rc=$?
  if [ "$acct_rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry session realign: '$key' names account '$row_account', which does not load" 78
    return 78
  fi
  local want_owner acct_host want_host
  want_owner="${acct%%$'\n'*}"; acct_host="${acct#*$'\n'}"; acct_host="${acct_host%%$'\n'*}"
  # THE ACCOUNT'S HOST IS READ AND NOT USED AS A TARGET. It is loaded because
  # the account has to load at all for this verb to be safe; where the session
  # lives stays whatever the row already says unless --host says otherwise.
  want_host="$row_host"
  [ -z "$host_given" ] || want_host="$host_flag"

  if [ "$row_owner" = "$want_owner" ] && [ "$row_host" = "$want_host" ]; then
    if [ -n "$want_json" ]; then
      jq -cn --arg id "$key" --arg owner "$row_owner" --arg host "$row_host" \
        '{ok:true,kind:"session-realign",id:$id,changed:false,owner:$owner,host:$host}'
    else
      printf '%s is already in the new shape (OWNER=%s, HOST=%s) — nothing written\n' "$key" "$row_owner" "$row_host"
    fi
    return 0
  fi

  # ONLY THE FIELDS THAT ACTUALLY MOVE ARE REWRITTEN, and only those appear in
  # the receipt. Rewriting a line to the value it already has is invisible in
  # the file and a lie in the receipt.
  local do_owner=0 do_host=0
  [ "$row_owner" = "$want_owner" ] || do_owner=1
  [ "$row_host" = "$want_host" ] || do_host=1

  local owner_line="" host_line=""
  if [ "$do_owner" -eq 1 ]; then
    owner_line="$(_registry_emit_kv OWNER "$want_owner")" || {
      _reg_fail "$want_json" "steward registry session realign: the account's username cannot be serialized" 70; return 70; }
  fi
  if [ "$do_host" -eq 1 ]; then
    host_line="$(_registry_emit_kv HOST "$want_host")" || {
      _reg_fail "$want_json" "steward registry session realign: the host cannot be serialized" 70; return 70; }
  fi

  local changes=""
  [ "$do_owner" -eq 0 ] || changes="OWNER '$row_owner' -> '$want_owner'"
  if [ "$do_host" -eq 1 ]; then
    changes="${changes:+$changes, }HOST '$row_host' -> '$want_host'"
  fi
  local receipt
  receipt="realigned to account '$row_account': $changes"
  # THE RECEIPT CARRIES THE CONSEQUENCE, not just the diff. It is appended to
  # the conf, so this is where the next person to open the file learns that the
  # login change moved the paths derived from it and that a session already up
  # is still using the old ones.
  [ "$do_owner" -eq 0 ] || receipt="$receipt (OWNER is the unix login this session runs as: its home, log and op-token paths are derived from it and move with it, and a session already running keeps the old ones until it is restarted)"

  # WRITE BESIDE THE ROW, NOT IN /tmp. A rename inside the same directory is
  # atomic; a move across filesystems is a copy, and a copy can be interrupted
  # halfway through a conf every supervisor on the host sources.
  local tmp backup
  tmp="$conf.realign.$$"
  backup="$conf.realign-backup.$$"
  cp -p "$conf" "$backup" 2>/dev/null || {
    _reg_fail "$want_json" "steward registry session realign: could not take a backup of $conf" 70; return 70; }
  cp -p "$conf" "$tmp" 2>/dev/null || {
    rm -f "$backup"
    _reg_fail "$want_json" "steward registry session realign: could not stage a rewrite beside $conf" 70; return 70; }

  # awk, NOT sed -i: the in-place flag spells differently on the two systems
  # this product runs on, and one of the two spellings silently writes a file
  # named after the argument.
  awk -v ol="$owner_line" -v hl="$host_line" -v do_o="$do_owner" -v do_h="$do_host" '
    do_o == 1 && /^[ \t]*OWNER=/ { if (!o) { print ol; o=1 } ; next }
    do_h == 1 && /^[ \t]*HOST=/  { if (!h) { print hl; h=1 } ; next }
    { print }
    END { if (do_o == 1 && !o) print ol; if (do_h == 1 && !h) print hl }
  ' "$backup" > "$tmp" 2>/dev/null || {
    rm -f "$tmp" "$backup"
    _reg_fail "$want_json" "steward registry session realign: the rewrite failed; $conf is untouched" 70; return 70; }
  printf '# %s\n' "$receipt" >> "$tmp"

  mv -f "$tmp" "$conf" 2>/dev/null || {
    rm -f "$tmp" "$backup"
    _reg_fail "$want_json" "steward registry session realign: could not replace $conf; it is untouched" 70; return 70; }

  # THE VERIFY STEP READS THE FIELD BACK, not just the return code, so what the
  # receipt claims and what the next loader will read are one value. The awk
  # above already drops every OWNER line after the first, so nothing on the
  # path today can make these two disagree; the read-back is what says so out
  # loud, and it is the line that would catch the next rewrite that forgets.
  local verify_rc verify_owner
  verify_owner="$( registry_load "$key" >/dev/null 2>&1 && printf '%s' "${OWNER:-}" )"; verify_rc=$?
  if [ "$verify_rc" -ne 0 ]; then
    mv -f "$backup" "$conf" 2>/dev/null
    _reg_fail "$want_json" "steward registry session realign: the rewritten row would not load (rc $verify_rc) — $conf has been put back" 70
    return 70
  fi
  if [ "$verify_owner" != "$want_owner" ]; then
    mv -f "$backup" "$conf" 2>/dev/null
    _reg_fail "$want_json" "steward registry session realign: the rewritten row loads as OWNER='$verify_owner', not '$want_owner' — the file carries more than one OWNER line and the loader takes the last; $conf has been put back" 70
    return 70
  fi
  # AND THE LOGIN THE ROW NOW NAMES MUST EXIST IN THE REGISTER. Everything
  # derived from OWNER is a path in that login home, so a login no accounts.d
  # row names leaves the session pointing at a person the register does not
  # describe. Refused rather than warned: this verb writes, and putting the row
  # back is free while a wrong home is discovered at the next restart.
  #
  # HONESTLY: TODAY IT CANNOT FIRE. want_owner is read out of one account row a
  # few lines up, so the scan is certain to find that row again unless the
  # register changes underneath this verb. It is here because the value it
  # guards is the one thing this verb writes, and the next writer that takes
  # want_owner from somewhere else - a flag, a resolved login row - must not be
  # able to skip the question.
  if ! _realign_login_registered "$verify_owner"; then
    mv -f "$backup" "$conf" 2>/dev/null
    _reg_fail "$want_json" "steward registry session realign: no account row names '$verify_owner' as its USERNAME, and OWNER is the login this session runs as — its home, log and op-token paths would point at a login the register does not describe; $conf has been put back" 65
    return 65
  fi
  rm -f "$backup"

  if [ -n "$want_json" ]; then
    # `changedFields` says what moved; `was` and the current values are still
    # both present for every field, so a caller never has to diff two strings
    # to learn whether HOST was touched.
    jq -cn --arg id "$key" --arg account "$row_account" \
           --arg wasOwner "$row_owner" --arg owner "$want_owner" \
           --arg wasHost "$row_host" --arg host "$want_host" --arg receipt "$receipt" \
           --argjson didOwner "$do_owner" --argjson didHost "$do_host" \
      '{ok:true,kind:"session-realign",id:$id,changed:true,account:$account,
        changedFields:([if $didOwner==1 then "OWNER" else empty end,
                        if $didHost==1 then "HOST" else empty end]),
        was:{owner:$wasOwner,host:$wasHost},owner:$owner,host:$host,receipt:$receipt}'
  else
    printf '%s: %s\n' "$key" "$receipt"
  fi
  return 0
}

# cmd_registry_migrate_session <old-slug> --account <slug> ( --project <slug>
# | --entity <slug> ) --slug <per-account-slug> [--json]
#
# THE NAMING-MODEL CUTOVER'S ONE-WAY CONVERTER. An OLD-SHAPE session conf
# (legacy DOMAIN/OWNER/RC_LABEL, no identity fields) becomes a NEW-SHAPE
# identity row IN PLACE, then the old row is unlinked — but ONLY after the
# new one reads back green through registry_load. Anything that fails before
# that leaves the old conf exactly as it was: the migration is abortable
# with no loss.
#
# WHAT IT CARRIES, AND WHAT IT CHANGES. Every OPERATIONAL field on the old
# row is carried forward UNCHANGED — RUNTIME, MODEL, OPENCODE_*, AUTO_APPROVE,
# CLAUDE_MEMORY_ROOT, ASSETS, REPO_PATH, HOST, the browser rig, the env and
# permission fields, the lifecycle. Dropping any one of them would break a
# working session, so the carry set is registry_load's OWN field-reset list,
# minus the fields this verb replaces. It ADDS the identity fields (a minted
# opaque ID, ACCOUNT, SLUG, exactly one TARGET_*) and rewrites OWNER to the
# account's PRINCIPAL — the visibility/enter bridge, which keys on OWNER. It
# REMOVES the legacy RC_LABEL: the display now DERIVES from the target, and a
# stale RC_LABEL would override that derivation. It DERIVES DOMAIN to the
# target slug and writes it as a literal line — the Linux supervisor sources
# the conf raw and refuses a session with no DOMAIN, so `session add`'s derived
# DOMAIN and this verb's must agree.
#
# EVERY RESOLVING LOAD IS SUBSHELLED — the same lesson `session add` carries:
# registry_account_load, registry_project_load, registry_entity_load and the
# old-conf snapshot all SOURCE an untrusted conf, and a hostile row assigning
# this function's own lowercase locals would clobber them the moment it
# sourced. The writer transaction and the atomic (ACCOUNT, SLUG) gate are the
# SAME registry_session_write / _registry_validate_session_stage that
# `session add` publishes through — a row this verb writes is by construction
# a row every reader loads.
cmd_registry_migrate_session() {
  local want_json="" old="" account="" project="" entity="" slug="" a
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) shift ;;
      --account)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry migrate-session: --account needs a value" 64; return 64; }
        account="$2"; shift 2 ;;
      --project)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry migrate-session: --project needs a value" 64; return 64; }
        project="$2"; shift 2 ;;
      --entity)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry migrate-session: --entity needs a value" 64; return 64; }
        entity="$2"; shift 2 ;;
      --slug)
        [ $# -ge 2 ] || { _reg_fail "$want_json" "steward registry migrate-session: --slug needs a value" 64; return 64; }
        slug="$2"; shift 2 ;;
      -*)
        _reg_fail "$want_json" "steward registry migrate-session: unknown flag '$1'" 64; return 64 ;;
      *)
        # The one positional operand is the OLD slug — the row to convert.
        if [ -n "$old" ]; then
          _reg_fail "$want_json" "steward registry migrate-session: unexpected argument '$1' (the new id is minted, never given)" 64
          return 64
        fi
        old="$1"; shift ;;
    esac
  done

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  # 0. THE OLD SLUG — required, form-checked before any path is built from it.
  [ -n "$old" ] || { _reg_fail "$want_json" "steward registry migrate-session: an old session slug is required" 64; return 64; }
  if ! [[ "$old" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry migrate-session: invalid old slug '$old' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  local dir; dir="$(registry_dir)"
  local old_conf="$dir/$old.conf"
  # 1. THE OLD ROW MUST EXIST. rc 78 — a missing subject is an environment
  # fault (the wrong slug, the wrong estate), not a usage error.
  if [ ! -f "$old_conf" ]; then
    _reg_fail "$want_json" "steward registry migrate-session: no such session '$old' (no $old_conf)" 78
    return 78
  fi
  # 1b. IT MUST BE OLD-SHAPE. A row that already carries ACCOUNT= or an opaque
  # ID=s-… has been migrated; converting it again would mint a SECOND identity
  # for one session. Refuse rc 65, and touch nothing. Detected by LINE
  # presence, the same way registry_load detects a present-but-empty label.
  if grep -qE '^ACCOUNT=' "$old_conf" || grep -qE '^ID="?s-[0-9a-f]' "$old_conf"; then
    _reg_fail "$want_json" "steward registry migrate-session: '$old' is already new-shape (carries ACCOUNT/opaque ID) — refusing to double-migrate" 65
    return 65
  fi

  # 1c. SNAPSHOT the old row's fields, each through a subshelled source. REPO
  # is required (registry_load refuses a row without it); everything else is
  # carried only when present.
  local old_repo old_host
  old_repo="$(_migrate_snap "$old_conf" REPO_PATH)"
  old_host="$(_migrate_snap "$old_conf" HOST)"
  if [ -z "$old_repo" ]; then
    _reg_fail "$want_json" "steward registry migrate-session: '$old' carries no REPO_PATH — not a migratable session" 65
    return 65
  fi

  # 1d. FAIL-CLOSED ON UNMODELED FIELDS. The carry-loop below is a
  # hand-maintained allowlist; a key on the old conf that no branch of this
  # verb models would otherwise be DROPPED SILENTLY at rc 0 — and a future
  # optional operational field forgotten in the loop would vanish across the
  # cut looking like success. Refuse instead, naming the field, so a human
  # decides: extend the model, or clean the conf. Nothing has been written
  # yet, so the refusal costs nothing. SESSION_NAME is the one known-dead
  # key: live confs still carry it, and registry_load overwrites it
  # unconditionally on every read, so dropping it is correct, not a loss.
  local _mig_known=" ID ACCOUNT SLUG TARGET_ENTITY TARGET_PROJECT OWNER DOMAIN RC_LABEL REPO_PATH HOST SESSION_NAME PERMISSION_MODE ENV_REFRESH OP_RUN ENV_FILE ENV_SOURCE OP_TOKEN_FILE KIND LIFECYCLE ASSETS VISIBILITY VISIBLE_TO BROWSER_RIG BROWSER_DISPLAY BROWSER_CDP BROWSER_VNC BROWSER_PROFILE RUNTIME MODEL OPENCODE_VERSION OPENCODE_PORT AUTO_APPROVE CLAUDE_MEMORY_ROOT LOGIN "
  local _mig_key
  for _mig_key in $(grep -oE '^[A-Z_]+=' "$old_conf" 2>/dev/null | sed 's/=$//' | sort -u); do
    case "$_mig_known" in
      *" $_mig_key "*) ;;
      *)
        _reg_fail "$want_json" "steward registry migrate-session: the old conf carries a field this migration does not model: $_mig_key — extend the model or clean the conf; nothing was changed" 65
        return 65 ;;
    esac
  done

  # 2. THE ACCOUNT — required and resolved once. PRINCIPAL authorizes the
  # human; USERNAME and HOST become the migrated row's Unix identity.
  [ -n "$account" ] || { _reg_fail "$want_json" "steward registry migrate-session: --account is required" 64; return 64; }
  if ! [[ "$account" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry migrate-session: invalid --account '$account' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  local account_data principal account_username account_host account_rest account_rc
  account_data="$( registry_account_load "$account" >/dev/null 2>&1 && printf '%s\n%s\n%s\nok\n' "$ACCOUNT_PRINCIPAL" "$ACCOUNT_USERNAME" "$ACCOUNT_HOST" )"; account_rc=$?
  if [ "$account_rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry migrate-session: --account '$account' does not resolve to a known account" 78
    return 78
  fi
  principal="${account_data%%$'\n'*}"; account_rest="${account_data#*$'\n'}"
  account_username="${account_rest%%$'\n'*}"; account_rest="${account_rest#*$'\n'}"
  account_host="${account_rest%%$'\n'*}"
  if ! [[ "$principal" =~ ^[a-z][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry migrate-session: account '$account' carries an invalid principal" 70
    return 70
  fi
  if ! [[ "$account_username" =~ ^[a-z][a-z0-9-]*$ ]] || ! [[ "$account_host" =~ ^[a-z][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry migrate-session: account '$account' carries an invalid username or host" 78
    return 78
  fi

  # 3. THE TARGET — a TYPED UNION: exactly one of --project/--entity, and it
  # must resolve (the display is DERIVED from it on every read).
  if [ -n "$project" ] && [ -n "$entity" ]; then
    _reg_fail "$want_json" "steward registry migrate-session: --project and --entity are a typed union — give exactly one" 64
    return 64
  fi
  if [ -z "$project" ] && [ -z "$entity" ]; then
    _reg_fail "$want_json" "steward registry migrate-session: a target is required — --project <slug> or --entity <slug>" 64
    return 64
  fi
  local tkind tslug
  if [ -n "$project" ]; then tkind="project"; tslug="$project"; else tkind="entity"; tslug="$entity"; fi
  if ! [[ "$tslug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry migrate-session: invalid --$tkind '$tslug' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  local load_rc
  if [ "$tkind" = "project" ]; then
    ( registry_project_load "$tslug" >/dev/null 2>&1 ); load_rc=$?
  else
    ( registry_entity_load "$tslug" >/dev/null 2>&1 ); load_rc=$?
  fi
  if [ "$load_rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry migrate-session: --$tkind '$tslug' does not resolve to a valid $tkind" 78
    return 78
  fi

  # 4. THE SLUG, and THE COMPOSITE GATE — (ACCOUNT, SLUG) is unique. The old
  # row carries no ACCOUNT/SLUG, so it never collides with itself here.
  [ -n "$slug" ] || { _reg_fail "$want_json" "steward registry migrate-session: --slug is required" 64; return 64; }
  if ! [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry migrate-session: invalid --slug '$slug' (allowed: a-z0-9-, must start a-z0-9)" 64
    return 64
  fi
  if ! registry_account_slug_available "$account" "$slug"; then
    _reg_fail "$want_json" "steward registry migrate-session: slug '$slug' is already taken in account '$account'" 65
    return 65
  fi

  # 5. THE HOST — carried when present, else inherited from the account. A
  # different host would make the migrated row unreadable under the identity
  # contract, so refuse before writing it.
  local host="$old_host"
  if [ -z "$host" ]; then
    host="$account_host"
  fi
  if ! [[ "$host" =~ ^[a-z][a-z0-9-]*$ ]]; then
    _reg_fail "$want_json" "steward registry migrate-session: '$old' carries an invalid HOST '$host'" 65
    return 65
  fi
  if [ "$host" != "$account_host" ]; then
    _reg_fail "$want_json" "steward registry migrate-session: '$old' HOST '$host' does not match account '$account' host '$account_host'" 78
    return 78
  fi

  # 6. MINT THE ID — opaque, immutable, NEVER derived from account or slug.
  # Sixteen hex digits from urandom behind the fixed "s-" mark; the shared
  # writer is create-only, and this remint loop is the belt on top.
  local id="" candidate tries=0
  while [ "$tries" -lt 5 ]; do
    candidate="s-$(head -c 8 /dev/urandom 2>/dev/null | od -An -tx1 | tr -d ' \n')"
    if [[ "$candidate" =~ ^s-[0-9a-f]{16}$ ]] && [ ! -e "$dir/$candidate.conf" ]; then
      id="$candidate"; break
    fi
    tries=$((tries+1))
  done
  if [ -z "$id" ]; then
    _reg_fail "$want_json" "steward registry migrate-session: could not mint a unique id" 70
    return 70
  fi

  # 7. SERIALIZE — every value through _registry_emit_kv (escaping); its
  # refusal is captured to a temp file, never leaked to real stderr. The
  # carry set is registry_load's field-reset list MINUS what this verb
  # replaces: OWNER (rewritten to the account username), RC_LABEL (removed), DOMAIN
  # (derived to the target slug), and the identity fields (added below).
  # REPO_PATH and HOST are always emitted; the rest only when the old row
  # carried them.
  local kv_err; kv_err="$(mktemp)" || { _reg_fail "$want_json" "steward registry migrate-session: cannot create a temporary file" 70; return 70; }
  local body="" _mig_rc=0
  # _mig_add KEY VALUE [required] — appends one escaped kv line to $body,
  # skipping an empty optional value. On a serializer refusal it records the
  # rc and every later call short-circuits.
  _mig_add() {
    local key="$1" val="$2" required="${3:-}" line
    [ "$_mig_rc" -eq 0 ] || return
    if [ -z "$val" ] && [ -z "$required" ]; then return; fi
    line="$(_registry_emit_kv "$key" "$val" 2>>"$kv_err")" || { _mig_rc=$?; return; }
    body="$body$line
"
  }
  # Identity first, then the OWNER bridge, then every carried operational
  # field. Order is immaterial to sourcing; this order reads top-down as
  # "who it is, then what it runs".
  _mig_add ID "$id" required
  _mig_add ACCOUNT "$account" required
  _mig_add SLUG "$slug" required
  if [ "$tkind" = "project" ]; then _mig_add TARGET_PROJECT "$tslug" required
  else _mig_add TARGET_ENTITY "$tslug" required; fi
  # DOMAIN IS CARRIED, NOT DERIVED — credential continuity across the cut.
  # The Linux supervisor SOURCES the conf raw (not through registry_load),
  # refuses a session with no DOMAIN, and builds the per-domain credential
  # directory from it with NO inheritance chain. Deriving the LEAF target
  # slug here (the first shape of this fix) silently moved that directory
  # for every session migrated to a sub-project: the migrated session
  # started against an EMPTY credential dir, the tools read "not logged
  # in", and the estate's own findings record that symptom minting second
  # identities against customer tenants. The same drift narrowed the bus
  # same-DOMAIN gate between sessions that share an entity. So the OLD
  # conf's DOMAIN survives the migration verbatim; only a conf with no
  # DOMAIN at all falls back to the target slug, so the supervisor's
  # DOMAIN-required start never refuses. `session add` still derives the
  # target slug — a FRESH session has no credential history to preserve.
  local old_domain; old_domain="$(_migrate_snap "$old_conf" DOMAIN)"
  _mig_add DOMAIN "${old_domain:-$tslug}" required
  _mig_add OWNER "$account_username" required
  _mig_add REPO_PATH "$old_repo" required
  _mig_add HOST "$host" required
  # THE CARRIED OPERATIONAL FIELDS — every one registry_load resets and reads,
  # save those replaced above. Snapshotted from the old conf, emitted only
  # when present.
  local _cf
  for _cf in PERMISSION_MODE ENV_REFRESH OP_RUN ENV_FILE ENV_SOURCE OP_TOKEN_FILE \
             KIND LIFECYCLE ASSETS VISIBILITY VISIBLE_TO \
             BROWSER_RIG BROWSER_DISPLAY BROWSER_CDP BROWSER_VNC BROWSER_PROFILE \
             RUNTIME MODEL OPENCODE_VERSION OPENCODE_PORT AUTO_APPROVE CLAUDE_MEMORY_ROOT \
             LOGIN; do
    _mig_add "$_cf" "$(_migrate_snap "$old_conf" "$_cf")"
  done
  local carried_pm; carried_pm="$(_migrate_snap "$old_conf" PERMISSION_MODE)"
  local carried_login; carried_login="$(_migrate_snap "$old_conf" LOGIN)"

  # 7b. GATE 1 ON THE CARRIED LOGIN — the SAME shared gate `cmd_registry_
  # session_add` calls (1b above), run against the NEW account this row is
  # moving to. A LOGIN survives the carry-loop's allowlist unconditionally;
  # without this, one writer could produce exactly the pair `session add`
  # and `enroll` both refuse: a session paying on another human's
  # credentials. Checked BEFORE anything is written (nothing on disk has
  # changed yet — the body above is still in memory), and skipped entirely
  # when the old row carries no LOGIN.
  if [ -n "$carried_login" ]; then
    local login_gate_err="" login_gate_rc=0
    login_gate_err="$( registry_login_principal_gate "$carried_login" "$account" 2>&1 )"; login_gate_rc=$?
    if [ "$login_gate_rc" -ne 0 ]; then
      rm -f "$kv_err"
      _reg_fail "$want_json" "steward registry migrate-session: $login_gate_err" "$login_gate_rc"
      return "$login_gate_rc"
    fi
  fi

  rm -f "$kv_err"
  if [ "$_mig_rc" -ne 0 ]; then
    _reg_fail "$want_json" "steward registry migrate-session: could not serialize the row (a field carries a control character or newline)" 70
    return 70
  fi

  # 8. WRITE through the shared hardened writer; the validate_fn runs the
  # atomic (ACCOUNT, SLUG) gate inside the sessions.d lock. Same expectations
  # `session add` sets, so the SAME validator applies.
  _REGW_EXPECT_ID="$id"
  _REGW_EXPECT_ACCOUNT="$account"
  _REGW_EXPECT_SLUG="$slug"
  if [ "$tkind" = "project" ]; then
    _REGW_EXPECT_TARGET_PROJECT="$tslug"; _REGW_EXPECT_TARGET_ENTITY=""
  else
    _REGW_EXPECT_TARGET_ENTITY="$tslug"; _REGW_EXPECT_TARGET_PROJECT=""
  fi
  _REGW_EXPECT_HOST="$host"
  _REGW_EXPECT_REPO_PATH="$old_repo"
  _REGW_EXPECT_OWNER="$account_username"
  _REGW_EXPECT_PERMISSION_MODE="$carried_pm"
  # LOGIN IS CARRIED, NOT MINTED — this verb migrates a row's SHAPE, never
  # its identity, and a LOGIN the old conf already carried (hand-added, or a
  # session migrated a second time in a later scope) must survive the cut
  # exactly like every other operational field above. Empty when the old
  # conf had none, which is the transition, byte for byte.
  _REGW_EXPECT_LOGIN="$carried_login"
  # A LITERAL newline joins the header to the body — a command substitution
  # would strip it and glue the first field onto the comment line, hiding it
  # from every reader that sources the row.
  local content
  content="# $id — session, migrated from $old by steward registry migrate-session.
$body"
  local rw_err; rw_err="$(mktemp)" || {
    _reg_fail "$want_json" "steward registry migrate-session: cannot create a temporary file" 70
    return 70
  }
  registry_session_write "$id" "$content" _registry_validate_session_stage 2>"$rw_err"
  local rc=$?
  local rw_msg; rw_msg="$(cat "$rw_err")"; rm -f "$rw_err"
  if [ "$rc" -ne 0 ]; then
    # THE OLD ROW IS UNTOUCHED — nothing has removed it, so the migration is
    # abortable with no loss. Report and stop.
    _reg_fail "$want_json" "steward registry migrate-session: $rw_msg" "$rc"
    return "$rc"
  fi

  # 9. ONLY NOW, after the new row reads back green, remove the old one.
  rm -f "$old_conf"

  local file="$dir/$id.conf"
  local display; display="$(registry_session_display "$id" 2>/dev/null)"
  if [ -n "$want_json" ]; then
    jq -cn --arg from "$old" --arg id "$id" --arg account "$account" --arg slug "$slug" \
      --arg tkind "$tkind" --arg tslug "$tslug" --arg display "$display" --arg file "$file" \
      '{ok:true,kind:"migrate-session",from:$from,id:$id,account:$account,slug:$slug,target:{kind:$tkind,slug:$tslug},display:$display,file:$file}'
  else
    printf 'migrated %s -> %s (display: %s)\n' "$old" "$id" "$display"
  fi
  return 0
}

# cmd_assets <session> [--json] — the declared list joined with probed health.
# Presentation-free: json or one line per asset, never ANSI.
cmd_assets() {
  local want_json="" session="" a err_msg

  # Detect --json anywhere in argv before validating other arguments
  for a in "$@"; do
    [ "$a" = "--json" ] && want_json=1
  done

  # Parse and validate arguments
  for a in "$@"; do
    case "$a" in
      --json) ;; # Already detected above
      -*)
        err_msg="steward: unknown flag '$a'"
        if [ -n "$want_json" ]; then
          jq -cn --arg reason "$err_msg" '{ok:false, reason:$reason}'
        else
          printf '%s\n' "$err_msg" >&2
        fi
        return 64
        ;;
      *)
        [ -n "$session" ] && {
          err_msg="steward: one session at a time"
          if [ -n "$want_json" ]; then
            jq -cn --arg reason "$err_msg" '{ok:false, reason:$reason}'
          else
            printf '%s\n' "$err_msg" >&2
          fi
          return 64
        }
        session="$a"
        ;;
    esac
  done

  [ -n "$session" ] || {
    err_msg="steward: assets requires a session name"
    if [ -n "$want_json" ]; then
      jq -cn --arg reason "$err_msg" '{ok:false, reason:$reason}'
    else
      printf '%s\n' "$err_msg" >&2
    fi
    return 64
  }
  # shellcheck source=lib/assets.sh
  . "$HERE/lib/assets.sh"
  # PRODUCTION WIRING. asset_probe reads STEWARD_ASSET_PROBE_CMD and reports
  # `unknown no-probe-command` when it is unset — correct as a contract, useless
  # as a product. Aim it at the dispatcher unless a caller (or the suite) has
  # already chosen one; an explicit setting always wins.
  : "${STEWARD_ASSET_PROBE_CMD:=$HERE/bin/probe-dispatch}"
  export STEWARD_ASSET_PROBE_CMD
  # AND A DEADLINE WITH ROOM FOR A REAL ROUND TRIP. The library's own default
  # (5s) is sized for a prober that hangs, not for one that talks to another
  # machine: a measured run of the real ssh path took ~1.75s per session, so a
  # loaded host tips a WORKING probe into `unknown probe-timeout` — the same
  # non-measurement-dressed-as-measurement this model exists to prevent, only
  # with the honest word on it.
  #
  # Raised here rather than in lib/assets.sh because this is the command that
  # wires the ssh-based dispatcher in; a caller embedding asset_probe with its
  # own fast prober should keep the tighter default. The ordering that must
  # hold, smallest first: the prober's own connect bound (3s, probes/chromium-rig)
  # < the library backstop (5s) <= this.
  : "${STEWARD_ASSET_PROBE_TIMEOUT:=10}"
  export STEWARD_ASSET_PROBE_TIMEOUT
  # THE PROBER NEEDS TO KNOW WHOSE ASSET IT IS MEASURING. asset_probe's signature
  # carries the asset, not the session, and a rig prober cannot measure a rig
  # without knowing which session declares it. The name rides in the environment
  # rather than in the asset string so the registry stays a derivation
  # (BROWSER_RIG implies chromium-rig) instead of a transcription.
  export STEWARD_PROBE_SESSION="$session"
  local list rc
  list="$(session_assets "$session" 2>&1)"; rc=$?
  if [ "$rc" -ne 0 ]; then
    if [ -n "$want_json" ]; then jq -cn --arg reason "$list" '{ok:false, reason:$reason}'
    else printf '%s\n' "$list" >&2; fi
    return "$rc"
  fi
  local lines="" one
  while IFS= read -r one || [ -n "$one" ]; do
    [ -n "$one" ] || continue
    lines="$lines$(asset_probe "$one")
"
  done <<EOF
$list
EOF
  if [ -n "$want_json" ]; then
    printf '%s' "$lines" | jq -Rn --arg session "$session" '
      {ok:true, session:$session,
       assets: [inputs | select(length>0) | split(" ")
                | {asset:.[0], status:.[1], detail:(.[2:] | join(" "))}]}'
  else
    printf '%s' "$lines"
  fi
  return 0
}

# cmd_sessions [--json] [--sort name|slug|display|owner|host|lineage] — every
# session's identity joined with its liveness. --sort reorders both the
# --json and human tables; with no flag the order is the registry's own
# (alphabetical by name/id, today's longstanding behaviour, unchanged).
#
# TWO LAYERS, JOINED HERE AND NOWHERE ELSE. Identity is a free local read;
# liveness shells out and can fail. They are measured separately so a failure in
# one cannot erase the other — a session whose liveness could not be measured
# still appears, with its identity intact and every liveness field `unknown`.
#
# REACH IS NOT HERE. Whether a session's declared assets actually answer costs a
# remote round trip each and is `steward assets`' job. A view asks for that
# separately and asynchronously; folding it in would make this command take half
# a minute for a fleet of twenty.
#
# The reorder itself is lib/sort.sh's _field_sort_rows, sourced lazily inside
# cmd_sessions below (and, for the same reason, inside cmd_ls) — not a local
# function here. `steward <estate> ls --sort` (the estate-listing form, over
# ssh) needs the exact same stable, dash-last, LC_ALL=C reorder over a
# differently-shaped table, and a second hand-copied awk/sort pipeline is how
# the two --sort flags would quietly stop meaning the same thing. See
# lib/sort.sh for the full reasoning.

# cmd_sessions' own --sort key -> TSV field number. One place, so the flag's
# validation, its usage text and its JSON refusal can never name a different
# set of keys than this actually understands. Field numbers match the
# contract at the top of session_identity_rows above lib/sessions.sh's
# session_identity_rows: name id owner domain host entity_name entity_relation
# assets slug display lineage.
_sessions_sort_field() {
  case "$1" in
    name)    echo 1 ;;
    owner)   echo 3 ;;
    host)    echo 5 ;;
    slug)    echo 9 ;;
    display) echo 10 ;;
    lineage) echo 11 ;;
    *)       return 1 ;;
  esac
}

# THE VALID KEYS, SAID ONCE. Three refusals name this set — cmd_sessions' plain
# form, its --json form, and cmd_ls before it ever reaches ssh — and three
# hand-kept copies is how a key gets added to the map above while one message
# keeps omitting it. The usage banner at the top of this file names them a
# fourth time and cannot read this variable (usage() seds the source text), so
# that one line still has to be edited by hand alongside the map.
_SESSIONS_SORT_KEYS="name, slug, display, owner, host, lineage"

# _sessions_pad <width> <value> — <value> followed by enough spaces to fill
# <width> columns, or unpadded when it is already at least that wide.
#
# WHY NOT `printf %-22s`. bash's printf counts the field width in BYTES. The
# ORG column is the first cell in this table that is not guaranteed ASCII: the
# lineage separator is U+2192, three bytes for one column, and an entity's
# display NAME may carry any UTF-8 the registry accepted. Measured here on a
# two-name lineage: `%-22s` padded to 22 BYTES, which is 20 columns, and every
# cell to its right on that row sat two spaces left of its header. `${#v}`
# counts CHARACTERS in a UTF-8 locale, which is what a terminal draws.
#
# IT IS ALIGNMENT, NEVER TRUNCATION. A value wider than the column pushes the
# rest of its row right, exactly as a long session name already does under
# `%-24s`. Cutting an org name to fit would render a DIFFERENT organisation's
# name and call it this one's.
#
# THE COUNT IS TAKEN UNDER `LC_ALL=C`, IN A SUBSHELL, AND THAT IS THE WHOLE
# TRICK. `${#v}` counts characters in a UTF-8 locale and BYTES in the C locale
# — so a helper that simply read `${#v}` would align on the operator's terminal
# and not in the test suite, or the reverse, which is the worst of both. Forcing
# C gives byte semantics EVERYWHERE; the continuation bytes of a UTF-8 sequence
# (0x80-0xBF) are then deleted, and what is left is exactly one byte per
# character. The assignment is inside `$( )` so it never reaches the caller's
# own locale.
#
# CHARACTERS, NOT DISPLAY CELLS. A full-width character draws two columns and
# is counted here as one. No shell table in this product solves that (neither
# does `column -t`), and an entity NAME made of them would run this column
# wide — which is the same, visible, harmless overrun a long name already
# causes, not a wrong value.
_sessions_pad() {
  local w="$1" v="$2" n _fill=""
  n="$( LC_ALL=C; _s="${v//[$'\200'-$'\277']/}"; printf '%s' "${#_s}" )"
  [ "$n" -lt "$w" ] && _fill="$(printf '%*s' "$((w - n))" '')"
  printf '%s%s' "$v" "$_fill"
}

# ── steward mcp render <session-id> ────────────────────────────────────────
#
# Prints a claude-compatible mcp-config document for ONE session's effective
# MCP set. THE VERB IS A THIN CALLER: every rule about what the document may
# contain, and which of the three exit codes says which thing, lives in
# lib/mcprender.sh next to the code that enforces it. The supervisor on a
# session host sources that same library, and a doctrine that had stayed here
# would have been doctrine only one of the two consumers could read.
#
# (INDENTED TWO SPACES, NOT THREE, AND THAT IS LOAD-BEARING. usage() prints
# every `#   ` line in this FILE, not just the banner at the top, so a comment
# block indented three spaces anywhere below turns prose into what reads as
# more verbs — measured on this very block, where six lines of rc-contract
# prose appeared in `steward --help` under the real verbs.)
cmd_mcp_render() {
  local sid="" a
  for a in "$@"; do
    case "$a" in
      -*) fel "mcp render: unknown flag '$a'" 64 ;;
      *)
        [ -n "$sid" ] && fel "mcp render: one session at a time" 64
        sid="$a" ;;
    esac
  done
  [ -n "$sid" ] || fel "mcp render: needs a session id — steward mcp render <session-id>" 64
  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"
  # shellcheck source=lib/mcprender.sh
  . "$HERE/lib/mcprender.sh"
  mcp_render_document "$sid"
}

# ── steward mcp surface <session-id> --json ────────────────────────────────
#
# Prints the session's MCP asset ids together with the AXIS each was granted
# on (account/entity/project) and the granting row's own slug — the desk's
# view of "who gave this session what", never the asset's own command/args/
# env file. THE ALLOWLIST IS THE SHAPE OF THE jq CALL BELOW: id, name, axis,
# source. Nothing read from mcp.d is consulted here at all — a command, an
# argument, an env file are the asset's business, never the surface's.
#
# ONE ENTRY PER GRANT, SO AN ID MAY APPEAR MORE THAN ONCE. A managing team and
# the client it manages may both declare the same asset, and both DID grant it;
# a surface that named only the first left a member of the client - who cannot
# see its manager - without an asset their own entity handed them. The entries
# are in collection order, closest granting level first, and the consumer
# deduplicates AFTER applying its own visibility rule (desk/filter.jq). The
# asset SET (`steward mcp render`) is deduplicated as it always was: one server
# per slug is what actually runs.
cmd_mcp_surface() { # <session-id> --json
  local sid="" want_json="" a
  for a in "$@"; do case "$a" in --json) want_json=1 ;; -*) fel "mcp surface: unknown flag '$a'" 64 ;; *) sid="$a" ;; esac; done
  [ -n "$want_json" ] || fel "mcp surface: --json is the only output form" 64
  [ -n "$sid" ] || fel "mcp surface: needs a session id" 64
  command -v jq >/dev/null 2>&1 || fel "mcp surface: jq is required" 69
  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"
  local rows rc
  rows="$(registry_session_mcp_surface "$sid")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    jq -cn --arg s "$sid" '{ok:false,session:$s,reason:"a level of the org would not load; the surface is not known"}'
    exit 65
  fi
  printf '%s' "$rows" | jq -cRn --arg s "$sid" '
    {ok:true, session:$s,
     assets:[inputs | select(length>0) | split("\t") | {id:.[0], name:.[0], axis:.[1], source:.[2]}]}'
}

cmd_mcp() {
  case "${1:-}" in
    render) shift; cmd_mcp_render "$@" ;;
    surface) shift; cmd_mcp_surface "$@" ;;
    *) fel "steward mcp: unknown verb '${1:-}' (allowed: render, surface)" 64 ;;
  esac
}

# THE DESK IS TWO PROGRAMS BEHIND ONE WORD, and this dispatcher is deliberately
# nothing but the fork. The producer is bash and the server is Node; neither
# belongs inside this file, and a `desk` verb that grew logic here would be a
# third place that knows what a desk is.
#
# `exec`, NOT A CALL. The two programs own their own exit codes - the snapshot's
# 69/73/78 mean what they mean to an operator reading a timer's log, and a
# wrapper that returned its own status would have to reproduce that vocabulary
# and would drift from it on the first change.
cmd_desk() {
  case "${1:-}" in
    snapshot) shift; exec bash "$HERE/desk/snapshot.sh" "$@" ;;
    serve)    shift; exec node "$HERE/desk/serve.mjs" "$@" ;;
    *) fel "steward desk: unknown verb '${1:-}' (allowed: snapshot, serve)" 64 ;;
  esac
}

cmd_sessions() {
  local want_json="" sort_key="" sort_field="" a
  # DETECT --json BEFORE VALIDATING ANYTHING ELSE. A refusal must come back in
  # the format the caller asked for; discovering the flag only after rejecting
  # an earlier argument would answer a json request with a bare sentence, and a
  # consumer reads that as a broken tool rather than a bad argument.
  for a in "$@"; do [ "$a" = "--json" ] && want_json=1; done

  # --sort TAKES A VALUE, so the validating pass walks an index rather than a
  # `for a in "$@"` loop — that shape sees --sort's OWN key token arrive as
  # the next iteration's argument and refuses it as "unknown argument
  # slug". Bash 3.2 (this file also runs as macOS's stock /bin/bash), so a
  # plain indexed array rather than anything newer.
  local -a _sess_argv=( "$@" )
  local _sess_i=0 _sess_n=${#_sess_argv[@]}
  while [ "$_sess_i" -lt "$_sess_n" ]; do
    a="${_sess_argv[$_sess_i]}"
    case "$a" in
      --json) ;;
      --sort)
        _sess_i=$((_sess_i + 1))
        sort_key="${_sess_argv[$_sess_i]:-}"
        if sort_field="$(_sessions_sort_field "$sort_key")"; then
          :
        else
          local _sort_msg
          _sort_msg="steward: unknown --sort key '$sort_key' — valid keys: $_SESSIONS_SORT_KEYS"
          if [ -n "$want_json" ]; then jq -cn --arg r "$_sort_msg" '{ok:false,reason:$r}'
          else printf '%s\n' "$_sort_msg" >&2; fi
          return 64
        fi
        ;;
      *) if [ -n "$want_json" ]; then jq -cn --arg r "steward: unknown argument '$a'" '{ok:false,reason:$r}'
         else printf 'steward: unknown argument %s\n' "$a" >&2; fi
         return 64 ;;
    esac
    _sess_i=$((_sess_i + 1))
  done

  # shellcheck source=lib/sessions.sh
  . "$HERE/lib/sessions.sh"
  # shellcheck source=lib/liveness.sh
  . "$HERE/lib/liveness.sh"
  # SOURCED EXPLICITLY HERE, not left to lib/sessions.sh's lazy load below —
  # that load only fires once session_identity_rows runs, and the estate
  # fallback just below needs registry_liveness_cmd before then. Sourcing
  # twice is harmless: the file has no side effects on source, only function
  # definitions.
  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"
  # shellcheck source=lib/sort.sh
  . "$HERE/lib/sort.sh"

  # ── THE ESTATE FALLBACK, RESOLVED BEFORE ANY LIVENESS MEASUREMENT RUNS ──
  #
  # THE ENVIRONMENT ALWAYS WINS. By the time this line runs, that "environment"
  # already includes whatever _operator_config_load filled in from the
  # operator's own config file — an operator who set STEWARD_LIVENESS_CMD by
  # hand, or through a future `config set`, gets exactly that shim, never a
  # second guess. Only when NEITHER has an opinion does the estate's own
  # LIVENESS_CMD get a turn: it is a claim about the ESTATE's shim, not about
  # this operator's choice, so it must never override one already made.
  #
  # A REFUSAL HERE IS AN INVOCATION REFUSAL, IN THE REQUESTED FORMAT — the
  # same shape as the missing-HUB_HOST refusal further down. An operator who
  # wrote a relative path into the estate's LIVENESS_CMD gets told so; a
  # `sessions` table that quietly rendered every liveness column as `unknown`
  # would hide exactly the mistake this guard exists to surface.
  if [ -z "${STEWARD_LIVENESS_CMD:-}" ]; then
    local _lv_out _lv_err _lv_rc
    _lv_err="$(mktemp)" || {
      if [ -n "$want_json" ]; then jq -cn --arg r "steward: cannot create a temporary file" '{ok:false,reason:$r}'
      else printf 'steward: cannot create a temporary file\n' >&2; fi
      return 70
    }
    _lv_out="$(registry_liveness_cmd 2>"$_lv_err")"; _lv_rc=$?
    if [ "$_lv_rc" -ne 0 ]; then
      local _lv_diag; _lv_diag="$(cat "$_lv_err")"; rm -f "$_lv_err"
      if [ -n "$want_json" ]; then jq -cn --arg r "$_lv_diag" '{ok:false,reason:$r}'
      else printf '%s\n' "$_lv_diag" >&2; fi
      return "$_lv_rc"
    fi
    rm -f "$_lv_err"
    # AN ESTATE THAT NAMES NO SHIM IS NOT A REFUSAL — it is the common,
    # unconfigured state, and liveness_rows already renders that as
    # `seam-not-configured` further down. Only a NON-EMPTY answer is wired in.
    if [ -n "$_lv_out" ]; then
      STEWARD_LIVENESS_CMD="$_lv_out"; export STEWARD_LIVENESS_CMD
      # SAME PROVENANCE VARIABLE _operator_config_load ALREADY MAINTAINS — a
      # third source next to process-environment and config-file, so a future
      # `doctor` probe (and STEWARD_CFG_DEBUG today) can say WHERE the value
      # that ran came from, not just that one ran.
      _CFG_SOURCE_STEWARD_LIVENESS_CMD="estate"
    fi
  fi

  # STDOUT AND STDERR ARE CAPTURED SEPARATELY, ON PURPOSE. `$ident` below is
  # parsed as pure TSV data by both the jq join and the human-form `read`
  # loop — a single `2>&1` fold would land session_identity_rows' diagnostic
  # sentence ("sessions: skipping '<name>' ...") inside that same variable
  # as if it were a data row. That diagnostic is not rare: it fires on rc 0
  # whenever some sessions load and one does not, which is a realistic fleet,
  # not an edge case. Measured live before this fix: `--json` fed the merged
  # text into jq's split() and produced no JSON at all, `jq: error ... split
  # input and separator must be strings`, while still exiting 0 — silent
  # corruption reported as success. The human form spliced the sentence into
  # the middle of a table row. Route stderr to a temp file instead, so `$ident`
  # stays pure data on every path; do not "simplify" this back to `2>&1`.
  #
  # AND STDOUT GOES TO A FILE TOO, not into `$( )`. A command substitution is a
  # subshell: session_identity_rows sets SESSIONS_UNREADABLE and liveness_rows
  # sets LIVENESS_SEAM_REASON, and neither would survive the trip back. Those
  # two variables are how the names of unloadable sessions and the reason a
  # measurement could not be made reach the JSON document below, which is the
  # whole reason both exist — so the redirection is load-bearing, not a style.
  local ident_out ident_err
  ident_out="$(mktemp)" && ident_err="$(mktemp)" || {
    if [ -n "$want_json" ]; then jq -cn --arg r "steward: cannot create a temporary file" '{ok:false,reason:$r}'
    else printf 'steward: cannot create a temporary file\n' >&2; fi
    rm -f "$ident_out" "$ident_err"
    return 70
  }
  local ident rc diag unreadable hidden viewer
  session_identity_rows >"$ident_out" 2>"$ident_err"; rc=$?
  ident="$(cat "$ident_out")"; diag="$(cat "$ident_err")"
  unreadable="${SESSIONS_UNREADABLE:-}"
  # SAME PRECEDENCE AS THE FILTER ITSELF, so the count printed here and the
  # rows it describes always agree on who was asking.
  hidden="${SESSIONS_HIDDEN:-0}"
  viewer="${SESSIONS_VIEWER:-}"
  rm -f "$ident_out" "$ident_err"

  if [ "$rc" -ne 0 ]; then
    # A REFUSAL MUST STAY IN THE REQUESTED FORMAT. A consumer that asked for
    # json and got a bare sentence on stdout cannot parse the refusal, so it
    # reports a broken tool instead of an unreadable registry. The registry
    # could not be read at all here, so `$diag` — the captured stderr — IS the
    # reason text; stdout is empty in this branch (session_identity_rows never
    # emits a data row for a session it never loaded).
    if [ -n "$want_json" ]; then jq -cn --arg r "$diag" '{ok:false,reason:$r}'
    else printf '%s\n' "$diag" >&2; fi
    return "$rc"
  fi

  # rc 0 WITH DIAGNOSTICS PRESENT is the partial-failure case: some sessions
  # loaded, at least one did not, and that is diagnosis, not silence. Forward
  # it unchanged to THIS command's own stderr — never into stdout, and never
  # dropped. Dropping it here would re-create, one layer up, exactly the
  # silence the skip-and-report fix in lib/sessions.sh removed.
  [ -n "$diag" ] && printf '%s\n' "$diag" >&2

  # --sort REORDERS THE TSV ITSELF, BEFORE EITHER RENDERER TOUCHES IT. Both the
  # --json and the human forms below read $ident; sorting once here — instead
  # of in each renderer, or by re-ordering rendered text after the fact — is
  # the only way the two forms can never disagree about order, and the only
  # way the sort never has to parse a column back out of a printf'd table.
  if [ -n "$sort_field" ]; then
    ident="$(printf '%s\n' "$ident" | _field_sort_rows "$sort_field")"
  fi

  # SAME REASON, SAME SHAPE: liveness_rows must not run in a subshell either, or
  # LIVENESS_SEAM_REASON never comes back and every `unknown` below loses its
  # reason — which is the exact silence this command exists to make impossible.
  local live live_out; live_out="$(mktemp)" || {
    if [ -n "$want_json" ]; then jq -cn --arg r "steward: cannot create a temporary file" '{ok:false,reason:$r}'
    else printf 'steward: cannot create a temporary file\n' >&2; fi
    return 70
  }
  liveness_rows >"$live_out"
  live="$(cat "$live_out")"; rm -f "$live_out"

  if [ -n "$want_json" ]; then
    # THE DOCUMENT DECLARES WHICH HOST IS HOME. Each session row carries its
    # own host, but a consumer deciding whether that session can be reached
    # LOCALLY (the cockpit's enter) needs the hub's name to compare against —
    # without it, the cockpit attached a remote-host session to the local tmux
    # and got "can't find session", measured on the real hub. HUB_HOST is a
    # required estate field (the all-fail refusal above names it), so by this
    # line it is readable; a failure here is still a refusal, never a guess.
    local hub
    hub="$(registry_hub_host)" || {
      jq -cn --arg r "steward: the estate file names no readable HUB_HOST" '{ok:false,reason:$r}'
      return 78
    }
    # Materialise one liveness row per IDENTIFIED session — including the ones
    # the command never mentioned, which liveness_for fills with `unknown`. No
    # temporary file: this writes nothing into the checkout and cannot leave
    # litter behind when a run is interrupted.
    local joined=""
    joined="$(printf '%s\n' "$ident" | while IFS=$'\t' read -r n _rest; do
        [ -n "$n" ] || continue
        liveness_for "$n" "$live"
      done)"
    # Join in jq rather than in shell string concatenation: the fields carry
    # names and timestamps, and hand-built json is where quoting bugs live.
    jq -Rn --arg _live "$joined" --arg _unreadable "$unreadable" --argjson _hidden "$hidden" --arg _hub "$hub" --arg _viewer "$viewer" '
      ($_live | split("\n") | map(select(length>0) | split("\t"))
        | map({key: .[0], value: {daemon:.[1], tmux:.[2], agent:.[3],
                                  runtime:.[4],
                                  model:       (if .[5] == "-" then null else .[5] end),
                                  lastActivity:(if .[6] == "-" then null else .[6] end),
                                  # `reason` IS A DETAIL FIELD, LIKE THE REACH
                                  # LAYER"S `detail` — not a fifth status word.
                                  # null means the session was genuinely
                                  # measured and there is nothing to explain.
                                  reason:      (if (.[7] // "-") == "-" then null else .[7] end)}})
        | from_entries) as $L |
      {ok:true,
       # WHICH HOST IS HOME — the name each session"s own `host` is compared
       # against when a consumer asks "is this reachable locally?".
       hub: $_hub,
       # The exact principal used to filter this document. Consumers must not
       # independently reinterpret the Unix account and drift from this gate.
       viewer: $_viewer,
       # A PARTIAL FAILURE MUST BE VISIBLE IN THE DOCUMENT, not only on a second
       # stream. `ok:true` beside a shorter list asserts the answer is complete;
       # a session that vanished entirely is the spec"s founding complaint with
       # fewer rows. Always a list, empty when nothing failed, so a consumer
       # never has to tell absent from empty.
       unreadable: ($_unreadable | split("\n") | map(select(length>0))),
       # A COUNT, NEVER NAMES — see lib/sessions.sh. `hidden` is always a
       # number, even zero, so a consumer never has to guess whether the
       # engine simply does not report hiding.
       hidden: $_hidden,
       sessions: [ inputs | select(length>0) | split("\t") |
         {name:.[0], id:.[1], owner:.[2], domain:.[3], host:.[4],
          slug: (if .[8] == "-" then null else .[8] end),
          display: (if .[9] == "-" then null else .[9] end),
          # THE MANAGING-TEAM CHAIN, ADDITIVE AND TOP-LEVEL. It is DERIVED from
          # the tree ABOVE the entity, not a property of the entity row, so it
          # does not live inside `entity` — and a session whose entity is null
          # can still be the only thing a consumer has to group by. null, never
          # "-": json has a type for absence, and a consumer should not have to
          # know this product"s placeholder byte.
          lineage: (if .[10] == "-" then null else .[10] end),
          entity: (if .[5] == "-" then null else {name:.[5], relation:.[6]} end),
          # `assets` IS THE ROW"S OWN DECLARATION, NOT A RESOLVED SURFACE.
          # It is the ASSETS line off the conf - what the session says it
          # wants - and it carries no axis, so visibility_asset_axes in
          # lib/visibility.sh (which decides which MCP AXES reach which
          # viewer, and is what the desk projects `mcp[]` through) does not
          # narrow it. docs/client-spec pins this field as always a list of
          # what the row declared. The desk answers the other question; the
          # two are only ever compared by mistake, and IMPORTANT 3 of the
          # 2026-09-08 review was that comparison.
          assets: (if .[7] == "-" then [] else (.[7] | split(" ")) end),
          liveness: ($L[.[0]] // {daemon:"unknown",tmux:"unknown",agent:"unknown",
                                  runtime:"unknown",model:null,lastActivity:null,
                                  reason:"not-in-answer"})} ]}' \
      <<<"$ident"
  else
    # ORG SITS BESIDE OWNER, NOT AT THE FAR RIGHT. The two answer the same
    # question one level apart — who this row belongs to — and ASSETS is the
    # only unpadded column, so anything placed after it would not line up.
    printf '%-24s %-10s %s %-8s %-12s %-14s %s\n' \
      SESSION OWNER "$(_sessions_pad 22 ORG)" TMUX AGENT MODEL ASSETS
    # id, dm, ho, en, er, sl, di are read but intentionally unused — they exist
    # only to keep the read positionally aligned with the 11-field TSV. THE
    # VARIABLE COUNT IS THE LOAD-BEARING PART: `read` folds every field past
    # the last variable into that variable, so a read one name short would put
    # "display<TAB>lineage" in `di` and print nothing in the ORG column while
    # looking entirely healthy.
    printf '%s\n' "$ident" | while IFS=$'\t' read -r n id ow dm ho en er as sl di li; do
      [ -n "$n" ] || continue
      local lrow; lrow="$(liveness_for "$n" "$live")"
      printf '%-24s %-10s %s %-8s %-12s %-14s %s\n' \
        "$n" "$ow" "$(_sessions_pad 22 "$li")" "$(printf '%s' "$lrow" | cut -f3)" \
        "$(printf '%s' "$lrow" | cut -f4)" "$(printf '%s' "$lrow" | cut -f6)" \
        "$([ "$as" = "-" ] && printf '(declares none)' || printf '%s' "$as")"
    done
    # SAME COUNT AS THE JSON FORM, said in a sentence instead of a field. A
    # zero-row table after every full listing would be noise nobody reads by
    # the second week, so this line is silent when nothing is hidden AND the
    # table itself has rows — but the one case that line would otherwise
    # leave ambiguous, an empty table, still gets it: "hidden" and "genuinely
    # no sessions" must not look the same on a blank screen.
    local _viewer_text; _viewer_text="$viewer"
    # A BLANK NAME IS NOT A REASON. If `id -un` fails and STEWARD_VIEWER is
    # unset there is no viewer, so lib/sessions.sh hides everything — an empty
    # viewer is not a wildcard, and refusing is right. But the line then read
    # "not visible to )" with nothing in the gap, which tells a reader that
    # something is withheld and not that the tool could not work out who they
    # are. Name the failure instead of printing its absence.
    [ -n "$_viewer_text" ] || _viewer_text="an unidentified account — 'id -un' failed and STEWARD_VIEWER is unset"
    local _listed; _listed="$(printf '%s\n' "$ident" | sed '/^$/d' | wc -l | tr -d ' ')"
    if [ "$hidden" -gt 0 ] || [ "$_listed" -eq 0 ]; then
      printf '(%s session(s) not visible to %s)\n' "$hidden" "$_viewer_text"
    fi
    # A FULL COLUMN OF `unknown` WITH NO EXPLANATION IS THE SILENCE THIS
    # COMMAND EXISTS TO REMOVE. lib/liveness.sh keeps the unconfigured case
    # quiet on purpose — it is a normal state, and a warning on every run of
    # every command is a warning nobody reads by the second week. But a human
    # who just asked for this table and got an unmeasured column deserves the
    # one sentence that says why, and where to fix it. Stderr, so the table
    # stays pure data; only in the human form, so a consumer is not spammed.
    if [ "${LIVENESS_SEAM_REASON:-}" = "seam-not-configured" ]; then
      printf 'steward: no liveness command configured — set STEWARD_LIVENESS_CMD to the estate'"'"'s shim; the liveness columns above are UNMEASURED, not unhealthy\n' >&2
    fi
  fi
  return 0
}

# ---------------------------------------------------------------------------
# The bare invocation's own two resolvers — hub-local verification, then
# socket derivation from it. Both run inside the "" branch of the dispatcher
# below, after _operator_config_load and before the cockpit runs.
#
# HUB-LOCAL IS A CONVENIENCE GATE, NOT A SECURITY BOUNDARY. STEWARD_HOSTNAME_CMD
# exists purely as a test seam — it can "spoof" the check, but that buys an
# operator nothing they could not already get with an explicit
# STEWARD_TMUX_SOCKET. It guards against running on the wrong machine, not
# against a hostile one.
#
# NEVER A HARD FAILURE. When the registry cannot answer — no estate root
# resolvable, a missing or broken estate file — this is simply "not
# hub-local". The cockpit's own refusals downstream (missing socket, etc.)
# already say why; a bare invocation must not gain a NEW way to fail just
# because this convenience check could not be evaluated.
_resolve_hub_local() {
  local _hostcmd="${STEWARD_HOSTNAME_CMD:-}" _here_host _hub_host
  if [ -n "$_hostcmd" ]; then
    _here_host="$("$_hostcmd" 2>/dev/null)" || return 1
  else
    _here_host="$(hostname -s 2>/dev/null)" || return 1
  fi
  [ -n "$_here_host" ] || return 1
  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh" 2>/dev/null || return 1
  _hub_host="$(registry_hub_host 2>/dev/null)" || return 1
  [ "$_here_host" = "$_hub_host" ] || return 1
  STEWARD_HUB_LOCAL=1
  export STEWARD_HUB_LOCAL
  return 0
}

# _resolve_socket — fills STEWARD_TMUX_SOCKET for the cockpit child by
# deriving it from the estate's own TMUX_SOCKET, but only on a verified
# hub-local machine. An explicit value — from the process environment, or
# already filled in by _operator_config_load from the operator's config file
# — always wins untouched; its _CFG_SOURCE_STEWARD_TMUX_SOCKET already says
# which. Any failure along the way (not hub-local, registry unreadable,
# TMUX_SOCKET missing or invalid) simply leaves the variable unset — the
# cockpit's existing "refusing to guess a socket" refusal stands on Enter.
_resolve_socket() {
  [ -n "${STEWARD_TMUX_SOCKET:-}" ] && return 0
  _resolve_hub_local || return 0
  local _sock
  _sock="$(registry_tmux_socket 2>/dev/null)" || return 0
  STEWARD_TMUX_SOCKET="$HOME/.tmux/$_sock"
  export STEWARD_TMUX_SOCKET
  _CFG_SOURCE_STEWARD_TMUX_SOCKET="derived"
  return 0
}

# ---------------------------------------------------------------------------
# `steward doctor` — the operator's first read on a fresh checkout, before
# anything is trusted. Ten probes, in dependency order, each PASS/WARN/FAIL/
# SKIP: self-path, operator-config, estate-root, registry, mandates, hub-local
# (the core, 1-6), then liveness, socket, cockpit-binary, dependencies (7-10).
# `mandates` arrived 2026-09-09 with the giving-back register: it renders
# registry_mandate_check, and it sits here so the check RUNS without anyone
# remembering it - the spec requires that before the first real mandate row
# is written. Both
# `--json` (every probe result plus each value's provenance) and `--static`
# (no shim/socket calls — skips the liveness contract probe) are implemented
# below — see docs/superpowers/specs/2026-08-29-operatorens-vag-in-design.md
# section 5 for the full probe table and the rc contract.
#
# EVERY PROBE READS, NEVER WRITES. No file writes, no builds, no bus, git or
# network calls happen anywhere below — the one verb that mutates is
# `steward config init`/`set`, and every FAIL/WARN line names the exact
# command to run, never a raw `export` line an operator would have to
# remember and repeat by hand.
#
# ONE FUNCTION PER PROBE, `_doctor_probe_<id>`, IDs EXACTLY as the spec's
# table. Each probe prints a single `STATUS text` line on its own stdout and
# returns a class the runner folds into both that line's STATUS and the
# overall exit code: 0 for PASS/WARN, 78 for an unsafe or missing config
# value, 69 for a missing facility, 70 for a doctor-internal failure (e.g. it
# could not even create a temp file).
#
# THE DEPENDENCY CHAIN IS TWO RULES, NOT FIVE. A FAIL in operator-config
# blocks estate-root, registry AND hub-local — nothing downstream of a broken
# config can be measured honestly, because every one of those probes needs a
# resolved STEWARD_ESTATE_ROOT. A FAIL in estate-root blocks registry and
# hub-local the same way. self-path blocks nothing (it runs before anything
# else could need it) and hub-local blocks nothing further (nothing runs
# after it today). Every SKIP names the probe that blocked it, never a bare
# "skipped".
_DOCTOR_PROBE_IDS="self-path operator-config estate-root registry mandates hub-local liveness socket cockpit-binary dependencies"

# _doctor_oneline <text> — flattens a possibly multi-line diagnostic (reused
# lib/registry.sh error text — e.g. registry_schema_check's schema-too-new
# refusal, or registry_list's missing-sessions.d refusal, both of which emit
# more than one line) to exactly one line before it enters a probe's
# `ID  STATUS  text` line. A raw embedded newline would leave a continuation
# line with no `ID  STATUS` prefix, breaking the one-line-per-probe contract
# every consumer of this output (including Task 5's --json) depends on.
#
# TABS ARE FLATTENED TOO, NOT JUST NEWLINES — a tab is the --json field
# separator cmd_doctor joins id/status/text with (`$id\t$status\t$text`), so
# an interpolated value carrying one would forge extra fields in that join
# the same way an embedded newline forges extra probe rows. Any raw value
# this file interpolates into probe text (STEWARD_ESTATE_ROOT,
# STEWARD_TMUX_SOCKET, STEWARD_LIVENESS_CMD, and the resolved estate root)
# must go through here first — a review found the operator-config probe
# forging a fake `{"id":"socket","status":"PASS"}` row from exactly this gap
# before this function was applied on that path.
_doctor_oneline() {
  printf '%s' "$1" | tr '\n\t' '  ' | tr -s ' ' | sed -e 's/^ *//' -e 's/ *$//'
}

# _doctor_mtime_of <path> — best-effort epoch mtime, BSD or GNU stat. Same
# shape as _CFG_MODE_OF above (portable stat is a mode-reader in that
# function, a clock-reader here); mtime is used by the cockpit-binary probe
# as a DIAGNOSIS ("does the binary look older than its sources"), never as
# provenance of anything — a touched file can lie in either direction.
_doctor_mtime_of() {
  # ONLY DIGITS COUNT -- see _CFG_MODE_OF above for the trap: `stat -f` on GNU
  # reports the FILESYSTEM and exits 0, so a non-empty check accepts an ext4
  # report as an epoch and every age computed from it is nonsense.
  local p="$1" m
  for m in "$(stat -f '%m' "$p" 2>/dev/null)" "$(stat -c '%Y' "$p" 2>/dev/null)"; do
    case "$m" in ''|*[!0-9]*) continue ;; *) printf '%s' "$m"; return 0 ;; esac
  done
  return 1
}

# self-path — reports on the SAME symlink-resolution loop at the top of this
# file, never a second one. By the time this runs, $_selfpath and $HERE are
# already the resolved, canonical values every other command trusts; a
# dangling link or an unresolvable install root would already have made
# nearly everything below this line fail in stranger ways, so this probe
# exists to say so plainly, first.
_doctor_probe_self-path() {
  if [ -z "${_selfpath:-}" ] || [ ! -f "$_selfpath" ]; then
    printf 'FAIL the resolved self-path does not exist (a dangling symlink?): %s\n' "${_selfpath:-<empty>}"
    return 69
  fi
  if [ -z "${HERE:-}" ] || [ ! -d "$HERE" ]; then
    printf 'FAIL could not resolve the install root from %s\n' "$_selfpath"
    return 69
  fi
  printf 'PASS resolved to %s (install root %s)\n' "$_selfpath" "$HERE"
  return 0
}

# operator-config — syntax/owner/mode plus every effective value's
# provenance. _operator_config_load already ran at the top of this script
# (reused, never re-implemented); this probe only reports what it found.
#
# THE FOUNDING CASE: A VALUE FROM THE ENVIRONMENT WITH NO DURABLE FILE BEHIND
# IT. A session inherits STEWARD_ESTATE_ROOT from its supervisor every time
# it runs — that is correct and common, and it is also indistinguishable
# from real setup unless something says so. `ambient-only` is that word: it
# fires only when a value's source is process-environment AND no config
# file exists at all, never when the value merely differs from what a
# present file says (env always wins there too, but a durable file already
# exists to fall back to).
_doctor_probe_operator-config() {
  # A BROKEN FILE ALWAYS MEANS AN EXISTING FILE. _operator_config_load
  # returns rc 0 for "no file at all" unconditionally — every rc-78 branch in
  # it runs only after `[ -e "$f" ]` already passed. So the remedy here is
  # always `config set`, never `config init` (which refuses outright on a
  # file that exists): `set` rewrites the file atomically rather than
  # patching the broken line, so it clears whatever made the old one
  # unreadable.
  if [ "${_cfg_rc:-0}" -ne 0 ]; then
    # THE WRITABLE-DIRECTORY CASE DOES NOT CONVERGE ON 'config set'. That
    # remedy only ever repairs the FILE's own content — it never touches
    # the directory's mode — so prescribing it here would have `config
    # set` report success while the reader's FAIL persists forever. Mirror
    # the file-mode WARN's own remedy shape (chmod on the offending path)
    # instead, matched against the reader's own error text so this stays
    # one judgment, not a second copy of the predicate.
    case "$_CFG_ERROR" in
      *"directory holding the operator config is group- or other-writable"*)
        local baddir="${_CFG_ERROR##*: }"
        printf 'FAIL %s -- run: chmod 0700 %s\n' "$_CFG_ERROR" "$baddir"
        return 78
        ;;
    esac
    printf 'FAIL %s -- run: steward config set STEWARD_ESTATE_ROOT /abs/correct-estate-root (config set rewrites the file cleanly)\n' "$_CFG_ERROR"
    return 78
  fi

  local cfgfile="${STEWARD_CONFIG_FILE:-$HOME/.config/steward/config}"
  local have_file=""
  [ -e "$cfgfile" ] && have_file=1

  # EVERY RAW VALUE GOES THROUGH _doctor_oneline BEFORE IT EVER REACHES
  # PROBE TEXT. C1 (the config-FILE value shape gate) already refuses an
  # embedded newline/tab, but STEWARD_ESTATE_ROOT (and the other two) can
  # still arrive newline- or tab-bearing from the PROCESS ENVIRONMENT — the
  # plan's founding "a session inherits it from the supervisor" case — so
  # this flattening is needed independently of C1, not merely as a backstop
  # for it.
  # THE USAGE SEAM KEY IS THE LIVENESS SEAM KEY'S TWIN HERE TOO. Both name an
  # absolute path to a program the estate supplies, both can arrive ambient, and
  # this probe is the closest thing the product has to `config show` - a key the
  # probe does not print is a key nobody can see the provenance of.
  local root_v sock_v live_v usage_v
  root_v="$(_doctor_oneline "${STEWARD_ESTATE_ROOT:-}")"
  sock_v="$(_doctor_oneline "${STEWARD_TMUX_SOCKET:-}")"
  live_v="$(_doctor_oneline "${STEWARD_LIVENESS_CMD:-}")"
  usage_v="$(_doctor_oneline "${STEWARD_USAGE_CMD:-}")"

  local root_txt sock_txt live_txt usage_txt
  root_txt="STEWARD_ESTATE_ROOT=$root_v source=$_CFG_SOURCE_STEWARD_ESTATE_ROOT"
  sock_txt="STEWARD_TMUX_SOCKET=$sock_v source=$_CFG_SOURCE_STEWARD_TMUX_SOCKET"
  live_txt="STEWARD_LIVENESS_CMD=$live_v source=$_CFG_SOURCE_STEWARD_LIVENESS_CMD"
  usage_txt="STEWARD_USAGE_CMD=$usage_v source=$_CFG_SOURCE_STEWARD_USAGE_CMD"

  local ambient=""
  if [ -z "$have_file" ]; then
    if [ "$_CFG_SOURCE_STEWARD_ESTATE_ROOT" = "process-environment" ]; then root_txt="$root_txt (ambient-only)"; ambient=1; fi
    if [ "$_CFG_SOURCE_STEWARD_TMUX_SOCKET" = "process-environment" ]; then sock_txt="$sock_txt (ambient-only)"; ambient=1; fi
    if [ "$_CFG_SOURCE_STEWARD_LIVENESS_CMD" = "process-environment" ]; then live_txt="$live_txt (ambient-only)"; ambient=1; fi
    if [ "$_CFG_SOURCE_STEWARD_USAGE_CMD" = "process-environment" ]; then usage_txt="$usage_txt (ambient-only)"; ambient=1; fi
  fi

  # THE MODE CHECK THE PARSER ITSELF DOES NOT MAKE. 0644 is ACCEPTED for
  # reading (only group/other WRITE bits are refused) — but a config file
  # that names an estate root should not be world-readable either, so doctor
  # says so even where the loader stayed silent.
  local mode_warn=""
  if [ -n "$have_file" ] && [ ! -L "$cfgfile" ]; then
    local mode; mode="$(_CFG_MODE_OF "$cfgfile" 2>/dev/null)"
    if [ -n "$mode" ] && [ "$mode" != "600" ]; then
      mode_warn="config file mode is $mode, not 0600 (group/other can read it) -- run: chmod 0600 $cfgfile"
    fi
  fi

  local text="$root_txt; $sock_txt; $live_txt; $usage_txt"

  if [ -n "$ambient" ]; then
    # REUSES root_v/sock_v/live_v/usage_v (already flattened above) rather than
    # the raw env values - the remedy command text is part of the SAME
    # single-line probe text as $root_txt/$sock_txt/$live_txt/$usage_txt, so it
    # is exactly as exposed to the newline/tab forgery C2 closes.
    #
    # EVERY AMBIENT KEY IS CARRIED INTO THE REMEDY. This line exists to turn an
    # ambient environment into a durable file, and a key left out of it is a key
    # the operator loses by following the advice.
    local init_root="${root_v:-/abs/correct-estate-root}"
    local init_cmd="steward config init --estate-root $init_root"
    [ "$_CFG_SOURCE_STEWARD_TMUX_SOCKET" = "process-environment" ]  && init_cmd="$init_cmd --tmux-socket $sock_v"
    [ "$_CFG_SOURCE_STEWARD_LIVENESS_CMD" = "process-environment" ] && init_cmd="$init_cmd --liveness-cmd $live_v"
    [ "$_CFG_SOURCE_STEWARD_USAGE_CMD" = "process-environment" ]    && init_cmd="$init_cmd --usage-cmd $usage_v"
    if [ -n "$mode_warn" ]; then
      printf 'WARN %s -- run: %s; also: %s\n' "$text" "$init_cmd" "$mode_warn"
    else
      printf 'WARN %s -- run: %s\n' "$text" "$init_cmd"
    fi
    return 0
  fi

  if [ -n "$mode_warn" ]; then
    printf 'WARN %s -- %s\n' "$text" "$mode_warn"
    return 0
  fi

  printf 'PASS %s\n' "$text"
  return 0
}

# estate-root — the root directory, estate/steward.conf, and its schema.
# Reuses _registry_estate_root and registry_estate_file/registry_schema_check
# from lib/registry.sh rather than re-deriving any of it.
_doctor_probe_estate-root() {
  local root; root="$(_registry_estate_root)"
  # DISPLAY-ONLY, FLATTENED. $root is STEWARD_ESTATE_ROOT (or its
  # config-file value) verbatim — the same value that can arrive
  # newline/tab-bearing from the process environment that C2 closes on the
  # operator-config probe. The raw $root still drives every real
  # filesystem check below (-d, registry_estate_file); only what gets
  # printed into probe text is flattened.
  local root_disp; root_disp="$(_doctor_oneline "$root")"

  local cfgfile="${STEWARD_CONFIG_FILE:-$HOME/.config/steward/config}"
  local have_file=""
  [ -e "$cfgfile" ] && have_file=1
  # SAME RULE AS operator-config's OWN REMEDY: `init` only ever applies when
  # no config file exists yet; once one exists, `set` is the only verb that
  # will not refuse.
  local remedy
  if [ -n "$have_file" ]; then
    remedy="steward config set STEWARD_ESTATE_ROOT /abs/correct-estate-root"
  else
    remedy="steward config init --estate-root /abs/correct-estate-root"
  fi

  if [ ! -d "$root" ]; then
    printf 'FAIL estate root does not exist: %s -- run: %s\n' "$root_disp" "$remedy"
    return 78
  fi

  local estate_file; estate_file="$(registry_estate_file)"
  if [ ! -f "$estate_file" ]; then
    printf 'FAIL estate file missing: %s -- run: %s\n' "$(_doctor_oneline "$estate_file")" "$remedy"
    return 78
  fi

  local schema_out schema_rc
  schema_out="$(registry_schema_check 2>&1 >/dev/null)"
  schema_rc=$?
  if [ "$schema_rc" -ne 0 ]; then
    printf 'FAIL %s -- run: %s\n' "$(_doctor_oneline "$schema_out")" "$remedy"
    return 78
  fi

  printf 'PASS root=%s estate-file=%s\n' "$root_disp" "$(_doctor_oneline "$estate_file")"
  return 0
}

# registry — does the session registry load, and how many rows are
# unreadable. Reuses registry_list and registry_load; never re-parses a
# session conf itself.
_doctor_probe_registry() {
  local errf; errf="$(mktemp 2>/dev/null)"
  if [ -z "$errf" ]; then
    printf 'FAIL could not create a temporary file\n'
    return 70
  fi
  local list rc
  list="$(registry_list 2>"$errf")"
  rc=$?
  local err; err="$(cat "$errf" 2>/dev/null)"
  rm -f "$errf"
  if [ "$rc" -ne 0 ]; then
    printf 'FAIL %s -- if this estate root is wrong, run: steward config set STEWARD_ESTATE_ROOT /abs/correct-estate-root\n' "$(_doctor_oneline "$err")"
    return 78
  fi

  local total=0 unreadable=0 name load_err load_rc
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    total=$((total+1))
    load_err="$(registry_load "$name" 2>&1 >/dev/null)"; load_rc=$?
    if [ "$load_rc" -eq 78 ]; then
      printf 'FAIL %s\n' "$(_doctor_oneline "$load_err")"
      return 78
    fi
    [ "$load_rc" -eq 0 ] || unreadable=$((unreadable+1))
  done <<EOF
$list
EOF

  if [ "$unreadable" -gt 0 ]; then
    printf 'WARN %d/%d session(s) failed to load -- run: steward sessions to see which\n' "$unreadable" "$total"
    return 0
  fi
  printf 'PASS %d session(s) registered, all load\n' "$total"
  return 0
}

# mandates — does the mandate register hang together with the registers it
# points into? registry_mandate_check IS the measurement (lib/registry.sh);
# this probe only renders it: absent register, coherent register, findings,
# or the register's own refusal.
#
# AN ABSENT REGISTER IS PASS, WITH THE SENTENCE. An estate that has not set the
# giving-back programme up is the ordinary state, not a defect - so not WARN,
# there is nothing to fix. And not silence: the doctor is how this check runs
# without anyone remembering it, so the row must exist even when it says "not
# set up". A dangling symlink is NOT absent; it reaches the check and refuses.
#
# A FINDING IS FAIL, NEVER WARN. The findings this check makes are a login the
# register does not know, a payer that is not the seat's, and FALSE-CONSENT -
# a row signed from a channel that authenticates someone else. None of them is
# a degradation to note; each is a row that must not be honoured. The first
# finding is quoted so the line can be acted on, and the count says how many
# more there are. No remedy verb is named, because none exists yet; the check
# itself is the remedy's first half.
_doctor_probe_mandates() {
  local dir; dir="$(registry_mandate_dir 2>/dev/null)" || {
    printf 'FAIL could not resolve the mandate register directory\n'; return 78; }
  if [ ! -d "$dir" ] && [ ! -L "$dir" ]; then
    printf 'PASS no mandate register - the giving-back programme is not set up (%s absent)\n' "$(_doctor_oneline "$dir")"
    return 0
  fi
  local outf errf
  outf="$(mktemp 2>/dev/null)" && errf="$(mktemp 2>/dev/null)" || {
    printf 'FAIL could not create a temporary file\n'; return 70; }
  registry_mandate_check >"$outf" 2>"$errf"; local rc=$?
  local n first err
  n="$(grep -c . "$outf")"; first="$(head -1 "$outf")"; err="$(cat "$errf")"
  rm -f "$outf" "$errf"
  case "$rc" in
    0)  printf 'PASS %d mandate(s), register coherent\n' "$(registry_mandate_list 2>/dev/null | grep -c .)"; return 0 ;;
    78) printf 'FAIL %s\n' "$(_doctor_oneline "$err")"; return 78 ;;
    *)  if [ "$n" -gt 1 ]; then
          printf 'FAIL %d findings in the mandate register -- first: %s -- and %d more\n' "$n" "$(_doctor_oneline "$first")" "$((n-1))"
        else
          printf 'FAIL 1 finding in the mandate register -- %s\n' "$(_doctor_oneline "$first")"
        fi
        return 78 ;;
  esac
}

# hub-local — this machine's hostname against the estate's HUB_HOST. THE
# DECISION ITSELF IS _resolve_hub_local's, REUSED VERBATIM (same
# STEWARD_HOSTNAME_CMD test seam it already honors); this probe only prints
# the two names next to the same yes/no it already makes. Not being the hub
# is a normal state for an operator's own laptop, not a defect — so it is a
# WARN with no remedy, never a FAIL.
_doctor_probe_hub-local() {
  local hub_host; hub_host="$(registry_hub_host 2>/dev/null)"
  if [ -z "$hub_host" ]; then
    printf 'FAIL the estate names no readable HUB_HOST -- run: steward config set STEWARD_ESTATE_ROOT /abs/correct-estate-root\n'
    return 78
  fi

  local here_host
  if [ -n "${STEWARD_HOSTNAME_CMD:-}" ]; then here_host="$("$STEWARD_HOSTNAME_CMD" 2>/dev/null)"
  else here_host="$(hostname -s 2>/dev/null)"; fi
  if [ -z "$here_host" ]; then
    printf 'FAIL could not determine this machine'"'"'s hostname\n'
    return 69
  fi

  if _resolve_hub_local; then
    printf 'PASS this machine (%s) is the hub (HUB_HOST=%s)\n' "$here_host" "$hub_host"
  else
    printf 'WARN this machine (%s) is not the hub (HUB_HOST=%s) -- socket derivation and estate-local shortcuts stay off; an explicit STEWARD_TMUX_SOCKET is still honored\n' "$here_host" "$hub_host"
  fi
  return 0
}

# liveness — source+provenance of the effective STEWARD_LIVENESS_CMD, path
# safety, a BOUNDED contract probe (the shim actually runs, through the same
# liveness_rows/LIVENESS_SEAM_REASON machinery every other caller uses — this
# probe adds no timeout mechanism of its own), and registry parity: the
# session names the shim answered about, compared against the registry's own
# set.
#
# THE EFFECTIVE VALUE IS RESOLVED IN cmd_doctor, NOT HERE. This function runs
# inside a `$( )` command substitution — a subshell — so any mutation it made
# to STEWARD_LIVENESS_CMD or _CFG_SOURCE_STEWARD_LIVENESS_CMD (the estate
# fallback cmd_sessions performs) would vanish the instant it returned. The
# runner performs that same fallback once, in ITS OWN shell, before the probe
# loop starts, and leaves the result (and any refusal from it) in
# $STEWARD_LIVENESS_CMD / $_CFG_SOURCE_STEWARD_LIVENESS_CMD /
# $_DOCTOR_LIVENESS_RC / $_DOCTOR_LIVENESS_DIAG for this probe to only read.
#
# A VALID EMPTY ANSWER IS NOT PROOF OF AN EMPTY FLEET. A shim that returns
# `{"sessions":{}}` cleanly (rc 0, no seam reason) against a registry that
# lists real sessions is indistinguishable, on the wire, from a shim that
# is quietly pointed at the wrong estate — so it is a WARN, never a PASS.
# The same is true in reverse: a session name the shim mentions that the
# registry does not know is worth a WARN, not silent acceptance.
_doctor_probe_liveness() {
  if [ -n "${_DOCTOR_LIVENESS_RC:-}" ] && [ "$_DOCTOR_LIVENESS_RC" -ne 0 ]; then
    if [ "$_DOCTOR_LIVENESS_RC" -eq 70 ]; then
      printf 'FAIL %s\n' "$(_doctor_oneline "${_DOCTOR_LIVENESS_DIAG:-could not create a temporary file}")"
      return 70
    fi
    printf 'FAIL %s -- run: steward config set STEWARD_LIVENESS_CMD /abs/path (or fix LIVENESS_CMD in estate/steward.conf)\n' \
      "$(_doctor_oneline "${_DOCTOR_LIVENESS_DIAG:-registry: LIVENESS_CMD is invalid}")"
    return 78
  fi

  local cmd="${STEWARD_LIVENESS_CMD:-}" src="${_CFG_SOURCE_STEWARD_LIVENESS_CMD:-unset}"

  if [ -z "$cmd" ]; then
    printf 'WARN no liveness command configured (seam-not-configured) -- run: steward config set STEWARD_LIVENESS_CMD /abs/path/to/shim, or add LIVENESS_CMD to estate/steward.conf\n'
    return 0
  fi

  # THE SAME ABSOLUTE-PATH CONTRACT lib/liveness.sh ITSELF ENFORCES, checked
  # here too so the FAIL line names doctor's own remedy rather than making an
  # operator read liveness_rows' stderr to learn it.
  case "$cmd" in
    /*) ;;
    *)
      printf 'FAIL STEWARD_LIVENESS_CMD is not an absolute path (seam-not-absolute): %s -- run: steward config set STEWARD_LIVENESS_CMD /abs/path\n' "$cmd"
      return 78
      ;;
  esac

  if [ -n "${_DOCTOR_STATIC:-}" ]; then
    printf 'SKIP static -- shim not invoked under --static (source=%s cmd=%s)\n' "$src" "$cmd"
    return 0
  fi

  # SAID BEFORE THE SHIM RUNS, NOT AFTER. The shim reads a live multiplexer
  # socket; an operator watching doctor run deserves to know, in advance,
  # that this is the one probe that executes estate-owned code rather than
  # only reading files doctor itself can account for.
  echo "steward: about to run the estate's liveness code to measure it -- invoking the configured shim ($cmd)" >&2

  local _rows_out _rows_err
  _rows_out="$(mktemp 2>/dev/null)" && _rows_err="$(mktemp 2>/dev/null)" || {
    rm -f "$_rows_out"
    printf 'FAIL could not create a temporary file\n'
    return 70
  }
  liveness_rows >"$_rows_out" 2>"$_rows_err"
  local rows errtext reason
  rows="$(cat "$_rows_out")"; errtext="$(cat "$_rows_err")"
  rm -f "$_rows_out" "$_rows_err"
  reason="${LIVENESS_SEAM_REASON:-}"

  if [ "$reason" = "seam-timeout" ]; then
    printf 'FAIL %s (seam-timeout) -- source=%s cmd=%s -- a hung shim is "could not measure now", not misconfiguration; raise STEWARD_LIVENESS_TIMEOUT if this is expected, or fix the shim\n' \
      "$(_doctor_oneline "$errtext")" "$src" "$cmd"
    return 75
  fi
  if [ -n "$reason" ]; then
    printf 'FAIL %s (%s) -- source=%s cmd=%s\n' "$(_doctor_oneline "$errtext")" "$reason" "$src" "$cmd"
    return 78
  fi

  local reg_names shim_names reg_count=0 shim_count=0 name unknown_sessions=""
  reg_names="$(registry_list 2>/dev/null)"
  shim_names="$(printf '%s\n' "$rows" | awk -F'\t' 'NF{print $1}')"

  while IFS= read -r name; do [ -n "$name" ] || continue; reg_count=$((reg_count+1)); done <<EOF
$reg_names
EOF
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    shim_count=$((shim_count+1))
    if ! printf '%s\n' "$reg_names" | grep -Fxq -- "$name"; then
      unknown_sessions="$unknown_sessions $name"
    fi
  done <<EOF
$shim_names
EOF

  if [ "$shim_count" -eq 0 ] && [ "$reg_count" -gt 0 ]; then
    printf 'WARN the shim answered with zero sessions against a %d-session registry -- a valid empty JSON answer is not proof of an empty fleet; source=%s cmd=%s\n' \
      "$reg_count" "$src" "$cmd"
    return 0
  fi
  if [ -n "$unknown_sessions" ]; then
    printf 'WARN the shim reports session(s) the registry does not know:%s -- source=%s cmd=%s\n' "$unknown_sessions" "$src" "$cmd"
    return 0
  fi

  printf 'PASS source=%s cmd=%s answered %d session(s), registry has %d, parity ok\n' "$src" "$cmd" "$shim_count" "$reg_count"
  return 0
}

# socket — the derived-or-explicit tmux socket path (reusing _resolve_socket's
# own logic and provenance, called once in cmd_doctor's shell for the same
# subshell reason liveness above documents), then measured: exists, is a
# socket, nothing more.
#
# NEVER CREATES OR STARTS ANYTHING. This probe is a stat, not a connection —
# `nc -lU` or any other server-starting fixture is out of bounds even in
# tests; a missing socket is reported, never brought into existence.
_doctor_probe_socket() {
  local path="${STEWARD_TMUX_SOCKET:-}" src="${_CFG_SOURCE_STEWARD_TMUX_SOCKET:-unset}"

  if [ -z "$path" ]; then
    printf 'WARN no tmux socket resolved (not hub-local, and no explicit STEWARD_TMUX_SOCKET) -- run: steward config set STEWARD_TMUX_SOCKET /abs/path/under/.tmux/name, or run doctor on the hub\n'
    return 0
  fi

  if [ -n "${_DOCTOR_STATIC:-}" ]; then
    printf 'SKIP static -- filesystem probe not run under --static (path=%s source=%s)\n' "$path" "$src"
    return 0
  fi

  if [ ! -e "$path" ]; then
    printf 'FAIL tmux socket does not exist: %s (source=%s) -- this is normal before any session has started; doctor never creates or starts one\n' "$path" "$src"
    return 69
  fi
  if [ ! -S "$path" ]; then
    printf 'FAIL %s exists but is not a socket (source=%s)\n' "$path" "$src"
    return 69
  fi
  printf 'PASS %s is a socket (source=%s)\n' "$path" "$src"
  return 0
}

# cockpit-binary — missing/fresh/stale/unverifiable against the source set
# (src/, Cargo.toml, Cargo.lock) by mtime. mtime is DIAGNOSIS, never
# provenance — a touched file can lie in either direction, so every
# non-`missing` state says so and hands back the exact build command rather
# than acting on what it saw.
#
# STEWARD_COCKPIT_DIR is a TEST SEAM, same spirit as STEWARD_HOSTNAME_CMD —
# it lets a fixture aim this probe at a FAKE cockpit tree instead of the
# real product checkout's cockpit/, which this probe must never read from
# inside a test. STEWARD_COCKPIT_BIN (already used by the bare invocation)
# is honored the same way here: an explicit binary always wins over the
# derived target/release/cockpit path.
_doctor_probe_cockpit-binary() {
  local dir="${STEWARD_COCKPIT_DIR:-$HERE/cockpit}"
  local bin="${STEWARD_COCKPIT_BIN:-$dir/target/release/cockpit}"
  local build_cmd="cargo build --release --manifest-path $dir/Cargo.toml"

  local have_src=""
  [ -d "$dir/src" ] && [ -f "$dir/Cargo.toml" ] && [ -f "$dir/Cargo.lock" ] && have_src=1

  if [ ! -e "$bin" ]; then
    if [ -n "$have_src" ]; then
      printf 'WARN cockpit binary missing: %s -- run: %s\n' "$bin" "$build_cmd"
      return 0
    fi
    printf 'FAIL cockpit binary missing and no source tree found at %s -- run: %s, or set STEWARD_COCKPIT_BIN to a prebuilt binary\n' "$dir" "$build_cmd"
    return 69
  fi

  if [ -z "$have_src" ]; then
    printf 'WARN cockpit binary present but unverifiable: no source tree at %s to compare mtimes against (this looks like a deployed install without source) -- freshness cannot be measured\n' "$dir"
    return 0
  fi

  local newest_src=0 newest_src_file="$dir/Cargo.toml" f mt
  for f in "$dir/Cargo.toml" "$dir/Cargo.lock"; do
    mt="$(_doctor_mtime_of "$f" 2>/dev/null)" || continue
    if [ "$mt" -gt "$newest_src" ]; then newest_src="$mt"; newest_src_file="$f"; fi
  done
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    mt="$(_doctor_mtime_of "$f" 2>/dev/null)" || continue
    if [ "$mt" -gt "$newest_src" ]; then newest_src="$mt"; newest_src_file="$f"; fi
  done < <(find "$dir/src" -type f 2>/dev/null)

  local bin_mt; bin_mt="$(_doctor_mtime_of "$bin" 2>/dev/null)" || bin_mt=0

  if [ "$bin_mt" -ge "$newest_src" ]; then
    printf 'PASS cockpit binary is fresh: %s (mtime diagnosis, not provenance) is not older than any file under %s\n' "$bin" "$dir"
    return 0
  fi
  printf 'WARN cockpit binary is stale: %s is older than %s (mtime diagnosis, not provenance -- stale does NOT trigger an automatic rebuild) -- run: %s\n' \
    "$bin" "$newest_src_file" "$build_cmd"
  return 0
}

# dependencies — exact resolved paths for jq, tmux, cargo. NO PATH-GUESSING:
# this reports exactly what `command -v` resolved in THIS environment, which
# is what matters under cron or ssh, where PATH is not a login shell's PATH
# — never a claim about where an operator's shell would find it.
_doctor_probe_dependencies() {
  local jq_path tmux_path cargo_path
  jq_path="$(command -v jq 2>/dev/null)"
  tmux_path="$(command -v tmux 2>/dev/null)"
  cargo_path="$(command -v cargo 2>/dev/null)"

  local text="jq=${jq_path:-MISSING} tmux=${tmux_path:-MISSING} cargo=${cargo_path:-MISSING}"

  # jq IS LOAD-BEARING FOR THE PRODUCT ITSELF -- steward sessions --json and
  # this very doctor --json both build their documents with it. Its absence
  # is a missing facility, not a preference.
  if [ -z "$jq_path" ]; then
    printf 'FAIL %s -- jq is required (steward sessions --json and doctor --json both need it) -- install jq so it resolves on PATH\n' "$text"
    return 69
  fi

  local warn=""
  if [ -z "$tmux_path" ]; then
    warn="tmux missing: attach/peek and the tmux socket probe will not work"
  fi
  if [ -z "$cargo_path" ]; then
    [ -n "$warn" ] && warn="$warn; "
    warn="${warn}cargo missing: the cockpit cannot be built from source here (aim STEWARD_COCKPIT_BIN at a prebuilt binary instead)"
  fi
  if [ -n "$warn" ]; then
    printf 'WARN %s -- %s\n' "$text" "$warn"
    return 0
  fi
  printf 'PASS %s\n' "$text"
  return 0
}

# cmd_doctor — the runner. Prints one `ID  STATUS  text` line per probe, in
# dependency order, and returns 0 only when nothing FAILed (worst rc wins:
# 0 PASS/WARN/SKIP, 78 unsafe/missing config, 69 missing facility, 75
# temporary measurement unknown, 70 internal doctor error).
cmd_doctor() {
  local want_json="" a
  _DOCTOR_STATIC=""
  for a in "$@"; do
    case "$a" in
      --json) want_json=1 ;;
      --static) _DOCTOR_STATIC=1 ;;
      *) fel "doctor: unknown argument '$a'" 64 ;;
    esac
  done

  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh" || { echo "steward: could not load lib/registry.sh" >&2; return 70; }
  # shellcheck source=lib/liveness.sh
  . "$HERE/lib/liveness.sh" || { echo "steward: could not load lib/liveness.sh" >&2; return 70; }

  # ── THE TWO RESOLUTIONS THAT MUST HAPPEN IN THIS SHELL, ONCE ──────────
  # See the liveness/socket probes' own comments for why: each probe runs
  # inside a `$( )` subshell, so a mutation made there never reaches the
  # sources object this runner builds after the loop. Resolving here, before
  # any probe runs, means every probe (and --json's sources block) reads the
  # SAME already-settled values — never re-derives them, never disagrees.
  _DOCTOR_LIVENESS_RC=0
  _DOCTOR_LIVENESS_DIAG=""
  if [ -z "${STEWARD_LIVENESS_CMD:-}" ]; then
    local _lv_out _lv_err
    _lv_err="$(mktemp 2>/dev/null)"
    if [ -z "$_lv_err" ]; then
      _DOCTOR_LIVENESS_RC=70
      _DOCTOR_LIVENESS_DIAG="steward: cannot create a temporary file"
    else
      _lv_out="$(registry_liveness_cmd 2>"$_lv_err")"; _DOCTOR_LIVENESS_RC=$?
      _DOCTOR_LIVENESS_DIAG="$(cat "$_lv_err" 2>/dev/null)"
      rm -f "$_lv_err"
      if [ "$_DOCTOR_LIVENESS_RC" -eq 0 ] && [ -n "$_lv_out" ]; then
        STEWARD_LIVENESS_CMD="$_lv_out"; export STEWARD_LIVENESS_CMD
        _CFG_SOURCE_STEWARD_LIVENESS_CMD="estate"
      fi
    fi
  fi
  _resolve_socket

  local worst=0 blocked_by="" id out status text rc
  for id in $_DOCTOR_PROBE_IDS; do
    if [ -n "$blocked_by" ]; then
      case "$id" in
        # cockpit-binary and dependencies are LOCAL, ESTATE-INDEPENDENT
        # checks -- a broken operator config or estate root says nothing
        # about whether cargo or jq are even on this machine, so they run
        # regardless of what blocked everything else.
        cockpit-binary|dependencies) ;;
        *)
          status="SKIP"; text="blocked by $blocked_by"
          # --json PRINTS NOTHING TO STDOUT UNTIL THE ONE DOCUMENT AT THE
          # END. The human `ID  STATUS  text` lines and the JSON document
          # are two different renderings of the same probe list, never
          # both at once -- a consumer piping doctor --json into jq must
          # see ONLY the document.
          [ -n "$want_json" ] || printf '%s  %s  %s\n' "$id" "$status" "$text"
          if [ -n "$want_json" ]; then
            _doctor_json_probes="${_doctor_json_probes:-}$id	$status	$text
"
          fi
          continue
          ;;
      esac
    fi
    # CALLED DIRECTLY, NEVER THROUGH `$( )`. A command substitution forks a
    # subshell whose $$ still reads as THIS process's pid (bash does not
    # renumber it) but whose `trap` table is its own, private copy — so the
    # liveness probe's outer-deadline watchdog (lib/liveness.sh, `kill -USR1
    # $$`) would signal the right pid with the wrong process listening,
    # and the signal's default disposition (terminate) would kill this
    # entire doctor run instead of only unblocking the one `wait`. MEASURED:
    # a hanging stub under `$( )` exited the whole script at rc 158 (128+30,
    # SIGUSR1) instead of the probe returning 75. Capturing through a temp
    # file instead keeps the probe in THIS shell, where the trap lib/liveness.sh
    # sets is the one `kill -USR1 $$` actually reaches.
    local _probe_outf; _probe_outf="$(mktemp 2>/dev/null)" || {
      printf '%s  FAIL  could not create a temporary file\n' "$id"
      rc=70; [ "$rc" -gt "$worst" ] && worst="$rc"
      continue
    }
    _doctor_probe_"$id" >"$_probe_outf"; rc=$?
    out="$(cat "$_probe_outf")"; rm -f "$_probe_outf"
    status="${out%% *}"
    text="${out#* }"
    [ -n "$want_json" ] || printf '%s  %s  %s\n' "$id" "$status" "$text"
    [ "$rc" -gt "$worst" ] && worst="$rc"
    case "$id" in
      operator-config|estate-root)
        [ "$status" = "FAIL" ] && blocked_by="$id"
        ;;
    esac
    if [ -n "$want_json" ]; then
      _doctor_json_probes="${_doctor_json_probes:-}$id	$status	$text
"
    fi
  done

  if [ -n "$want_json" ]; then
    jq -Rn \
      --arg probes "${_doctor_json_probes:-}" \
      --arg root_val "${STEWARD_ESTATE_ROOT:-}" --arg root_src "${_CFG_SOURCE_STEWARD_ESTATE_ROOT:-unset}" \
      --arg sock_val "${STEWARD_TMUX_SOCKET:-}" --arg sock_src "${_CFG_SOURCE_STEWARD_TMUX_SOCKET:-unset}" \
      --arg live_val "${STEWARD_LIVENESS_CMD:-}" --arg live_src "${_CFG_SOURCE_STEWARD_LIVENESS_CMD:-unset}" \
      --arg usage_val "${STEWARD_USAGE_CMD:-}" --arg usage_src "${_CFG_SOURCE_STEWARD_USAGE_CMD:-unset}" \
      --argjson rc "$worst" '
      ($probes | split("\n") | map(select(length>0) | split("\t"))
        | map({id: .[0], status: .[1], text: .[2]})) as $probelist |
      { ok: ($rc == 0),
        rc: $rc,
        probes: $probelist,
        sources: {
          root:     {value: $root_val, source: $root_src},
          socket:   {value: $sock_val, source: $sock_src},
          liveness: {value: $live_val, source: $live_src},
          usage:    {value: $usage_val, source: $usage_src}
        } }'
  fi

  return "$worst"
}

# ---------------------------------------------------------------------------
# `steward login [session]` — hands the operator to the runtime's OWN
# interactive login flow, in their own tty. Defaults to the estate's hub
# session when no name is given. Steward never touches, parses or stores the
# credential; this verb only decides which flow to start and gets out of the
# way before it runs.
#
# TWO GATES, IN THIS ORDER — the same reasoning the cockpit already applies:
# ownership is the durable truth, reach is a capability.
#   1. OWNERSHIP: the session's account principal must be this viewer, or login
#      stays with whoever it belongs to.
#   2. HUB-LOCAL: login runs on the machine the session actually lives on,
#      never dialed in from a laptop over ssh.
#
# THE RECIPE LIVES IN THIS CASE STATEMENT AND NOWHERE ELSE. A LOGIN_CMD read
# out of a session conf would be the exact execution path the operator-config
# parser exists to refuse — a file an operator can edit steering which binary
# their own credentials go through. STEWARD_LOGIN_CMD_CLAUDE and
# STEWARD_LOGIN_CMD_OPENCODE are test seams only; production always resolves
# the bare runtime name on PATH.
cmd_login() {
  if [ $# -gt 1 ]; then
    echo "steward: login takes at most one session name" >&2
    return 64
  fi
  local session="${1:-}"
  # shellcheck source=lib/registry.sh
  . "$HERE/lib/registry.sh"

  if [ -z "$session" ]; then
    session="$(registry_hub_session)" || return 78
  fi

  # THE REGISTRY'S OWN MESSAGE PASSES THROUGH, UNCAPTURED — stderr is never
  # redirected here. The exit code is house style regardless of what
  # registry_load itself returns for "no such session" (a bare 1): every
  # other caller in this file that wraps a registry-layer failure reports it
  # as 78, and a session name is exactly that layer.
  #
  # THE HANDLE IS RESOLVED FIRST: a person says the SLUG, the row is keyed by
  # an opaque id. An unknown handle falls through to registry_load so the
  # refusal is the registry's own sentence, not a second one from here.
  local key; key="$(registry_resolve_session "$session")" || key="$session"
  registry_load "$key" || return 78

  local viewer="${STEWARD_VIEWER:-}" username="" viewer_host="" owner_principal=""
  if [ -z "$viewer" ]; then
    username="$(id -un 2>/dev/null)"
    if [ -n "${STEWARD_HOSTNAME_CMD:-}" ]; then
      viewer_host="$("$STEWARD_HOSTNAME_CMD" 2>/dev/null)"
    else
      viewer_host="$(hostname -s 2>/dev/null)"
    fi
    [ -z "$username" ] || viewer="$(registry_principal_for_username "$username" "$viewer_host")" || viewer=""
  fi
  owner_principal="$(_registry_row_principal "$key")" || return 78
  # AN EMPTY VIEWER MATCHES NO ONE. registry_load already guarantees a
  # non-empty, regex-validated OWNER, so empty==empty cannot happen today —
  # but that guarantee lives in another file, and this comparison must not
  # silently reopen if the loader ever relaxes. Same construction as the
  # cockpit's enter_allowed: non-empty first, equality second.
  if [ -z "$viewer" ] || [ "$owner_principal" != "$viewer" ]; then
    printf 'steward: %s is owned by %s — login stays with the owner\n' "$session" "$owner_principal" >&2
    return 77
  fi

  # THE LOGIN WRITES IN A HOME, AND THE HOME STANDS ON THE SESSION'S HOST.
  # Until 2026-09-05 the gate was "this machine is the hub", which was the
  # same machine for every session the estate had — and became wrong the day
  # a session lived on a host the hub only deploys to: run on the hub, the
  # flow would have written credentials into the hub's copy of the home, and
  # the session on the real host would have kept asking for /login. Same
  # hostname seam as _resolve_hub_local, compared against the row's HOST.
  local here_host
  if [ -n "${STEWARD_HOSTNAME_CMD:-}" ]; then
    here_host="$("$STEWARD_HOSTNAME_CMD" 2>/dev/null)"
  else
    here_host="$(hostname -s 2>/dev/null)"
  fi
  if [ -z "$here_host" ] || [ "$here_host" != "$HOST" ]; then
    printf 'steward: %s lives on %s — login runs there, and this machine (%s) is not it\n' \
      "$session" "$HOST" "${here_host:-unknown}" >&2
    return 69
  fi

  # NON-TTY IS AN HONEST REFUSAL, NOT A HANG. Both recipes below are
  # interactive; started with stdin piped or redirected they would either
  # hang waiting for input that never comes, or silently run a partial
  # credential flow with nobody watching it.
  #
  # STEWARD_LOGIN_ASSUME_TTY is a TEST SEAM ONLY, documented here because
  # nowhere else in this file names it: it lets a fixture drive this far
  # without a real terminal. No production path ever sets it.
  if [ -z "${STEWARD_LOGIN_ASSUME_TTY:-}" ] && [ ! -t 0 ]; then
    echo "steward: login is interactive — run it in a terminal" >&2
    return 64
  fi

  # THE LOGIN FLOW WRITES CREDENTIALS, so it must never run in whatever
  # directory this process happened to inherit. registry_login_apply is THE
  # rule, applied to this process's own environment — the handoff below execs
  # from here, so there is no command string and no prefix.
  #
  # THE LOAD RUNS IN THIS SHELL, un-subshelled, because the printed line needs
  # LOGIN_ACCOUNT. Sourcing an untrusted row is not the risk here that it is
  # elsewhere: this register is parsed, never sourced.
  local login_dir="" login_account=""
  if [ -n "${LOGIN:-}" ]; then
    registry_login_load "$LOGIN" >/dev/null || {
      fel "login '$LOGIN' does not resolve — refusing to hand off an interactive login to an unknown account" 78
    }
    login_account="$LOGIN_ACCOUNT"
    login_dir="$(registry_login_config_dir "$LOGIN" "$OWNER")" || \
      fel "login '$LOGIN' does not resolve to a directory — see the message above" 78
    registry_login_apply "$LOGIN" "$OWNER" || \
      fel "login '$LOGIN' could not be applied" 78
  fi

  # SAY WHERE IT IS GOING, EVERY TIME, BEFORE ANYTHING RUNS. An interactive
  # login is a one-way door: it REPLACES the credentials in whichever directory
  # it lands in. Whoever runs this must be able to read the target off the
  # screen rather than deduce it from a register.
  #
  # THE "inherited" WORDING IS THE PURPOSE OF THE NO-LOGIN BRANCH. A line that
  # names a directory reads as a decision; a line that says "inherited" is the
  # only form that makes visible that the verb does NOT know whose credentials
  # are about to be replaced. ${VAR-} under set -u: the variable may be unset,
  # and a nounset abort here would turn a warning into a crash.
  if [ -n "$login_dir" ]; then
    echo "steward login: account '$login_account' · directory '$login_dir'"
  else
    echo "steward login: account UNKNOWN · directory '<inherited: ${CLAUDE_CONFIG_DIR-the runtime default}>'"
    echo "steward login: WARNING — this session declares no LOGIN, so this flow will replace" >&2
    echo "steward login: the credentials of whichever account this process inherited." >&2
    echo "steward login: register a login and set LOGIN on the row to make the target explicit." >&2
  fi

  local cmd
  local -a args
  case "$RUNTIME" in
    claude-code)
      cmd="${STEWARD_LOGIN_CMD_CLAUDE:-claude}"
      args=(/login)
      ;;
    opencode)
      cmd="${STEWARD_LOGIN_CMD_OPENCODE:-opencode}"
      args=(auth login)
      ;;
    *)
      # BELT AND BRACES. registry_load already refuses any RUNTIME outside
      # claude-code|opencode before this line can run — this case exists so
      # a future closed-vocabulary addition that outpaces this file's own
      # recipes fails by naming itself, rather than falling through with an
      # empty $cmd.
      printf "steward: no login recipe for runtime '%s'\n" "$RUNTIME" >&2
      return 69
      ;;
  esac

  local resolved
  resolved="$(command -v "$cmd" 2>/dev/null)"
  # THE INSTALLER'S OWN SHELF COUNTS. install.sh places the runtime binary
  # in ~/.local/bin, but a non-login shell (sudo, cron, an ssh command)
  # often lacks that on PATH — the first real operator hit exactly this:
  # refused "not found on PATH" while the binary sat where the product
  # itself had put it. A bare name falls back to the shelf before refusing.
  if [ -z "$resolved" ]; then
    case "$cmd" in
      */*) ;;
      *) [ -x "$HOME/.local/bin/$cmd" ] && resolved="$HOME/.local/bin/$cmd" ;;
    esac
  fi
  if [ -z "$resolved" ]; then
    case "$cmd" in
      */*) printf 'steward: login binary not found: %s (looked for it at that exact path)\n' "$cmd" >&2 ;;
      *)   printf 'steward: login binary not found: %s (looked for it on PATH and in ~/.local/bin)\n' "$cmd" >&2 ;;
    esac
    return 69
  fi

  printf "steward: login for '%s' (runtime %s) — running: %s %s\n" "$session" "$RUNTIME" "$cmd" "${args[*]}"
  exec "$resolved" "${args[@]}"
}

# `steward job start|cancel|reconcile` — the submission gate wired onto the
# job engine (lib/job{state,schema,git,outbox,reconcile}.sh).
#
# `start` reads its WHOLE submission from SUBMIT_* in the environment (see
# lib/jobschema.sh's usage doc), refuses an incomplete one with the schema's
# own reason (nothing minted), then: mints an id, gives the job its OWN
# checkout — never the submitter's — via jobgit_checkout (which also hands
# back BASE_SHA, the source's HEAD at checkout time, written into the row),
# creates the row DESIRED=run PROCESS=queued OUTCOME=pending
# DELIVERY_RECEIPT=pending MESSAGE_RECEIPT=not-sent, and launches the runner
# DETACHED (JOBSTART_SPAWN is an injectable seam for tests; the default is a
# detached tmux session running job-run.sh) BEFORE returning — the id goes to
# stdout immediately, the run happens off to the side.
#
# `cancel` and `reconcile` are thin: state the one change (or none) and let
# the reconciler — the one place that decides outcome — do the rest.
cmd_job() {
  local sub="${1:-}"; shift || true
  # shellcheck source=lib/jobstate.sh
  . "$HERE/lib/jobstate.sh"
  # shellcheck source=lib/jobschema.sh
  . "$HERE/lib/jobschema.sh"
  # shellcheck source=lib/jobgit.sh
  . "$HERE/lib/jobgit.sh"
  # shellcheck source=lib/joboutbox.sh
  . "$HERE/lib/joboutbox.sh"
  # shellcheck source=lib/jobreconcile.sh
  . "$HERE/lib/jobreconcile.sh"
  case "$sub" in
    start)
      jobschema_validate || return $?
      # FILE-DELIVERY JOBS (DELIVERY_GLOB without REPO) ARE STAGE-2. The
      # schema accepts them so submissions stay forward-compatible with a
      # workdir contract that does not exist yet; the engine refuses
      # honestly here rather than half-running one on a checkout it never
      # had.
      if [ -z "${SUBMIT_REPO:-}" ]; then
        echo "steward job: file-delivery jobs (DELIVERY_GLOB without REPO) are not" >&2
        echo "  built yet — digest pinning and a workdir contract are stage-2 work." >&2
        echo "  The schema accepts them so submissions stay forward-compatible;" >&2
        echo "  the engine refuses honestly rather than half-running one." >&2
        return 65
      fi
      # THE PERMISSION MODE IS A CLOSED SET, CHECKED BEFORE ANYTHING IS MINTED.
      # The runner hands this straight to the runtime, and a value the runtime
      # does not know fails halfway through a DETACHED run — an id, a clone and
      # a branch already spent on a submission that could never start. Empty
      # means unset: no field on the row, no flag in the argv, no default this
      # gate invented on the submitter's behalf.
      local perm_kv=()
      if [ -n "${SUBMIT_PERMISSION_MODE:-}" ]; then
        case "$SUBMIT_PERMISSION_MODE" in
          default|acceptEdits|bypassPermissions|plan)
            perm_kv=(PERMISSION_MODE="$SUBMIT_PERMISSION_MODE") ;;
          *)
            echo "steward job: REFUSES — SUBMIT_PERMISSION_MODE='$SUBMIT_PERMISSION_MODE' is not a mode" >&2
            echo "  the runtime knows. The whole set: default, acceptEdits," >&2
            echo "  bypassPermissions, plan. Leave it empty to say nothing about" >&2
            echo "  permissions at all. Nothing was minted." >&2
            return 65 ;;
        esac
      fi
      local id workroot base_out
      id="$(jobstate_mint_id)"
      workroot="$(jobstate_home)/$id/work"
      base_out="$(jobgit_checkout "$id" "$SUBMIT_REPO" "$workroot")" || return $?
      jobstate_create "$id" \
        GOAL="$SUBMIT_GOAL" OWNER="${SUBMIT_OWNER:-$(id -un)}" \
        LOGIN="${SUBMIT_LOGIN:-}" \
        DESIRED=run PROCESS=queued OUTCOME=pending \
        DELIVERY_RECEIPT=pending MESSAGE_RECEIPT=not-sent \
        CHECK_CMD="$SUBMIT_CHECK_CMD" CHECK_EXPECT="$SUBMIT_CHECK_EXPECT" \
        BRIEF_OBJECTIVE="$SUBMIT_BRIEF_OBJECTIVE" BRIEF_DELIVERY="$SUBMIT_BRIEF_DELIVERY" \
        BRIEF_TOOLS="$SUBMIT_BRIEF_TOOLS" BRIEF_BOUNDS="$SUBMIT_BRIEF_BOUNDS" \
        WORKDIR="$workroot" RUNTIME="${SUBMIT_RUNTIME:-claude-code}" \
        ${perm_kv+"${perm_kv[@]}"} \
        "$base_out" || return $?
      if [ -n "${JOBSTART_SPAWN:-}" ]; then
        "$JOBSTART_SPAWN" "$id" >/dev/null 2>&1
      else
        tmux new-session -d -s "$id" "$HERE/job-run.sh" "$id" >/dev/null 2>&1
      fi || echo "steward job: runner spawn failed — run 'steward job reconcile $id' to retry" >&2
      printf '%s\n' "$id"
      ;;
    cancel)
      local id="${1:?steward job cancel <id>}"
      jobstate_read "$id" || return $?
      jobstate_transition "$id" "$JOB_VERSION" DESIRED=cancel || return $?
      jobreconcile "$id"
      ;;
    reconcile) jobreconcile "${1:?steward job reconcile <id>}" ;;
    show)
      local sid="${1:-}"
      [ -n "$sid" ] || { echo "usage: steward job show <id>" >&2; return 64; }
      _job_show "$sid"
      ;;
    *)
      echo "usage: steward job start|cancel|reconcile (start reads SUBMIT_* from the environment)" >&2
      echo "       steward job show <id>" >&2
      return 64 ;;
  esac
}

# `steward job show <id>` — everything this machine knows about ONE job, in
# the order an operator asks for it: what the row says, what happened, what
# was announced, and whether the delivery it claims is still there.
#
# THE FIELDS COME FROM THE STRICT READER, NEVER FROM READING THE FILE. A row
# under the state home is written by machinery and editable by hand, so this
# verb shows exactly what jobstate_read parsed — a row it refuses to parse
# gets that refusal (rc 65) rather than a half-shown row, and a name nobody
# has gets rc 66 saying which id was not found. Printing the file directly
# would show fields the rest of the product would never act on.
#
# THE DELIVERY BLOCK ASKS THE REMOTE, and says which of three things it
# found: the tip still matches DELIVERY_SHA, the tip has MOVED (and to
# where), or there is no ref to compare against at all. "Delivered" is a
# claim in the row; only the remote can confirm it, and rounding a moved tip
# down to "delivered" is exactly the lie the job engine exists to prevent.
#
# AN ABSENT WORKDIR IS A FACT, NOT AN ERROR. The checkout is where the
# origin url lives, so without it there is nothing to ask git with — the
# line says `workdir: gone` and the verb still succeeds. A job whose
# checkout was cleaned up is an ordinary old job, and refusing to describe
# it would make `show` useless on precisely the jobs nobody remembers.
_job_show() {
  local id="$1" home branch have v name f eid state any=""
  home="$(jobstate_home)" || return $?
  jobstate_read "$id" || return $?

  printf 'job %s\n' "$id"
  # Sorted so two runs of this verb on the same row print the same thing;
  # compgen's own order is not a contract worth reading a diff against.
  for v in $(compgen -v JOB_ | sort); do
    name="${v#JOB_}"
    printf '%s=%s\n' "$name" "${!v}"
  done

  # THE LAST TEN LINES, not the whole journal. The journal grows with every
  # transition and the tail is what answers "what just happened"; an
  # operator who wants the rest knows where the file is, and it is named
  # here so they do.
  printf 'journal:\n'
  if [ -f "$home/$id/journal" ]; then
    tail -n 10 "$home/$id/journal" | sed 's/^/  /'
  else
    printf '  (no journal at %s/%s/journal)\n' "$home" "$id"
  fi

  # BOTH STATES, IN ONE LIST. A pending event and a sent one are the same
  # notice at different moments, and an outbox listing that showed only one
  # of them would make a stuck send look like a job that never announced
  # anything.
  printf 'outbox:\n'
  for f in "$home/$id/outbox"/*.pending "$home/$id/outbox"/*.sent; do
    [ -e "$f" ] || continue
    any=1
    eid="$(basename "$f")"; state="${eid##*.}"; eid="${eid%.*}"
    printf '  %s %s\n' "$eid" "$state"
  done
  [ -n "$any" ] || printf '  (none)\n'

  printf 'delivery:\n'
  branch="$(jobgit_branch "$id")" || return $?
  printf '  branch: %s\n' "$branch"
  printf '  DELIVERY_SHA=%s\n' "${JOB_DELIVERY_SHA:-(none yet)}"
  if [ ! -d "${JOB_WORKDIR:-}" ]; then
    printf '  workdir: gone\n'
  elif [ -z "${JOB_DELIVERY_SHA:-}" ]; then
    printf '  remote: nothing has been delivered yet, so there is nothing to verify\n'
  else
    have="$(git -C "$JOB_WORKDIR" ls-remote origin "refs/heads/$branch" 2>/dev/null | cut -f1)"
    if [ -z "$have" ]; then
      printf '  remote: no ref for %s — the branch is gone, or origin is unreachable\n' "$branch"
    elif [ "$have" = "$JOB_DELIVERY_SHA" ]; then
      printf '  remote: matches DELIVERY_SHA\n'
    else
      printf '  remote: does NOT match — the tip is now %s\n' "$have"
    fi
  fi
}

# `steward jobs [--json]` — IDENTITY FIRST. Every row that exists under the
# state home is listed, whether or not it can be measured; a measurement
# (the parsed fields) is then left-joined onto that identity, never the
# other way around. A row whose `row` file cannot be parsed still appears,
# with `reason:"unparsable row"` — it is never silently dropped and never
# guessed at. `coverage` states listed/measured/unmeasurable so a caller can
# tell a clean sweep from one that quietly lost rows.
#
# THE TABLE AND THE JSON READ THE SAME SWEEP. Both forms come out of the one
# loop below, so a row that appears in one appears in the other — a table
# built from its own second pass would be free to disagree with the machine
# answer, and the first time it did nobody would know which to believe. The
# table therefore carries the unparsable rows too, as `<id> [unparsable
# row]`: the operator-facing form is the one where a silently dropped row
# does the most damage, because there is no `coverage` count beside it to
# notice the gap.
#
# THE GOAL IS THE ONLY TRUNCATED COLUMN, and it is truncated because it is a
# sentence and the rest are tokens. It sits last so a long one runs off the
# right of the terminal rather than pushing every other column out of line,
# and the ellipsis says a cut happened — `steward job show <id>` prints it
# whole.
cmd_jobs() {
  local want_json=""
  case "${1:-}" in
    --json) want_json=1; shift ;;
  esac
  [ $# -eq 0 ] || { echo "usage: steward jobs [--json]" >&2; return 64; }
  # shellcheck source=lib/jobstate.sh
  . "$HERE/lib/jobstate.sh"
  local home d id rows="[]" listed=0 measured=0 unmeasurable=0 now hb age hbtext goal
  home="$(jobstate_home)" || return $?
  now="$(_jobstate_now)"
  [ -n "$want_json" ] || printf '%-18s %-9s %-9s %-3s %-6s %s\n' ID PROCESS OUTCOME ATT HB-AGE GOAL
  for d in "$home"/j-*/; do
    [ -d "$d" ] || continue
    id="$(basename "$d")"; listed=$((listed+1))
    if jobstate_read "$id" 2>/dev/null; then
      measured=$((measured+1))
      age=null; hbtext="-"
      hb="$home/$id/heartbeat"
      # _doctor_mtime_of, not a bare stat: the BSD-first probe answers about the
      # FILESYSTEM on GNU and $(( )) would then fail on an ext4 report.
      [ -f "$hb" ] && { _hbm="$(_doctor_mtime_of "$hb")" && { age=$((now - _hbm)); hbtext="$age"; }; }
      if [ -n "$want_json" ]; then
        rows="$(jq -n --argjson rows "$rows" \
          --arg id "$id" --arg goal "${JOB_GOAL:-}" --arg owner "${JOB_OWNER:-}" \
          --arg desired "${JOB_DESIRED:-}" --arg process "${JOB_PROCESS:-}" \
          --arg outcome "${JOB_OUTCOME:-pending}" --arg receipt "${JOB_DELIVERY_RECEIPT:-pending}" \
          --arg sha "${JOB_DELIVERY_SHA:-}" --arg attempt "${JOB_ATTEMPT_ID:-0}" --argjson age "$age" \
          '$rows + [{id:$id, goal:$goal, owner:$owner, desired:$desired, process:$process,
                     outcome:$outcome, delivery:{receipt:$receipt, sha:(if $sha=="" then null else $sha end)},
                     attempt:($attempt|tonumber), heartbeatAgeSec:$age, reason:null}]')"
      else
        goal="${JOB_GOAL:-}"
        [ "${#goal}" -gt 50 ] && goal="${goal:0:47}..."
        printf '%-18s %-9s %-9s %-3s %-6s %s\n' \
          "$id" "${JOB_PROCESS:-unknown}" "${JOB_OUTCOME:-pending}" \
          "${JOB_ATTEMPT_ID:-0}" "$hbtext" "$goal"
      fi
    else
      unmeasurable=$((unmeasurable+1))
      if [ -n "$want_json" ]; then
        rows="$(jq -n --argjson rows "$rows" --arg id "$id" \
          '$rows + [{id:$id, reason:"unparsable row"}]')"
      else
        printf '%-18s %s\n' "$id" '[unparsable row]'
      fi
    fi
  done
  if [ -z "$want_json" ]; then
    # THE HEADER WITHOUT ROWS IS AMBIGUOUS on a blank screen — it looks the
    # same as a verb that fell over before printing anything. One sentence
    # settles it, and rc stays 0: an estate with no jobs is a healthy estate.
    [ "$listed" -eq 0 ] && printf 'no jobs\n'
    return 0
  fi
  jq -n --argjson jobs "$rows" --argjson l "$listed" --argjson m "$measured" --argjson u "$unmeasurable" \
    '{ok:true, schema:1, measuredAt:(now|todate), jobs:$jobs,
      coverage:{listed:$l, measured:$m, unmeasurable:$u}}'
}

# ---------------------------------------------------------------------------
# `steward selfupdate` — bring the two checkouts this operator actually runs
# from up to date, then rebuild the cockpit if this machine has ever built
# one. Every line it prints is a receipt: `<name>: <from-sha> -> <to-sha>`,
# or `<name>: already current`, one per repo, so a run that changed nothing
# is distinguishable at a glance from a run that changed everything.
#
# TWO REPOS, AND THEY ARE NOT THE SAME REPO. The PRODUCT is this checkout,
# found the same way every other path here finds it — from where bin/steward
# itself lives, symlinks resolved (see $HERE at the top of this file), never
# from the caller's working directory. The ESTATE is whatever the operator
# config or the environment named as STEWARD_ESTATE_ROOT, and it is a
# different repository with a different history and a different owner.
# Naming them separately in every line matters: "already current" against a
# product that was three commits behind, printed because the reader assumed
# the line was about the other repo, is the kind of receipt that gets trusted
# once and never again.
#
# A MISSING ESTATE ROOT IS NOT AN ERROR. Most operators run the product long
# before they build an estate, and a laptop with no estate at all is a
# perfectly ordinary machine to update. So an unset root, a root naming a
# directory that does not exist, and a root naming something git does not
# recognise all land in the same place: the product is updated on its own and
# the run SAYS which of the three it was. Silence would leave the operator
# believing an estate had been updated when nothing had gone near it.
#
# BOTH TREES ARE CHECKED FOR UNCOMMITTED WORK BEFORE EITHER IS PULLED. The
# alternative — pull the product, then discover the estate is dirty — leaves
# the machine half-updated on the way out of a refusal, which is the state
# hardest to reason about afterwards. Refusing before anything moved means a
# refusal always leaves the machine exactly as it was found.
#
# AND IT NEVER PUTS THE OPERATOR'S WORK ASIDE FOR THEM. Automatically moving
# uncommitted changes out of the way to make a pull succeed turns "your
# update refused" into "your update succeeded and your work is somewhere you
# did not put it" — recoverable only by whoever knows it happened. The
# refusal names the checkout and the changed files and stops there.
#
# UNTRACKED FILES ARE NOT UNCOMMITTED WORK, for this purpose. A working
# checkout is full of them — cockpit/target/ alone is thousands — and git's
# own fast-forward refuses on its own terms if an incoming file would land on
# an untracked one. Counting them as dirt would make this verb refuse on
# every machine that had ever built the cockpit, which is every machine that
# needs step three below.
#
# FAST-FORWARD ONLY, ALWAYS. A merge or a rebase decides what someone else's
# history means, and that decision belongs to whoever wrote the commits, in
# their own checkout, awake. A pull that cannot fast-forward is therefore a
# refusal telling the operator to reconcile it by hand, never a smarter pull.
#
# THE COCKPIT IS REBUILT ONLY IF IT WAS ALREADY BUILT. The presence of
# cockpit/target/release/cockpit is the whole test: it means this machine
# runs the TUI and now has a binary older than the source it just pulled. A
# machine that has never built one gets told there was nothing to rebuild
# rather than having a Rust toolchain run on it uninvited. When there IS a
# binary and no cargo to rebuild it with, the rebuild SKIPs loudly — a stale
# cockpit that nobody was told about is a bug report about a fix that was
# already pulled.
cmd_selfupdate() {
  if [ $# -ne 0 ]; then
    echo "usage: steward selfupdate" >&2
    return 64
  fi

  local product="$HERE" estate="${STEWARD_ESTATE_ROOT:-}" estate_note=""

  if ! _selfupdate_checkout "$product"; then
    echo "steward selfupdate: the product root is not a git checkout: $product" >&2
    echo "  This verb updates a checkout by pulling it, so an install that was copied" >&2
    echo "  rather than cloned has nothing for it to pull. Run it from a product" >&2
    echo "  checkout (or aim a symlink on PATH at one) and it will update that." >&2
    return 65
  fi

  if [ -z "$estate" ]; then
    estate_note="estate: no estate root is configured — updating the product on its own"
  elif [ ! -d "$estate" ]; then
    estate_note="estate: no directory at $estate — updating the product on its own"
  elif ! _selfupdate_checkout "$estate"; then
    estate_note="estate: $estate is not a git checkout — updating the product on its own"
  fi
  [ -n "$estate_note" ] && estate=""

  if _selfupdate_dirty "$product"; then
    _selfupdate_refuse_dirty product "$product"
    return 65
  fi
  if [ -n "$estate" ] && _selfupdate_dirty "$estate"; then
    _selfupdate_refuse_dirty estate "$estate"
    return 65
  fi

  _selfupdate_pull product "$product" || return $?
  if [ -n "$estate" ]; then
    _selfupdate_pull estate "$estate" || return $?
  else
    printf '%s\n' "$estate_note"
  fi

  _selfupdate_cockpit "$product"
}

# git's own answer, not a guess from the presence of a .git directory: a
# checkout whose .git is a FILE (a worktree, a submodule) is still a checkout,
# and a bare repository is not one this verb can pull into.
_selfupdate_checkout() { # <dir>
  [ -n "$1" ] || return 1
  [ -d "$1" ] || return 1
  [ "$(git -C "$1" rev-parse --is-inside-work-tree 2>/dev/null)" = "true" ]
}

_selfupdate_dirty() { # <dir> — tracked changes only, staged or not
  [ -n "$(git -C "$1" status --porcelain --untracked-files=no 2>/dev/null)" ]
}

_selfupdate_refuse_dirty() { # <name> <dir>
  echo "steward selfupdate: the $1 checkout has uncommitted changes: $2" >&2
  echo "  Nothing was pulled, in either checkout. Commit the work or set it aside" >&2
  echo "  yourself: an update that quietly moved your own changes out of the way to" >&2
  echo "  make room would be the one thing here nobody else could undo for you." >&2
  git -C "$2" status --short --untracked-files=no >&2
}

# ONE RECEIPT LINE PER CALL, from two rev-parses around the pull rather than
# from parsing what git printed — git's pull output is prose that varies with
# version and locale, while the two shas are the measurement itself.
_selfupdate_pull() { # <name> <dir>
  local name="$1" dir="$2" from to out rc
  from="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"
  out="$(git -C "$dir" pull --ff-only 2>&1)"; rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '%s\n' "$out" >&2
    case "$out" in
      *fast-forward*|*fast-forwarded*|*iverg*)
        echo "steward selfupdate: the $name checkout cannot fast-forward onto its origin: $dir" >&2
        echo "  It carries commits origin does not, or the two have gone their own ways." >&2
        echo "  Reconcile it by hand, in that checkout, by whoever wrote those commits — a" >&2
        echo "  rebase or a merge is a judgement about someone's history, and this verb" >&2
        echo "  only ever fast-forwards. Then run selfupdate again." >&2
        ;;
      *)
        echo "steward selfupdate: the pull failed in the $name checkout: $dir" >&2
        echo "  The git output above says why. Reconcile it there and run selfupdate again." >&2
        ;;
    esac
    return 65
  fi
  to="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"
  if [ "$from" = "$to" ]; then
    printf '%s: already current\n' "$name"
  else
    printf '%s: %s -> %s\n' "$name" "$from" "$to"
  fi
  return 0
}

# THE SAME CARGO RESOLUTION THE BARE INVOCATION USES, deliberately: an
# explicit $STEWARD_CARGO_BIN, then ~/.cargo/bin/cargo (rustup's home, which
# is not on PATH for a login shell on either platform), then cargo on PATH.
# Two orders for the same question would eventually build with one toolchain
# and refuse with the other.
_selfupdate_cockpit() { # <product-root>
  local root="$1" bin="$1/cockpit/target/release/cockpit" cargo
  if [ ! -x "$bin" ]; then
    printf 'cockpit: not built in this checkout — nothing to rebuild\n'
    return 0
  fi
  cargo="${STEWARD_CARGO_BIN:-$HOME/.cargo/bin/cargo}"
  command -v "$cargo" >/dev/null 2>&1 || cargo="$(command -v cargo 2>/dev/null || true)"
  if [ -z "$cargo" ]; then
    printf 'cockpit: SKIP — no cargo was found to rebuild it with\n'
    echo "steward selfupdate: THE COCKPIT BINARY AT $bin IS NOW OLDER THAN THE SOURCE" >&2
    echo "  that was just pulled, and no cargo was found to rebuild it with (looked for" >&2
    echo "  \$STEWARD_CARGO_BIN, ~/.cargo/bin/cargo, and cargo on PATH). The next cockpit" >&2
    echo "  this machine starts is the old one. Install Rust, or set STEWARD_CARGO_BIN," >&2
    echo "  and run selfupdate again." >&2
    return 0
  fi
  if ! "$cargo" build --release --manifest-path "$root/cockpit/Cargo.toml"; then
    echo "steward selfupdate: the cockpit failed to rebuild — see the cargo output above." >&2
    echo "  The pulls above stand and their receipts are true; only the binary is stale." >&2
    return 70
  fi
  printf 'cockpit: rebuilt (%s)\n' "$cargo"
  return 0
}

# CALLED FIRST IN THE DISPATCHER, BEFORE ANY SUBCOMMAND — every path below
# (add, ls, sessions, the bare cockpit invocation, an <estate> verb) must
# see the same, already-resolved environment, and a broken config must
# refuse before any of them has a chance to run.
_operator_config_load; _cfg_rc=$?

# `doctor` IS THE ONE EXCEPTION TO THE GATE JUST BELOW. Its whole purpose is
# to diagnose a broken operator config, which it cannot do if the dispatcher
# has already exited on that same brokenness — so it runs on $_cfg_rc/
# $_CFG_ERROR/$_CFG_SOURCE_* exactly as _operator_config_load left them,
# reused rather than re-derived, whether or not the load itself succeeded.
if [ "${1:-}" = "doctor" ]; then
  shift
  cmd_doctor "$@"
  exit $?
fi

# `config` IS THE OTHER EXCEPTION, FOR THE SAME REASON. doctor's own
# prescribed remedy for a broken file is `steward config set ...` — it must
# be able to repair a file the loader just refused, so it cannot sit behind
# a gate that exits on that exact refusal first.
if [ "${1:-}" = "config" ]; then
  shift
  cmd_config "$@"
  exit $?
fi

if [ "$_cfg_rc" -ne 0 ]; then
  _cfg_json=""
  for _cfg_a in "$@"; do [ "$_cfg_a" = "--json" ] && _cfg_json=1; done
  if [ -n "$_cfg_json" ]; then
    jq -cn --arg r "$_CFG_ERROR" '{ok:false,reason:$r}'
  else
    printf '%s\n' "$_CFG_ERROR" >&2
  fi
  exit "$_cfg_rc"
fi
# TEST-ONLY SEAM. Prints the allowlisted values and their provenance,
# then exits — before any subcommand dispatch. Nothing user-facing sets
# this; it exists so operator-config.test.sh can observe
# _CFG_SOURCE_<KEY> from outside the process without a `steward config get`
# verb, which belongs to a later task (config init/set).
if [ -n "${STEWARD_CFG_DEBUG:-}" ]; then
  printf 'STEWARD_ESTATE_ROOT=%s source=%s\n'  "${STEWARD_ESTATE_ROOT:-}"  "$_CFG_SOURCE_STEWARD_ESTATE_ROOT"
  printf 'STEWARD_TMUX_SOCKET=%s source=%s\n'  "${STEWARD_TMUX_SOCKET:-}" "$_CFG_SOURCE_STEWARD_TMUX_SOCKET"
  printf 'STEWARD_LIVENESS_CMD=%s source=%s\n' "${STEWARD_LIVENESS_CMD:-}" "$_CFG_SOURCE_STEWARD_LIVENESS_CMD"
  printf 'STEWARD_USAGE_CMD=%s source=%s\n'    "${STEWARD_USAGE_CMD:-}"    "$_CFG_SOURCE_STEWARD_USAGE_CMD"
  printf 'STEWARD_CREDENTIAL_CMD=%s source=%s\n' "${STEWARD_CREDENTIAL_CMD:-}" "$_CFG_SOURCE_STEWARD_CREDENTIAL_CMD"
  exit 0
fi

case "${1:-}" in
  add)      shift; cmd_add "$@" ;;
  ls)       shift; cmd_ls "$@" ;;
  init)     shift; cmd_init "$@" ;;
  scaffold) shift; cmd_scaffold "$@" ;;
  assets)   shift; cmd_assets "$@"; exit $? ;;
  sessions) shift; cmd_sessions "$@"; exit $? ;;
  mcp)      shift; cmd_mcp "$@"; exit $? ;;
  desk)     shift; cmd_desk "$@"; exit $? ;;
  login)    shift; cmd_login "$@"; exit $? ;;
  job)      shift; cmd_job "$@"; exit $? ;;
  jobs)     shift; cmd_jobs "$@"; exit $? ;;
  selfupdate) shift; cmd_selfupdate "$@"; exit $? ;;
  # NAMESPACED, NOT TOP-LEVEL. `steward team` or `steward client` at the top
  # would collide with the estate-client fallback in the `*)` branch below
  # (`steward <estate> attach|peek|ls`) the moment an operator's own estate
  # happened to be named "team" or "client". `registry` is the one word this
  # dispatcher does not already use for a dispatch route into an estate.
  invite)   shift; cmd_invite "$@"; exit $? ;;
  offboard) shift; cmd_offboard "$@"; exit $? ;;
  registry) shift; cmd_registry "$@"; exit $? ;;
  -h|--help) usage 0 ;;
  "")
    # No subcommand at all is the bare invocation — it starts the
    # interactive cockpit (a Rust TUI) rather than falling into --help.
    #
    # BUILT ON FIRST USE, NOT VENDORED — AND HONEST WHEN THERE IS NOTHING TO
    # BUILD. A fresh checkout has no cockpit/target/ at all, and a bare
    # invocation there must not look like the same refusal a genuinely broken
    # build would produce — nothing attempted vs. something failed are
    # different problems and get different messages and exit codes. A
    # DEPLOYED install is a further state again: the script copied into a
    # home carries no cockpit/ source at all, and attempting a build there
    # hands the operator cargo's raw missing-manifest error, which reads like
    # a broken build when the truth is "this install was never given the
    # source". Measured on the real hub the first day an operator typed a
    # bare `steward` outside the checkout. So: an explicit
    # STEWARD_COCKPIT_BIN always wins; a checkout builds on first use; an
    # install with no source refuses and names both ways forward.
    #
    # SOCKET DERIVATION RUNS FOR EVERY PATH BELOW, including
    # STEWARD_COCKPIT_BIN — a stub or a real binary should see the same
    # environment a built-in-place cockpit would.
    _resolve_socket
    if [ -n "${STEWARD_COCKPIT_BIN:-}" ]; then
      [ -x "$STEWARD_COCKPIT_BIN" ] || fel "STEWARD_COCKPIT_BIN is set but not an executable: $STEWARD_COCKPIT_BIN" 69
      exec "$STEWARD_COCKPIT_BIN"
    fi
    _cockpit_bin="$HERE/cockpit/target/release/cockpit"
    if [ ! -x "$_cockpit_bin" ]; then
      if [ ! -f "$HERE/cockpit/Cargo.toml" ]; then
        fel "this install has no cockpit source (looked in $HERE/cockpit) — run bin/steward from a product checkout, or aim STEWARD_COCKPIT_BIN at a built cockpit binary" 69
      fi
      _cargo="${STEWARD_CARGO_BIN:-$HOME/.cargo/bin/cargo}"
      command -v "$_cargo" >/dev/null 2>&1 || _cargo="$(command -v cargo 2>/dev/null || true)"
      if [ -z "$_cargo" ]; then
        fel "the cockpit is not built and no cargo was found to build it with (looked for \$STEWARD_CARGO_BIN, ~/.cargo/bin/cargo, and cargo on PATH) — install Rust, or set STEWARD_CARGO_BIN" 69
      fi
      echo "steward: the cockpit is not built yet — building it now ($_cargo build --release)..." >&2
      "$_cargo" build --release --manifest-path "$HERE/cockpit/Cargo.toml" \
        || fel "the cockpit failed to build — see the cargo output above" 70
    fi
    exec "$_cockpit_bin"
    ;;
  *)
    est="$1"; shift
    case "${1:-}" in
      attach) shift; cmd_attach "$est" "${1:-}" ;;
      peek)   shift; cmd_peek "$est" "${1:-}" ;;
      login)  shift; cmd_estate_login "$est" "${1:-}" ;;
      # SHIFT PAST "ls", AND FORWARD THE REST. Measured live: `steward <estate>
      # ls --sort slug` neither sorted nor refused — this branch called
      # `cmd_ls "$est"` and nothing else, so `--sort slug` was never even
      # passed to cmd_ls to accept or reject. Silent flag-swallowing is worse
      # than the flag not existing at all.
      ls)     shift; cmd_ls "$est" "$@" ;;
      *) fel "unknown command '${1:-}' for estate '$est' — see steward --help" 64 ;;
    esac ;;
esac
