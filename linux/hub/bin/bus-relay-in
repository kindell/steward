#!/bin/bash
# bus-relay-in <sender-identity> - the receiving side of the bus's machine bridge.
#
# NEVER run directly: it is the forced command for a remote machine's ssh key in
# ~/.ssh/authorized_keys (restrict,command="... bus-relay-in <identity>"). It is
# the whole envelope model in miniature: THE SENDER COMES FROM THE KEY, not from
# the message. A remote machine cannot claim to be somebody else, because the
# identity is pinned in the authorized_keys line on OUR side - and the key can do
# nothing else (no pty, no forwarding, no shell).
#
# Protocol on stdin: line 1 = recipient, the rest to EOF = text.
set -euo pipefail
IDENTITY="${1:?bus-relay-in requires an identity (set in authorized_keys)}"
here="$(CDPATH= cd -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib.sh
source "$here/lib.sh"

# READ TIMEOUTS ON EVERYTHING FROM OUTSIDE, as in bus-relay-deliver: a half-open
# connection must not leave this forced command in pipe_read forever. The body cap
# is coreutils timeout when present, gtimeout when present, otherwise plain - the
# client side ServerAlive remains the guard where neither exists.
RT="${BUS_RELAY_READ_TIMEOUT:-15}"
IFS= read -r -t "$RT" to || { echo "relay: empty stdin, or nothing within ${RT}s" >&2; exit 64; }
_cap=""; command -v timeout >/dev/null 2>&1 && _cap="timeout $RT"
[ -n "$_cap" ] || { command -v gtimeout >/dev/null 2>&1 && _cap="gtimeout $RT"; }
text="$($_cap head -c 65536)" || { echo "relay: timeout reading the text" >&2; exit 64; }   # cap: 64 kB - a bus message is a short notice, not a file
[ -n "$text" ] || { echo "relay: empty text" >&2; exit 64; }

# The sender field is ALWAYS the key's identity. Should the remote side send a
# from-claim of its own, there is no path for it to get here.
bus_send "$to" "$IDENTITY" "$text"
