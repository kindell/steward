#!/bin/bash
# bus/bin/nav-enroll — the hub's half of the session command (direction doc,
# pass 3, item 0). Reads ENROLL-REQUEST v1 on stdin, validates, and (Task 2)
# executes: registry entry + authorized_keys line + proof in both directions.
#
# RUNS ON THE HUB (macOS today): bash 3.2-safe, no GNU-isms.
#
# THE IDENTITY COMES FROM THE ENVELOPE, NEVER FROM THE PAYLOAD. The controller
# reads the inbox entry and sets STEWARD_ENROLL_FROM from its from field, which
# is bound by the relay key in authorized_keys. A "from=" in the payload would
# be a signature, and a signature is not a sender.
# No -e: fel() gives exit 65, not 1. Every error is routed through the function.
set -uo pipefail
here="$(CDPATH= cd -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
repo="$(CDPATH= cd -- "$here/.." && pwd)"
# shellcheck source=../../lib/registry.sh
# THE REGISTRY MAY LIVE IN THE PRODUCT. Manifest sources migrate one at a time,
# and lib/registry.sh is one of them. The lookup is product-first-then-estate,
# the same order the deploy uses — safe precisely because the double-life guard
# forbids a source existing in both trees. STEWARD_REGISTRY_LIB overrides fully.
# REFUSAL IF FOUND NOWHERE: a registry that cannot be read must not look like an
# empty registry.
_reg_lib() {
  local rot="$1" c
  [ -n "${STEWARD_REGISTRY_LIB:-}" ] && { printf '%s' "$STEWARD_REGISTRY_LIB"; return 0; }
  for c in "$rot/../steward/lib/registry.sh" "$rot/lib/registry.sh" "$HOME/scripts/lib/registry.sh"; do
    [ -f "$c" ] && { printf '%s' "$c"; return 0; }
  done
  echo "the registry library was found in neither the product nor the estate (root: $rot)" >&2
  return 78
}
_REGROT="$repo"
: "${STEWARD_ESTATE_ROOT:=$_REGROT}"; export STEWARD_ESTATE_ROOT
_REGLIB="$(_reg_lib "$_REGROT")" || exit 78
# shellcheck source=/dev/null
source "$_REGLIB"

KONTROLLERA=""; UTAN_SANDNING=""; SAND=""
while [ $# -gt 0 ]; do
  case "$1" in
    # THE FLAG NAMES CHANGED LANGUAGE 2026-08-23, not meaning. The old names are
    # NOT accepted as aliases: the product's language guard greps the whole file,
    # so an alias would hold the suite red forever — and an alias no guard permits
    # is an alias nobody maintains. Every caller was corrected in the same change:
    # linux/session-new.sh here, and three test files in the estate.
    #
    # --dry-run BECAME --no-send 2026-08-24, and this one was a LIE, not a
    # translation. The flag never meant "touch nothing": it writes the registry
    # entry AND the authorized_keys line, and skips only the SEND. The suite has
    # always demanded exactly that, so the behaviour was intended — but the name
    # said otherwise, and the hub ran it against a live request believing it was
    # safe. A session got registered; the next run answered "name collision" for
    # an entry nobody thought existed. Only --check writes nothing.
    #
    # NO ALIAS, deliberately. Whoever types the old name must meet a refusal
    # rather than a silent registration — which is the whole failure being fixed.
    --check)     KONTROLLERA=1 ;;
    --no-send)   UTAN_SANDNING=1 ;;
    --send)      SAND=1 ;;
    *) echo "nav-enroll: unknown argument '$1'" >&2; exit 64 ;;
  esac
  shift
done
# A live send is NEVER a default. 2026-08-15 an implementation run reached the
# real bus because the send path fell back silently — so the choice is
# mandatory and tested BEFORE any reading or writing.
if [ -z "$KONTROLLERA" ] && [ -z "$UTAN_SANDNING" ] && [ -z "$SAND" ]; then
  echo "nav-enroll: choose a send path — --send (live), --no-send (execute, print instead of send) or --check (validate only, writes nothing)" >&2
  exit 64
fi

# ── THE ESTATE'S NAMES COME FROM THE ESTATE ────────────────────────────────
# Three values stood here as literals: the hub's machine name (the HOST
# default), the RC label prefix and the hub's name on the bus — an owner's
# namespace burned into code destined for the product. Each is looked up ONCE,
# before use; a failed lookup REFUSES with rc 78 rather than guessing, for the
# same reasons as in lib/registry.sh (a guessed default would silently
# misroute the host check, the label or the proof's instruction).
NAV_VARD="$(registry_hub_host)"       || exit 78
RC_PREFIX="$(registry_rc_label_prefix)" || exit 78
NAV="$(registry_hub_session)"         || exit 78

AUTH_KEYS="${STEWARD_AUTHORIZED_KEYS:-$HOME/.ssh/authorized_keys}"
FROM="${STEWARD_ENROLL_FROM:-}"

fel() { echo "nav-enroll: REFUSING — $1" >&2; exit 65; }

NAMN=""; DOMAN=""; PROJEKT=""; PERSON=""; VARD=""; REPO_S=""; PUBKEY=""; RC_ONSKAD=""
forsta=1; kuvertrad_provad=""
# `|| [ -n "$rad" ]`: a final line WITHOUT a trailing newline is still a line.
# read returns nonzero on EOF-without-delimiter but has already assigned — drop
# the guard and the last field of a request built with printf '%s' is silently
# discarded, and the refusal blames a MISSING field. The estate measured exactly
# this shape in its bus client; the fix is the same one.
while IFS= read -r rad || [ -n "$rad" ]; do
  if [ -n "$forsta" ]; then
    # THE ENVELOPE IS OPTIONAL HERE (Task 2, envelope v2). bus_send now demands
    # that every SEND carries "CLASS subject: headline" on its first line (the
    # requester's half now sends such a line before "ENROLL-REQUEST v1") — but
    # READING must tolerate both presence and absence, the same
    # backwards-compatibility rule as bus/lib.sh (only sending requires an
    # envelope). A line that looks like an envelope is therefore skipped HERE,
    # once, before the format check runs. "ENROLL-REQUEST v1" itself is NOT the
    # envelope and is not touched — nav-enroll requires it verbatim; the
    # envelope line sits BEFORE it, never in its place.
    if [ -z "$kuvertrad_provad" ]; then
      kuvertrad_provad=1
      case "$rad" in
        BESLUT\ *|FYND\ *|SAMORDNING\ *|DRIFT\ *) continue ;;
      esac
    fi
    [ "$rad" = "ENROLL-REQUEST v1" ] || fel "unknown format: '$rad' (expected 'ENROLL-REQUEST v1')"
    forsta=""
    continue
  fi
  case "$rad" in
    namn=*)    NAMN="${rad#namn=}" ;;
    doman=*)   DOMAN="${rad#doman=}" ;;
    projekt=*) PROJEKT="${rad#projekt=}" ;;
    person=*)  PERSON="${rad#person=}" ;;
    vard=*)    VARD="${rad#vard=}" ;;
    repo=*)    REPO_S="${rad#repo=}" ;;
    pubkey=*)  PUBKEY="${rad#pubkey=}" ;;
    # OPTIONAL. The requester knows what the session should be CALLED; the
    # protocol used to drop it, and the hub then invented prefix+name.
    rc_label=*) RC_ONSKAD="${rad#rc_label=}" ;;
    from=*)    fel "the payload carries a from field — the identity comes from the envelope, never from the text" ;;
    "")        : ;;
    *)         fel "unknown line in the request: '$rad'" ;;
  esac
done

[ -n "$FROM" ]    || fel "STEWARD_ENROLL_FROM missing — the envelope's from field is mandatory"
[ -n "$NAMN" ]    || fel "field NAMN missing"
[ -n "$DOMAN" ]   || fel "field DOMAN missing"
[ -n "$PROJEKT" ] || fel "field PROJEKT missing"
[ -n "$PERSON" ]  || fel "field PERSON missing"
[ -n "$VARD" ]    || fel "field VARD missing"
[ -n "$REPO_S" ]  || fel "field REPO missing"
[ -n "$PUBKEY" ]  || fel "field PUBKEY missing"

# Enumeration, not a range — see the long explanation in bus/lib.sh at the
# subject guard. A range here would have admitted a capitalised
# <Domain>-<Person> name in a UTF-8 locale.
case "$NAMN$DOMAN$PROJEKT$PERSON$VARD" in
  *[!abcdefghijklmnopqrstuvwxyz0123456789-]*) fel "illegal characters — the namespace is [a-z0-9-]" ;;
esac
# The convention is CONSTRUCTED from the fields and compared. The name is never parsed.
[ "$NAMN" = "${DOMAN}-${PROJEKT}-${PERSON}" ] || \
  fel "the name '$NAMN' does not match the convention doman-projekt-person ('${DOMAN}-${PROJEKT}-${PERSON}')"

# ── EVERY FIELD THAT LANDS IN THE CONF IS CHARSET-GUARDED ───────────────────
# THE GAP, measured 2026-09-01. The five fields above were guarded; repo= and
# rc_label= were not — and both are interpolated UNQUOTED into a conf that is
# then sourced, by this file's own gate a few lines further down and by every
# later reader of the register. So
#
#     repo=/x$(touch PWNED)y
#
# registered with rc 0 and executed its payload as the hub's owner on every
# single read of that row. The sender is any registered session, including
# another human's account — the very population this path exists to grow.
#
# THE COMMENT THAT USED TO STAND AT THE HEREDOC made it worse: it called the
# interpolation "deliberately unescaped — see the injection note the
# callability gate below relies on". No such gate and no such note existed
# anywhere in the product. The only gate below DETONATED the payload rather
# than catching it. A false safety rationale on a live injection is worse than
# silence, so the claim is gone and the guard is here, where it can be read
# next to what it guards.
#
# REPO IS AN ALLOWLIST: an absolute path, enumerated characters only. RC_LABEL
# is a DISPLAY STRING and cannot be an ASCII allowlist — a real label carries
# arrows, accents, whatever a human types — so it is a DENYLIST of what breaks
# out of a double-quoted shell assignment, plus control characters.
case "$REPO_S" in
  /*) : ;;
  *) fel "field repo must be an absolute path — got '$REPO_S'" ;;
esac
case "$REPO_S" in
  *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789/._-]*)
    fel "field repo contains characters outside [A-Za-z0-9/._-] — a repository path lands unquoted in a conf that is sourced, so it is an allowlist" ;;
esac
# One character at a time, quoted — a case pattern built by hand out of $, a
# backquote and a backslash is exactly the kind of quoting nobody can read back
# six months later, and a mis-escape there fails OPEN.
_bar_farligt() { # <text> <forbidden characters>
  local _s="$1" _bad="$2" _i=0 _c
  while [ "$_i" -lt "${#_bad}" ]; do
    _c="${_bad:$_i:1}"
    case "$_s" in *"$_c"*) return 0 ;; esac
    _i=$((_i+1))
  done
  return 1
}
if [ -n "$RC_ONSKAD" ]; then
  if _bar_farligt "$RC_ONSKAD" '$`"\;&|<>'; then
    fel "field rc_label contains a shell metacharacter — the label lands inside a double-quoted assignment in a conf that is sourced"
  fi
  case "$RC_ONSKAD" in
    *[[:cntrl:]]*) fel "field rc_label contains a control character" ;;
  esac
fi

# Private-key check BEFORE the format check: a genuine private key should get the PRIVATE text, not the generic format text
case "$PUBKEY" in
  *PRIVATE*|*private*|*-----BEGIN*) fel "the key field looks PRIVATE — private keys never travel" ;;
esac
case "$PUBKEY" in
  ssh-ed25519\ *|ssh-rsa\ *) : ;;
  *) fel "PUBKEY does not look like a public ssh key" ;;
esac

rdir="$(registry_dir)"
# THE REQUESTER MAY BE NAMED BY A SLUG, NOT ONLY BY THE FILENAME. A new-shape
# row is filed under its opaque id; its human-readable identity lives in the
# SLUG field. The envelope's from= (bound to the relay key, never trusted
# from the payload) still carries whatever the sender authenticates as — for
# a new-shape session that is its SLUG, not its filename. Exact filename
# wins first (the common, cheap, old-shape case); only on a miss is the
# register scanned for a matching SLUG — mirroring estate-status.sh's own
# _resolve_session_key. Two rows sharing a SLUG in different accounts is a
# real ambiguity: refuse and name the accounts, rather than guess one.
FROMKEY=""
if [ -f "$rdir/$FROM.conf" ]; then
  FROMKEY="$FROM"
else
  case "$FROM" in
    ''|*[!abcdefghijklmnopqrstuvwxyz0123456789-]*) : ;;
    *)
      _famounts=""
      for _ff in "$rdir"/*.conf; do
        [ -f "$_ff" ] || continue
        [ "$(sed -n 's/^SLUG="\(.*\)"/\1/p' "$_ff" | head -1)" = "$FROM" ] || continue
        _fn="$(basename "$_ff" .conf)"
        _facc="$(sed -n 's/^ACCOUNT="\(.*\)"/\1/p' "$_ff" | head -1)"
        if [ -n "$FROMKEY" ]; then
          fel "requesting session '$FROM' is ambiguous: accounts '${_famounts}' and '${_facc:-<none>}' both declare that slug"
        fi
        FROMKEY="$_fn"; _famounts="${_facc:-<none>}"
      done
      ;;
  esac
fi
[ -n "$FROMKEY" ] || fel "requesting session '$FROM' is not in the registry"

F_OWNER="$(sed -n 's/^OWNER="\(.*\)"/\1/p' "$rdir/$FROMKEY.conf" | head -1)"
F_HOST="$(sed -n 's/^HOST="\(.*\)"/\1/p' "$rdir/$FROMKEY.conf" | head -1)"
[ "$F_OWNER" = "$PERSON" ] || \
  fel "owner check: '$FROM' is owned by '${F_OWNER:-<empty>}', the request names '$PERSON'"
# A conf without HOST lives on the hub — the same default registry_load applies.
[ "${F_HOST:-$NAV_VARD}" = "$VARD" ] || \
  fel "host check: '$FROM' lives on '${F_HOST:-$NAV_VARD}', the request names '$VARD'"

[ ! -f "$rdir/$NAMN.conf" ] || fel "name collision: '$NAMN' already exists in the registry"
if grep -qF "$PUBKEY" "$AUTH_KEYS" 2>/dev/null; then
  fel "the public key is already registered — one key, one identity"
fi

# ── THE ORG TREE IS A PRECONDITION, NOT AN AFTERTHOUGHT ─────────────────────
# A session must aim at something the org tree already knows: a project if
# one exists under this name, otherwise the domain's own entity row. Minting
# an id and writing a row that references nothing would publish a session
# whose display derivation refuses on every future read — the failure would
# land on the reader, not on the request that caused it.
TARGET_PROJECT=""; TARGET_ENTITY=""
if ( registry_project_load "$PROJEKT" >/dev/null 2>&1 ); then
  TARGET_PROJECT="$PROJEKT"
elif ( registry_entity_load "$DOMAN" >/dev/null 2>&1 ); then
  TARGET_ENTITY="$DOMAN"
else
  fel "register the project or entity first — the org tree is a precondition, not an afterthought"
fi

# ── THE ACCOUNT THE NEW SESSION BELONGS TO ───────────────────────────────────
# Resolved from (OWNER, HOST) against accounts.d — never taken from the
# request itself. A requester that could name its own account slug could
# file a session under an account it does not own.
_ACDIR="$(registry_account_dir)" || exit 78
ACCOUNT_SLUG=""
for _af in "$_ACDIR"/*.conf; do
  [ -f "$_af" ] || continue
  _aslug="$(basename "$_af" .conf)"
  # SUBSHELLED, twice — the same pattern registry_account_slug_available uses
  # below: a hostile or merely malformed accounts.d row must not clobber this
  # loop's own locals via bash's dynamic scoping.
  _ap="$( registry_account_load "$_aslug" >/dev/null 2>&1 && printf '%s' "$ACCOUNT_PRINCIPAL" )"
  _ah="$( registry_account_load "$_aslug" >/dev/null 2>&1 && printf '%s' "$ACCOUNT_HOST" )"
  [ "$_ap" = "$PERSON" ] && [ "$_ah" = "$VARD" ] || continue
  ACCOUNT_SLUG="$_aslug"
  break
done
[ -n "$ACCOUNT_SLUG" ] || fel "no account resolves for owner '$PERSON' on host '$VARD' — register the account in accounts.d first"

# ── THE COMPOSITE (ACCOUNT, SLUG) GATE ───────────────────────────────────────
# THE FILENAME COLLISION CHECK ABOVE CATCHES OLD-SHAPE ROWS (filename ==
# NAMN); a new-shape row is filed under its minted id, so the SAME name in the
# SAME account is caught only here, through the registry's own composite gate.
if ! registry_account_slug_available "$ACCOUNT_SLUG" "$NAMN"; then
  fel "slug '$NAMN' is already taken in account '$ACCOUNT_SLUG'"
fi

if [ -n "$KONTROLLERA" ]; then
  echo "nav-enroll: OK — '$NAMN' can be registered (requested by $FROM; check only, nothing written)"
  exit 0
fi

# ── EXECUTION ──────────────────────────────────────────────────────────────────
# THE SEND GOES THROUGH THE SIBLING LIBRARY, NOT THROUGH A CLIENT PATH. The old
# default kept the client path from this file's previous home, where $repo meant
# the estate root; after the move $repo means the product root (checkout) or the
# home root (deployed), and the path exists in NEITHER — so every live
# confirm/proof died with rc 127 while the registration stood (measured on a
# live hub 2026-08-21). The library is the one thing the manifest guarantees to
# be a TRUE SIBLING of this file in both layouts, and running ON the hub is
# exactly the context it is written for. STEWARD_BUS_SEND still overrides with
# an executable (argv: <recipient>, text on stdin) — the tests drive their
# stubs through it.
BUS_SEND="${STEWARD_BUS_SEND:-}"
BUS_LIB_LOADED=""
_busdir="$(CDPATH= cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -z "$BUS_SEND" ] && [ -f "$_busdir/lib.sh" ]; then
  # shellcheck source=lib.sh
  if source "$_busdir/lib.sh"; then BUS_LIB_LOADED=1; fi
fi

# ── MINT THE OPAQUE ID ───────────────────────────────────────────────────────
# s-<16 hex>, the exact shape the registry mints elsewhere (bin/steward
# registry session add, lib/jobstate.sh's j- twin) — opaque, immutable, and
# NEVER derived from account or slug: an id that encoded either would change
# identity on an account move. The filename becomes this id, never NAMN.
ID=""
_mint_tries=0
while [ "$_mint_tries" -lt 5 ]; do
  _cand="s-$(head -c 8 /dev/urandom 2>/dev/null | od -An -tx1 | tr -d ' \n')"
  case "$_cand" in
    s-????????????????) [ -e "$rdir/$_cand.conf" ] || { ID="$_cand"; break; } ;;
  esac
  _mint_tries=$((_mint_tries+1))
done
[ -n "$ID" ] || { echo "nav-enroll: could not mint a unique session id" >&2; exit 70; }

conf="$rdir/$ID.conf"
tmpc="$(mktemp)" || exit 70
# THE LABEL COMES FROM THE REQUEST WHEN THE REQUEST CARRIES ONE.
#
# Measured 2026-08-24: this wrote prefix+name unconditionally, so a session was
# registered as "<prefix>: <name>" although the requester had stated what it
# should be called. The protocol had no field for it, so the knowledge was
# dropped between the two halves and the hub filled the hole with a guess.
#
# THE COST IS NOT COSMETIC. The session ran for a minute under the invented
# label, and an RC label a session has RUN under becomes a pairing on the
# server that stays in a human's list afterwards — a name nobody asked for,
# which cannot be removed from the machines.
#
# The construction remains the fallback, so a requester that has not been
# updated behaves exactly as before.
RC_ETIKETT="${RC_ONSKAD:-$RC_PREFIX$NAMN}"
# THE TARGET LINE IS A TYPED UNION, built before the heredoc so the heredoc
# itself stays the same flat interpolation every other field uses. THAT IS SAFE
# ONLY BECAUSE EVERY FIELD IT INTERPOLATES IS CHARSET-GUARDED FIRST — see the
# guards above, immediately after the field parse: the five convention fields,
# then repo (absolute-path allowlist) and rc_label (metacharacter denylist).
# The comment that stood here used to cite a "callability gate" that existed
# nowhere, over an interpolation that was genuinely injectable; if a field is
# ever added to this heredoc, its guard belongs up there before it does.
if [ -n "$TARGET_PROJECT" ]; then
  TARGET_LINE="TARGET_PROJECT=\"$TARGET_PROJECT\""
else
  TARGET_LINE="TARGET_ENTITY=\"$TARGET_ENTITY\""
fi
# ID IS THE MINTED OPAQUE ID, never NAMN. The registry used to default ID to
# the file's basename, and the file's basename USED TO BE NAMN — a conf
# without the line "worked" only because NAMN and ID were the same string.
# Now the file's basename is the minted id and SLUG carries the human name,
# so ID must be written explicitly and match the filename exactly — the
# purpose of an opaque id is that it outlives both the display name and an
# account move, and a mismatch here would defeat that on day one.
cat > "$tmpc" <<CONFEOF
# $ID — registered by nav-enroll $(date -u +%Y-%m-%dT%H:%M:%SZ), requested by $FROM.
# Trigger per the direction doc: a domain acquired a project.
ID="$ID"
ACCOUNT="$ACCOUNT_SLUG"
SLUG="$NAMN"
$TARGET_LINE
HOST="$VARD"
REPO_PATH="$REPO_S"
RC_LABEL="$RC_ETIKETT"
PERMISSION_MODE="bypassPermissions"
OWNER="$PERSON"
DOMAIN="$DOMAN"
CONFEOF
mv "$tmpc" "$conf" || exit 70

# THE GATE: the conf must SOURCE with every field set — otherwise everything is
# withdrawn. A registry entry that does not load is a registry claiming
# something that does not exist.
if ! ( set -u; . "$conf"; : "$ID" "$ACCOUNT" "$SLUG" "$HOST" "$REPO_PATH" "$OWNER" "$DOMAIN" ) 2>/dev/null; then
  rm -f "$conf"
  echo "nav-enroll: the conf could not be sourced — NOTHING registered, nothing left behind" >&2
  exit 70
fi

# authorized_keys: backup BEFORE the write, then exactly the restrict,command
# form — the sender identity lives in the KEY, never in the message.
cp "$AUTH_KEYS" "$AUTH_KEYS.bak-$(date +%s)" 2>/dev/null || true
# $here, NOT $repo: in a deployed hub home the relay lives at
# <home>/scripts/bus/bin/bus-relay-in and $here IS <home>/scripts; $repo is one
# step too high and was correct only in this file's previous home.
#
# AND THE PATH IS CHECKED BEFORE THE LINE IS WRITTEN. This used to write the
# derived path unconditionally, and the comment here called that deliberate: an
# inbound relay that "refuses loudly (no such file)" rather than a key line to
# rewrite later. LOUDLY was the word that did not hold.
#
# Measured 2026-08-24 by the newly registered session itself: the hub was run
# from a checkout where the relay does not live, so the line named a path that
# did not exist. The refusal lands on the NEW session, and the one thing it
# cannot do is report it — all three of its attempts failed with rc 127,
# INCLUDING the automatic alarm about unacknowledged mail. So the escalation
# that would have told somebody died too. Inbound worked throughout, so the
# registration looked complete from the hub and the session merely looked quiet.
# Its outbound channel stayed dead for an hour until a human rewrote the line.
#
# A refusal only the victim can see is not a refusal; it is a silent loss.
RELAY_ROOT="${STEWARD_RELAY_ROOT:-$here}"
if [ ! -f "$RELAY_ROOT/bus/bin/bus-relay-in" ]; then
  rm -f "$conf"
  fel "the relay is missing at $RELAY_ROOT/bus/bin/bus-relay-in — the key line would name a path that does not exist, and the new session's outbound channel would be dead without it being able to say so. Run the hub from the tree where the relay lives." 78
fi
# THE KEY BINDS THE ID, NEVER THE NAME. A name is a per-account SLUG and can
# change; the id is the one thing that must never move underneath a key that
# already exists on a real machine.
printf 'restrict,command="/bin/bash %s/bus/bin/bus-relay-in %s" %s\n' \
  "$RELAY_ROOT" "$ID" "$PUBKEY" >> "$AUTH_KEYS" || { rm -f "$conf"; exit 70; }

# THE FIRST LINE IS THE ENVELOPE (bus/lib.sh:bus_envelope_parse, Task 2
# envelope v2): "DRIFT enroll: <headline>". bus_send now refuses every SEND
# without it — without the line this live send path would have gone quiet as a
# WARNING (the code below swallowed a failed send even before the envelope
# existed) and neither ENROLL-CONFIRM nor ENROLL-PROOF would have arrived. The
# ENROLL-CONFIRM/PROOF markers stay as the second line — the approval script
# and nav-enroll.test.sh look for them in the TEXT, not specifically on line one.
# THE APPROVE PATH DEPENDS ON WHOSE MACHINE THE RECIPIENT IS ON. A recipient on
# the hub's own machine shares the hub's layout, so $here (checkout or deployed
# alike) is a path they can run. A recipient on a session host has the deployed
# layout under their OWN home — an absolute hub path would name the hub owner's
# home on a machine where it does not exist, so the tilde is left for THEIR
# shell to expand. The old text hardcoded the deployed form for everyone, which
# broke every checkout-run estate (measured on a live hub 2026-08-21).
#
# THE ACTIVATE COMMAND CARRIES BOTH HALVES OF THE PAIRING: <id> AND <slug>.
# It used to print the id alone, which made the command copy-pastable and
# UNRUNNABLE. The id is the hub's name for the session; the private key on the
# host is filed under the SLUG, because the slug is all the requester knew when
# it generated the key. With only the id on the command line, the host had to
# GUESS which local reservation the id belonged to — and the guess was
# ambiguous on any host that already had a session (the requester's own row is
# always a candidate) and SILENTLY WRONG whenever exactly one candidate
# survived: it linked another session's key under the new id, so the newborn's
# outbound mail was stamped with the other session's name. That is the fleet's
# own identity-swap incident, rebuilt from new parts.
#
# The pairing is therefore CARRIED, never discovered. The hub knows both names
# at this moment and prints both; the host's --activate takes the slug as its
# second token and links exactly that key. Two tokens are as copy-pastable as
# one, and unambiguous with any number of enrolments in flight.
if [ "$VARD" = "$NAV_VARD" ]; then
  APPROVE_CMD="bash $here/session-approve.sh"
  STATUS_CMD="bash $here/estate-status.sh"
  ACTIVATE_CMD="bash $here/session-new.sh --activate $ID $NAMN"
else
  APPROVE_CMD='bash ~/scripts/session-approve.sh'
  STATUS_CMD='bash ~/scripts/estate-status.sh'
  ACTIVATE_CMD="bash ~/scripts/session-new.sh --activate $ID $NAMN"
fi
CONFIRM="DRIFT enroll: $NAMN registered
ENROLL-CONFIRM v1
namn=$NAMN
id=$ID
form=new
status=registered
activate=$ACTIVATE_CMD
gate=the approval runs FROM the new session: $APPROVE_CMD"
PROOF="DRIFT enroll: $NAMN registered, run session-approve.sh
ENROLL-PROOF v1
namn=$NAMN
from-hub=yes — that this entry reached your inbox proves the hub knows the name
task=run: $APPROVE_CMD  and send the outcome to $NAV
fleet-questions=answer from the estate's own data: $STATUS_CMD — never from account-wide discovery"

# THE IMAGE-SYNC TRAP, LOUD. PROOF now addresses the minted id, which lives
# only in THIS registry write — a deployed hub image running from an older
# install has never heard of it. Left silent, the failure that follows reads
# as "unknown recipient", which misdirects the operator toward the wrong
# cause; said here, it names the real one before the send is even attempted.
echo "nav-enroll: NOTE — the deployed hub image must be synced (run the estate's install) before ENROLL-PROOF can reach '$ID'; an unsynced image answers 'unknown recipient' instead of naming this." >&2

if [ -n "$UTAN_SANDNING" ]; then
  printf '=== to %s ===\n%s\n=== to %s ===\n%s\n' \
    "$FROM" "$CONFIRM" "$ID" "$PROOF"
else
  # THE WARNING MUST SAY WHAT HAPPENED, not merely that something did not
  # arrive. rc 65/78 are THE BUS'S OWN GUARDS refusing (paused subject,
  # malformed envelope, secret guard) — not a flaky network. The difference
  # decides what to do about it, and without it the hub's "registered" reads
  # as if CONFIRM arrived.
  bus_skicka() { # <vad> <mottagare> <text>
    local vad="$1" mot="$2" txt="$3" rc=0
    if [ -n "$BUS_SEND" ]; then
      printf '%s\n' "$txt" | "$BUS_SEND" "$mot" || rc=$?
    elif [ -n "$BUS_LIB_LOADED" ]; then
      # The hub sends as ITSELF — the identity is the hub session's name from
      # the estate, the same NAV the proof instructs the recipient to answer.
      bus_send "$mot" "$NAV" "$txt" >/dev/null || rc=$?
    else
      echo "nav-enroll: no send path — the sibling library did not load and STEWARD_BUS_SEND is unset" >&2
      rc=78
    fi
    case "$rc" in
      0) return 0 ;;
      65|78)
        echo "nav-enroll: WARNING — $vad REFUSED BY THE BUS'S OWN GUARD (rc $rc), not by the network." >&2
        echo "nav-enroll:   The reason is in the guard's output above (paused subject? envelope? secret?)." >&2
        echo "nav-enroll:   The registration stands, but $mot has NOT received the notice." >&2 ;;
      *)
        echo "nav-enroll: WARNING — $vad did not reach $mot (rc $rc). The registration stands." >&2 ;;
    esac
    return "$rc"
  }
  bus_skicka confirm "$FROM" "$CONFIRM" || true
  bus_skicka proof   "$ID"   "$PROOF"   || true
fi
echo "nav-enroll: '$NAMN' registered as $ID (requested by $FROM)"
exit 0
