# linux/browser-stack.timer — the browser stack's supervision round.
#
# OnActiveSec, NOT OnBootSec — THE SAME ANCHOR BUG, MEASURED TWICE.
# agent-session@.timer was fixed on 2026-08-23 after a power cut left eleven
# sessions down. This file kept OnBootSec, and the identical failure hit the
# very next reboot: the host came up 2026-08-23 12:37, the timer reported ACTIVE
# and enabled, and NextElapse was EMPTY. Every browser rig in EVERY domain was
# down for an hour and a half — noticed only because a session happened to be
# measuring something else.
#
# WHY THE ANCHOR IS MISSED. OnBootSec counts from the SYSTEM's boot, but a user
# timer cannot arm until the user manager has started — 71 seconds later on that
# host. The trigger was already in the past when the timer came into existence,
# and OnUnitActiveSec had nothing to chain from because the unit had never been
# active this boot. The chain therefore has no first link, and a monotonic timer
# with no anchor has no next elapse at all: permanently dead until a human runs
# the service by hand. Persistent=true does not save it — that governs
# OnCalendar, not monotonic timers.
#
# OnActiveSec counts from when the TIMER is activated, which is when the user
# manager reaches timers.target. It cannot be in the past, so it cannot be
# missed, however long the machine takes to assemble itself.
#
# THE DELAY KEEPS ITS ORIGINAL PURPOSE: a host that has just booted is still
# assembling itself, and a supervision round that reads that half-built state
# treats absence as death. Zero would be a different bug from the one fixed here.
[Unit]
Description=browser stack supervision

[Timer]
OnActiveSec=30s
OnUnitActiveSec=3min
Persistent=true

[Install]
WantedBy=timers.target
