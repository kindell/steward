#!/bin/bash
# linux/steward-account-helper - the ONE privileged action the product needs.
#
# Creating a unix account needs root; the hub runs as the steward account. The
# alternative to this file is unrestricted sudo for the steward account, which
# is not a boundary at all: it makes every bug in every product script a root
# bug. So the estate installs exactly one line,
#
#   steward ALL=(root) NOPASSWD: /usr/local/sbin/steward-account-helper
#
# and this file is what stands behind it. On a host where the steward account
# already has unrestricted sudo the line is redundant and is installed anyway,
# so the product measures the same thing on every host - and the day a host
# restricts that account, nothing changes.
#
# IT TAKES NO INPUT BUT ITS ARGUMENTS. It reads no configuration file and never
# reads stdin, and the two lines below pin the two things an argument alone does
# not settle: PATH chooses every binary this file runs as root, and LC_ALL
# chooses what the argument guard accepts. Both are pinned HERE rather than
# assumed from sudo, because secure_path is a setting in someone else's sudoers
# file that this product neither installs nor measures - and because root also
# reaches this file from cron and from a root shell, where there is no sudo at
# all. They are the FIRST statements: nothing may run before the search path is
# ours.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
#
# WHAT THOSE TWO LINES DO NOT PIN, AND WHAT DOES. bash reads BASH_ENV - and ENV,
# and SHELLOPTS - before the first statement of this script runs, so no line in
# this file can close that door from the inside. The sudoers line's env_reset is
# what keeps them out on the path this file was written for, and the product
# relies on it for exactly that. On the other paths the claim is not needed: a
# caller who already has a root shell or a root crontab is not going through
# here to reach root.
#
# IT VALIDATES ITS OWN ARGUMENT. A sudoers line permits a COMMAND, not an
# argument, so a caller can pass anything; the guard has to live here.
#
# Exit codes: 0 done - 64 usage or a bad argument - 70 an action failed -
# 77 not running as root.
set -uo pipefail

usage() {
  cat >&2 <<'USAGE'
usage: steward-account-helper add <username>
       steward-account-helper lock <username> [--archive-home]

  add   create the account when it is missing (home 750, groups video and
        render where they exist, a locked password, lingering enabled) and
        write the per-account rig socket directory fragment. Idempotent.
  lock  stop lingering (which takes the account's user manager and its session
        units with it), lock the password and expire the account.
        --archive-home also moves the home under /home/.offboarded.

The estate grants this file, and nothing else, through:
  steward ALL=(root) NOPASSWD: /usr/local/sbin/steward-account-helper
USAGE
  exit 64
}

fail() { echo "helper: REFUSING - $1" >&2; exit "${2:-70}"; }

# receipt <what> - one line of evidence, ON STDERR. Receipts are diagnostics,
# and the caller reads this helper's output to find out what was done; stdout is
# where a caller that parses would look for DATA, and this helper produces none.
# Keeping them apart also means a caller can capture the receipts without
# capturing anything else, which is what the redeem verb does.
receipt() { echo "helper: $1" >&2; }

ACTION="${1:-}"; USERNAME="${2:-}"; shift 2 2>/dev/null || true
ARCHIVE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --archive-home) ARCHIVE=1; shift ;;
    *) usage ;;
  esac
done
case "$ACTION" in
  # --archive-home BELONGS TO LOCK, AND ADD REFUSES IT rather than dropping it:
  # a flag that was taken and ignored would turn a typo'd offboard into a
  # return 0 that had quietly onboarded the person instead.
  add)  [ -z "$ARCHIVE" ] || usage ;;
  lock) ;;
  *)    usage ;;
esac
# THE SHAPE, ENUMERATED. Between 2 and 32 characters, starting with a letter -
# the shape a unix account name has on the hosts this runs on, and narrow
# enough that the name can never be anything but a name.
if ! [[ "$USERNAME" =~ ^[a-z][a-z0-9-]{1,31}$ ]]; then
  usage
fi
[ "$(id -u)" = "0" ] || fail "this helper must run as root (through the estate's sudoers line)" 77

# read_account <username> - sets ACCT_UID and HOME_DIR from the SYSTEM's own
# database, never from a /home literal; rc 1 when there is no such account, rc 2
# when the database answered about a DIFFERENT account. ONE lookup answers both
# questions, so the uid this file judges and the home it acts on can never come
# from two answers that disagree - and the name field is checked for the same
# reason: an answer that is not about the account we asked about is not an
# answer, whatever else it contains.
ACCT_UID=""
HOME_DIR=""
read_account() {
  local row _name _pw _gid _gecos _shell
  row="$(getent passwd "$1" 2>/dev/null)" || return 1
  row="${row%%$'\n'*}"
  [ -n "$row" ] || return 1
  IFS=: read -r _name _pw ACCT_UID _gid _gecos HOME_DIR _shell <<<"$row"
  [ -n "$ACCT_UID" ] || return 1
  [ "$_name" = "$1" ] || return 2
  return 0
}

# require_ordinary_account - THE FLOOR, judged on what read_account found. The
# name guard above says what a name may LOOK like; it says nothing about WHICH
# account the caller named, and every system account on a stock host is a
# lower-case name of legal shape whose home field is a real system directory.
# Without this, an account holding nothing but the sudoers line can expire root
# - the recovery account an operator reaches for - or move /dev, /bin or
# /usr/sbin out of the filesystem under the name of an archive.
#
# AND IT IS NOT ENOUGH TO ASK WHETHER AN ACCOUNT IS ORDINARY. On the hosts this
# product targets, the account an operator reaches for when everything else is
# broken is not root: root ships with a locked password and no remote login. It
# is an ordinary account - uid 1000 or above, home /home/<name> - that happens
# to be in a sudo-capable group. Every such account passed the four tests above,
# so an account holding nothing but the one sudoers line could expire, lock and
# archive every human on the machine one call at a time and keep its own way in.
# Locking every person out of a host is not reversible from the host.
#
# Two more refusals close it, and neither is visible in a passwd row:
#
#   THE CALLING ACCOUNT. SUDO_USER is one of the few variables sudo SETS rather
#   than passes through, so it survives env_reset and names the account the hub
#   runs as - the account that holds the sudoers line. Managing it is the
#   self-destruct: it locks the caller out and archives its own home, registry
#   and keys, from a process whose working directory is inside that tree. On the
#   paths where there is no sudo - a root shell, a root crontab - SUDO_USER is
#   unset and the test is vacuous, which is the right answer there: nobody
#   reaches root THROUGH this file on those paths.
#
#   AN ACCOUNT THAT CAN BECOME ROOT, asked in two ways because one is not
#   enough. A group list is cheap and covers the stock arrangement, but rights
#   granted in /etc/sudoers.d - which is exactly how this product's own installer
#   grants the hub account - or by a directory service put an account nowhere
#   near those groups and one command from root. So the group list is the first
#   test and sudo itself is the second: `sudo -l -U <name>` resolves sudoers.d,
#   LDAP, netgroups and whatever else a site configured, and answers the question
#   that is actually being asked. The cost if that is the wrong call is small and
#   visible: a member with rights of their own cannot be offboarded by the
#   helper, the receipt says exactly why, and the operator does it by hand.
#
#   AND NEITHER TEST MAY FAIL OPEN. An unreadable group list, a group this host
#   cannot name, or a sudo that will not answer are all the same answer - this
#   helper does not know - and the account goes unmanaged rather than judged on a
#   guess. Reading silence as "no privileges" is how a floor built to protect the
#   administrator locks the administrator out, on a host that is already unwell.
#
#   WHICH MEANS THE HOST'S OWN SUDOERS MUST LET root RUN `sudo -l -U`: on a host
#   whose sudoers omits `root ALL=(ALL:ALL) ALL`, or has a parse error anywhere
#   in it, that command prints nothing and this floor refuses EVERY add and lock
#   on the machine. That is the right direction to be wrong in, and it is also
#   one line of somebody else's configuration turning into a total outage of
#   both verbs - so an operator meeting a blanket "sudo would not answer" should
#   look at the host's sudoers before looking at anything here.
#
# So the helper manages only what it could have created itself: an ordinary
# uid, never root, never the caller, never sudo-capable, with its home exactly
# at /home/<name>, which is the account layout this product's own 'add'
# produces. Anything else is a usage error: the caller named something that is
# not this helper's business.
#
# The judgement is split in two: account_fails_floor names the reason without
# deciding what to do about it, because the create path below has already run a
# privileged command by the time it asks and owes a different answer than a
# caller who named the wrong account.
#
# account_group_privilege <username> - the cheap first test, out of the account's
# own group list: rc 0 the account is in a group that is a way to root, rc 1 it
# is in none of them, rc 2 the list could not be read or could not be named.
#
# IT READS THE GROUP LIST WITHOUT A PIPELINE, deliberately. `id -nG | grep -q`
# under `set -o pipefail` can return the status of a writer killed by grep's
# early exit, which would turn "not sudo-capable" into an error on timing alone.
# A loop over the words has no such reading.
#
# THE NAMES ARE NOT ONLY THE STOCK ONES. sudo, wheel, admin and adm are the
# distributions' own; docker and lxd hand out a root shell one `docker run -v
# /:/host` away, and disk is raw write access to the block device the root
# filesystem lives on. None of them is a smaller privilege than sudo.
account_group_privilege() {
  local groups g
  # AN UNREADABLE LIST IS NOT AN EMPTY LIST. On a host whose groups come from a
  # directory service this read fails during a blip, and reading that as "in no
  # privileged group" locks out the administrator this floor exists to protect,
  # at the moment the host is already unwell.
  groups="$(id -nG -- "$1" 2>/dev/null)" || return 2
  # AND AN EMPTY LIST IS NOT AN EMPTY ANSWER. A real `id -nG` always prints at
  # least the account's primary group, so nothing on a working host answers with
  # nothing - but a broken NSS answer did, at status 0, and the loop below then
  # never ran and this returned "in no privileged group". The last silence in
  # this file that was still read as an answer.
  [ -n "$groups" ] || return 2
  for g in $groups; do
    case "$g" in
      sudo|wheel|admin|adm|docker|lxd|disk) return 0 ;;
      # id prints the NUMBER when a group has no name on this host, so a host
      # that cannot name its own sudo group would answer '27' and pass a test
      # that looks for the word. Unnameable is unjudgeable.
      *[!0-9]*) ;;
      *) return 2 ;;
    esac
  done
  return 1
}
# account_sudo_rules <username> - THE QUESTION PUT TO SUDO ITSELF: rc 0 sudo
# lists privileges for the account, rc 1 it lists none (or there is no sudo on
# this host to ask), rc 2 sudo would not answer.
#
# A LIST OF GROUP NAMES IS THE WRONG SHAPE FOR THIS QUESTION and no addition to
# it makes it the right one. The rights that matter live in /etc/sudoers.d - the
# arrangement this product's own installer produces for the hub account - and in
# whatever a directory service or a netgroup hands out; an account with
# `<name> ALL=(ALL) NOPASSWD:ALL` in a drop-in file is in no privileged group at
# all. sudo resolves every one of those sources, so sudo is asked.
#
# -n because nothing here may ever wait for a terminal: this runs from a hub with
# no tty, and a helper that blocks on a prompt is a helper that hangs.
account_sudo_rules() {
  local out line listing
  command -v sudo >/dev/null 2>&1 || return 1
  out="$(sudo -n -l -U "$1" 2>/dev/null)" || true
  listing=""
  while IFS= read -r line; do
    case "$line" in
      # The shape a real sudo gives an account with no rules at all, alongside
      # status 1. That is a NO, and it is the ONLY non-zero status this reads as
      # one - every other one is an unanswered question.
      #
      # AND IT IS A NO ONLY WHILE IT IS THE WHOLE ANSWER. Below the header this
      # sentence is not sudo's own: it is text inside a spec, and a sudoers rule
      # whose command or arguments carry the phrase - a file root or a directory
      # administrator writes - turned a real listing into "no rules at all" and
      # walked a sudo-capable account through the floor. Past the header, every
      # line is a privilege whatever it says.
      *'is not allowed to run sudo'*) [ -z "$listing" ] || return 0; return 1 ;;
      # Everything after this header is a privilege, whatever it looks like.
      *'may run the following commands'*) listing=1; continue ;;
    esac
    case "$line" in *[![:space:]]*) ;; *) continue ;; esac
    [ -z "$listing" ] || return 0
    case "$line" in *'NOPASSWD'*|*'(ALL'*) return 0 ;; esac
  done <<<"$out"
  # Nothing this file can read either way. An answer that cannot be parsed is not
  # an answer, and the account goes unmanaged rather than judged on a guess.
  return 2
}

# account_privilege_reason <username> - sets FLOOR_REASON when the account has,
# or might have, a way to root of its own. Every answer this cannot get is a
# refusal: an account this helper cannot judge is an account it does not manage,
# which is the rule the session list and the device numbers below already follow.
account_privilege_reason() {
  local st
  account_group_privilege "$1"; st=$?
  case "$st" in
    0) FLOOR_REASON="'$1' is in a sudo-capable group; this helper never manages it - an account with its own way to root is the operator's to offboard by hand"
       return ;;
    2) FLOOR_REASON="could not read the group list for '$1' - this helper does not manage an account it cannot judge"
       return ;;
  esac
  account_sudo_rules "$1"; st=$?
  case "$st" in
    0) FLOOR_REASON="sudo lists privileges for '$1'; this helper never manages it - an account with its own way to root is the operator's to offboard by hand" ;;
    2) FLOOR_REASON="sudo would not answer for '$1' - this helper does not manage an account it cannot judge" ;;
  esac
}
FLOOR_REASON=""
account_fails_floor() {
  FLOOR_REASON=""
  if [ "$USERNAME" = "root" ]; then
    FLOOR_REASON="'$USERNAME' is the root account - this helper never manages it"
  elif [ "$USERNAME" = "${SUDO_USER:-}" ]; then
    FLOOR_REASON="'$USERNAME' is the calling account - this helper never manages the account it was invoked on behalf of"
  elif [ "$ACCT_UID" = "${SUDO_UID:-}" ]; then
    FLOOR_REASON="'$USERNAME' has the calling account's uid ($ACCT_UID) - this helper never manages the account it was invoked on behalf of, under whichever name"
  else
    case "$ACCT_UID" in
      ''|*[!0-9]*)
        FLOOR_REASON="the account database gives no numeric uid for '$USERNAME'" ;;
      *)
        if [ "$ACCT_UID" -lt 1000 ]; then
          FLOOR_REASON="'$USERNAME' is a system account (uid $ACCT_UID) - this helper manages ordinary accounts only"
        elif [ "$HOME_DIR" != "/home/$USERNAME" ]; then
          FLOOR_REASON="'$USERNAME' has home '$HOME_DIR', not /home/$USERNAME - this helper manages only the account layout it creates"
        else
          account_privilege_reason "$USERNAME"
        fi ;;
    esac
  fi
  [ -n "$FLOOR_REASON" ]
}
require_ordinary_account() {
  ! account_fails_floor || fail "$FLOOR_REASON" 64
}

if [ "$ACTION" = "add" ]; then
  CREATED=""
  # WHAT A LATE FAILURE LEFT STANDING, NAMED. The last two steps of add can only
  # fail once the account exists and is configured, and "could not write the
  # fragment" tells the operator nothing about the account now on their host.
  # The belt refusal on the create path already names what it left behind; these
  # owe the same, so each step records itself as it succeeds.
  ADD_LEFT=""
  add_left() { ADD_LEFT="$ADD_LEFT, $1"; }
  add_left_summary() {
    if [ -n "$ADD_LEFT" ]; then printf '%s' "${ADD_LEFT#, }"
    else printf '%s' "as this run found it - nothing here configured it"; fi
  }
  # A row for another account is not a row for this one: the create path is the
  # honest answer, and useradd will refuse for real if the name is taken.
  if read_account "$USERNAME"; then
    require_ordinary_account
    receipt "account $USERNAME already exists"
  else
    # THE HOST'S ANSWER IS MEASURED BEFORE ANYTHING IS CREATED. The floor below
    # judges the row useradd produced - but by then the account exists, and on a
    # host whose useradd puts homes somewhere other than /home EVERY add would
    # create an account this helper then has to refuse. That default is
    # readable, so it is read first and the refusal costs nothing.
    UA_DEFAULTS="$(useradd -D 2>/dev/null)" \
      || fail "could not read this host's useradd defaults ('useradd -D' failed)"
    UA_HOME=""
    while IFS= read -r ua_line; do
      case "$ua_line" in HOME=*) UA_HOME="${ua_line#HOME=}"; break ;; esac
    done <<<"$UA_DEFAULTS"
    [ "$UA_HOME" = "/home" ] \
      || fail "useradd default HOME is '$UA_HOME', expected /home - nothing was created" 64
    # --user-group IS WHAT MAKES THE 750 BELOW MEAN ANYTHING. Without it the new
    # account's primary group is whatever USERGROUPS_ENAB in the host's
    # /etc/login.defs says - a setting in someone else's file, which is the same
    # category of assumption the PATH and LC_ALL lines above refuse to make. On
    # a host where that setting is 'no' every member lands in one shared group,
    # and a 750 home is then r-x to every other member: each person's model
    # credentials under ~/.claude-logins readable by all of them, which is the
    # one property the per-account design exists to provide. The flag forces a
    # group of one regardless of the host's setting.
    useradd --create-home --user-group --shell /bin/bash "$USERNAME" \
      || fail "useradd failed for '$USERNAME'"
    read_account "$USERNAME" \
      || fail "the account database has no row for '$USERNAME' after useradd"
    # THE BELT, AND WHY ITS CODE IS 70 AND NOT 64. The account exists now: root
    # ran useradd two lines ago. 64 means the caller asked wrong and nothing
    # happened, so it would be a lie here - and a receipt that can be wrong is
    # the one thing this file refuses to print. The account is left exactly as
    # useradd made it: unconfigured, and named in the refusal so the operator
    # knows what is there.
    ! account_fails_floor \
      || fail "account $USERNAME was created by useradd but fails the floor ($FLOOR_REASON); left as is, not configured - remove it by hand if that is not what you wanted" 70
    CREATED=1
    add_left "created"
    receipt "account $USERNAME created"
  fi
  # AN ACCOUNT THIS HELPER DID NOT CREATE IS NOT ITS ACCOUNT TO CONFIGURE.
  # Everything from here to the fragment is guarded on CREATED, and each of them
  # is destructive on a person's existing account: a password lock takes that
  # person's sudo away, a group add hands them a device nobody granted them, and
  # lingering starts a user manager nobody asked for. `add` on an existing
  # account used to do all three and return 0 under the receipt "already
  # exists", which says the helper looked and did nothing.
  #
  # THE MODE IS THE ORIGINAL CASE OF THIS RULE: 750 is the contract for a home
  # this product created, and applying it to a home this helper did not make can
  # only loosen a 0700 that somebody chose on purpose.
  #
  # THE FRAGMENT IS THE ONE EXCEPTION, at the bottom, and it is the one thing
  # here that is genuinely idempotent: it is this helper's OWN file, its bytes
  # are fixed, and re-writing it changes nothing about the person.
  if [ -n "$CREATED" ]; then
    # chmod FOLLOWS SYMLINKS, and useradd --create-home does not create a home
    # that already exists: it short-circuits on a path that is already there,
    # symlink included, and writes the passwd row anyway. So a link pre-placed
    # at /home/<name> passes the floor, is recorded as created here, and turns
    # the contract's chmod into a root chmod on whatever it points at - /etc,
    # /usr/bin, /var/lib. The archive path below has refused exactly this since
    # it was written; there is no reason for the two to disagree.
    [ ! -L "$HOME_DIR" ] \
      || fail "$HOME_DIR is a symlink - a mode set on it would land on whatever it points at; account $USERNAME is left $(add_left_summary), not configured - remove it by hand if that is not what you wanted"
    chmod 750 "$HOME_DIR" || fail "could not set mode 750 on $HOME_DIR"
    add_left "home mode 750"
    receipt "home $HOME_DIR mode 750"
    # THE GROUPS ARE OPTIONAL, PER HOST. A host with no graphics stack has no
    # render group, and refusing there would make a headless host un-onboardable
    # for a reason that has nothing to do with the person.
    for g in video render; do
      if getent group "$g" >/dev/null 2>&1; then
        usermod -aG "$g" "$USERNAME" || fail "could not add '$USERNAME' to group '$g'"
        add_left "group $g"
        receipt "group $g"
      else
        receipt "group $g absent on this host, skipped"
      fi
    done
    # NO PASSWORD, EVER. The account is reached over ssh with a key or as its
    # own user manager; a password is one more credential nobody rotates.
    #
    # ITS STDOUT IS QUIET AND ITS STDERR IS NOT: the only text explaining why a
    # root password lock failed is the one this used to throw away.
    passwd -l "$USERNAME" >/dev/null || fail "could not lock the password for '$USERNAME'"
    add_left "password locked"
    receipt "password locked"
    loginctl enable-linger "$USERNAME" || fail "could not enable lingering for '$USERNAME'"
    add_left "lingering enabled"
    receipt "lingering enabled"
  else
    receipt "home $HOME_DIR left as it is (the mode is set only on a home this helper creates)"
    receipt "groups, password and lingering left as is (this helper configures only an account it created)"
  fi
  # THE RIG SOCKET DIRECTORY, PER ACCOUNT. The rig's account must be able to
  # create the socket and the steward account must be able to connect to it, so
  # the directory is 0710 owned <account>:steward. Harmless on an account that
  # never gets a rig: an empty directory under /run.
  FRAGMENT="/etc/tmpfiles.d/steward-rig-$USERNAME.conf"
  printf 'd /run/steward/rig/%s 0710 %s steward -\n' "$USERNAME" "$USERNAME" \
    | install -m 0644 /dev/stdin "$FRAGMENT" \
    || fail "could not write $FRAGMENT - account $USERNAME is left $(add_left_summary), and has no rig socket directory"
  systemd-tmpfiles --create "$FRAGMENT" \
    || fail "could not apply $FRAGMENT - account $USERNAME is left $(add_left_summary), and the fragment is written but not applied"
  receipt "tmpfiles $FRAGMENT"
  exit 0
fi

# lock - the reverse of add, in reverse order.
read_account "$USERNAME"; FOUND=$?
case "$FOUND" in
  0) ;;
  2) fail "the account database answered about another account than '$USERNAME' - this helper acts on nothing it cannot identify" 64 ;;
  *) fail "no such account '$USERNAME' - nothing to lock" ;;
esac
require_ordinary_account
# THE EXPIRY GOES FIRST, AND IT IS THE ONLY THING HERE THAT STOPS A NEW LOGIN.
# usermod --lock puts a '!' in front of the password hash, which key-based ssh
# never consults; terminate-user kills what is running at that instant and
# nothing after it. So with the old order - stop, terminate, measure, then
# expire - a member whose laptop is reconnecting on a loop lands in the window
# between the terminate and the measurement, and the receipt below describes a
# host that stopped being true while it was being printed. With --archive-home
# that is the whole harm back again: their processes go on working through open
# file descriptors into a tree that has been moved out from under them.
#
# Expiring first closes the window rather than narrowing it, and costs nothing:
# expiring the account is what this verb was called to do.
usermod --expiredate 1 "$USERNAME" || fail "could not expire '$USERNAME'"
receipt "account expired"
usermod --lock "$USERNAME" || fail "could not lock '$USERNAME'"
receipt "password locked"
# DISABLE-LINGER IS WHAT STOPS THE WORK. It takes the account's user manager
# down, and every session unit under it with the manager - which is the only
# way the steward account can stop another person's sessions without a shell in
# their home.
loginctl disable-linger "$USERNAME" || fail "could not disable lingering for '$USERNAME'"
# DISABLE-LINGER ALONE DOES NOT STOP ANYTHING WHILE A SESSION IS OPEN. It
# removes /var/lib/systemd/linger/<name> and releases logind's own reference;
# logind stops user@<uid>.service when the reference count reaches zero, and an
# open ssh connection is a reference. So the member who is logged in at the
# moment they are offboarded keeps their user manager and every unit under it -
# and if --archive-home follows, their processes go on working through open file
# descriptors into the tree that was just moved out from under them. Neither
# usermod --lock (the password) nor --expiredate (new logins) signals a single
# running process.
#
# So the sessions are terminated and then the claim is MEASURED. The receipt is
# this product's evidence and must not be able to be wrong: terminate-user is
# allowed to fail, because an account with nothing to terminate is the ordinary
# case, but the session list afterwards is not - if logind will not answer, the
# receipt below is a claim this helper cannot make.
loginctl terminate-user -- "$USERNAME" 2>/dev/null || true
SESSIONS="$(loginctl --no-legend list-sessions 2>/dev/null)" \
  || fail "could not ask logind which sessions are open for '$USERNAME' - without that answer the receipt below would be a claim this helper cannot make"
while read -r _s_id _s_uid s_user _s_rest; do
  [ "$s_user" = "$USERNAME" ] || continue
  fail "'$USERNAME' still has an open session - the user manager is not down, so the account's units are still running"
done <<<"$SESSIONS"
# THE RECEIPT NAMES WHAT WAS MEASURED, and nothing beyond it. The session list is
# the one thing this helper read; whether user@<uid>.service is still up is a
# separate question to a separate command, and a receipt may not answer a
# question that was never asked.
receipt "lingering disabled, no session left (measured)"
# THE FRAGMENT IS THIS HELPER'S OWN FILE, and add is what put it there. Left
# behind, systemd recreates /run/steward/rig/<name> at every boot for an account
# that was offboarded. Removing it is not deleting the member's data - it is
# this helper taking back the one file it placed outside their home - and the
# receipt says which of the two just happened, because that distinction is the
# whole promise of the archive below.
FRAGMENT="/etc/tmpfiles.d/steward-rig-$USERNAME.conf"
rm -f "$FRAGMENT" || fail "could not remove $FRAGMENT"
receipt "tmpfiles fragment $FRAGMENT removed - this helper's OWN file, not the member's data"
# AND THE DIRECTORY ONLY IF IT IS EMPTY. rmdir refuses a directory with anything
# in it, which is exactly the reading wanted: a socket still in there is
# somebody's live rig, and this helper does not decide that.
if rmdir "/run/steward/rig/$USERNAME" 2>/dev/null; then
  receipt "rig socket directory /run/steward/rig/$USERNAME removed (it was empty)"
else
  receipt "rig socket directory /run/steward/rig/$USERNAME left in place (it is not empty, or it was never there) - nothing was deleted"
fi
if [ -n "$ARCHIVE" ]; then
  # THE ARCHIVE ROOT IS FIXED AND THE SOURCE IS NOT. Where a home lives is the
  # system's answer; where an archived home waits for the operator's word is a
  # place a human has to be able to find, so it is one path, named here.
  #
  # THE RECEIPT IS THE PRODUCT'S EVIDENCE, SO IT MUST NOT BE ABLE TO BE WRONG.
  # Two ways this move can print a truth that is not one, and both are refused
  # rather than worked around: mv does not follow a symlinked source, so it
  # would relocate the LINK and leave the home where it is, still readable; and
  # mv into a destination that already exists puts the source INSIDE it, one
  # level below the path the receipt names, which is where an operator
  # restoring from that receipt would find the PREVIOUS archive instead.
  [ ! -L "$HOME_DIR" ] \
    || fail "$HOME_DIR is a symlink - archiving it would move the link and leave the home in place"
  # A COMMAND SUBSTITUTION THAT FAILS IS NOT CAUGHT BY set -u: it yields an
  # empty string. An unstamped destination is /home/.offboarded/<name>-, which
  # collides with itself and turns every later archive of that account into the
  # destination refusal below, for a reason nothing in the message would name.
  STAMP="$(date -u +%Y-%m-%d)" || STAMP=""
  [ -n "$STAMP" ] \
    || fail "could not read the date this archive would be stamped with - an unstamped destination collides with the next one"
  DEST="/home/.offboarded/$USERNAME-$STAMP"
  mkdir -p /home/.offboarded || fail "could not create /home/.offboarded"
  # THE ARCHIVE ROOT IS CHECKED AFTER IT IS MADE, because mkdir -p succeeds on a
  # symlink that already points at a directory - which is the one way the
  # archive lands somewhere other than the path this receipt names. And 700,
  # because root's umask leaves a fresh directory at 0755 and the list of who
  # was offboarded and when is not every account's business.
  [ ! -L /home/.offboarded ] \
    || fail "/home/.offboarded is a symlink - the archive would land somewhere other than the path this receipt names"
  [ -d /home/.offboarded ] \
    || fail "/home/.offboarded is not a directory - there is nowhere to archive to"
  chmod 700 /home/.offboarded || fail "could not set mode 700 on /home/.offboarded"
  # AND ONLY NOW THE DESTINATION, through a path that has been proved to be the
  # directory this receipt names. Taken earlier, this was a stat through an
  # archive root that had not yet been made, let alone shown not to be a symlink
  # somewhere else. Nothing was exploitable in that order - the refusals below it
  # caught the same arrangements - but the test read as a question about a place
  # and answered one about a path.
  if [ -e "$DEST" ] || [ -L "$DEST" ]; then
    fail "archive destination $DEST already exists - move or remove it before archiving again"
  fi
  # A MOVE ACROSS FILESYSTEMS IS NOT A MOVE. mv degrades silently to a recursive
  # copy followed by a recursive delete of the source, and both of the things
  # this archive promises stop being true: the receipt below says nothing was
  # deleted, and the one tree it exists to preserve is the tree that was
  # deleted; and the operation stops being atomic, so a member who fills the
  # archive volume leaves half a home and half an archive behind. A per-user
  # dataset, a quota volume and a bind-mounted home all produce it. Refused
  # rather than worked around: this helper does not delete, so it does not use a
  # move that would.
  SRC_DEV="$(stat -c %d "$HOME_DIR" 2>/dev/null)" || SRC_DEV=""
  ARCHIVE_DEV="$(stat -c %d /home/.offboarded 2>/dev/null)" || ARCHIVE_DEV=""
  [ -n "$SRC_DEV" ] && [ -n "$ARCHIVE_DEV" ] \
    || fail "could not read the device number of $HOME_DIR or of /home/.offboarded - without it there is no telling a rename from a copy and a delete"
  [ "$SRC_DEV" = "$ARCHIVE_DEV" ] \
    || fail "$HOME_DIR (device $SRC_DEV) and /home/.offboarded (device $ARCHIVE_DEV) are on different filesystems - a move between them copies and then deletes, and this helper never deletes"
  # -T MAKES THE KERNEL REFUSE A NEST. The destination test above is still a
  # check-then-act, however close to the move it is taken; -T means mv treats the
  # destination as a name and not as a directory to move into, so the guarantee
  # is the kernel's rather than the stat's.
  mv -T "$HOME_DIR" "$DEST" || fail "could not archive $HOME_DIR to $DEST"
  receipt "archived $DEST"
  # THE LOUDEST LINE IN THE OUTPUT SAYS WHOSE DATA IT IS ABOUT. This run has just
  # deleted two things - the helper's own tmpfiles fragment and an empty rig
  # directory, both receipted above - so an unqualified "nothing was deleted" is
  # read against those two lines and loses. The promise is about the member.
  receipt "NOTHING BELONGING TO THE MEMBER WAS DELETED - the archive is removed on the operator's word, never by this helper"
fi
exit 0
